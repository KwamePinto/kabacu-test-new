<script>
  const successMsg = <%- JSON.stringify(success_msg) %>;
  const errorMsg   = <%- JSON.stringify(error_msg) %>;
  if (successMsg && successMsg.length > 0) Swal.fire({ icon: 'success', text: successMsg[0] });
  if (errorMsg && errorMsg.length > 0) Swal.fire({ icon: 'error', text: errorMsg[0] });
</script>

<section class="auth-page">
  <div class="auth-card">
    <div class="auth-card__logo">
      <img src="/assets/images/new.PNG" alt="Data Mall">
    </div>

    <h1 class="auth-card__title">Verify OTP</h1>
    <p class="auth-card__sub">An OTP has been sent to <strong><%= email %></strong></p>

    <%
      /* Signed in already? Then this step is genuinely optional and gets a
         skip. Arriving without a session means they came from signup or a
         login attempt on an unverified account, and skipping would leave
         them nowhere — so the skip is hidden and the page reads as before. */
      var canSkip = Boolean(locals.user);
    %>

    <p class="auth-card__sub" style="margin-top:-6px;">
      Verifying your email is how you reset a forgotten password — and it counts
      towards your signup bonus.
    </p>

    <form action="/user/verify-otp" method="post" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label class="form-label" style="text-align: center; display: block; margin-bottom: 15px;">OTP Verification Code</label>
        <div class="input-wrapper" style="display:flex; justify-content:center; align-items:center;">
          <input type="text" name="otp" class="form-input" placeholder="------"  pattern="[0-9]{6}" maxlength="6" inputmode="numeric" style="text-align: center; letter-spacing: 12px; font-size: 1.5rem; font-weight: bold; width: 100%; max-width: 280px; padding: 12px;">
        </div>
      </div>

      <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top: 15px;">Verify Code</button>
    </form>

    <div style="text-align:center; margin-top:20px;">
      <form action="/user/resend-otp" method="post" id="resendForm" style="display:inline;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" id="resendBtn" class="btn btn--link" style="color:var(--primary); font-size:14px; background:none; border:none; cursor:pointer; padding:0; text-decoration:underline; font-weight: 500;">
          Resend Code
        </button>
      </form>
    </div>

    <% if (canSkip) { %>
    <div class="auth-divider"><span>Not now?</span></div>
    <a href="/" class="btn btn--outline btn--full">
      Skip for now
    </a>
    <p class="auth-card__sub" style="margin-top:10px; font-size:12.5px;">
      You can finish this any time from
      <a href="/signup-bonus" style="color:var(--primary);">your signup bonus page</a>.
    </p>
    <% } else { %>
    <div class="auth-divider"><span>Back to signup?</span></div>
    <a href="/user/signup" class="btn btn--outline btn--full">Register Again</a>
    <% } %>
  </div>
</section>
