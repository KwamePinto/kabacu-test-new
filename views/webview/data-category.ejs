<section class="category-page">
  <div class="container">

    <!-- Page header -->
    <div class="page-hero">
      <h1 class="page-hero__title">
        Data Bundles
      </h1>
      <p class="page-hero__sub">
        <% if (locals.viewerCountryName) { %>
        Instant delivery in <%= viewerCountryName %>
        <% } else { %>
        Instant delivery to any number
        <% } %>
      </p>
    </div>

    <%
      /* A market with no packages is "not launched here yet", not an empty
         search. Shown whenever a country is in play — for signed-in users that
         is their profile country, for visitors it is the one they picked. With
         no country selected at all, every package is listed and this is skipped. */
      var _locked        = locals.viewerCountry && viewerCountry.locked;
      var _hasCountry    = locals.viewerCountry && viewerCountry.code;
      var _noneForMarket = Object.keys(groupedProducts).length === 0;
    %>
    <% if (_noneForMarket && _hasCountry) { %>
    <div class="market-soon">
      <div class="market-soon__icon"><i data-lucide="rocket"></i></div>
      <h2 class="market-soon__title">Coming soon<%= viewerCountryName ? ' to ' + viewerCountryName : '' %></h2>
      <p class="market-soon__text">
        We haven't launched data bundles in <%= viewerCountryName || 'your country' %> yet.
        We're working on it — you'll be able to buy here as soon as we go live.
      </p>
      <a href="/" class="market-soon__btn">Back to home</a>
      <p class="market-soon__hint">
        <% if (_locked) { %>
          Wrong country? Update it in <a href="/user-profile">your profile</a>.
        <% } else { %>
          Browsing from somewhere else? Pick another country from the flag in the header.
        <% } %>
      </p>
    </div>
    <% } else { %>

    <!-- Network provider dropdown + quick phone entry -->
    <div class="category-controls">
      <div class="network-select-wrap" id="networkSelectWrap">
        <i data-lucide="wifi" class="network-select__icon"></i>
        <select class="form-select network-select" id="networkSelect">
          <% let tabIdx = 0; %>
          <% for (let provider in groupedProducts) { %>
          <option value="net_<%= tabIdx %>" <%= provider === activeNetwork ? 'selected' : '' %>>
            <%= provider %>
          </option>
          <% tabIdx++; %>
          <% } %>
        </select>
      </div>

      <div class="quick-phone-wrap" id="quickPhoneWrap">
        <div class="quick-phone-input-group">
          <div class="phone-field quick-phone-field">
            <input type="tel" id="quickPhoneInput" class="phone-field__num" placeholder="Enter phone number" maxlength="11" inputmode="numeric" autocomplete="off">
          </div>
          <% if (beneficiaries && beneficiaries.length > 0) { %>
          <div class="quick-phone-suggestions" id="quickPhoneSuggestions">
            <% beneficiaries.forEach(function(b) { %>
            <button type="button" class="quick-phone-suggestion" data-phone="<%= b.phone %>">
              <span class="quick-phone-suggestion__name"><%= b.nickname || b.phone %></span>
              <% if (b.nickname) { %><span class="quick-phone-suggestion__phone"><%= b.phone %></span><% } %>
            </button>
            <% }) %>
          </div>
          <% } %>
        </div>
        <small id="quickPhoneError" class="quick-phone-error" style="display:none;">
          Phone number must be exactly 11 digits
        </small>
        <div id="quickBeneficiaryBox" class="quick-beneficiary-box" style="display:none;">
          <label class="quick-beneficiary-toggle">
            <input type="checkbox" id="quickSaveBeneficiaryCheckbox" aria-label="Save this number as a beneficiary">
            <span class="quick-beneficiary-toggle__icon"><i data-lucide="bookmark-plus"></i></span>
            <span>Save this number as a beneficiary</span>
          </label>
          <input type="text" id="quickBeneficiaryNicknameInput" class="form-input form-input--plain quick-phone-nickname" placeholder="Nickname (optional)" style="display:none;" maxlength="30">
        </div>
      </div>
    </div>

    <!-- Network panels — each has its own pagination if needed -->
    <% let panelIdx = 0; %>
    <% for (let provider in groupedProducts) { %>
    <% const npag = netPagination[provider]; %>
    <div id="net_<%= panelIdx %>" class="tab-panel network-panel <%= provider === activeNetwork ? 'active' : '' %>">
      <%
        const panelItems = groupedProducts[provider];
        /* The filter now lists plan names. `network` on a product holds the
           plan it belongs to (e.g. "CTC Weekly Special-MTN"); the provider is
           the panel itself. */
        const plans = [...new Set(panelItems.map(function(p) { return p.dataDetails.network; }).filter(Boolean))]
          .sort();
      %>

      <!-- Plan filter — a dropdown, per AsuraX-X's design. The options are the
           plan names available in this provider's panel. -->
      <% if (plans.length > 1) { %>
      <div class="network-filter-wrap">
        <select class="network-filter-select" aria-label="Filter by plan">
          <option value="all">All Plans</option>
          <% plans.forEach(function(n) { %>
          <option value="<%= n.toLowerCase() %>"><%= n %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="bundle-grid">
        <% groupedProducts[provider].forEach(function(product) { %>
        <%
          /* Card structure: plan type, validity, price, optional struck-through
             old price with a cashback badge for the difference, optional bonus.
             Cashback is display only — nothing is credited. */
          var d = product.dataDetails;
          var hasDiscount = d.oldPrice && d.oldPrice > d.amount;
          var cashback = hasDiscount ? (d.oldPrice - d.amount) : 0;
          /* `extras` is the older array form; `bonus` is the single field the
             admin now fills. Support both so existing products keep rendering. */
          var bonuses = d.bonus ? [d.bonus] : (d.extras && d.extras.length ? d.extras : []);
        %>
        <div class="bundle-card" data-plan-type="<%= d.plan_type %>" data-name="<%= (d.plan_type + ' ' + (d.plan_name || '')).toLowerCase() %>" data-brand="<%= d.network.toLowerCase() %>" data-id="<%= product._id %>" data-network="<%= provider %>" <% if (!user) { %>data-requires-login="true" <% } %> role="button" tabindex="0" aria-label="Buy <%= d.plan_type %> on <%= d.network %> for ₦<%= d.amount %>">
          <div class="bundle-card__body">
            <div class="bundle-card__amount"><%= d.plan_type %></div>
            <div class="bundle-card__validity"><%= d.validate_period %></div>
            <div class="bundle-card__pricing">
              <span class="bundle-card__price"><span class="js-currency-symbol">₦</span><%= d.amount %></span>
              <% if (hasDiscount) { %>
              <span class="bundle-card__price-old"><span class="js-currency-symbol">₦</span><%= d.oldPrice %></span>
              <% } %>
            </div>
            <% if (hasDiscount) { %>
            <div class="bundle-card__cashback"><span class="js-currency-symbol">₦</span><%= cashback %> cashback</div>
            <% } %>
            <div class="bundle-card__meta">
              <span class="bundle-card__network"><%= d.network %></span>
              <span class="bundle-card__rp">
                <i data-lucide="star"></i>
                <%= product.reward_point %> RP
              </span>
            </div>
          </div>
          <% if (bonuses.length) { %>
          <div class="bundle-card__extras">
            <% bonuses.forEach(function(b) { %>
            <span class="bundle-card__extras-chip">
              <i data-lucide="gift"></i>
              <%= b %>
            </span>
            <% }) %>
          </div>
          <% } %>
        </div>
        <% }) %>
      </div>

      <% if (npag && npag.pages > 1) { %>
      <div class="pagination">
        <% if (npag.hasPrev) { %>
        <a href="/category/data-category?network=<%= provider %>&page=<%= npag.current - 1 %>" class="pagination__btn">
          <i data-lucide="chevron-left"></i>
        </a>
        <% } %>
        <% for (let i = 1; i <= npag.pages; i++) { %>
        <a href="/category/data-category?network=<%= provider %>&page=<%= i %>" class="pagination__page <%= i === npag.current ? 'active' : '' %>">
          <%= i %>
        </a>
        <% } %>
        <% if (npag.hasNext) { %>
        <a href="/category/data-category?network=<%= provider %>&page=<%= npag.current + 1 %>" class="pagination__btn">
          <i data-lucide="chevron-right"></i>
        </a>
        <% } %>
      </div>
      <% } %>
    </div>
    <% panelIdx++; %>
    <% } %>

    <% } %>
    <!-- / market has packages -->

  </div>
</section>

<!-- Buy Modal -->
<div id="buyModal" class="modal-overlay" role="dialog" aria-modal="true">
  <div class="modal-box">
    <div class="modal-box__header">
      <h3 class="modal-title">Enter Phone Number</h3>
      <button class="modal-close" id="cancelBtn" aria-label="Close">
        <i data-lucide="x"></i>
      </button>
    </div>
    <p class="modal-subtitle">Enter the active number to receive the data bundle</p>

    <% if (beneficiaries && beneficiaries.length > 0) { %>
    <div class="form-group">
      <label class="form-label">Saved Numbers</label>
      <div class="beneficiary-chips" id="beneficiaryChips">
        <% beneficiaries.forEach(function(b) { %>
        <button type="button" class="beneficiary-chip" data-phone="<%= b.phone %>">
          <span class="beneficiary-chip__name"><%= b.nickname || b.phone %></span>
          <% if (b.nickname) { %><span class="beneficiary-chip__phone"><%= b.phone %></span><% } %>
        </button>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="form-group">
      <label class="form-label">Phone Number</label>
      <div class="phone-field">
        <select class="phone-field__code" id="countryCode">
          <option value="+234">🇳🇬 +234</option>
        </select>
        <input type="tel" id="phoneInput" class="phone-field__num" placeholder="XXX XXX XXXX" maxlength="11" inputmode="numeric" autocomplete="tel-national">
      </div>
      <small id="phoneError" style="color:var(--error);display:none;margin-top:6px;">
        Phone number must be exactly 11 digits
      </small>
    </div>

    <div class="form-group">
      <label class="beneficiary-save-toggle">
        <input type="checkbox" id="saveBeneficiaryCheckbox" aria-label="Save this number as a beneficiary">
        Save this number as a beneficiary
      </label>
      <input type="text" id="beneficiaryNicknameInput" class="form-input form-input--plain" placeholder="Nickname (optional)" style="display:none;margin-top:8px;" maxlength="30">
    </div>

    <div class="modal-actions">
      <button id="checkoutBtn" class="btn btn--primary btn--full">
        <i data-lucide="arrow-right"></i>
        Proceed to Checkout
      </button>
    </div>
  </div>
</div>

<script>
  // ── Network dropdown switching ──
  const networkSelect = document.getElementById('networkSelect');
  if (networkSelect) {
    networkSelect.addEventListener('change', function() {
      document.querySelectorAll('.network-panel').forEach(p => p.classList.remove('active'));
      document.getElementById(this.value).classList.add('active');
    });
  }

  // ── Network → size sub-filters (per network panel) ──
  // Plan filter — a single dropdown per provider panel, no secondary size row.
  document.querySelectorAll('.network-panel').forEach(panel => {
    const planSelect = panel.querySelector('.network-filter-select');
    const cards = Array.from(panel.querySelectorAll('.bundle-card'));
    if (!planSelect) return;

    function apply(plan) {
      cards.forEach(card => {
        card.style.display = (plan === 'all' || card.dataset.brand === plan) ? '' : 'none';
      });
    }

    planSelect.addEventListener('change', function () { apply(this.value); });
    apply(planSelect.value || 'all');
  });

  // ── Buy modal ──
  let selectedPackageId = null;
  let selectedNetwork = null;

  // Nigerian network prefixes — soft hint only (number portability means these
  // are not authoritative; OurDataStore validates the actual network on purchase).
  const NETWORK_PREFIXES = {
    MTN: ['0803', '0806', '0703', '0706', '0707', '0810', '0813', '0814', '0816', '0903', '0906', '0913', '0916'],
    AIRTEL: ['0802', '0808', '0701', '0708', '0812', '0901', '0902', '0904', '0907', '0912'],
    GLO: ['0805', '0807', '0705', '0811', '0815', '0905', '0915']
  };

  function detectNetworkKey(name) {
    const n = (name || '').toUpperCase();
    if (n.indexOf('MTN') !== -1) return 'MTN';
    if (n.indexOf('AIRTEL') !== -1) return 'AIRTEL';
    if (n.indexOf('GLO') !== -1) return 'GLO';
    return null;
  }

  // Returns true if known match, false if looks wrong, null if no data for this network.
  function phoneMatchesNetwork(phone, networkName) {
    const key = detectNetworkKey(networkName);
    if (!key) return null;
    return NETWORK_PREFIXES[key].indexOf(phone.slice(0, 4)) !== -1;
  }

  // Reverse lookup — given a phone number, guess which provider it belongs to
  // so we can auto-switch the network dropdown as the user types.
  const NETWORK_KEY_TO_PROVIDER_LABEL = {
    MTN: 'MTN',
    AIRTEL: 'Airtel',
    GLO: 'GLO'
  };

  function detectProviderFromPhone(phone) {
    const prefix = phone.slice(0, 4);
    for (const key in NETWORK_PREFIXES) {
      if (NETWORK_PREFIXES[key].indexOf(prefix) !== -1) return NETWORK_KEY_TO_PROVIDER_LABEL[key];
    }
    return null;
  }

  function selectNetworkByLabel(label) {
    if (!networkSelect) return;
    const match = Array.from(networkSelect.options)
      .find(o => o.textContent.trim().toUpperCase() === label.toUpperCase());
    if (match && networkSelect.value !== match.value) {
      networkSelect.value = match.value;
      networkSelect.dispatchEvent(new Event('change'));
    }
  }

  // ── Quick phone entry (beside the network dropdown) ──
  const quickPhoneInput = document.getElementById('quickPhoneInput');
  const quickPhoneError = document.getElementById('quickPhoneError');
  const quickBeneficiaryBox = document.getElementById('quickBeneficiaryBox');
  const quickSaveBeneficiaryCheckbox = document.getElementById('quickSaveBeneficiaryCheckbox');
  const quickBeneficiaryNicknameInput = document.getElementById('quickBeneficiaryNicknameInput');
  const quickPhoneSuggestions = document.getElementById('quickPhoneSuggestions');
  const quickPhoneSuggestionBtns = quickPhoneSuggestions ?
    Array.from(quickPhoneSuggestions.querySelectorAll('.quick-phone-suggestion')) : [];
  const quickSavedPhones = new Set(quickPhoneSuggestionBtns.map(function(btn) {
    return btn.dataset.phone;
  }));

  // Shows saved-beneficiary suggestions that start with what's been typed so far;
  // hides the dropdown entirely once nothing matches.
  function refreshQuickPhoneSuggestions() {
    if (!quickPhoneSuggestions) return;
    const typed = quickPhoneInput.value;
    let anyVisible = false;
    quickPhoneSuggestionBtns.forEach(function(btn) {
      const isMatch = btn.dataset.phone.indexOf(typed) === 0;
      btn.style.display = isMatch ? '' : 'none';
      if (isMatch) anyVisible = true;
    });
    quickPhoneSuggestions.classList.toggle('open', anyVisible);
  }

  if (quickPhoneInput) {
    quickPhoneInput.addEventListener('focus', refreshQuickPhoneSuggestions);

    quickPhoneInput.addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '').slice(0, 11);
      quickPhoneError.style.display = 'none';
      if (quickSaveBeneficiaryCheckbox) quickSaveBeneficiaryCheckbox.disabled = false;
      refreshQuickPhoneSuggestions();

      const isComplete = this.value.length === 11;
      const alreadySaved = isComplete && quickSavedPhones.has(this.value);

      if (quickBeneficiaryBox) quickBeneficiaryBox.style.display = (isComplete && !alreadySaved) ? 'block' : 'none';
      if (!isComplete || alreadySaved) {
        if (quickSaveBeneficiaryCheckbox) quickSaveBeneficiaryCheckbox.checked = false;
        if (quickBeneficiaryNicknameInput) {
          quickBeneficiaryNicknameInput.value = '';
          quickBeneficiaryNicknameInput.style.display = 'none';
        }
      }

      if (isComplete) {
        if (quickPhoneSuggestions) quickPhoneSuggestions.classList.remove('open');
        const label = detectProviderFromPhone(this.value);
        if (label) selectNetworkByLabel(label);
      }
    });

    quickPhoneInput.addEventListener('blur', function() {
      if (this.value && !/^\d{11}$/.test(this.value)) {
        quickPhoneError.style.display = 'block';
      }
      // Delay so a click on a suggestion registers before the dropdown disappears.
      setTimeout(function() {
        if (quickPhoneSuggestions) quickPhoneSuggestions.classList.remove('open');
      }, 150);
    });

    quickPhoneSuggestionBtns.forEach(function(btn) {
      btn.addEventListener('mousedown', function(e) {
        e.preventDefault();
        quickPhoneInput.value = this.dataset.phone;
        // Triggers the same input handling as manual typing — since this number is
        // in quickSavedPhones, it hides the "save as beneficiary" box automatically.
        quickPhoneInput.dispatchEvent(new Event('input'));
        if (quickPhoneSuggestions) quickPhoneSuggestions.classList.remove('open');
        quickPhoneInput.focus();
      });
    });
  }

  if (quickSaveBeneficiaryCheckbox) {
    quickSaveBeneficiaryCheckbox.addEventListener('change', function() {
      quickBeneficiaryNicknameInput.style.display = this.checked ? 'block' : 'none';
    });
  }

  // Shared by both the quick input and the modal — saves the beneficiary
  // (if requested) then initiates checkout for the selected package.
  async function proceedToCheckout(phone, saveBeneficiary, nickname) {
    if (saveBeneficiary) {
      fetch('/beneficiaries/add', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({
          phone,
          network: selectedNetwork,
          nickname
        })
      }).catch(() => {});
    }

    const productId = selectedPackageId;
    if (!productId) {
      Swal.fire({
        icon: 'error',
        text: 'No product selected'
      });
      return;
    }
    try {
      const res = await fetch('/checkout/initiate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({
          packageId: productId,
          phone
        })
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = '/checkout';
      } else {
        Swal.fire({
          icon: 'error',
          text: data.message || 'Something went wrong'
        });
      }
    } catch (err) {
      Swal.fire({
        icon: 'error',
        text: 'Network error'
      });
    }
  }

  async function initiateBundleBuy(card) {
    if (card.dataset.requiresLogin) {
      window.location.href = '/user/login';
      return;
    }
    selectedPackageId = card.dataset.id;
    selectedNetwork = card.dataset.network || null;

    const quickPhone = quickPhoneInput ? quickPhoneInput.value.trim() : '';
    if (quickPhone) {
      if (!/^\d{11}$/.test(quickPhone)) {
        quickPhoneError.style.display = 'block';
        return;
      }
      const quickNetworkMatch = phoneMatchesNetwork(quickPhone, selectedNetwork);
      if (quickNetworkMatch === false) {
        const result = await Swal.fire({
          icon: 'warning',
          text: 'This number may not be a ' + selectedNetwork + ' number (could be ported). Proceed anyway?',
          showCancelButton: true,
          confirmButtonText: 'Proceed',
          cancelButtonText: 'Cancel'
        });
        if (!result.isConfirmed) return;
      }
      proceedToCheckout(
        quickPhone,
        quickSaveBeneficiaryCheckbox && quickSaveBeneficiaryCheckbox.checked,
        quickBeneficiaryNicknameInput ? quickBeneficiaryNicknameInput.value.trim() : ''
      );
      return;
    }

    resetBuyModalForm();
    document.getElementById('buyModal').classList.add('open');
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
  }

  document.querySelectorAll('.bundle-card').forEach(card => {
    card.addEventListener('click', function() {
      initiateBundleBuy(this);
    });
    card.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        initiateBundleBuy(this);
      }
    });
  });

  document.getElementById('cancelBtn').addEventListener('click', () => {
    document.getElementById('buyModal').classList.remove('open');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  });

  document.getElementById('buyModal').addEventListener('click', function(e) {
    if (e.target === this) {
      this.classList.remove('open');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }
  });

  const phoneInput = document.getElementById('phoneInput');
  const phoneError = document.getElementById('phoneError');
  const beneficiaryChips = document.getElementById('beneficiaryChips');
  const saveBeneficiaryCheckbox = document.getElementById('saveBeneficiaryCheckbox');
  const beneficiaryNicknameInput = document.getElementById('beneficiaryNicknameInput');

  let networkWarningDismissed = false;

  function resetBuyModalForm() {
    phoneInput.value = '';
    phoneError.style.display = 'none';
    networkWarningDismissed = false;
    if (beneficiaryChips) {
      beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(c => c.classList.remove('active'));
    }
    if (saveBeneficiaryCheckbox) {
      saveBeneficiaryCheckbox.checked = false;
      saveBeneficiaryCheckbox.disabled = false;
    }
    if (beneficiaryNicknameInput) {
      beneficiaryNicknameInput.value = '';
      beneficiaryNicknameInput.style.display = 'none';
    }
  }

  phoneInput.addEventListener('input', function() {
    this.value = this.value.replace(/\D/g, '').slice(0, 11);
    networkWarningDismissed = false;
    phoneError.style.display = 'none';
    if (beneficiaryChips) {
      beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(c => c.classList.remove('active'));
    }
    if (saveBeneficiaryCheckbox) saveBeneficiaryCheckbox.disabled = false;
  });

  if (beneficiaryChips) {
    beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(function(chip) {
      chip.addEventListener('click', function() {
        beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        phoneInput.value = this.dataset.phone;
        phoneError.style.display = 'none';
        // Already saved — no need to save it again.
        if (saveBeneficiaryCheckbox) {
          saveBeneficiaryCheckbox.checked = false;
          saveBeneficiaryCheckbox.disabled = true;
        }
      });
    });
  }

  if (saveBeneficiaryCheckbox) {
    saveBeneficiaryCheckbox.addEventListener('change', function() {
      beneficiaryNicknameInput.style.display = this.checked ? 'block' : 'none';
    });
  }

  document.getElementById('checkoutBtn').addEventListener('click', async () => {
    const phone = phoneInput.value.trim();
    if (!/^\d{11}$/.test(phone)) {
      phoneError.textContent = 'Phone number must be exactly 11 digits';
      phoneError.style.display = 'block';
      return;
    }
    const networkMatch = phoneMatchesNetwork(phone, selectedNetwork);
    if (networkMatch === false && !networkWarningDismissed) {
      phoneError.textContent = 'This number may not be a ' + selectedNetwork + ' number (could be ported). Tap Proceed again to continue anyway.';
      phoneError.style.display = 'block';
      networkWarningDismissed = true;
      return;
    }
    phoneError.style.display = 'none';
    networkWarningDismissed = false;

    await proceedToCheckout(
      phone,
      saveBeneficiaryCheckbox && saveBeneficiaryCheckbox.checked,
      beneficiaryNicknameInput ? beneficiaryNicknameInput.value.trim() : ''
    );
  });
</script>