<script>
  const successMsg = <%- JSON.stringify(success_msg) %>;
  const errorMsg = <%- JSON.stringify(error_msg) %>;
  if (successMsg.length > 0) Swal.fire({
    icon: 'success',
    text: successMsg[0]
  });
  if (errorMsg.length > 0) Swal.fire({
    icon: 'error',
    text: errorMsg[0]
  });
</script>

<section class="history-page">
  <div class="container">
    <div style="margin-top:24px;">
      <a href="/user-profile" class="btn btn--outline">
        <i data-lucide="arrow-left"></i>
        Back to Profile
      </a>
    </div>

    <div class="page-hero">
      <h1 class="page-hero__title">
        <i data-lucide="gift"></i>
        Referrals
      </h1>
      <p class="page-hero__sub">Share your code, track who's joined, and see what you've earned</p>
    </div>

    <div class="referral-card">
      <p class="referral-card__label">Your referral code</p>
      <div class="referral-code-row">
        <code class="referral-code" id="referralCode"><%= referralCode || '—' %></code>
        <button type="button" class="referral-copy-btn" id="referralCopyBtn" data-code="<%= referralCode || '' %>" aria-label="Copy referral code">
          <i data-lucide="copy"></i>
          <span>Copy</span>
        </button>
      </div>

      <p class="referral-card__hint">
        <% if (referralSettings && referralSettings.isActive) { %>
        Share this code. You are rewarded once someone who used it makes their first purchase.
        <% } else { %>
        The referral programme is currently paused.
        <% } %>
      </p>

      <div class="referral-stats">
        <div class="referral-stat">
          <span class="referral-stat__num"><%= (myReferrals || []).length %></span>
          <span class="referral-stat__lbl">Signed up</span>
        </div>
        <div class="referral-stat">
          <span class="referral-stat__num"><%= referralsRewarded || 0 %></span>
          <span class="referral-stat__lbl">Rewarded</span>
        </div>
      </div>
    </div>

    <!-- Entering someone else's code. Only offered when this account has not
         already been referred — the link can never be changed once set. -->
    <div class="referral-card">
      <% if (myReferral) { %>
      <p class="referral-card__label">Referred by</p>
      <p class="referral-applied">
        <i data-lucide="check-circle"></i>
        <span><%= (myReferral.referrer && myReferral.referrer.username) || 'a Kabacu user' %>
          <small>(<%= myReferral.codeUsed %>)</small></span>
      </p>
      <p class="referral-card__hint">A referral code can only be used once, so this cannot be changed.</p>
      <% } else { %>
      <p class="referral-card__label">Have a referral code?</p>
      <div class="referral-apply-row">
        <input type="text" id="referralInput" class="form-input referral-input" placeholder="Enter code" autocomplete="off" maxlength="12">
        <button type="button" class="btn-primary referral-apply-btn" id="referralApplyBtn">Apply</button>
      </div>
      <p class="referral-card__hint">You can only ever apply one code, and it must belong to an account older than yours.</p>
      <% } %>
    </div>

    <!-- ── Reward totals by type ────────────────────────────── -->
    <%
      /* TODO: no per-reward-type aggregation exists yet (rewardType/rewardAmount
         are only snapshotted per-Referral at payout time) — rewardStats is a
         placeholder from the controller until that reporting is built. */
    %>
    <div class="acct-section">
      <h3 class="acct-section__title">Your Rewards</h3>
      <div class="reward-stats-grid">
        <div class="reward-stat-card reward-stat-card--rp">
          <div class="reward-stat-card__header">
            <i data-lucide="star"></i>
            <span>Reward Points</span>
          </div>
          <div class="reward-stat-card__total"><%= rewardStats.rp.total %> RP</div>
          <div class="reward-stat-card__row">
            <span>Claimed</span>
            <span class="reward-stat-card__claimed"><%= rewardStats.rp.claimed %> RP</span>
          </div>
          <div class="reward-stat-card__row">
            <span>Unclaimed</span>
            <span class="reward-stat-card__unclaimed"><%= rewardStats.rp.unclaimed %> RP</span>
          </div>
        </div>

        <div class="reward-stat-card reward-stat-card--usdt">
          <div class="reward-stat-card__header">
            <i data-lucide="dollar-sign"></i>
            <span>USDT</span>
          </div>
          <div class="reward-stat-card__total">$<%= rewardStats.usdt.total %></div>
          <div class="reward-stat-card__row">
            <span>Claimed</span>
            <span class="reward-stat-card__claimed">$<%= rewardStats.usdt.claimed %></span>
          </div>
          <div class="reward-stat-card__row">
            <span>Unclaimed</span>
            <span class="reward-stat-card__unclaimed">$<%= rewardStats.usdt.unclaimed %></span>
          </div>
        </div>

        <div class="reward-stat-card reward-stat-card--data">
          <div class="reward-stat-card__header">
            <i data-lucide="wifi"></i>
            <span>Data Bundles</span>
          </div>
          <div class="reward-stat-card__total"><%= rewardStats.data.total %> bundles</div>
          <div class="reward-stat-card__row">
            <span>Claimed</span>
            <span class="reward-stat-card__claimed"><%= rewardStats.data.claimed %> bundles</span>
          </div>
          <div class="reward-stat-card__row">
            <span>Unclaimed</span>
            <span class="reward-stat-card__unclaimed"><%= rewardStats.data.unclaimed %> bundles</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Everyone who's used your code ────────────────────── -->
    <%
      /* TODO: reward type/amount are placeholders until reward payouts are
         surfaced per-referral — real values live on r.rewardType/rewardAmount
         once a reward has actually been paid out. */
      var REWARD_PLACEHOLDERS = ['1GB Data', '$2 USDT', '+500 RP'];
    %>
    <div class="acct-section">
      <h3 class="acct-section__title">Your Referrals</h3>

      <% if ((myReferrals || []).length) { %>
      <div class="referral-track-list">
        <% (myReferralsPage || []).forEach(function (r, i) { %>
        <% var fulfilled = r.status === 'qualified' || r.status === 'rewarded'; %>
        <% var rewardIdx = ((referralPagination.current - 1) * 10 + i) % REWARD_PLACEHOLDERS.length; %>
        <div class="referral-track-row <%= fulfilled ? 'referral-track-row--fulfilled' : 'referral-track-row--unfulfilled' %>">
          <span class="referral-track-row__name"><%= (r.referred && r.referred.username) || 'User' %></span>
          <span class="referral-track-row__reward"><%= REWARD_PLACEHOLDERS[rewardIdx] %></span>
        </div>
        <% }) %>
      </div>

      <% if (referralPagination && referralPagination.pages > 1) { %>
      <div class="pagination">
        <% if (referralPagination.hasPrev) { %>
        <a href="/referrals?page=<%= referralPagination.current - 1 %>" class="pagination__btn">
          <i data-lucide="chevron-left"></i>
        </a>
        <% } %>
        <% for (let i = 1; i <= referralPagination.pages; i++) { %>
        <a href="/referrals?page=<%= i %>" class="pagination__page <%= i === referralPagination.current ? 'active' : '' %>">
          <%= i %>
        </a>
        <% } %>
        <% if (referralPagination.hasNext) { %>
        <a href="/referrals?page=<%= referralPagination.current + 1 %>" class="pagination__btn">
          <i data-lucide="chevron-right"></i>
        </a>
        <% } %>
      </div>
      <% } %>
      <% } else { %>
      <%
        /* Placeholder rows so the design can be previewed before any real
           referrals exist — swapped out automatically once myReferrals is non-empty. */
        var PLACEHOLDER_REFERRALS = [
          { name: 'Ade O.', fulfilled: true },
          { name: 'Chidinma K.', fulfilled: true },
          { name: 'Musa B.', fulfilled: false },
          { name: 'Grace T.', fulfilled: false },
        ];
      %>
      <div class="referral-track-list referral-track-list--placeholder">
        <% PLACEHOLDER_REFERRALS.forEach(function (p, i) { %>
        <div class="referral-track-row <%= p.fulfilled ? 'referral-track-row--fulfilled' : 'referral-track-row--unfulfilled' %>">
          <span class="referral-track-row__name"><%= p.name %></span>
          <span class="referral-track-row__reward"><%= REWARD_PLACEHOLDERS[i % REWARD_PLACEHOLDERS.length] %></span>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>

  </div>
</section>

<script>
  /* ── Referrals: copy own code, apply someone else's ───────────────────── */
  (function() {
    var copyBtn = document.getElementById('referralCopyBtn');
    var applyBtn = document.getElementById('referralApplyBtn');
    var input = document.getElementById('referralInput');

    function toast(icon, text) {
      if (typeof Swal === 'undefined') return alert(text);
      Swal.fire({
        icon: icon,
        text: text,
        toast: true,
        position: 'top',
        timer: 2400,
        showConfirmButton: false
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var code = this.dataset.code;
        if (!code) return;

        var done = function() {
          var label = copyBtn.querySelector('span');
          var original = label.textContent;
          label.textContent = 'Copied';
          setTimeout(function() {
            label.textContent = original;
          }, 1600);
        };

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code).then(done).catch(fallback);
        } else {
          fallback();
        }

        /* clipboard API needs HTTPS, so keep a plain-HTTP path working too */
        function fallback() {
          var ta = document.createElement('textarea');
          ta.value = code;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
            done();
          } catch (e) {
            toast('error', 'Could not copy. Your code is ' + code);
          }
          document.body.removeChild(ta);
        }
      });
    }

    if (applyBtn && input) {
      input.addEventListener('input', function() {
        this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
      });

      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          applyBtn.click();
        }
      });

      applyBtn.addEventListener('click', async function() {
        var code = input.value.trim();
        if (!code) return toast('warning', 'Enter a referral code.');

        applyBtn.disabled = true;
        var original = applyBtn.textContent;
        applyBtn.textContent = 'Applying…';

        try {
          var res = await fetch('/referral/apply', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': '<%= csrfToken %>'
            },
            credentials: 'same-origin',
            body: JSON.stringify({
              code: code
            }),
          });
          var data = await res.json();

          if (data.success) {
            toast('success', data.message);
            setTimeout(function() {
              location.reload();
            }, 1400);
          } else {
            toast('error', data.message);
            applyBtn.disabled = false;
            applyBtn.textContent = original;
          }
        } catch (e) {
          toast('error', 'Network error. Please try again.');
          applyBtn.disabled = false;
          applyBtn.textContent = original;
        }
      });
    }
  })();
</script>