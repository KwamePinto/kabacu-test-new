<style>
/* ── Page layout ─────────────────────────────────────────── */
.faq-page { padding-bottom: 64px; }

.page-hero {
  text-align: center;
  padding: 36px 0 28px;
}
.page-hero__title {
  font-size: 26px; font-weight: 800;
  color: var(--text); margin-bottom: 8px;
  display: flex; align-items: center; justify-content: center; gap: 10px;
}
.page-hero__title svg { width: 28px; height: 28px; color: var(--primary); }
.page-hero__sub { font-size: 14px; color: var(--muted); max-width: 480px; margin: 0 auto; }

/* ── Category nav ────────────────────────────────────────── */
.faq-nav {
  display: flex; gap: 8px; flex-wrap: wrap;
  justify-content: center; margin-bottom: 32px;
}
.faq-nav__btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 16px; border-radius: 20px;
  font-size: 12px; font-weight: 700;
  border: 1px solid var(--border);
  background: var(--white); color: var(--text-sub);
  cursor: pointer; transition: all .15s;
  text-decoration: none;
}
.faq-nav__btn:hover,
.faq-nav__btn.active {
  background: var(--primary); color: #fff;
  border-color: var(--primary);
}
.faq-nav__btn svg { width: 13px; height: 13px; }

/* ── FAQ section ─────────────────────────────────────────── */
.faq-section {
  max-width: 760px; margin: 0 auto 40px;
  scroll-margin-top: 80px;
}

.faq-section__header {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 16px; padding-bottom: 10px;
  border-bottom: 2px solid var(--primary-light);
}
.faq-section__header svg { width: 20px; height: 20px; color: var(--primary); flex-shrink: 0; }
.faq-section__title {
  font-size: 16px; font-weight: 800;
  color: var(--text); letter-spacing: -.01em;
}

/* ── Accordion items ─────────────────────────────────────── */
.faq-item {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 8px;
  overflow: hidden;
  transition: box-shadow .15s;
}
.faq-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,.07); }
.faq-item.open   { box-shadow: 0 2px 12px rgba(0,0,0,.09); }

.faq-item__q {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px;
  width: 100%; text-align: left;
  padding: 16px 18px;
  background: none; border: none; cursor: pointer;
  font-size: 14px; font-weight: 700; color: var(--text);
  font-family: var(--font);
  transition: color .15s;
}
.faq-item__q:hover { color: var(--primary); }
.faq-item.open .faq-item__q { color: var(--primary); }

.faq-item__icon {
  flex-shrink: 0; width: 18px; height: 18px;
  color: var(--muted); transition: transform .25s;
}
.faq-item.open .faq-item__icon { transform: rotate(180deg); color: var(--primary); }

.faq-item__body {
  max-height: 0; overflow: hidden;
  transition: max-height .3s ease, padding .3s ease;
  padding: 0 18px;
}
.faq-item.open .faq-item__body {
  max-height: 600px;
  padding: 0 18px 18px;
}

.faq-item__ans {
  font-size: 13px; color: var(--text-sub); line-height: 1.75;
  border-top: 1px solid var(--border);
  padding-top: 14px;
}
.faq-item__ans a {
  color: var(--primary); font-weight: 600;
  text-decoration: none;
}
.faq-item__ans a:hover { text-decoration: underline; }
.faq-item__ans strong { color: var(--text); }
.faq-item__ans p { margin: 0 0 10px; }
.faq-item__ans p:last-child { margin-bottom: 0; }

/* ── Still need help ─────────────────────────────────────── */
.faq-help {
  max-width: 760px; margin: 0 auto;
  background: var(--primary-light);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 28px 24px;
  text-align: center;
}
.faq-help svg { width: 32px; height: 32px; color: var(--primary); margin-bottom: 10px; }
.faq-help h3 { font-size: 16px; font-weight: 800; margin-bottom: 6px; }
.faq-help p  { font-size: 13px; color: var(--muted); margin-bottom: 0; }
</style>

<%
var CATEGORY_META = {
  'getting-started': { label: 'Getting Started',    icon: 'rocket' },
  'wallet':          { label: 'Wallet & Payments',  icon: 'wallet' },
  'data':            { label: 'Data Bundles',        icon: 'wifi' },
  'courses':         { label: 'Courses',             icon: 'graduation-cap' },
  'account':         { label: 'Account & Profile',  icon: 'user' },
  'rewards':         { label: 'Reward Points',       icon: 'star' },
};

// Only show categories that have at least one active FAQ
var visibleCategories = CATEGORY_ORDER.filter(function(cat) {
  return faqsByCategory[cat] && faqsByCategory[cat].length > 0;
});
%>

<section class="faq-page">
  <div class="container">

    <div class="page-hero">
      <h1 class="page-hero__title">
        <i data-lucide="help-circle"></i>
        Frequently Asked Questions
      </h1>
      <p class="page-hero__sub">Everything you need to know about using Kabacu. Can't find your answer? Reach out to our support team.</p>
    </div>

    <% if (visibleCategories.length > 0) { %>

    <!-- Category nav -->
    <nav class="faq-nav">
      <% visibleCategories.forEach(function(cat) { var m = CATEGORY_META[cat]; %>
      <a href="#<%= cat %>" class="faq-nav__btn">
        <i data-lucide="<%= m.icon %>"></i> <%= m.label %>
      </a>
      <% }) %>
    </nav>

    <!-- FAQ sections -->
    <% visibleCategories.forEach(function(cat) { %>
    <%   var m = CATEGORY_META[cat]; %>
    <%   var items = faqsByCategory[cat]; %>
    <div class="faq-section" id="<%= cat %>">
      <div class="faq-section__header">
        <i data-lucide="<%= m.icon %>"></i>
        <span class="faq-section__title"><%= m.label %></span>
      </div>

      <% items.forEach(function(faq) { %>
      <div class="faq-item">
        <button class="faq-item__q" onclick="toggleFaq(this)">
          <%= faq.question %>
          <i data-lucide="chevron-down" class="faq-item__icon"></i>
        </button>
        <div class="faq-item__body">
          <div class="faq-item__ans">
            <%- faq.answer %>
          </div>
        </div>
      </div>
      <% }) %>

    </div>
    <% }) %>

    <% } else { %>
    <div style="text-align:center;padding:48px 0;color:var(--muted);">
      <i data-lucide="help-circle" style="width:40px;height:40px;margin-bottom:12px;display:block;margin-left:auto;margin-right:auto;"></i>
      <p>No FAQs available yet.</p>
    </div>
    <% } %>

    <!-- Still need help -->
    <div class="faq-help">
      <i data-lucide="message-circle"></i>
      <h3>Still have questions?</h3>
      <p>Our support team is available to help. Reach out via email or through our social channels and we'll get back to you as soon as possible.</p>
    </div>

  </div>
</section>

<script>
function toggleFaq(btn) {
  var item = btn.closest('.faq-item');
  var isOpen = item.classList.contains('open');

  /* close all siblings */
  var siblings = item.parentElement.querySelectorAll('.faq-item');
  siblings.forEach(function (s) { s.classList.remove('open'); });

  if (!isOpen) item.classList.add('open');

  /* re-init icons in newly opened item */
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

/* smooth-scroll nav pills */
document.querySelectorAll('.faq-nav__btn').forEach(function (btn) {
  btn.addEventListener('click', function (e) {
    e.preventDefault();
    var target = document.querySelector(this.getAttribute('href'));
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });

    document.querySelectorAll('.faq-nav__btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
  });
});
</script>
