<!-- ══ HOME ════════════════════════════════════════════════ -->

<div id="homeContent">

  <!-- ── Mobile: Category quick-access circles ─────────────── -->
  <div class="mobile-cats">
    <div class="mobile-cats__header">
      <a href="/categories" class="mobile-cats__see-all" aria-label="See all categories">
        <i data-lucide="chevron-right"></i>
      </a>
      <p class="mobile-cats__label">Categories</p>
    </div>
    <div class="mobile-cats__row">
      <a href="/category/data-category" class="mobile-cat">
        <div class="mobile-cat__circle">
          <i data-lucide="wifi"></i>
        </div>
        <span class="mobile-cat__name">Data</span>
      </a>
      <a href="/category/electronic-category" class="mobile-cat">
        <div class="mobile-cat__circle">
          <i data-lucide="smartphone"></i>
        </div>
        <span class="mobile-cat__name">Electronics</span>
      </a>
      <a href="/category/automobile-category" class="mobile-cat">
        <div class="mobile-cat__circle">
          <i data-lucide="car"></i>
        </div>
        <span class="mobile-cat__name">Automobiles</span>
      </a>
      <a href="/category/course-category" class="mobile-cat">
        <div class="mobile-cat__circle">
          <i data-lucide="graduation-cap"></i>
        </div>
        <span class="mobile-cat__name">Courses</span>
      </a>
      <a href="/category/p2p-category" class="mobile-cat">
        <div class="mobile-cat__circle">
          <i data-lucide="arrow-left-right"></i>
        </div>
        <span class="mobile-cat__name">P2P</span>
      </a>
      <!-- "More" circle — always at the end; links to the categories landing page -->
      <a href="/categories" class="mobile-cat mobile-cat--more">
        <div class="mobile-cat__circle mobile-cat__circle--more">
          <i data-lucide="layout-grid"></i>
        </div>
        <span class="mobile-cat__name">More</span>
      </a>
    </div>
  </div>

  <!-- ══ Hero section — green bg (desktop), image card + header ══ -->
  <div class="hero-section">

    <!-- Desktop: faint diagonal product-name watermark -->
    <div class="hero-bg-pattern" aria-hidden="true" id="heroBgPattern"></div>

    <!-- Desktop: centred heading above the card (hidden on mobile) -->
    <div class="hero-section__header desktop-section">
      <div class="container">
        <h2 class="hero-title" id="heroTitle">Buy Data Bundles in Seconds</h2>
        <p class="hero-sub" id="heroSub">Fast, instant delivery to any Nigerian network. Shop the best plans now.</p>
      </div>
    </div>

    <!-- Carousel card -->
    <div class="promo-carousel" id="promoCarousel">

      <%
        /* Banners come from the Announcements admin section. */
        var _banners = (locals.announcements && announcements.banners) || [];
      %>
      <% _banners.forEach(function(b, i) { %>
      <div class="promo-slide<%= i === 0 ? ' active' : '' %>">
        <% if (b.image) { %>
        <img class="promo-slide__bg-img" src="<%= b.image %>" alt="<%= b.title %>">
        <% } %>
        <div class="promo-slide__overlay"></div>
        <!-- Mobile overlay text -->
        <div class="promo-slide__content">
          <% if (b.eyebrow) { %><span class="promo-slide__eyebrow"><%= b.eyebrow %></span><% } %>
          <h2 class="promo-slide__title"><%= b.title %></h2>
          <% if (b.subtitle) { %><p class="promo-slide__sub"><%= b.subtitle %></p><% } %>
          <% if (b.ctaLabel) { %>
          <a href="<%= b.ctaLink || '#' %>" class="promo-slide__btn"><%= b.ctaLabel %></a>
          <% } %>
        </div>
        <!-- Desktop caption at card bottom -->
        <% if (b.caption) { %>
        <div class="promo-slide__caption">
          <p class="promo-slide__caption-text"><%= b.caption %></p>
        </div>
        <% } %>
      </div>
      <% }) %>

    </div>

    <!-- Desktop: curved wave at the bottom of the green section -->
    <div class="hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,120 Q720,0 1440,120 Z" fill="#f4f4f4" />
      </svg>
    </div>

  </div><!-- / .hero-section -->

  <!-- Dots — below overflowing card (desktop: positioned in white area) -->
  <div class="hero-dots-wrap">
    <div class="promo-dots" id="promoDots">
      <% _banners.forEach(function(b, i) { %>
      <span class="promo-dot<%= i === 0 ? ' promo-dot--active' : '' %>"></span>
      <% }) %>
    </div>
  </div>

  <!-- ── Desktop: Browse Categories (hidden on mobile) ───── -->
  <div class="desktop-section cat-browse">
    <div class="container">
      <div class="cat-browse__heading">
        <h2 class="cat-browse__title">Browse Categories</h2>
        <p class="cat-browse__subtitle">Everything you need, all in one place</p>
      </div>
      <div class="cat-browse__grid">

        <a href="/category/data-category" class="cat-browse__card">
          <div class="cat-browse__img-wrap">
            <picture>
              <source srcset="/assets/images/cat-databundles-tall.webp" type="image/webp">
              <img src="/assets/images/cat-databundles-tall.jpg" alt="Data Bundles" loading="lazy">
            </picture>
            <div class="cat-browse__hover-overlay">
              <div class="cat-browse__hover-label">Data Bundles</div>
              <div class="cat-browse__hover-desc">MTN · Airtel · Glo</div>
            </div>
          </div>
        </a>

        <a href="/category/electronic-category" class="cat-browse__card">
          <div class="cat-browse__img-wrap">
            <picture>
              <source srcset="/assets/images/cat-electronics.webp" type="image/webp">
              <img src="/assets/images/cat-electronics.jpg" alt="Electronics" loading="lazy">
            </picture>
            <div class="cat-browse__hover-overlay">
              <div class="cat-browse__hover-label">Electronics</div>
              <div class="cat-browse__hover-desc">Phones, Laptops &amp; Gadgets</div>
            </div>
          </div>
        </a>

        <a href="/category/automobile-category" class="cat-browse__card">
          <div class="cat-browse__img-wrap">
            <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=800&q=85" alt="Automobiles">
            <div class="cat-browse__hover-overlay">
              <div class="cat-browse__hover-label">Automobiles</div>
              <div class="cat-browse__hover-desc">Cars, Parts &amp; Accessories</div>
            </div>
          </div>
        </a>

        <a href="/category/course-category" class="cat-browse__card">
          <div class="cat-browse__img-wrap">
            <picture>
              <source srcset="/assets/images/cat-courses.webp" type="image/webp">
              <img src="/assets/images/cat-courses.jpg" alt="Courses" loading="lazy">
            </picture>
            <div class="cat-browse__hover-overlay">
              <div class="cat-browse__hover-label">Courses</div>
              <div class="cat-browse__hover-desc">Online Skills &amp; Training</div>
            </div>
          </div>
        </a>

      </div>
    </div>
  </div>

  <!-- ── Products, strips, trust bar ─────────────────────── -->
  <div class="container">

    <!-- New Arrivals -->
    <div class="sec-header" style="margin-top:28px;">
      <span class="sec-title">New Arrivals <span style="font-size:16px;">🔥</span></span>
      <a href="/category/data-category" class="sec-link">See All</a>
    </div>

    <% var arrivalProducts = dataProducts || []; %>
    <% if (arrivalProducts.length > 0) { %>
    <div class="product-grid" id="homeProductGrid">
      <% arrivalProducts.slice(0, 8).forEach(function(product) { %>
      <div class="product-card" data-name="<%= (product.dataDetails.plan_type + ' ' + product.dataDetails.plan_name).toLowerCase() %>" data-brand="<%= product.dataDetails.network.toLowerCase() %>">
        <%
          /* Same structure as the data-section cards: plan type, validity,
             price, optional struck-through old price plus a cashback badge for
             the difference (display only), optional bonus chip. */
          var hd = product.dataDetails;
          var hasDisc = hd.oldPrice && hd.oldPrice > hd.amount;
          var hCashback = hasDisc ? (hd.oldPrice - hd.amount) : 0;
          var hBonuses = hd.bonus ? [hd.bonus] : (hd.extras && hd.extras.length ? hd.extras : []);
        %>
        <div class="product-card__body">
          <h4 class="product-card__name" style="min-height: 35px; font-size: medium;"><%= hd.plan_type %></h4>
          <p class="product-card__brand"><%= hd.validate_period %></p>
          <% if (hBonuses.length) { %>
          <span class="product-card__bonus"><i data-lucide="gift"></i><%= hBonuses[0] %></span>
          <% } %>
          <div class="product-card__footer">
            <div class="product-card__price-col">
              <span class="product-card__rp"><i data-lucide="star"></i><%= product.reward_point %> RP</span>
              <div class="product-card__price-row">
                <span class="product-card__price"><span class="js-currency-symbol">₦</span><%= hd.amount %></span>
                <% if (hasDisc) { %>
                <span class="product-card__price-old"><span class="js-currency-symbol">₦</span><%= hd.oldPrice %></span>
                <% } %>
              </div>
              <% if (hasDisc) { %>
              <span class="product-card__cashback"><span class="js-currency-symbol">₦</span><%= hCashback %> cashback</span>
              <% } %>
            </div>
            <% if (user) { %>
            <button class="product-card__buy buy-btn" data-id="<%= product._id %>" data-network="<%= product.dataDetails.network %>" aria-label="Buy">
              <i data-lucide="plus"></i>
            </button>
            <% } else { %>
            <a href="/user/login" class="product-card__buy" aria-label="Login to buy">
              <i data-lucide="plus"></i>
            </a>
            <% } %>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if (arrivalProducts.length === 0) { %>
    <div class="empty-state">
      <i data-lucide="package"></i>
      <p>No products available yet</p>
    </div>
    <% } %>

    <!-- ── Electronics strip ──────────────────────────────── -->
    <% if (electronicProducts && electronicProducts.length > 0) { %>
    <div class="cat-strip">
      <div class="cat-strip__head">
        <h3 class="cat-strip__title">
          <i data-lucide="monitor-smartphone"></i>
          Electronics
        </h3>
        <a href="/category/electronic-category" class="cat-strip__link">
          See All <i data-lucide="chevron-right"></i>
        </a>
      </div>
      <div class="cat-strip__scroll">
        <% electronicProducts.slice(0, 4).forEach(function(p) { %>
        <a href="/category/electronic-category" class="cat-strip__card">
          <% if (p.images && p.images[0]) { %>
          <img src="<%= p.images[0] %>" alt="<%= p.electronicDetails && p.electronicDetails.itemName || 'Electronic' %>" class="cat-strip__img" onerror="this.style.display='none';this.nextElementSibling.removeAttribute('hidden');">
          <div class="cat-strip__img--placeholder" hidden><i data-lucide="monitor-smartphone"></i></div>
          <% } else { %>
          <div class="cat-strip__img--placeholder"><i data-lucide="monitor-smartphone"></i></div>
          <% } %>
          <div class="cat-strip__body">
            <div class="cat-strip__name"><%= p.electronicDetails && p.electronicDetails.itemName || p.description %></div>
            <div class="cat-strip__sub"><%= p.electronicDetails && p.electronicDetails.brandItem || '' %></div>
            <% if (p.electronicDetails && p.electronicDetails.items_price) { %>
            <div class="cat-strip__price"><span class="js-currency-symbol">₦</span><%= p.electronicDetails.items_price.toLocaleString() %></div>
            <% } %>
          </div>
        </a>
        <% }) %>
        <% if (electronicProducts.length > 4) { %>
        <a href="/category/electronic-category" class="cat-strip__more">
          <i data-lucide="arrow-right"></i>
          More
        </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- ── Automobiles strip ───────────────────────────────── -->
    <% if (automobileProducts && automobileProducts.length > 0) { %>
    <div class="cat-strip">
      <div class="cat-strip__head">
        <h3 class="cat-strip__title">
          <i data-lucide="car"></i>
          Automobiles
        </h3>
        <a href="/category/automobile-category" class="cat-strip__link">
          See All <i data-lucide="chevron-right"></i>
        </a>
      </div>
      <div class="cat-strip__scroll">
        <% automobileProducts.slice(0, 4).forEach(function(p) { %>
        <a href="/category/automobile-category" class="cat-strip__card">
          <% if (p.images && p.images[0]) { %>
          <img src="<%= p.images[0] %>" alt="<%= p.automobileDetails && p.automobileDetails.brand || 'Auto' %>" class="cat-strip__img" onerror="this.style.display='none';this.nextElementSibling.removeAttribute('hidden');">
          <div class="cat-strip__img--placeholder" hidden><i data-lucide="car"></i></div>
          <% } else { %>
          <div class="cat-strip__img--placeholder"><i data-lucide="car"></i></div>
          <% } %>
          <div class="cat-strip__body">
            <div class="cat-strip__name"><%= p.automobileDetails && (p.automobileDetails.brand + ' ' + p.automobileDetails.model) || p.description %></div>
            <div class="cat-strip__sub"><%= p.automobileDetails && (p.automobileDetails.year + ' · ' + (p.automobileDetails.condition || '')) || '' %></div>
            <% if (p.automobileDetails && p.automobileDetails.price) { %>
            <div class="cat-strip__price"><span class="js-currency-symbol">₦</span><%= p.automobileDetails.price.toLocaleString() %></div>
            <% } %>
          </div>
        </a>
        <% }) %>
        <% if (automobileProducts.length > 4) { %>
        <a href="/category/automobile-category" class="cat-strip__more">
          <i data-lucide="arrow-right"></i>
          More
        </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- ── Courses strip ───────────────────────────────────── -->
    <% if (coursesProducts && coursesProducts.length > 0) { %>
    <div class="cat-strip">
      <div class="cat-strip__head">
        <h3 class="cat-strip__title">
          <i data-lucide="graduation-cap"></i>
          Courses
        </h3>
        <a href="/category/course-category" class="cat-strip__link">
          See All <i data-lucide="chevron-right"></i>
        </a>
      </div>
      <div class="cat-strip__scroll">
        <% coursesProducts.slice(0, 4).forEach(function(p) { %>
        <a href="/category/course-category" class="cat-strip__card">
          <% if (p.images && p.images[0]) { %>
          <img src="<%= p.images[0] %>" alt="<%= p.coursesDetails && p.coursesDetails.title || 'Course' %>" class="cat-strip__img" onerror="this.style.display='none';this.nextElementSibling.removeAttribute('hidden');">
          <div class="cat-strip__img--placeholder" hidden><i data-lucide="book-open"></i></div>
          <% } else { %>
          <div class="cat-strip__img--placeholder"><i data-lucide="book-open"></i></div>
          <% } %>
          <div class="cat-strip__body">
            <div class="cat-strip__name"><%= p.coursesDetails && p.coursesDetails.title || p.description %></div>
            <div class="cat-strip__sub"><%= p.coursesDetails && p.coursesDetails.instructor ? 'by ' + p.coursesDetails.instructor : '' %></div>
            <% if (p.coursesDetails && p.coursesDetails.course_price) { %>
            <div class="cat-strip__price"><span class="js-currency-symbol">₦</span><%= p.coursesDetails.course_price.toLocaleString() %></div>
            <% } %>
          </div>
        </a>
        <% }) %>
        <% if (coursesProducts.length > 4) { %>
        <a href="/category/course-category" class="cat-strip__more">
          <i data-lucide="arrow-right"></i>
          More
        </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- ── Trust bar (desktop only) ───────────────────────── -->
    <div class="desktop-section">
      <div class="trust-bar">

        <div class="trust-item">
          <div class="trust-item__icon">
            <i data-lucide="zap"></i>
          </div>
          <div>
            <div class="trust-item__title">Instant Delivery</div>
            <div class="trust-item__sub">Data bundles delivered in seconds to any Nigerian network</div>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-item__icon">
            <i data-lucide="shield-check"></i>
          </div>
          <div>
            <div class="trust-item__title">Secure Payments</div>
            <div class="trust-item__sub">All transactions are encrypted and fully protected</div>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-item__icon">
            <i data-lucide="headphones"></i>
          </div>
          <div>
            <div class="trust-item__title">24/7 Support</div>
            <div class="trust-item__sub">Our team is always available to help you out</div>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-item__icon">
            <i data-lucide="gift"></i>
          </div>
          <div>
            <div class="trust-item__title">Reward Points</div>
            <div class="trust-item__sub">Earn RP on every purchase and redeem it to your BitToken mining account</div>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<!-- ══ CATEGORY TAB ════════════════════════════════════════ -->
<!-- Buy Modal -->
<div id="buyModal" class="modal-overlay" role="dialog" aria-modal="true">
  <div class="modal-box">
    <div class="modal-box__header">
      <h3 class="modal-title">Enter Phone Number</h3>
      <button class="modal-close" id="cancelBtn" aria-label="Close">
        <i data-lucide="x"></i>
      </button>
    </div>
    <p class="modal-subtitle">Enter the active number to receive the data bundle</p>

    <% if (beneficiaries && beneficiaries.length > 0) { %>
    <div class="form-group">
      <label class="form-label">Saved Numbers</label>
      <div class="beneficiary-chips" id="beneficiaryChips">
        <% beneficiaries.forEach(function(b) { %>
        <button type="button" class="beneficiary-chip" data-phone="<%= b.phone %>">
          <span class="beneficiary-chip__name"><%= b.nickname || b.phone %></span>
          <% if (b.nickname) { %><span class="beneficiary-chip__phone"><%= b.phone %></span><% } %>
        </button>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="form-group">
      <label class="form-label">Phone Number</label>
      <div class="input-wrapper">
        <i data-lucide="phone"></i>
        <input type="text" id="phoneInput" class="form-input" placeholder="e.g 08012345678" maxlength="11" inputmode="numeric">
      </div>
      <small id="phoneError" style="color:var(--error);display:none;margin-top:4px;">
        Phone number must be exactly 11 digits
      </small>
    </div>

    <div class="form-group">
      <label class="beneficiary-save-toggle">
        <input type="checkbox" id="saveBeneficiaryCheckbox" aria-label="Save this number as a beneficiary">
        Save this number as a beneficiary
      </label>
      <input type="text" id="beneficiaryNicknameInput" class="form-input form-input--plain" placeholder="Nickname (optional)" style="display:none;margin-top:8px;" maxlength="30">
    </div>

    <div class="modal-actions">
      <button id="checkoutBtn" class="btn btn--primary btn--full">
        <i data-lucide="arrow-right"></i>
        Proceed to Checkout
      </button>
    </div>
  </div>
</div>

<script>
  /* ── Carousel ─────────────────────────────────────────── */
  (function() {
    var slides = document.querySelectorAll('.promo-slide');
    var dots = document.querySelectorAll('#promoDots .promo-dot');
    var current = 0;
    var timer;

    /* Banners are admin-managed, so the carousel may legitimately be empty */
    if (!slides.length) return;

    /* Desktop heading text mirrors the active banner. Built from the same
       Announcements records that rendered the slides above. */
    var slideData = <%- JSON.stringify(_banners.map(function(b) {
      return { title: b.title || '', sub: b.caption || b.subtitle || '' };
    })) %>;

    function updateHeroHeader(idx) {
      var titleEl = document.getElementById('heroTitle');
      var subEl = document.getElementById('heroSub');
      if (titleEl) titleEl.textContent = slideData[idx].title;
      if (subEl) subEl.textContent = slideData[idx].sub;
    }

    function go(n) {
      var titleEl = document.getElementById('heroTitle');
      var subEl = document.getElementById('heroSub');

      /* fade out heading text */
      if (titleEl) titleEl.style.opacity = '0';
      if (subEl) subEl.style.opacity = '0';

      slides[current].classList.remove('active');
      dots[current].classList.remove('promo-dot--active');
      current = (n + slides.length) % slides.length;
      slides[current].classList.add('active');
      dots[current].classList.add('promo-dot--active');

      /* update text mid-transition then fade back in */
      setTimeout(function() {
        updateHeroHeader(current);
        if (titleEl) titleEl.style.opacity = '';
        if (subEl) subEl.style.opacity = '';
      }, 280);
    }

    function restart() {
      clearInterval(timer);
      timer = setInterval(function() {
        go(current + 1);
      }, 4500);
    }

    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() {
        go(i);
        restart();
      });
    });

    restart();
  })();

  /* ── Cat-browse scroll-reveal ─────────────────────────── */
  (function() {
    var heading = document.querySelector('.cat-browse__heading');
    var grid = document.querySelector('.cat-browse__grid');
    if (!grid || !window.IntersectionObserver) return;

    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        if (entry.target === heading && heading) {
          heading.classList.add('revealed');
        } else {
          entry.target.querySelectorAll('.cat-browse__card').forEach(function(card) {
            card.classList.add('revealed');
          });
          io.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15
    });

    if (heading) io.observe(heading);
    io.observe(grid);

    lucide.createIcons();
  })();

  /* Hero watermark now lives in its own <script> below so that an error in
     any of the blocks above can never leave it unfilled. */

  /* ── Hero transparent header (desktop only) ──────────── */
  (function() {
    if (window.innerWidth < 768) return;
    var header = document.querySelector('.app-header');
    var hero = document.querySelector('.hero-section');
    var main = document.querySelector('.page-main');
    if (!header || !hero) return;

    /* Remove page-main top gap so hero sits under the fixed bar */
    if (main) main.style.paddingTop = '0';

    function sync() {
      var bottom = hero.getBoundingClientRect().bottom;
      if (bottom > 10) {
        header.classList.add('hero-transparent');
      } else {
        header.classList.remove('hero-transparent');
      }
    }

    sync();
    window.addEventListener('scroll', sync, {
      passive: true
    });

    /* Restore on resize back to mobile */
    window.addEventListener('resize', function() {
      if (window.innerWidth < 768) {
        header.classList.remove('hero-transparent');
        if (main) main.style.paddingTop = '';
      } else {
        if (main) main.style.paddingTop = '0';
        sync();
      }
    }, {
      passive: true
    });
  })();

  /* ── Buy modal ────────────────────────────────────────── */
  var selectedPackageId = null;
  var selectedNetwork = null;

  // Nigerian network prefixes — soft hint only (number portability means these
  // are not authoritative; OurDataStore validates the actual network on purchase).
  var NETWORK_PREFIXES = {
    MTN: ['0803', '0806', '0703', '0706', '0707', '0810', '0813', '0814', '0816', '0903', '0906', '0913', '0916'],
    AIRTEL: ['0802', '0808', '0701', '0708', '0812', '0901', '0902', '0904', '0907', '0912'],
    GLO: ['0805', '0807', '0705', '0811', '0815', '0905', '0915']
  };

  function detectNetworkKey(name) {
    var n = (name || '').toUpperCase();
    if (n.indexOf('MTN') !== -1) return 'MTN';
    if (n.indexOf('AIRTEL') !== -1) return 'AIRTEL';
    if (n.indexOf('GLO') !== -1) return 'GLO';
    return null;
  }

  // Returns true if known match, false if looks wrong, null if no data for this network.
  function phoneMatchesNetwork(phone, networkName) {
    var key = detectNetworkKey(networkName);
    if (!key) return null;
    return NETWORK_PREFIXES[key].indexOf(phone.slice(0, 4)) !== -1;
  }

  document.querySelectorAll('.buy-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      selectedPackageId = this.dataset.id;
      selectedNetwork = this.dataset.network || null;
      resetBuyModalForm();
      document.getElementById('buyModal').classList.add('open');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    });
  });

  document.getElementById('cancelBtn').addEventListener('click', function() {
    document.getElementById('buyModal').classList.remove('open');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  });

  document.getElementById('buyModal').addEventListener('click', function(e) {
    if (e.target === this) {
      this.classList.remove('open');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }
  });

  var phoneInput = document.getElementById('phoneInput');
  var phoneError = document.getElementById('phoneError');
  var beneficiaryChips = document.getElementById('beneficiaryChips');
  var saveBeneficiaryCheckbox = document.getElementById('saveBeneficiaryCheckbox');
  var beneficiaryNicknameInput = document.getElementById('beneficiaryNicknameInput');

  var networkWarningDismissed = false;

  function resetBuyModalForm() {
    phoneInput.value = '';
    phoneError.style.display = 'none';
    networkWarningDismissed = false;
    if (beneficiaryChips) {
      beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(function(c) {
        c.classList.remove('active');
      });
    }
    if (saveBeneficiaryCheckbox) {
      saveBeneficiaryCheckbox.checked = false;
      saveBeneficiaryCheckbox.disabled = false;
    }
    if (beneficiaryNicknameInput) {
      beneficiaryNicknameInput.value = '';
      beneficiaryNicknameInput.style.display = 'none';
    }
  }

  phoneInput.addEventListener('input', function() {
    this.value = this.value.replace(/\D/g, '').slice(0, 11);
    networkWarningDismissed = false;
    phoneError.style.display = 'none';
    if (beneficiaryChips) {
      beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(function(c) {
        c.classList.remove('active');
      });
    }
    if (saveBeneficiaryCheckbox) saveBeneficiaryCheckbox.disabled = false;
  });

  if (beneficiaryChips) {
    beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(function(chip) {
      chip.addEventListener('click', function() {
        beneficiaryChips.querySelectorAll('.beneficiary-chip').forEach(function(c) {
          c.classList.remove('active');
        });
        this.classList.add('active');
        phoneInput.value = this.dataset.phone;
        phoneError.style.display = 'none';
        if (saveBeneficiaryCheckbox) {
          saveBeneficiaryCheckbox.checked = false;
          saveBeneficiaryCheckbox.disabled = true;
        }
      });
    });
  }

  if (saveBeneficiaryCheckbox) {
    saveBeneficiaryCheckbox.addEventListener('change', function() {
      beneficiaryNicknameInput.style.display = this.checked ? 'block' : 'none';
    });
  }

  document.getElementById('checkoutBtn').addEventListener('click', async function() {
    var phone = phoneInput.value.trim();
    if (!/^\d{11}$/.test(phone)) {
      phoneError.textContent = 'Phone number must be exactly 11 digits';
      phoneError.style.display = 'block';
      return;
    }
    var networkMatch = phoneMatchesNetwork(phone, selectedNetwork);
    if (networkMatch === false && !networkWarningDismissed) {
      phoneError.textContent = 'This number may not be a ' + selectedNetwork + ' number (could be ported). Tap Proceed again to continue anyway.';
      phoneError.style.display = 'block';
      networkWarningDismissed = true;
      return;
    }
    phoneError.style.display = 'none';
    networkWarningDismissed = false;
    if (!selectedPackageId) {
      Swal.fire({
        icon: 'error',
        text: 'No product selected'
      });
      return;
    }
    if (saveBeneficiaryCheckbox && saveBeneficiaryCheckbox.checked) {
      fetch('/beneficiaries/add', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({
          phone: phone,
          network: selectedNetwork,
          nickname: beneficiaryNicknameInput.value.trim()
        })
      }).catch(function() {});
    }
    try {
      var res = await fetch('/checkout/initiate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({
          packageId: selectedPackageId,
          phone: phone
        })
      });
      var data = await res.json();
      if (data.success) {
        window.location.href = '/checkout';
      } else {
        Swal.fire({
          icon: 'error',
          text: data.message || 'Something went wrong'
        });
      }
    } catch (err) {
      Swal.fire({
        icon: 'error',
        text: 'Network error'
      });
    }
  });
</script>
<!-- Hero watermark tiling — deliberately isolated in its own script tag.
     It previously shared a block with the carousel and reveal observers, so any
     error in those left the pattern element empty and the tiling invisible.
     There is also no viewport check here: the element is filled unconditionally
     and CSS alone decides where it shows, so resizing from mobile to desktop
     (or opening devtools on load) can no longer leave it blank. -->
<script>
  (function() {
    var el = document.getElementById('heroBgPattern');
    if (!el || el.textContent.trim()) return;
    var words = ['Data', 'MTN', 'Airtel', 'Glo', 'Electronics', 'Courses', 'Automobiles'];
    el.textContent = (words.join(' · ') + ' · ').repeat(30);
  })();
</script>