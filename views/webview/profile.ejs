<script>
  const successMsg = <%- JSON.stringify(success_msg) %>;
  const errorMsg   = <%- JSON.stringify(error_msg) %>;
  if (successMsg.length > 0) Swal.fire({ icon: 'success', text: successMsg[0] });
  if (errorMsg.length   > 0) Swal.fire({ icon: 'error',   text: errorMsg[0] });
</script>

<div class="container">
<div class="acct-page">

  <!-- ── Avatar + identity ────────────────────────────────── -->
  <div class="acct-hero">
    <div class="acct-avatar">
      <%= user.username ? user.username[0].toUpperCase() : 'U' %>
    </div>
    <h2 class="acct-name"><%= user.username %></h2>
    <p class="acct-email"><%= user.email %></p>
  </div>

  <!-- ── Balances ─────────────────────────────────────────── -->
  <div class="acct-balances">
    <%
      /* This card was pairing the BROWSING country's symbol with the Naira
         figure, so switching country relabelled the amount without changing it
         — a Naira balance shown as Cedis. Both halves now come from the active
         wallet, which is the only pairing that is ever true. */
      var _pMarkets = (typeof marketBalances !== 'undefined' && marketBalances) || [];
      var _pActive  = (typeof activeMarket !== 'undefined' && activeMarket) || 'NG';
      var _pCur = _pMarkets.filter(function (m) { return m.country === _pActive; })[0]
               || _pMarkets[0]
               || { country: _pActive,
                    countryName: (typeof viewerCountryName !== 'undefined' && viewerCountryName) || 'Nigeria',
                    flag: '',
                    currencySymbol: (typeof activeCurrency !== 'undefined' && activeCurrency.symbol) || '₦',
                    currencyName: (typeof activeCurrency !== 'undefined' && activeCurrency.name) || 'Naira',
                    balance: typeof marketBalance === 'function'
                           ? marketBalance(wallet)
                           : ((wallet && wallet.balances && wallet.balances.NAIRA) || 0) };
    %>
    <div class="acct-balance-card wallet-switch" data-active="<%= _pCur.country %>">
      <i data-lucide="wallet"></i>
      <div class="acct-balance-card__val"><span class="js-ws-symbol"><%= _pCur.currencySymbol %></span><span class="js-ws-balance"><%= Number(_pCur.balance || 0).toFixed(2) %></span></div>
      <div class="acct-balance-card__lbl"><span class="js-ws-name"><%= _pCur.currencyName || _pCur.countryName %></span> Wallet Balance</div>
      <%- include('../partials/walletSwitcher', { markets: _pMarkets, current: _pCur }) %>
    </div>
    <div class="acct-balance-card">
      <i data-lucide="star"></i>
      <div class="acct-balance-card__val"><%= user.rpBalance || 0 %></div>
      <div class="acct-balance-card__lbl">Reward Points</div>
    </div>
  </div>

  <!-- ── Quick links ──────────────────────────────────────── -->
  <div class="acct-section">
    <h3 class="acct-section__title">Account Activity</h3>
    <div class="acct-links">

      <a href="/referrals" class="acct-link">
        <div class="acct-link__icon">
          <i data-lucide="gift"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Referrals</span>
          <span class="acct-link__sub"><%= referralsCount || 0 %> referred · <%= referralsRewarded || 0 %> rewarded</span>
        </div>
        <i data-lucide="chevron-right" class="acct-link__arrow"></i>
      </a>

      <a href="/history" class="acct-link">
        <div class="acct-link__icon">
          <i data-lucide="package"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Order History</span>
          <% if (recentOrders && recentOrders.length > 0) { %>
          <span class="acct-link__sub"><%= recentOrders.length %> recent order<%= recentOrders.length !== 1 ? 's' : '' %></span>
          <% } else { %>
          <span class="acct-link__sub">No orders yet</span>
          <% } %>
        </div>
        <i data-lucide="chevron-right" class="acct-link__arrow"></i>
      </a>

      <a href="/my-wallet" class="acct-link">
        <div class="acct-link__icon">
          <i data-lucide="credit-card"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">My Wallet</span>
          <!-- <% if (totalTopups > 0) { %>
          <span class="acct-link__sub"><%= totalTopups %> completed topup<%= totalTopups !== 1 ? 's' : '' %></span>
          <% } else { %>
          <span class="acct-link__sub">No topups yet</span>
          <% } %> -->
        </div>
        <i data-lucide="chevron-right" class="acct-link__arrow"></i>
      </a>

       <a href="/my-topUps" class="acct-link">
        <div class="acct-link__icon">
          <i data-lucide="credit-card"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Topups and History</span>
          <% if (totalTopups > 0) { %>
          <span class="acct-link__sub"><%= totalTopups %> completed topup<%= totalTopups !== 1 ? 's' : '' %></span>
          <% } else { %>
          <span class="acct-link__sub">No topups yet</span>
          <% } %>
        </div>
        <i data-lucide="chevron-right" class="acct-link__arrow"></i>
      </a>

      <a href="/conversion-history" class="acct-link">
        <div class="acct-link__icon">
          <i data-lucide="arrow-left-right"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Conversion History</span>
          <span class="acct-link__sub">USDT → <span class="js-currency-name">Naira</span> conversions</span>
        </div>
        <i data-lucide="chevron-right" class="acct-link__arrow"></i>
      </a>

      <% if (user.minerId) { %>
      <div class="acct-link acct-link--static">
        <div class="acct-link__icon">
          <i data-lucide="cpu"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Miner ID</span>
          <span class="acct-link__sub"><%= user.minerId %></span>
        </div>
      </div>
      <% } %>

    </div>
  </div>

  <!-- ── Preferences ──────────────────────────────────────── -->
  <div class="acct-section">
    <h3 class="acct-section__title">Preferences</h3>
    <div class="acct-links">
      <button type="button" class="acct-link acct-link--btn js-country-trigger">
        <div class="acct-link__icon" style="background:var(--input-bg);">
          <span class="js-country-flag" style="font-size:20px;line-height:1;">🇳🇬</span>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Country</span>
          <span class="acct-link__sub js-country-name">Nigeria</span>
        </div>
        <i data-lucide="chevron-right" class="acct-link__arrow"></i>
      </button>

      <!-- Appearance. Defaults to following the device setting. -->
      <div class="acct-link acct-link--static">
        <div class="acct-link__icon" style="background:var(--input-bg);">
          <i data-lucide="moon-star"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Appearance</span>
          <span class="acct-link__sub" id="themeSubLabel">Following your device</span>
        </div>
      </div>

      <div class="theme-choice" role="radiogroup" aria-label="Appearance">
        <button type="button" class="theme-opt" data-theme-choice="system">
          <i data-lucide="smartphone"></i><span>System</span>
        </button>
        <button type="button" class="theme-opt" data-theme-choice="light">
          <i data-lucide="sun"></i><span>Light</span>
        </button>
        <button type="button" class="theme-opt" data-theme-choice="dark">
          <i data-lucide="moon"></i><span>Dark</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ── Beneficiaries ────────────────────────────────────── -->
  <div class="acct-section">
    <h3 class="acct-section__title">Beneficiaries</h3>
    <div class="acct-card">
      <% if (beneficiaries && beneficiaries.length > 0) { %>
      <div class="beneficiary-manage-list" id="beneficiaryManageList">
        <% beneficiaries.forEach(function(b) { %>
        <div class="beneficiary-manage-row" data-id="<%= b._id %>">
          <div class="beneficiary-manage-row__info">
            <span class="beneficiary-manage-row__name"><%= b.nickname || b.phone %></span>
            <% if (b.nickname) { %><span class="beneficiary-manage-row__phone"><%= b.phone %></span><% } %>
          </div>
          <button type="button" class="beneficiary-manage-row__delete" data-id="<%= b._id %>" aria-label="Delete beneficiary">
            <i data-lucide="trash-2"></i>
          </button>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <p class="acct-empty-note">No saved beneficiaries yet</p>
      <% } %>

      <form id="addBeneficiaryForm" class="profile-form">
        <div class="form-group">
          <label class="form-label" for="newBeneficiaryPhone">Phone Number</label>
          <div class="input-wrapper">
            <i data-lucide="phone"></i>
            <input type="text" id="newBeneficiaryPhone" class="form-input" placeholder="e.g 08012345678" maxlength="11" inputmode="numeric" required>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="newBeneficiaryNickname">Nickname <span style="font-weight:400;color:var(--muted);">(optional)</span></label>
          <input type="text" id="newBeneficiaryNickname" class="form-input form-input--plain" placeholder="e.g Mum" maxlength="30">
        </div>
        <button type="submit" class="btn btn--primary btn--full">
          <i data-lucide="plus"></i>
          Add Beneficiary
        </button>
      </form>
    </div>
  </div>

  <!-- ── Edit profile ─────────────────────────────────────── -->
  <div class="acct-section">
    <h3 class="acct-section__title">Edit Profile</h3>
    <div class="acct-card">
      <form action="/edit-user-profile" method="post" class="profile-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <input type="hidden" name="email" value="<%= user.email %>">

        <div class="form-group">
          <label class="form-label">Full Name</label>
          <div class="input-wrapper">
            <i data-lucide="user"></i>
            <input type="text" id="usernameInput" name="username" value="<%= user.username %>" class="form-input"
              pattern="[A-Za-z\s]+" title="Full name can only contain letters and spaces" required>
          </div>
        </div>

        

        <div class="form-group">
          <label class="form-label">Miner ID <span style="font-weight:400;color:var(--muted);">(optional)</span></label>
          <div class="input-wrapper">
            <i data-lucide="cpu"></i>
            <input type="text" name="minerId" value="<%= user.minerId || '' %>" class="form-input" placeholder="8 to 11 digit miner ID" pattern="[0-9]{8,11}" title="Miner ID must be between 8 and 11 digits (numbers only)" maxlength="11" minlength="8" inputmode="numeric">
          </div>
        </div>





        <button type="submit" class="btn btn--primary btn--full" style="margin-top:4px;">
          <i data-lucide="save"></i>
          Save Changes
        </button>

      </form>
    </div>
  </div>


  <!-- -- Change password -------------------------------- -->
  <div class="acct-section">
    <h3 class="acct-section__title">Security</h3>
    <div class="acct-links">
      <a href="/user/profile-change-password" class="acct-link">
        <div class="acct-link__icon">
          <i data-lucide="key-round"></i>
        </div>
        <div class="acct-link__body">
          <span class="acct-link__label">Change Password</span>
          <span class="acct-link__sub">A verification code will be sent to your email</span>
        </div>
        <i data-lucide="chevron-right" class="acct-link__arrow"></i>
      </a>
    </div>
  </div>
  <!-- ── Logout ───────────────────────────────────────────── -->
  <div class="acct-section">
    <a href="/user/logout" class="btn btn--danger btn--full">
      <i data-lucide="log-out"></i>
      Log Out
    </a>
  </div>

</div>
</div>

<script>
(function() {
  var input = document.getElementById('usernameInput');
  if (!input) return;
  input.addEventListener('input', function() {
    var pos = this.selectionStart;
    var cleaned = this.value.replace(/[^A-Za-z\s]/g, '');
    if (cleaned !== this.value) {
      this.value = cleaned;
      this.setSelectionRange(pos - 1, pos - 1);
    }
  });
  input.addEventListener('keydown', function(e) {
    if (e.key.length === 1 && /[^A-Za-z\s]/.test(e.key)) {
      e.preventDefault();
    }
  });
})();

// ── Beneficiaries management ──
(function() {
  var addForm       = document.getElementById('addBeneficiaryForm');
  var phoneInput     = document.getElementById('newBeneficiaryPhone');
  var nicknameInput  = document.getElementById('newBeneficiaryNickname');
  var list           = document.getElementById('beneficiaryManageList');

  if (phoneInput) {
    phoneInput.addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '').slice(0, 11);
    });
  }

  if (addForm) {
    addForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      var phone = phoneInput.value.trim();
      if (!/^\d{11}$/.test(phone)) {
        Swal.fire({ icon: 'error', text: 'Phone number must be exactly 11 digits' });
        return;
      }
      try {
        var res = await fetch('/beneficiaries/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify({ phone: phone, nickname: nicknameInput.value.trim() })
        });
        var data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          Swal.fire({ icon: 'error', text: data.message || 'Could not save beneficiary' });
        }
      } catch (err) {
        Swal.fire({ icon: 'error', text: 'Network error' });
      }
    });
  }

  if (list) {
    list.querySelectorAll('.beneficiary-manage-row__delete').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var id = this.dataset.id;
        var confirmResult = await Swal.fire({
          icon: 'warning',
          text: 'Remove this beneficiary?',
          showCancelButton: true,
          confirmButtonText: 'Remove'
        });
        if (!confirmResult.isConfirmed) return;
        try {
          var res = await fetch('/beneficiaries/' + id + '/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' }
          });
          var data = await res.json();
          if (data.success) {
            var row = list.querySelector('.beneficiary-manage-row[data-id="' + id + '"]');
            if (row) row.remove();
          } else {
            Swal.fire({ icon: 'error', text: data.message || 'Could not remove beneficiary' });
          }
        } catch (err) {
          Swal.fire({ icon: 'error', text: 'Network error' });
        }
      });
    });
  }
})();
</script>

<script>
/* ── Appearance: system / light / dark ────────────────────────────────────
   Restored after the referral-page refactor removed this block while leaving
   the picker buttons in place, which left the control inert.
   "system" means no data-theme attribute at all, so the CSS media query
   takes over again. */
(function () {
  var KEY  = 'kbc_theme';
  var root = document.documentElement;
  var opts = Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'));
  var label = document.getElementById('themeSubLabel');
  if (!opts.length) return;

  var LABELS = { system: 'Following your device', light: 'Always light', dark: 'Always dark' };

  function stored() {
    try {
      var v = localStorage.getItem(KEY);
      return (v === 'dark' || v === 'light') ? v : 'system';
    } catch (e) { return 'system'; }
  }

  function paint(choice) {
    opts.forEach(function (b) {
      var on = b.dataset.themeChoice === choice;
      b.classList.toggle('active', on);
      b.setAttribute('aria-checked', on ? 'true' : 'false');
    });
    if (label) label.textContent = LABELS[choice] || LABELS.system;
  }

  function apply(choice) {
    try {
      if (choice === 'system') { localStorage.removeItem(KEY); root.removeAttribute('data-theme'); }
      else { localStorage.setItem(KEY, choice); root.setAttribute('data-theme', choice); }
    } catch (e) {
      if (choice === 'system') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', choice);
    }
    paint(choice);
  }

  opts.forEach(function (b) {
    b.setAttribute('role', 'radio');
    b.addEventListener('click', function () { apply(this.dataset.themeChoice); });
  });

  paint(stored());
})();
</script>
