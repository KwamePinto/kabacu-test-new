<script>
  const successMsg = <%- JSON.stringify(success_msg) %>;
  const errorMsg   = <%- JSON.stringify(error_msg) %>;
  if (successMsg.length > 0) Swal.fire({ icon: 'success', text: successMsg[0] });
  if (errorMsg.length   > 0) Swal.fire({ icon: 'error',   text: errorMsg[0] });
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@29/dist/css/intlTelInput.min.css">
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@29/dist/js/intlTelInputWithUtils.min.js"></script>

<section class="auth-page">
  <div class="auth-card">

    <a href="/" style="display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:600;color:var(--muted);text-decoration:none;margin-bottom:10px;">
      <i data-lucide="arrow-left" style="width:15px;height:15px;"></i> Home
    </a>

    <div class="auth-card__logo">
      <img src="/assets/images/new.PNG" alt="Data Mall">
    </div>

    <h1 class="auth-card__title">Create your account</h1>
    <p class="auth-card__sub">Save up to 80% on your purchases!</p>

    <form action="/user/signup" id="signupForm" method="post" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <div class="input-wrapper">
          <i data-lucide="user"></i>
          <input type="text" id="fullName" name="username" class="form-input" placeholder="Enter your full name" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Email address</label>
        <div class="input-wrapper">
          <i data-lucide="mail"></i>
          <input type="email" name="email" class="form-input" placeholder="you@example.com" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Phone Number</label>
        <input type="tel" id="phone" class="form-input" placeholder="Enter phone number" required>
        <input type="hidden" name="phone_number" id="phoneNumber">
      </div>

      <div class="form-group">
        <label class="form-label">Country</label>
        <div class="input-wrapper">
          <i data-lucide="map-pin"></i>
          <select name="country" id="countrySelect" class="form-input form-select" required>
             <% Object.entries(countryNames).forEach(([code, name]) => { %>

            <option value="<%= name %>" <%= name === 'Nigeria' ? 'selected' : '' %>> <%= name %></option>

            <% }) %>


          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Referral code <span style="font-weight:400;color:var(--muted);">(optional)</span></label>
        <div class="input-wrapper">
          <i data-lucide="gift"></i>
          <input type="text" name="referralCode" id="referralCode" class="form-input"
                 placeholder="e.g. KB12345678" value="<%= typeof prefillReferralCode !== 'undefined' ? prefillReferralCode : '' %>"
                 maxlength="32" autocapitalize="characters" autocomplete="off"
                 style="text-transform:uppercase;letter-spacing:.05em;">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Password</label>
        <div class="input-wrapper input-wrapper--pw">
          <i data-lucide="lock"></i>
          <input type="password" name="password" id="password" class="form-input" placeholder="Min. 8 characters" required minlength="8">
          <button type="button" class="pw-toggle" data-target="password" aria-label="Toggle password visibility">
            <i data-lucide="eye" class="pw-toggle__show"></i>
            <i data-lucide="eye-off" class="pw-toggle__hide" style="display:none;"></i>
          </button>
        </div>
        <!-- Strength meter -->
        <div class="pw-strength" id="pwStrength">
          <div class="pw-strength__segments">
            <span class="pw-strength__seg"></span>
            <span class="pw-strength__seg"></span>
            <span class="pw-strength__seg"></span>
            <span class="pw-strength__seg"></span>
          </div>
          <span class="pw-strength__label" id="pwStrengthLabel"></span>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Confirm Password</label>
        <div class="input-wrapper input-wrapper--pw">
          <i data-lucide="lock"></i>
          <input type="password" id="confirm_password" class="form-input" placeholder="Repeat your password" required minlength="8">
          <button type="button" class="pw-toggle" data-target="confirm_password" aria-label="Toggle password visibility">
            <i data-lucide="eye" class="pw-toggle__show"></i>
            <i data-lucide="eye-off" class="pw-toggle__hide" style="display:none;"></i>
          </button>
        </div>
      </div>

      <div class="form-group">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
          <label class="form-label" style="margin-bottom:0;">Human check</label>
          <span id="mathQuestion" style="background:#e8f5ee;color:#15a844;border:1.5px dashed #15a844;border-radius:8px;padding:4px 14px;font-size:1.1rem;font-weight:700;letter-spacing:2px;"><%= mathQuestion %> = ?</span>
          <button type="button" id="refreshCaptcha" title="Get new question" style="background:none;border:none;cursor:pointer;color:#15a844;padding:4px;display:flex;align-items:center;flex-shrink:0;">
            <i data-lucide="refresh-cw" style="width:16px;height:16px;pointer-events:none;"></i>
          </button>
        </div>
        <div class="input-wrapper">
          <i data-lucide="calculator"></i>
          <input type="number" id="mathAnswer" name="mathAnswer" class="form-input" placeholder="Enter the answer" required inputmode="numeric" autocomplete="off">
        </div>
      </div>

      <button type="submit" class="btn btn--primary btn--full btn--lg">Create Account</button>
    </form>

    <div class="auth-divider"><span>Already have an account?</span></div>

    <a href="/user/login" class="btn btn--outline btn--full">Sign in</a>
  </div>
</section>

<script>
/* ── Password visibility toggles ─────────────────────── */
(function() {
  document.querySelectorAll('.pw-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var input = document.getElementById(btn.getAttribute('data-target'));
      if (!input) return;
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.querySelector('.pw-toggle__show').style.display = show ? 'none' : '';
      btn.querySelector('.pw-toggle__hide').style.display = show ? ''     : 'none';
    });
  });
})();

/* ── Password strength meter ──────────────────────────── */
(function() {
  var input    = document.getElementById('password');
  var meter    = document.getElementById('pwStrength');
  var label    = document.getElementById('pwStrengthLabel');
  var levels   = ['', 'pw-strength--weak', 'pw-strength--fair', 'pw-strength--good', 'pw-strength--strong'];
  var names    = ['', 'Weak', 'Fair', 'Good', 'Strong'];

  function score(pw) {
    if (!pw) return 0;
    var s = 0;
    if (pw.length >= 8)           s++;
    if (pw.length >= 12)          s++;
    if (/[A-Z]/.test(pw))         s++;
    if (/[0-9]/.test(pw))         s++;
    if (/[^A-Za-z0-9]/.test(pw))  s++;
    /* map 0-5 score → 1-4 levels */
    if (s <= 1) return 1;
    if (s === 2) return 2;
    if (s === 3) return 3;
    return 4;
  }

  if (!input || !meter || !label) return;

  input.addEventListener('input', function() {
    var pw  = input.value;
    var lvl = pw.length ? score(pw) : 0;

    /* toggle visibility */
    meter.classList.toggle('visible', lvl > 0);

    /* remove all level classes then apply current */
    levels.forEach(function(c) { if (c) meter.classList.remove(c); });
    if (lvl > 0) meter.classList.add(levels[lvl]);

    label.textContent = names[lvl] || '';
  });
})();

/* ── Math captcha: parse equation and return expected answer ── */
function getMathAnswer() {
  var text = document.getElementById('mathQuestion').textContent.replace('= ?', '').trim();
  var m = text.match(/(\d+)\s*([+\-−×÷*\/])\s*(\d+)/);
  if (!m) return NaN;
  var a = parseInt(m[1], 10), op = m[2], b = parseInt(m[3], 10);
  if (op === '+')                      return a + b;
  if (op === '-' || op === '−')   return a - b;
  if (op === '*' || op === '×')        return a * b;
  if (op === '/' || op === '÷')        return a / b;
  return NaN;
}

/* ── Real-time border feedback on math answer ────────────── */
document.getElementById('mathAnswer').addEventListener('input', function() {
  if (this.value === '') { this.style.outline = ''; this.style.borderColor = ''; return; }
  var correct = parseInt(this.value, 10) === getMathAnswer();
  this.style.outline     = '2px solid ' + (correct ? '#15a844' : '#dc3545');
  this.style.borderColor =                (correct ? '#15a844' : '#dc3545');
});

/* ── Refresh math captcha ─────────────────────────────── */
document.getElementById('refreshCaptcha').addEventListener('click', async function() {
  var btn = this;
  btn.style.opacity = '0.4';
  btn.style.pointerEvents = 'none';
  try {
    var res  = await fetch('/user/refresh-captcha?type=signup');
    var data = await res.json();
    document.getElementById('mathQuestion').textContent = data.question + ' = ?';
    var inp = document.getElementById('mathAnswer');
    inp.value = '';
    inp.style.outline = '';
    inp.style.borderColor = '';
  } catch (e) { /* silently ignore */ }
  btn.style.opacity = '';
  btn.style.pointerEvents = '';
});

/* ── Full name: letters and spaces only ───────────────── */
document.getElementById('fullName').addEventListener('input', function() {
  this.value = this.value.replace(/[^a-zA-Z\s]/g, '');
  var valid = this.value.trim().length > 0 && /^[a-zA-Z\s]+$/.test(this.value.trim());
  this.style.outline     = this.value === '' ? '' : '2px solid ' + (valid ? '#15a844' : '#dc3545');
  this.style.borderColor = this.value === '' ? '' :                (valid ? '#15a844' : '#dc3545');
});

/* ── Phone number: intl-tel-input ─────────────────────── */
var phoneInputField = document.getElementById('phone');
var phoneInput = window.intlTelInput(phoneInputField, {
  initialCountry: 'ng',
  preferredCountries: ['ng', 'gh', 'ke', 'za'],
  separateDialCode: true,
});

/* ── Keep the Country field and the phone country picker in sync ──────
   Both defaulted to Nigeria independently before, with nothing tying
   them together afterward — pick a different phone country and the
   Country field silently stops matching it, and vice versa. */
(function () {
  var countrySelect = document.getElementById('countrySelect');
  if (!countrySelect) return;

  var isoToName = <%- JSON.stringify(Object.fromEntries(Object.entries(countryNames).map(([code, name]) => [code.toLowerCase(), name]))) %>;
  var nameToIso = <%- JSON.stringify(Object.fromEntries(Object.entries(countryNames).map(([code, name]) => [name, code.toLowerCase()]))) %>;

  var syncing = false; // guards against the two handlers re-triggering each other

  phoneInputField.addEventListener('countrychange', function () {
    if (syncing) return;
    var iso2 = phoneInput.getSelectedCountryData().iso2;
    var name = iso2 && isoToName[iso2];
    if (!name || countrySelect.value === name) return;
    syncing = true;
    countrySelect.value = name;
    syncing = false;
  });

  countrySelect.addEventListener('change', function () {
    if (syncing) return;
    var iso2 = nameToIso[countrySelect.value];
    if (!iso2) return;
    syncing = true;
    phoneInput.setCountry(iso2);
    syncing = false;
  });
})();

phoneInputField.addEventListener('blur', function() {
  if (this.value.trim() === '') { this.style.outline = ''; this.style.borderColor = ''; return; }
  var valid = phoneInput.isValidNumber();
  this.style.outline     = '2px solid ' + (valid ? '#15a844' : '#dc3545');
  this.style.borderColor =                (valid ? '#15a844' : '#dc3545');
});

/* ── Form submit validation ───────────────────────────── */
document.getElementById('signupForm').addEventListener('submit', function(e) {
  var username        = document.querySelector('input[name="username"]').value.trim();
  var password        = document.getElementById('password').value;
  var confirmPassword = document.getElementById('confirm_password').value;

  if (/\d/.test(username)) {
    e.preventDefault();
    Swal.fire({ icon: 'error', text: 'Full Name cannot contain numbers.' });
    return;
  }

  if (phoneInputField.value.trim() === '') {
    e.preventDefault();
    Swal.fire({ icon: 'error', text: 'Please enter your phone number.' });
    return;
  }

  if (!phoneInput.isValidNumber()) {
    e.preventDefault();
    Swal.fire({ icon: 'error', text: 'Please enter a valid phone number.' });
    return;
  }

  document.getElementById('phoneNumber').value = phoneInput.getNumber();

  if (password.length < 8) {
    e.preventDefault();
    Swal.fire({ icon: 'error', text: 'Password must be at least 8 characters long.' });
    return;
  }

  if (password !== confirmPassword) {
    e.preventDefault();
    Swal.fire({ icon: 'error', text: 'Passwords do not match.' });
  }
});
</script>
