<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kabacu — Under Maintenance</title>
  <link rel="shortcut icon" type="image/x-icon" href="/assets/images/kabacufavicon.png">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', sans-serif;
      background: #f8fdf9;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 20px 80px;
      color: #111827;
    }

    .maint-logo {
      height: 36px;
      width: auto;
      object-fit: contain;
      margin-bottom: 52px;
      opacity: .85;
    }

    .maint-img {
      width: 200px;
      max-width: 72vw;
      display: block;
      margin: 0 auto 44px;
      animation: float 3s ease-in-out infinite;
      filter: drop-shadow(0 16px 24px rgba(0,0,0,.10));
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-18px); }
    }

    .maint-title {
      font-size: clamp(24px, 5vw, 34px);
      font-weight: 800;
      letter-spacing: -0.6px;
      color: #111827;
      text-align: center;
      margin-bottom: 14px;
    }

    .maint-message {
      font-size: 15px;
      line-height: 1.75;
      color: #6b7280;
      text-align: center;
      max-width: 420px;
      /* The message can now contain admin-authored paragraph breaks (blank
         lines between paragraphs) — pre-line keeps those breaks visible
         while still wrapping normally within each paragraph, matching how
         the notification bell already handles multi-paragraph text. */
      white-space: pre-line;
    }

    /* A date/time/countdown token, once filled in by the script below.
       Subtle emphasis only — it should read as part of the sentence, not as
       a UI control on a page that has none. */
    .mt-token {
      font-weight: 600;
      color: #15803d;
    }

    .maint-divider {
      width: 40px;
      height: 3px;
      border-radius: 2px;
      background: #22c55e;
      margin: 28px auto;
    }

    .maint-footer {
      position: fixed;
      bottom: 24px;
      left: 0; right: 0;
      text-align: center;
      font-size: 12px;
      color: #9ca3af;
      letter-spacing: .3px;
    }

    @media (max-width: 480px) {
      .maint-img { width: 150px; margin-bottom: 32px; }
      .maint-logo { margin-bottom: 36px; }
    }
  </style>
</head>
<body>

  <img src="/assets/images/new.PNG" alt="Kabacu" class="maint-logo">

  <picture>
    <source srcset="/assets/images/maintenance.webp" type="image/webp">
    <img src="/assets/images/maintenance-opt.png" alt="Under maintenance" class="maint-img">
  </picture>

  <h1 class="maint-title">We'll Be Right Back</h1>

  <div class="maint-divider"></div>

  <!-- messageHtml is produced by server/utils/maintenanceTokens.js: admin
       text is HTML-escaped, {{date:...}}/{{time:...}}/{{countdown:...}}
       tokens become inert <span data-mt> placeholders. The script below
       fills those in and ticks any countdown — see that file and
       assets/js/maintenanceEditor.js for the full explanation. -->
  <p class="maint-message" id="maintMessage"><%- messageHtml %></p>

  <footer class="maint-footer">
    &copy; <%= new Date().getFullYear() %> Kabacu &mdash; All rights reserved.
  </footer>

  <script>
    // Mirrors server/utils/maintenanceTokens.js's token types and
    // assets/js/maintenanceEditor.js's own copy of this same formatting, so
    // what the admin saw in their live preview is exactly what renders here.
    (function () {
      function fillDate(el, value) {
        var d = new Date(value + 'T00:00:00');
        el.textContent = isNaN(d) ? value : d.toLocaleDateString('en-NG', {
          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
        });
      }
      function fillTime(el, value) {
        var t = new Date('2000-01-01T' + value + ':00');
        el.textContent = isNaN(t) ? value : t.toLocaleTimeString('en-NG', {
          hour: 'numeric', minute: '2-digit',
        });
      }
      function fillCountdown(el, value) {
        var target = new Date(value);
        if (isNaN(target)) { el.textContent = value; return; }
        function tick() {
          var diff = target - Date.now();
          if (diff <= 0) { el.textContent = 'any moment now'; return; }
          var d = Math.floor(diff / 86400000);
          var h = Math.floor((diff % 86400000) / 3600000);
          var m = Math.floor((diff % 3600000) / 60000);
          var s = Math.floor((diff % 60000) / 1000);
          el.textContent =
            (d > 0 ? d + 'd ' : '') +
            (d > 0 || h > 0 ? h + 'h ' : '') +
            m + 'm ' + s + 's';
          setTimeout(tick, 1000);
        }
        tick();
      }

      var nodes = document.querySelectorAll('#maintMessage [data-mt]');
      for (var i = 0; i < nodes.length; i++) {
        var el = nodes[i];
        var value = el.getAttribute('data-value') || '';
        var kind = el.getAttribute('data-mt');
        if (kind === 'date') fillDate(el, value);
        else if (kind === 'time') fillTime(el, value);
        else if (kind === 'countdown') fillCountdown(el, value);
      }
    }());
  </script>

</body>
</html>
