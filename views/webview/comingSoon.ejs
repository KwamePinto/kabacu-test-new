<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kabacu — <%= pageLabel ? (pageLabel + ' Coming Soon') : 'Coming Soon' %></title>
  <link rel="shortcut icon" type="image/x-icon" href="/assets/images/kabacufavicon.png">
  <style>
    /* Same structure/style as views/webview/maintenance.ejs on purpose — this
       is the per-page version of that same "holding page" look. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', sans-serif;
      background: #f8fdf9;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 20px 80px;
      color: #111827;
    }

    .cs-logo {
      height: 36px;
      width: auto;
      object-fit: contain;
      margin-bottom: 52px;
      opacity: .85;
    }

    .cs-img {
      width: 200px;
      max-width: 72vw;
      display: block;
      margin: 0 auto 44px;
      animation: float 3s ease-in-out infinite;
      filter: drop-shadow(0 16px 24px rgba(0,0,0,.10));
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-18px); }
    }

    .cs-title {
      font-size: clamp(24px, 5vw, 34px);
      font-weight: 800;
      letter-spacing: -0.6px;
      color: #111827;
      text-align: center;
      margin-bottom: 14px;
    }

    .cs-message {
      font-size: 15px;
      line-height: 1.75;
      color: #6b7280;
      text-align: center;
      max-width: 420px;
      white-space: pre-line;
    }

    .cs-divider {
      width: 40px;
      height: 3px;
      border-radius: 2px;
      background: #22c55e;
      margin: 28px auto;
    }

    .cs-footer {
      position: fixed;
      bottom: 24px;
      left: 0; right: 0;
      text-align: center;
      font-size: 12px;
      color: #9ca3af;
      letter-spacing: .3px;
    }

    @media (max-width: 480px) {
      .cs-img { width: 150px; margin-bottom: 32px; }
      .cs-logo { margin-bottom: 36px; }
    }
  </style>
</head>
<body>

  <img src="/assets/images/new.PNG" alt="Kabacu" class="cs-logo">

  <%
    /* A custom image (admin-uploaded, from PageFlag.comingSoonImage) wins;
       otherwise reuse the existing maintenance illustration as the generic
       "under development" graphic, so a page with no custom asset still gets
       a proper holding page instead of a blank gap. */
    var hasCustomImage = !!(typeof image !== 'undefined' && image);
  %>
  <% if (hasCustomImage) { %>
    <img src="<%= image %>" alt="Coming soon" class="cs-img">
  <% } else { %>
    <picture>
      <source srcset="/assets/images/maintenance.webp" type="image/webp">
      <img src="/assets/images/maintenance-opt.png" alt="Coming soon" class="cs-img">
    </picture>
  <% } %>

  <h1 class="cs-title"><%= (typeof title !== 'undefined' && title) ? title : ((pageLabel ? pageLabel + ' — ' : '') + 'Coming Soon') %></h1>

  <div class="cs-divider"></div>

  <p class="cs-message"><%= (typeof message !== 'undefined' && message)
    ? message
    : "We're working on something great here. This feature will be available soon — thank you for your patience." %></p>

  <footer class="cs-footer">
    &copy; <%= new Date().getFullYear() %> Kabacu &mdash; All rights reserved.
  </footer>

</body>
</html>
