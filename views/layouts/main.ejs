  <!-- Lucide icons render -->
  <script>lucide.createIcons();</script>

  <!-- Dynamic island scroll behaviour -->
  <script>
    (function() {
      var header = document.querySelector('.app-header');
      var lastY  = window.scrollY;

      if (!header) return;

      window.addEventListener('scroll', function() {
        var currentY = window.scrollY;

        if (currentY > lastY) {
          /* scrolling DOWN — hide */
          header.classList.add('island-hidden');
        } else {
          /* scrolling UP — show */
          header.classList.remove('island-hidden');
        }

        lastY = currentY;
      }, { passive: true });
    })();
  </script>

  <!-- Bottom nav active state -->
  <script>
    (function() {
      const path = window.location.pathname;
      document.querySelectorAll('.bottom-nav__item').forEach(function(item) {
        const p = item.getAttribute('data-path');
        if (p === '/' ? path === '/' : path.startsWith(p)) {
          item.classList.add('active');
        }
      });
    })();
  </script>

  <!-- Search bar logic -->
  <script>
    (function() {
      const searchBtn   = document.getElementById('searchBtn');
      const searchRow   = document.getElementById('headerSearchRow');
      const searchInput = document.getElementById('headerSearchInput');
      const clearBtn    = document.getElementById('clearSearchBtn');

      if (!searchBtn || !searchRow || !searchInput) return;

      function openSearch() {
        searchRow.classList.add('open');
        lucide.createIcons();
        searchInput.focus();
      }

      function closeSearch() {
        searchRow.classList.remove('open');
        searchInput.value = '';
        if (clearBtn) clearBtn.classList.remove('visible');
        showAll();
      }

      function showAll() {
        document.querySelectorAll('.product-card, .bundle-card').forEach(function(c) {
          c.style.display = '';
        });
        const nr = document.getElementById('searchNoResults');
        if (nr) nr.style.display = 'none';
      }

      searchBtn.addEventListener('click', openSearch);

      /* X button clears text only — does not close the overlay */
      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          searchInput.value = '';
          clearBtn.classList.remove('visible');
          showAll();
        });
      }

      /* Back arrow closes the overlay */
      var closeSearchBtn = document.getElementById('closeSearchBtn');
      if (closeSearchBtn) closeSearchBtn.addEventListener('click', closeSearch);

      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSearch();
      });

      searchInput.addEventListener('input', function() {
        const q = this.value.toLowerCase().trim();
        if (clearBtn) clearBtn.classList.toggle('visible', q.length > 0);

        const cards = document.querySelectorAll('.product-card, .bundle-card');
        let visible = 0;
        cards.forEach(function(card) {
          const name  = (
            card.getAttribute('data-name') ||
            card.querySelector('.product-card__name, .bundle-card__name')?.textContent || ''
          ).toLowerCase();
          const brand = (
            card.getAttribute('data-brand') ||
            card.querySelector('.product-card__brand, .bundle-card__network')?.textContent || ''
          ).toLowerCase();
          const match = !q || name.includes(q) || brand.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        const nr = document.getElementById('searchNoResults');
        if (nr) nr.style.display = (q && visible === 0) ? 'block' : 'none';
      });
    })();
  </script>

  <!-- Claim RP -->
  <script>
    const claimModal      = document.getElementById('claimRpModal');
    const openClaimBtn    = document.getElementById('openClaimModal');
    const closeClaimBtn   = document.getElementById('closeClaimModal');
    const confirmClaimBtn = document.getElementById('confirmClaimBtn');

    var rpAmountEl = claimModal ? claimModal.querySelector('.claim-rp-modal__amount') : null;

    function openClaimRpModal() {
      if (!claimModal) return;
      claimModal.classList.add('open');
      // Fetch live rpBalance so stale JWT value never shows
      fetch('/user/rp-balance', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (rpAmountEl && typeof d.rpBalance === 'number') {
            rpAmountEl.innerHTML = d.rpBalance + ' <span class="claim-rp-modal__unit">RP</span>';
          }
        })
        .catch(function() {});
    }

    if (openClaimBtn)  openClaimBtn.addEventListener('click',  function(e) { e.preventDefault(); openClaimRpModal(); });
    if (closeClaimBtn) closeClaimBtn.addEventListener('click', function()   { claimModal.classList.remove('open'); });
    if (claimModal)    claimModal.addEventListener('click',    function(e)  { if (e.target === claimModal) claimModal.classList.remove('open'); });

    if (confirmClaimBtn) {
      confirmClaimBtn.addEventListener('click', async function() {
        try {
          confirmClaimBtn.disabled = true;
          confirmClaimBtn.textContent = 'Processing...';
          const res  = await fetch('/wallet/claim-rp', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' } });
          const data = await res.json();
          if (data.success) {
            Swal.fire({ icon: 'success', text: data.message });
            setTimeout(() => location.reload(), 1500);
          } else {
            Swal.fire({ icon: 'error', text: data.message });
            confirmClaimBtn.disabled = false;
            confirmClaimBtn.textContent = 'Confirm Claim';
          }
        } catch (e) {
          Swal.fire({ icon: 'error', text: 'Claim failed' });
          confirmClaimBtn.disabled = false;
          confirmClaimBtn.textContent = 'Confirm Claim';
        }
      });
    }
  </script>

  <!-- Desktop nav: mark active link based on current path -->
  <script>
    (function() {
      var path = window.location.pathname;
      document.querySelectorAll('.desktop-nav__link').forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href) return;
        if ((href === '/' && path === '/') || (href !== '/' && path.startsWith(href))) {
          link.classList.add('active');
        }
      });
    })();
  </script>

  <!-- Support bottom sheet logic -->
  <script>
    (function() {
      var sheet        = document.getElementById('supportSheet');
      var backdrop     = document.getElementById('supportSheetBackdrop');
      var supportBtn   = document.getElementById('supportNavBtn');
      var liveChatBtn  = document.getElementById('liveChatSheetBtn');

      if (!sheet) return;

      function openSheet()  { sheet.classList.add('open');    lucide.createIcons(); }
      function closeSheet() { sheet.classList.remove('open'); }

      if (supportBtn)  supportBtn.addEventListener('click', openSheet);
      if (backdrop)    backdrop.addEventListener('click',   closeSheet);

      if (liveChatBtn) {
        liveChatBtn.addEventListener('click', function() {
          closeSheet();
          if (typeof Tawk_API !== 'undefined' && typeof Tawk_API.maximize === 'function') {
            Tawk_API.maximize();
          }
        });
      }
    })();
  </script>

  <!-- More popover logic -->
  <script>
    (function() {
      var popover  = document.getElementById('morePopover');
      var backdrop = document.getElementById('morePopoverBackdrop');
      var moreBtn  = document.getElementById('moreNavBtn');

      if (!popover || !moreBtn) return;

      function openPopover()  {
        popover.classList.add('open');
        backdrop.classList.add('open');
        popover.setAttribute('aria-hidden', 'false');
        lucide.createIcons();
      }
      function closePopover() {
        popover.classList.remove('open');
        backdrop.classList.remove('open');
        popover.setAttribute('aria-hidden', 'true');
      }

      moreBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (popover.classList.contains('open')) closePopover();
        else openPopover();
      });
      backdrop.addEventListener('click', closePopover);
    })();
  </script>

  <!-- Page transition — fade out on navigate, fade in on load -->
  <script>
    (function() {
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href) return;
        /* skip anchors, special protocols, new-tab links, downloads */
        var ch = href.charAt(0);
        if (ch === '#' || href.indexOf('javascript') === 0 ||
            href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0) return;
        if (link.target === '_blank' || link.hasAttribute('download')) return;
        /* skip cross-origin */
        try {
          var url = new URL(href, window.location.href);
          if (url.origin !== window.location.origin) return;
        } catch (err) { return; }
        e.preventDefault();
        document.body.classList.add('is-leaving');
        var dest = href;
        setTimeout(function() { window.location.href = dest; }, 120);
      });

      /* When the browser restores a page from bfcache (back button),
         clear the is-leaving class so the page isn't stuck invisible */
      window.addEventListener('pageshow', function(e) {
        if (e.persisted) {
          document.body.classList.remove('is-leaving');
        }
      });
    })();
  </script>

  <!-- Announcements: strip countdowns + sign-in popup -->
  <script>
    (function () {
      /* ── Strip countdowns ──────────────────────────────────────────────
         Any strip carrying data-ends-at has its {countdown} token replaced
         with a live HH:MM:SS. When it hits zero the strip removes itself. */
      var strips = Array.prototype.slice.call(document.querySelectorAll('.ann-strip[data-ends-at]'));

      if (strips.length) {
        strips.forEach(function (el) {
          var textEl = el.querySelector('.ann-strip__text');
          el._template = textEl ? textEl.textContent : '';
        });

        var pad = function (n) { return String(n).padStart(2, '0'); };

        var tick = function () {
          var now = Date.now();
          var stillRunning = false;

          strips.forEach(function (el) {
            if (!el.isConnected) return;
            var textEl = el.querySelector('.ann-strip__text');
            if (!textEl) return;

            var remaining = new Date(el.dataset.endsAt).getTime() - now;

            if (remaining <= 0) {
              el.remove();           // expired — drop it from the page
              return;
            }

            stillRunning = true;
            var total   = Math.floor(remaining / 1000);
            var hours   = Math.floor(total / 3600);
            var minutes = Math.floor((total % 3600) / 60);
            var seconds = total % 60;

            textEl.textContent = el._template.replace(
              '{countdown}',
              pad(hours) + ':' + pad(minutes) + ':' + pad(seconds)
            );
          });

          if (!stillRunning) clearInterval(timer);
        };

        tick();
        var timer = setInterval(tick, 1000);
      }

      /* ── Sign-in popup tour ────────────────────────────────────────────
         Shown once per browser session so it greets the user after login
         without reappearing on every page they visit.

         localStorage rather than sessionStorage: a feature tour is worth seeing
         once, not once per browser session. Reading it in a try/catch because a
         private window can throw on access rather than merely return null — and
         a storage failure must not cost the user the tour, so the fallback is to
         show it. */
      var popup = document.getElementById('annPopup');
      if (popup) {
        var key = 'kbc_popup_seen_' + popup.dataset.popupId;
        var steps = Array.prototype.slice.call(popup.querySelectorAll('.ann-popup__step'));
        var dots  = Array.prototype.slice.call(popup.querySelectorAll('.ann-popup__dot'));
        var prevBtn = document.getElementById('annPopupPrev');
        var nextBtn = document.getElementById('annPopupNext');
        var index = 0;

        var close = function () {
          popup.hidden = true;
          document.body.style.overflow = '';
          try { localStorage.setItem(key, '1'); } catch (e) {}
        };

        var show = function (i) {
          // Clamped rather than trusted: a dot index comes from the DOM.
          index = Math.max(0, Math.min(i, steps.length - 1));

          steps.forEach(function (el, n) { el.classList.toggle('is-active', n === index); });
          dots.forEach(function (el, n) {
            el.classList.toggle('is-active', n === index);
            el.setAttribute('aria-selected', n === index ? 'true' : 'false');
          });

          if (prevBtn) prevBtn.hidden = index === 0;
          if (nextBtn) {
            // The last step closes rather than advances, so the label has to say so.
            nextBtn.textContent = index === steps.length - 1 ? 'Got it' : 'Next';
          }

          // Long steps scroll; a new step should start at its own top.
          var card = popup.querySelector('.ann-popup__card');
          if (card) card.scrollTop = 0;
        };

        var alreadySeen = false;
        try { alreadySeen = localStorage.getItem(key) === '1'; } catch (e) {}

        if (!alreadySeen) {
          popup.hidden = false;
          document.body.style.overflow = 'hidden';
          show(0);
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            if (index >= steps.length - 1) close();
            else show(index + 1);
          });
        }
        if (prevBtn) {
          prevBtn.addEventListener('click', function () { show(index - 1); });
        }
        dots.forEach(function (dot) {
          dot.addEventListener('click', function () {
            show(parseInt(dot.dataset.goto, 10) || 0);
          });
        });

        popup.querySelectorAll('[data-ann-close]').forEach(function (el) {
          el.addEventListener('click', close);
        });

        document.addEventListener('keydown', function (e) {
          if (popup.hidden) return;
          if (e.key === 'Escape') close();
          // Arrow keys mirror the buttons for anyone navigating by keyboard.
          else if (e.key === 'ArrowRight' && index < steps.length - 1) show(index + 1);
          else if (e.key === 'ArrowLeft'  && index > 0) show(index - 1);
        });
      }
    })();
  </script>

