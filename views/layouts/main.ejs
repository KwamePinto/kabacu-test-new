<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kabacu Marketplace</title>
  <link rel="shortcut icon" type="image/png" href="/assets/images/kabacufavicon.png">

  <!-- Read by scripts served from /assets, which cannot template the token in. -->
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

  <!-- Theme. Runs before any stylesheet so the correct palette is in place on
       the first paint — setting this later causes a visible flash of the wrong
       theme. Storing nothing means "follow the system", which is the default. -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('kbc_theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) { /* private mode — fall through to the system preference */ }
    })();
  </script>
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#101219" media="(prefers-color-scheme: dark)">

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <!-- Design System CSS -->
  <link rel="stylesheet" href="/assets/css/new/base.css">
  <link rel="stylesheet" href="/assets/css/new/layout.css">
  <link rel="stylesheet" href="/assets/css/new/components.css">
  <link rel="stylesheet" href="/assets/css/new/home.css">
  <link rel="stylesheet" href="/assets/css/new/auth.css">
  <link rel="stylesheet" href="/assets/css/new/data-category.css">
  <link rel="stylesheet" href="/assets/css/new/wallet.css">
  <link rel="stylesheet" href="/assets/css/new/history.css">
  <link rel="stylesheet" href="/assets/css/new/profile.css">
  <link rel="stylesheet" href="/assets/css/new/checkout.css">
</head>
<body class="<% if (locals.hideHeader) { %>no-header<% } %>">

  <% if (locals.maintenanceBanner) { %>
  <div class="maint-banner" id="maintBanner">
    <div class="maint-banner__inner">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span class="maint-banner__text">
        Kabacu will undergo scheduled maintenance on
        <strong id="maintBannerDate"></strong>.
        Please save your work before then.
      </span>
      <span class="maint-banner__countdown" id="maintCountdown"></span>
      <button class="maint-banner__close" id="maintBannerClose" aria-label="Dismiss">&times;</button>
    </div>
  </div>
  <style>
    .maint-banner {
      background: linear-gradient(90deg, #f59e0b, #d97706);
      color: #fff;
      padding: 9px 16px;
      position: sticky; top: 0; z-index: 1100;
    }
    .maint-banner__inner {
      max-width: 1200px; margin: 0 auto;
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .maint-banner__text { flex: 1; font-size: 13px; line-height: 1.5; }
    .maint-banner__countdown {
      font-size: 12px; font-weight: 700;
      background: rgba(0,0,0,.18); padding: 3px 12px;
      border-radius: 20px; white-space: nowrap;
    }
    .maint-banner__close {
      background: none; border: none; color: #fff;
      font-size: 20px; line-height: 1; cursor: pointer;
      padding: 0 2px; flex-shrink: 0; opacity: .8;
    }
    .maint-banner__close:hover { opacity: 1; }
    @media (max-width: 600px) {
      .maint-banner__text { font-size: 12px; }
    }
  </style>
  <script>
    (function () {
      var target = new Date('<%= maintenanceBanner.scheduledAt %>');
      var dateEl = document.getElementById('maintBannerDate');
      var countdownEl = document.getElementById('maintCountdown');

      if (dateEl) {
        dateEl.textContent = target.toLocaleDateString('en-NG', {
          weekday: 'short', month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit',
        });
      }

      function tick() {
        var diff = target - Date.now();
        if (diff <= 0) {
          if (countdownEl) countdownEl.textContent = 'Starting now…';
          return;
        }
        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        if (countdownEl) countdownEl.textContent =
          'in ' + (h > 0 ? h + 'h ' : '') + m + 'm ' + s + 's';
        setTimeout(tick, 1000);
      }
      tick();

      var closeBtn = document.getElementById('maintBannerClose');
      if (closeBtn) closeBtn.addEventListener('click', function () {
        var el = document.getElementById('maintBanner');
        if (el) el.style.display = 'none';
      });
    }());
  </script>
  <% } %>

  <% if (!locals.hideHeader) { %>
  <%- include('../partials/header') %>
  <% } %>

  <main class="page-main">

    <%
      var _strips = (locals.announcements && announcements.strips) || [];
      var _popups = (locals.announcements && announcements.popups) || [];
    %>

    <!-- Announcement strips — sit directly under the header, above page content -->
    <% if (!locals.hideHeader && _strips.length) { %>
    <div class="ann-strips">
      <% _strips.forEach(function(s) { %>
      <div class="ann-strip"
           style="background:<%= s.background %>;color:<%= s.textColor %>;"
           <% if (s.countdownEndsAt) { %>data-ends-at="<%= new Date(s.countdownEndsAt).toISOString() %>"<% } %>>
        <div class="container ann-strip__inner">
          <i data-lucide="zap" class="ann-strip__icon"></i>
          <span class="ann-strip__text"><%= s.text %></span>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

    <%- body %>
  </main>

  <!-- Announcement popups — a stepped tour, shown once per sign-in session.
       Every active popup is rendered and the script moves between them, rather
       than only the first being shown: a set of new features needs more than one
       card to explain, and a user who is told about one of them and never the
       rest is worse served than one who is walked through all of them. -->
  <% if (user && !locals.hideHeader && _popups.length) { %>
  <%
    /* The whole set is identified by one key so finishing the tour dismisses it
       as a unit. Built from the ids, so adding or changing a popup produces a
       new key and the tour is offered again — which is the point of adding one. */
    var _tourKey = _popups.map(function (p) { return String(p._id); }).join('.');
  %>
  <div class="ann-popup" id="annPopup" data-popup-id="<%= _tourKey %>"
       data-popup-count="<%= _popups.length %>"
       role="dialog" aria-modal="true" aria-labelledby="annPopupTitle" hidden>
    <div class="ann-popup__backdrop" data-ann-close></div>
    <div class="ann-popup__card">
      <button type="button" class="ann-popup__close" data-ann-close aria-label="Close">
        <i data-lucide="x"></i>
      </button>

      <% _popups.forEach(function (_popup, _i) { %>
      <div class="ann-popup__step<%= _i === 0 ? ' is-active' : '' %>" data-step="<%= _i %>">
        <% if (_popup.image) { %>
        <div class="ann-popup__media">
          <img src="<%= _popup.image %>" alt="">
        </div>
        <% } %>

        <div class="ann-popup__body">
          <% if (_popup.eyebrow) { %>
          <span class="ann-popup__eyebrow"><%= _popup.eyebrow %></span>
          <% } %>
          <!-- The id is emitted with the unescaped output tag. The escaping
               form turned its quotes into HTML entities, so the attribute never
               existed and the dialog's aria-labelledby pointed at nothing. -->
          <h3 class="ann-popup__title"<%- _i === 0 ? ' id="annPopupTitle"' : '' %>><%= _popup.title %></h3>
          <% if (_popup.subtitle) { %>
          <p class="ann-popup__text"><%= _popup.subtitle %></p>
          <% } %>
          <% if (_popup.ctaLabel) { %>
          <a href="<%= _popup.ctaLink || '#' %>" class="ann-popup__cta"><%= _popup.ctaLabel %></a>
          <% } %>
        </div>
      </div>
      <% }) %>

      <!-- Navigation, only when there is somewhere to navigate to. -->
      <% if (_popups.length > 1) { %>
      <div class="ann-popup__nav">
        <button type="button" class="ann-popup__nav-btn" id="annPopupPrev" hidden>Back</button>

        <div class="ann-popup__dots" role="tablist" aria-label="Steps">
          <% _popups.forEach(function (p, i) { %>
          <button type="button" class="ann-popup__dot<%= i === 0 ? ' is-active' : '' %>"
                  data-goto="<%= i %>" aria-label="Step <%= i + 1 %>"></button>
          <% }) %>
        </div>

        <button type="button" class="ann-popup__nav-btn ann-popup__nav-btn--primary" id="annPopupNext">Next</button>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <% if (!locals.hideFooter) { %>
  <%- include('../partials/footer') %>
  <% } %>


  <% if (!locals.hideFooter) { %>
  <!-- Bottom Navigation (mobile only) -->
