<script>
/* Sidebar search.
 *
 * Filters the nav in place rather than navigating anywhere: an admin looking
 * for "commission" should not have to remember it lives under Growth & Rewards.
 * Each link is matched on its own text plus the group heading above it, so
 * typing "transaction" surfaces the whole Transactions group and searching
 * "wallet" finds Payments & Wallets.
 *
 * A group heading is hidden whenever every link beneath it is hidden, so the
 * result never shows a section title with nothing under it.
 */
(function () {
  var input = document.getElementById('sidebarSearch');
  var clear = document.getElementById('sidebarSearchClear');
  var empty = document.getElementById('sidebarSearchEmpty');
  var menu  = document.querySelector('.sidebar-menu');
  if (!input || !menu) return;

  /* Build the index once. Walking the DOM on every keystroke would re-read
     every label for each character typed. */
  var groups = [];
  var current = null;

  Array.prototype.forEach.call(menu.children, function (li) {
    if (li.classList.contains('menu-header')) {
      current = { header: li, heading: li.textContent.trim().toLowerCase(), items: [] };
      groups.push(current);
      return;
    }
    var link = li.querySelector('a');
    if (!link) return;
    /* Label plus its aliases. Searching "referral" has to find the page called
       "Growth & Rewards" — an admin types the name of the setting they want,
       not the name of the page it happens to sit on. */
    var label = (link.textContent || '').trim().toLowerCase();
    var extra = (link.dataset.search || '').toLowerCase();
    var entry = { li: li, label: label, extra: extra };
    if (current) {
      current.items.push(entry);
    } else {
      // A link before any heading still has to be searchable.
      groups.push({ header: null, heading: '', items: [entry] });
    }
  });

  function apply(query) {
    var q = query.trim().toLowerCase();
    var anyVisible = false;

    groups.forEach(function (group) {
      var shown = 0;

      group.items.forEach(function (entry) {
        // Matching the heading too means a group name finds its whole contents.
        var hit = !q
               || entry.label.indexOf(q) !== -1
               || entry.extra.indexOf(q) !== -1
               || group.heading.indexOf(q) !== -1;
        entry.li.hidden = !hit;
        if (hit) shown++;
      });

      if (group.header) group.header.hidden = (shown === 0);
      if (shown) anyVisible = true;
    });

    if (empty) empty.hidden = !q || anyVisible;
    if (clear) clear.hidden = !q;
  }

  var timer = null;
  input.addEventListener('input', function () {
    var value = this.value;
    // Debounced so a fast typist does not trigger a pass per keystroke.
    clearTimeout(timer);
    timer = setTimeout(function () { apply(value); }, 90);
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      this.value = '';
      apply('');
      this.blur();
      return;
    }
    // Enter jumps to the first match, so search-then-Enter is one gesture.
    if (e.key === 'Enter') {
      var first = menu.querySelector('li:not([hidden]):not(.menu-header) a');
      if (first) window.location.href = first.getAttribute('href');
    }
  });

  if (clear) {
    clear.addEventListener('click', function () {
      input.value = '';
      apply('');
      input.focus();
    });
  }

  /* "/" focuses the search from anywhere, unless the admin is already typing
     into a field — stealing focus mid-form would be worse than the shortcut is
     worth. */
  document.addEventListener('keydown', function (e) {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    var el = document.activeElement;
    var tag = el ? (el.tagName || '').toLowerCase() : '';
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || (el && el.isContentEditable)) return;
    e.preventDefault();
    input.focus();
    input.select();
  });
})();
</script>
