<header class="app-header">
  <div class="container">
    <div class="app-header__inner">

      <% if (user) { %>
      <!-- The only logo when signed in: the square mark on mobile,
           the full wordmark once there's room for it — both left-aligned -->
      <a href="/" class="app-header__center-logo" aria-label="Kabacu home">
        <picture>
          <source media="(min-width: 768px)" srcset="/assets/images/new.PNG">
          <img src="/assets/images/kabacufavicon.png" alt="Kabacu">
        </picture>
      </a>
      <% } else { %>
      <a href="/" class="app-header__logo">
        <img src="/assets/images/new.PNG" alt="Kabacu">
      </a>
      <% } %>

      <!-- Desktop nav links (hidden on mobile) -->
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/" class="desktop-nav__link">Home</a>
        <a href="/category/data-category" class="desktop-nav__link">Data Bundles</a>
        <a href="/category/electronic-category" class="desktop-nav__link">Electronics</a>
        <a href="/category/automobile-category" class="desktop-nav__link">Automobiles</a>
        <a href="/category/course-category" class="desktop-nav__link">Courses</a>
        <a href="/category/p2p-category" class="desktop-nav__link">P2P</a>
      </nav>

      <!-- Actions -->
      <div class="app-header__actions">
        <% if (user) { %>

        <!-- Mobile: wallet balance chip -->
        <span class="app-header__wallet-balance mobile-only"><span class="js-currency-symbol">₦</span><%= ((wallet && wallet.balances && (wallet.balances.NAIRA).toFixed(2)) || 0.00).toLocaleString() %></span>

        <!-- Notification bell -->
        <div class="notif-bell-wrap" style="position:relative;display:inline-block;">
          <button id="notifBellBtn" class="app-header__icon-btn" aria-label="Notifications" style="position:relative;">
            <i data-lucide="bell"></i>
            <span id="notifBadge" style="display:none;position:absolute;top:2px;right:2px;width:8px;height:8px;background:#ef4444;border-radius:50%;border:1px solid #fff;"></span>
          </button>
          <div id="notifPanel" style="display:none;position:fixed;width:320px;background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.18);z-index:99999;overflow:hidden;">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid #f0f0f0;">
              <strong style="font-size:14px;">Notifications</strong>
              <button id="notifMarkRead" style="background:none;border:none;font-size:12px;color:#6b7280;cursor:pointer;padding:0;">Mark all read</button>
            </div>
            <div id="notifList" style="max-height:340px;overflow-y:auto;">
              <div style="padding:24px 16px;text-align:center;color:#9ca3af;font-size:13px;">Loading…</div>
            </div>
            <div style="padding:10px 16px;border-top:1px solid #f0f0f0;text-align:center;">
              <a href="#" id="notifClaimRP" style="font-size:12px;color:#6b7280;">Claim Reward Points</a>
            </div>
          </div>
        </div>

        <a href="/user-profile" class="app-header__icon-btn desktop-only" aria-label="My Account" title="My Account">
          <i data-lucide="user-circle-2"></i>
        </a>
        <button type="button" id="countryTriggerBtn" class="app-header__icon-btn app-header__flag-btn js-country-trigger desktop-only" aria-label="Select country" title="Select your country">
          <span class="js-country-flag">🇳🇬</span>
        </button>
        <p class="desktop-only app-header__balance"><span class="js-currency-symbol">₦</span><%= ((wallet && wallet.balances && (wallet.balances.NAIRA).toFixed(2)) || 0.00).toLocaleString() %></p>

        <% } else { %>
        <!-- Signed out: pick a market to browse. Signed-in users don't get this
             — they are locked to the country on their profile. -->
        <button type="button" class="app-header__icon-btn app-header__flag-btn js-country-trigger"
                aria-label="Choose country" title="Choose your country">
          <span class="js-country-flag">🇳🇬</span>
        </button>
        <a href="/user/login" class="app-header__login-btn">
          <i data-lucide="log-in"></i>
          Log in
        </a>
        <% } %>
      </div>

    </div>
  </div>

  <!-- Search overlay -->
  <div class="app-header__search-row" id="headerSearchRow">
    <button id="closeSearchBtn" class="app-header__icon-btn" aria-label="Close search">
      <i data-lucide="arrow-left"></i>
    </button>
    <div class="app-header__search-wrap">
      <i data-lucide="search"></i>
      <input type="text" id="headerSearchInput"
             class="app-header__search-input"
             placeholder="Search data bundles, networks..."
             autocomplete="off">
      <button id="clearSearchBtn" class="app-header__search-clear" aria-label="Clear">
        <i data-lucide="x"></i>
      </button>
    </div>
  </div>

</header>

<% if (user) { %>
<script>
(function () {
  var btn   = document.getElementById('notifBellBtn');
  var panel = document.getElementById('notifPanel');
  var badge = document.getElementById('notifBadge');
  var list  = document.getElementById('notifList');
  var markReadBtn = document.getElementById('notifMarkRead');
  var claimBtn    = document.getElementById('notifClaimRP');
  var open  = false;
  var csrf  = '<%= csrfToken %>';

  // Move panel to <body> so it escapes any header stacking context or overflow
  document.body.appendChild(panel);

  var TYPE_COLOR = { purchase:'#3b82f6', success:'#22c55e', failed:'#ef4444', refund:'#f59e0b', attention:'#f97316', info:'#6b7280' };

  function timeAgo(d) {
    var s = Math.floor((Date.now() - new Date(d)) / 1000);
    if (s < 60)   return s + 's ago';
    if (s < 3600) return Math.floor(s/60) + 'm ago';
    if (s < 86400) return Math.floor(s/3600) + 'h ago';
    return Math.floor(s/86400) + 'd ago';
  }

  function loadNotifications() {
    fetch('/user/notifications', { credentials: 'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(data) {
        var items = data.notifications || [];
        var unread = data.unreadCount || 0;

        badge.style.display = unread > 0 ? 'block' : 'none';

        if (!items.length) {
          list.innerHTML = '<div style="padding:24px 16px;text-align:center;color:#9ca3af;font-size:13px;">No notifications yet</div>';
          return;
        }

        list.innerHTML = items.map(function(n) {
          var color = TYPE_COLOR[n.type] || '#6b7280';
          var href  = n.link ? ('href="' + n.link + '"') : 'href="#"';
          return '<a ' + href + ' style="display:flex;align-items:flex-start;gap:10px;padding:12px 16px;text-decoration:none;border-bottom:1px solid #f9f9f9;' + (!n.read ? 'background:#fafaf8;' : '') + '">' +
            '<span style="width:8px;height:8px;border-radius:50%;background:' + color + ';flex-shrink:0;margin-top:5px;"></span>' +
            '<span style="flex:1;">' +
              '<span style="display:block;font-size:13px;color:#111827;">' + n.text + '</span>' +
              '<span style="display:block;font-size:11px;color:#9ca3af;margin-top:2px;">' + timeAgo(n.createdAt) + '</span>' +
            '</span>' +
          '</a>';
        }).join('');
      })
      .catch(function() {
        list.innerHTML = '<div style="padding:24px 16px;text-align:center;color:#9ca3af;font-size:13px;">Could not load notifications</div>';
      });
  }

  function positionPanel() {
    var rect = btn.getBoundingClientRect();
    var panelWidth = 320;
    var left = Math.min(Math.max(8, rect.right - panelWidth), window.innerWidth - panelWidth - 8);
    panel.style.top  = (rect.bottom + 8) + 'px';
    panel.style.left = left + 'px';
  }

  btn.addEventListener('click', function(e) {
    e.stopPropagation();
    open = !open;
    if (open) {
      positionPanel();
      panel.style.display = 'block';
      loadNotifications();
    } else {
      panel.style.display = 'none';
    }
  });

  document.addEventListener('click', function(e) {
    if (open && !panel.contains(e.target) && e.target !== btn) {
      open = false;
      panel.style.display = 'none';
    }
  });

  window.addEventListener('scroll', function() {
    if (open) { open = false; panel.style.display = 'none'; }
  }, { passive: true });

  markReadBtn.addEventListener('click', function(e) {
    e.preventDefault();
    fetch('/user/notifications/read-all', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'X-CSRF-Token': csrf },
    });
    badge.style.display = 'none';
    list.querySelectorAll('a').forEach(function(a){ a.style.background=''; });
  });

  if (claimBtn) {
    claimBtn.addEventListener('click', function(e) {
      e.preventDefault();
      panel.style.display = 'none';
      open = false;
      if (typeof openClaimRpModal === 'function') {
        openClaimRpModal();
      } else {
        var modal = document.getElementById('claimRpModal');
        if (modal) modal.classList.add('open');
      }
    });
  }

  // Load badge on page open after short delay
  setTimeout(function() { loadNotifications(); }, 1500);
  // Refresh every 2 minutes
  setInterval(function() { if (!open) loadNotifications(); }, 120000);
}());
</script>
<% } %>

<!-- Country selector (frontend-only, persisted in localStorage) -->
<script>
(function () {
  var STORAGE_KEY = 'kbc_country';

  function flagEmoji(code) {
    return code.toUpperCase().replace(/./g, function (c) {
      return String.fromCodePoint(127397 + c.charCodeAt(0));
    });
  }

  function buildCountries() {
    var fallback = [
      { code: 'NG', name: 'Nigeria' }, { code: 'US', name: 'United States' },
      { code: 'GB', name: 'United Kingdom' }, { code: 'GH', name: 'Ghana' },
      { code: 'KE', name: 'Kenya' }, { code: 'ZA', name: 'South Africa' },
      { code: 'CA', name: 'Canada' }, { code: 'IN', name: 'India' },
      { code: 'CN', name: 'China' }, { code: 'DE', name: 'Germany' },
      { code: 'FR', name: 'France' }, { code: 'AE', name: 'United Arab Emirates' },
      { code: 'EG', name: 'Egypt' }, { code: 'BR', name: 'Brazil' },
      { code: 'AU', name: 'Australia' }
    ];
    try {
      var codes = Intl.supportedValuesOf('region').filter(function (c) { return /^[A-Z]{2}$/.test(c); });
      var dn = new Intl.DisplayNames(['en'], { type: 'region' });
      var list = codes.map(function (c) { return { code: c, name: dn.of(c) }; });
      list.sort(function (a, b) { return a.name.localeCompare(b.name); });
      return list.length ? list : fallback;
    } catch (e) {
      fallback.sort(function (a, b) { return a.name.localeCompare(b.name); });
      return fallback;
    }
  }

  var countries = buildCountries();

  function getCurrentCode() {
    return localStorage.getItem(STORAGE_KEY) || 'NG';
  }

  function getCurrentCountry() {
    var code = getCurrentCode();
    var found = countries.filter(function (c) { return c.code === code; })[0];
    return found || { code: 'NG', name: 'Nigeria' };
  }

  // Display-only symbol per country — actual amounts/conversion are unaffected for now.
  var CURRENCY_MAP = {
    NG: '₦', US: '$', GB: '£', GH: '₵', KE: 'KSh', ZA: 'R', CA: '$', IN: '₹',
    CN: '¥', DE: '€', FR: '€', AE: 'AED', EG: 'E£', BR: 'R$', AU: '$',
    JP: '¥', KR: '₩', RU: '₽', MX: '$', ES: '€', IT: '€', NL: '€', SE: 'kr',
    CH: 'CHF', SG: '$', MY: 'RM', PH: '₱', PK: '₨', BD: '৳', TZ: 'TSh',
    UG: 'USh', RW: 'FRw', ZM: 'ZK', SN: 'CFA', CI: 'CFA', CM: 'FCFA'
  };

  function getCurrencySymbol() {
    return CURRENCY_MAP[getCurrentCode()] || '$';
  }

  var CURRENCY_NAME_MAP = {
    NG: 'Naira', US: 'Dollar', GB: 'Pound', GH: 'Cedi', KE: 'Shilling',
    ZA: 'Rand', CA: 'Dollar', IN: 'Rupee', CN: 'Yuan', DE: 'Euro',
    FR: 'Euro', AE: 'Dirham', EG: 'Pound', BR: 'Real', AU: 'Dollar',
    JP: 'Yen', KR: 'Won', RU: 'Ruble', MX: 'Peso', ES: 'Euro', IT: 'Euro',
    NL: 'Euro', SE: 'Krona', CH: 'Franc', SG: 'Dollar', MY: 'Ringgit',
    PH: 'Peso', PK: 'Rupee', BD: 'Taka', TZ: 'Shilling', UG: 'Shilling',
    RW: 'Franc', ZM: 'Kwacha', SN: 'Franc', CI: 'Franc', CM: 'Franc'
  };

  var CURRENCY_CODE_MAP = {
    NG: 'NGN', US: 'USD', GB: 'GBP', GH: 'GHS', KE: 'KES', ZA: 'ZAR',
    CA: 'CAD', IN: 'INR', CN: 'CNY', DE: 'EUR', FR: 'EUR', AE: 'AED',
    EG: 'EGP', BR: 'BRL', AU: 'AUD', JP: 'JPY', KR: 'KRW', RU: 'RUB',
    MX: 'MXN', ES: 'EUR', IT: 'EUR', NL: 'EUR', SE: 'SEK', CH: 'CHF',
    SG: 'SGD', MY: 'MYR', PH: 'PHP', PK: 'PKR', BD: 'BDT', TZ: 'TZS',
    UG: 'UGX', RW: 'RWF', ZM: 'ZMW', SN: 'XOF', CI: 'XOF', CM: 'XAF'
  };

  function getCurrencyName() {
    return CURRENCY_NAME_MAP[getCurrentCode()] || 'Dollar';
  }

  function getCurrencyCode() {
    return CURRENCY_CODE_MAP[getCurrentCode()] || 'USD';
  }

  var overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.id = 'countryModalOverlay';
  overlay.innerHTML =
    '<div class="modal-box country-modal-box">' +
      '<button type="button" class="modal-close" id="countryModalClose"><i data-lucide="x"></i></button>' +
      '<div class="modal-box__header"><span class="modal-title">Select your country</span></div>' +
      '<div class="input-wrapper" style="margin-bottom:14px;">' +
        '<i data-lucide="search"></i>' +
        '<input type="text" id="countrySearchInput" class="form-input" placeholder="Search countries..." autocomplete="off">' +
      '</div>' +
      '<div class="country-list" id="countryList"></div>' +
    '</div>';
  document.body.appendChild(overlay);

  var searchInput = document.getElementById('countrySearchInput');
  var listEl = document.getElementById('countryList');
  var closeBtn = document.getElementById('countryModalClose');

  function renderList(filter) {
    var q = (filter || '').trim().toLowerCase();
    var current = getCurrentCode();
    var items = countries.filter(function (c) { return !q || c.name.toLowerCase().indexOf(q) !== -1; });

    if (!items.length) {
      listEl.innerHTML = '<div class="country-row__empty">No countries found</div>';
      return;
    }

    listEl.innerHTML = items.map(function (c) {
      return '<button type="button" class="country-row' + (c.code === current ? ' active' : '') + '" data-code="' + c.code + '">' +
        '<span class="country-row__flag">' + flagEmoji(c.code) + '</span>' +
        '<span class="country-row__name">' + c.name + '</span>' +
        '<i data-lucide="check" class="country-row__check"></i>' +
      '</button>';
    }).join('');

    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function updateTriggers() {
    var country = getCurrentCountry();
    var symbol = getCurrencySymbol();
    var currencyName = getCurrencyName();
    var currencyCode = getCurrencyCode();
    document.querySelectorAll('.js-country-flag').forEach(function (el) {
      el.textContent = flagEmoji(country.code);
    });
    document.querySelectorAll('.js-country-name').forEach(function (el) {
      el.textContent = country.name;
    });
    document.querySelectorAll('.js-currency-symbol').forEach(function (el) {
      el.textContent = symbol;
    });
    document.querySelectorAll('.js-currency-placeholder').forEach(function (el) {
      el.placeholder = symbol + (el.dataset.currencySuffix || '0.00');
    });
    document.querySelectorAll('.js-currency-name').forEach(function (el) {
      el.textContent = currencyName;
    });
    document.querySelectorAll('.js-currency-code').forEach(function (el) {
      el.textContent = currencyCode;
    });
  }

  function openModal() {
    renderList('');
    searchInput.value = '';
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(function () { searchInput.focus(); }, 50);
  }

  function closeModal() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  function selectCountry(code) {
    localStorage.setItem(STORAGE_KEY, code);
    updateTriggers();
    closeModal();
    window.dispatchEvent(new CustomEvent('kbc:countrychange', { detail: { code: code } }));
  }

  listEl.addEventListener('click', function (e) {
    var row = e.target.closest('.country-row');
    if (row) selectCountry(row.dataset.code);
  });

  searchInput.addEventListener('input', function () { renderList(this.value); });
  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

  // Trigger elements (header flag button, profile country row, ...) may live
  // further down the page than this script tag, so wait for the full DOM.
  document.addEventListener('DOMContentLoaded', function () {
    updateTriggers();
    document.querySelectorAll('.js-country-trigger').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        openModal();
      });
    });
  });

  window.KbcCountrySelector = {
    open: openModal,
    getCurrent: getCurrentCountry,
    getCurrencySymbol: getCurrencySymbol,
    getCurrencyName: getCurrencyName,
    getCurrencyCode: getCurrencyCode
  };
}());
</script>
