<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1 kp-has-drawer">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <div class="kp-panel">

            <%
              var _navSections = [
                { id: 'ods',   label: 'OurDataStore', icon: 'wifi' },
                { id: 'gsubz', label: 'GSubz',         icon: 'zap' },
              ];
              var providerColors = { 1: '#fbbf24', 2: '#22c55e', 3: '#ef4444', 4: '#3b82f6' };
            %>

            <div class="kp-panel__head">
              <h1 class="kp-panel__title">Data Plan Configuration</h1>
              <p class="kp-panel__sub kp-panel__section-label"><%= _navSections[0].label %></p>
            </div>

            <div class="kp-panel__body">

              <%- include('partials/panelDrawer', {
                panelKey: 'dataConfig',
                drawerLabel: 'Data Providers',
                sections: _navSections
              }) %>

              <div class="kp-panel__main">

                <!-- ══ OurDataStore ══════════════════════════════════════ -->
                <div class="kp-section" data-section="ods">
                  <div class="kp-grid kp-grid--2">

                    <div class="kp-card">
                      <div class="kp-card__head"><h2 class="kp-card__title">Add OurDataStore Plan</h2></div>
                      <div class="kp-card__body">

                        <% if (query.added == '1') { %>
                        <div class="alert alert-success alert-dismissible fade show">
                          Plan added successfully.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>
                        <% if (query.deleted == '1') { %>
                        <div class="alert alert-success alert-dismissible fade show">
                          Plan removed.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>
                        <% if (query.error == 'duplicate') { %>
                        <div class="alert alert-warning alert-dismissible fade show">
                          A plan with that name already exists.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } else if (query.error) { %>
                        <div class="alert alert-danger alert-dismissible fade show">
                          Something went wrong. Please try again.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>

                        <form method="post" action="/admin/networks/add">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                          <div class="kp-field">
                            <label class="kp-field__label">Plan Name</label>
                            <input type="text" name="name" class="kp-input"
                              placeholder="e.g. CTC Weekly Special-MTN" required maxlength="60">
                            <p class="kp-row__hint">The exact plan name that will appear on products.</p>
                          </div>

                          <div class="kp-field">
                            <label class="kp-field__label">Carrier</label>
                            <select name="apiCode" class="kp-select" required>
                              <option value="" disabled selected>Select carrier…</option>
                              <option value="1">MTN</option>
                              <option value="2">GLO</option>
                              <option value="3">Airtel</option>
                              <option value="4">9mobile</option>
                            </select>
                            <p class="kp-row__hint">The network this plan routes through on OurDataStore.</p>
                          </div>

                          <button type="submit" class="kp-btn kp-btn--primary kp-btn--block" style="margin-top:8px;">Add Data Plan</button>
                        </form>
                      </div>
                    </div>

                    <div class="kp-card">
                      <div class="kp-card__head">
                        <h2 class="kp-card__title">Configured Plans</h2>
                        <div class="kp-card__aside">
                          <span class="kp-pill kp-pill--info"><%= networks.length %> plan<%= networks.length !== 1 ? 's' : '' %></span>
                        </div>
                      </div>
                      <div class="kp-card__body kp-card__body--flush">
                        <% if (!networks.length) { %>
                        <div class="kp-empty">No plans configured yet. Add one to get started.</div>
                        <% } else { %>
                        <div class="kp-tablewrap">
                          <table class="kp-table">
                            <thead>
                              <tr><th>Plan Name</th><th>Carrier</th><th>Code</th><th></th></tr>
                            </thead>
                            <tbody>
                              <% networks.forEach(function (net) { %>
                              <tr>
                                <td><span class="kp-strong"><%= net.name %></span></td>
                                <td>
                                  <span class="kp-pill" style="background:<%= providerColors[net.apiCode] %>20;color:<%= providerColors[net.apiCode] %>;">
                                    <%= providerLabels[net.apiCode] %>
                                  </span>
                                </td>
                                <td><span class="kp-code"><%= net.apiCode %></span></td>
                                <td class="kp-table__act">
                                  <form method="post" action="/admin/networks/delete/<%= net._id %>" onsubmit="return confirmDeletePlan(this)">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="kp-btn kp-btn--sm kp-btn--danger">Remove</button>
                                  </form>
                                </td>
                              </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                        <% } %>
                      </div>
                    </div>

                  </div>
                </div>

                <!-- ══ GSubz ═════════════════════════════════════════════ -->
                <div class="kp-section" data-section="gsubz">
                  <div class="kp-grid kp-grid--2">

                    <div class="kp-card">
                      <div class="kp-card__head"><h2 class="kp-card__title">Add GSubz Plan</h2></div>
                      <div class="kp-card__body">

                        <% if (query.gadded == '1') { %>
                        <div class="alert alert-success alert-dismissible fade show">
                          Plan added successfully.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>
                        <% if (query.gdeleted == '1') { %>
                        <div class="alert alert-success alert-dismissible fade show">
                          Plan removed.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>
                        <% if (query.gerror == 'duplicate') { %>
                        <div class="alert alert-warning alert-dismissible fade show">
                          A plan with that name already exists.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } else if (query.gerror == 'invalid') { %>
                        <div class="alert alert-danger alert-dismissible fade show">
                          Pick a carrier and a category before saving.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } else if (query.gerror) { %>
                        <div class="alert alert-danger alert-dismissible fade show">
                          Something went wrong. Please try again.
                          <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                        <% } %>

                        <form method="post" action="/admin/networks/gsubz/add">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                          <div class="kp-field">
                            <label class="kp-field__label">Plan Name</label>
                            <input type="text" name="name" class="kp-input"
                              placeholder="e.g. MTN SME Special" required maxlength="60">
                            <p class="kp-row__hint">The brand name that will appear on products.</p>
                          </div>

                          <div class="kp-field">
                            <label class="kp-field__label">Carrier</label>
                            <select id="gsubzCarrier" class="kp-select" onchange="onGsubzCarrierChange(this.value)">
                              <% Object.keys(carrierCategories).forEach(function (carrier) { %>
                              <option value="<%= carrier %>" <%= carrier === 'MTN' ? 'selected' : '' %>><%= carrier %></option>
                              <% }) %>
                            </select>
                            <p class="kp-row__hint">Picking a carrier reveals the categories GSubz offers for it below.</p>
                          </div>

                          <div class="kp-field">
                            <label class="kp-field__label">Category</label>
                            <% Object.keys(carrierCategories).forEach(function (carrier) { %>
                            <% var cats = carrierCategories[carrier]; %>
                            <div class="gsubz-cat-panel" id="gsubzCat-<%= carrier %>" style="<%= carrier === 'MTN' ? '' : 'display:none;' %>">
                              <% if (!cats.length) { %>
                              <p class="kp-mute" style="font-size:12.5px;">No active categories on this account yet for <%= carrier %>.</p>
                              <% } else { %>
                              <div class="kp-stack">
                                <% cats.forEach(function (cat, i) { %>
                                <label class="kp-row" style="cursor:pointer;">
                                  <input type="radio" name="category" value="<%= cat.key %>"
                                    <%= (carrier === 'MTN' && i === 0) ? 'checked' : '' %>
                                    <%= carrier === 'MTN' ? 'required' : '' %>
                                    style="margin-right:10px;">
                                  <span class="kp-row__label"><%= cat.label %></span>
                                  <span class="kp-code" style="margin-left:auto;"><%= cat.serviceID %></span>
                                </label>
                                <% }) %>
                              </div>
                              <% } %>
                            </div>
                            <% }) %>
                          </div>

                          <button type="submit" class="kp-btn kp-btn--primary kp-btn--block" style="margin-top:8px;">Add GSubz Plan</button>
                        </form>
                      </div>
                    </div>

                    <div class="kp-card">
                      <div class="kp-card__head">
                        <h2 class="kp-card__title">Configured Plans</h2>
                        <div class="kp-card__aside">
                          <span class="kp-pill kp-pill--info"><%= gsubzPlans.length %> plan<%= gsubzPlans.length !== 1 ? 's' : '' %></span>
                        </div>
                      </div>
                      <div class="kp-card__body kp-card__body--flush">
                        <% if (!gsubzPlans.length) { %>
                        <div class="kp-empty">No GSubz plans configured yet. Add one to get started.</div>
                        <% } else { %>
                        <div class="kp-tablewrap">
                          <table class="kp-table">
                            <thead>
                              <tr><th>Plan Name</th><th>Carrier</th><th>Category</th><th>Service ID</th><th></th></tr>
                            </thead>
                            <tbody>
                              <% gsubzPlans.forEach(function (p) { %>
                              <tr>
                                <td><span class="kp-strong"><%= p.name %></span></td>
                                <td><span class="kp-pill kp-pill--good"><%= p.carrier %></span></td>
                                <td><%= p.category %></td>
                                <td><span class="kp-code"><%= p.serviceID %></span></td>
                                <td class="kp-table__act">
                                  <form method="post" action="/admin/networks/gsubz/delete/<%= p._id %>" onsubmit="return confirmDeletePlan(this)">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="kp-btn kp-btn--sm kp-btn--danger">Remove</button>
                                  </form>
                                </td>
                              </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                        <% } %>
                      </div>
                    </div>

                  </div>
                </div>

              </div><!-- /kp-panel__main -->
            </div><!-- /kp-panel__body -->
          </div><!-- /kp-panel -->

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/admin/assets/js/kbc-panel.js"></script>
<script>
function onGsubzCarrierChange(carrier) {
  document.querySelectorAll('.gsubz-cat-panel').forEach(function (panel) {
    var active = panel.id === 'gsubzCat-' + carrier;
    panel.style.display = active ? '' : 'none';
    panel.querySelectorAll('input[type=radio]').forEach(function (r) {
      r.required = active;
      if (!active) r.checked = false;
    });
  });
}

function confirmDeletePlan(form) {
  Swal.fire({
    title: 'Remove this plan?',
    text: 'Products already using it will still work, but it will no longer appear in the dropdown.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, Remove',
    confirmButtonColor: '#ef4444',
    cancelButtonText: 'Cancel',
  }).then(function (r) { if (r.isConfirmed) form.submit(); });
  return false;
}
</script>
