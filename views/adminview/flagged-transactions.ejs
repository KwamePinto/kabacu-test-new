<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>
    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-header">
          <h1>Flagged Transactions</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/admin/main">Dashboard</a></div>
            <div class="breadcrumb-item">Flagged Transactions</div>
          </div>
        </div>

        <div class="section-body">

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><strong>Error:</strong> <%- error %></div>
          <% } %>

          <div class="alert alert-warning">
            <strong>What is this?</strong>
            These are wallet payment transactions that failed because our server timed out waiting
            for OurDataStore — but OurDataStore may have already delivered the data to the user's phone.
            The wallet was <strong>refunded</strong> at the time. Use the OurDataStore dashboard to verify
            each entry, then click <strong>Deduct Wallet</strong> for confirmed deliveries.
          </div>

          <!-- Summary cards -->
          <div class="row mb-4">
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-danger"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Suspicious</h4></div>
                  <div class="card-body"><%= rows.length %></div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-naira-sign"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Total Exposed</h4></div>
                  <div class="card-body">₦<%= totalAmount.toLocaleString() %></div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-check-circle"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Deducted</h4></div>
                  <div class="card-body"><%= alreadyDeducted %></div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-info"><i class="fas fa-redo"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Has Paid Retry</h4></div>
                  <div class="card-body"><%= rows.filter(r => r.hasSuccessRetry).length %></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Legend -->
          <div class="mb-3" style="font-size:13px;">
            <span style="display:inline-block;background:#f8d7da;border:1px solid #f5c6cb;border-radius:4px;padding:2px 8px;color:#721c24;font-weight:600;margin-right:2px;">Wallet Refunded</span> — deduct if data arrived
            &nbsp;&nbsp;
            <span style="display:inline-block;background:#fff3cd;border:1px solid #ffeeba;border-radius:4px;padding:2px 8px;color:#856404;font-weight:600;margin-right:2px;">Wallet Refunded + Paid Retry</span> — user paid again; do NOT deduct unless certain first attempt delivered
            &nbsp;&nbsp;
            <span style="display:inline-block;background:#fff3cd;border:1px solid #ffeeba;border-radius:4px;padding:2px 8px;color:#856404;font-weight:600;">Wallet Held</span> — mark delivered or refund
          </div>

          <!-- Search -->
          <div class="mb-3">
            <input type="text" id="flaggedSearch" class="form-control" placeholder="Search by user, phone, amount, or reason…" style="max-width:360px;">
          </div>

          <!-- Tabs -->
          <ul class="nav nav-tabs mb-0" id="flaggedTabs" role="tablist">
            <li class="nav-item">
              <a class="nav-link active" id="flagged-tab" data-toggle="tab" href="#tab-flagged" role="tab">
                Flagged <span class="badge badge-danger ml-1"><%= rows.length %></span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="deducted-tab" data-toggle="tab" href="#tab-deducted" role="tab" data-lazy="deducted">
                Deducted <span class="badge badge-success ml-1" id="deducted-badge"><%= alreadyDeducted %></span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="refunded-tab" data-toggle="tab" href="#tab-refunded" role="tab" data-lazy="refunded">
                Refunded <span class="badge badge-info ml-1" id="refunded-badge">...</span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="cleared-tab" data-toggle="tab" href="#tab-cleared" role="tab" data-lazy="cleared">
                Cleared <span class="badge badge-secondary ml-1" id="cleared-badge">...</span>
              </a>
            </li>
          </ul>

          <div class="tab-content">

            <!-- ── Tab 1: Flagged ── -->
            <div class="tab-pane fade show active" id="tab-flagged" role="tabpanel">
              <div class="card" style="border-top-left-radius:0;border-top-right-radius:0;">
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                      <thead>
                        <tr>
                          <th>Date</th>
                          <th>User</th>
                          <th>Phone</th>
                          <th class="text-right">Amount</th>
                          <th>Status</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (rows.length === 0) { %>
                          <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No flagged transactions found.</td>
                          </tr>
                        <% } %>
                        <% rows.forEach(function(tx) {
                             var isOld = tx.status === 'failed';
                             var userName = tx.user ? tx.user.username : 'Unknown';
                        %>
                          <tr id="row-<%= tx._id %>">
                            <td>
                              <small>
                                <%= new Date(tx.createdAt).toLocaleString('en-GB', {
                                  day: '2-digit', month: 'short', year: 'numeric',
                                  hour: '2-digit', minute: '2-digit'
                                }) %>
                              </small>
                            </td>
                            <td>
                              <strong><%= userName %></strong><br>
                              <small class="text-muted"><%= tx.user ? tx.user.email : '' %></small>
                            </td>
                            <td><code><%= tx.phone || '—' %></code></td>
                            <td class="text-right"><strong>₦<%= (tx.amount || 0).toLocaleString() %></strong></td>
                            <td>
                              <% if (!isOld) { %>
                                <div style="display:inline-block;background:#fff3cd;border:1px solid #ffeeba;border-radius:4px;padding:4px 10px;line-height:1.6;">
                                  <span style="display:block;color:#856404;font-size:12px;font-weight:600;">Wallet Held</span>
                                  <% if (tx.hasSuccessRetry) { %>
                                    <span style="display:block;color:#856404;font-size:11px;">Paid Retry</span>
                                  <% } %>
                                </div>
                              <% } else if (tx.hasSuccessRetry) { %>
                                <div style="display:inline-block;background:#fff3cd;border:1px solid #ffeeba;border-radius:4px;padding:4px 10px;line-height:1.6;">
                                  <span style="display:block;color:#856404;font-size:12px;font-weight:600;">Wallet Refunded</span>
                                  <span style="display:block;color:#856404;font-size:11px;">Paid Retry</span>
                                </div>
                              <% } else { %>
                                <div style="display:inline-block;background:#f8d7da;border:1px solid #f5c6cb;border-radius:4px;padding:4px 10px;line-height:1.6;">
                                  <span style="display:block;color:#721c24;font-size:12px;font-weight:600;">Wallet Refunded</span>
                                </div>
                              <% } %>
                            </td>
                            <td>
                              <div class="d-flex align-items-center" style="gap:6px;">
                                <% if (isOld) { %>
                                  <button class="btn btn-sm btn-danger deduct-btn"
                                    data-id="<%= tx._id %>" data-amount="<%= tx.amount %>" data-user="<%= userName %>">
                                    Deduct Wallet
                                  </button>
                                <% } else { %>
                                  <button class="btn btn-sm btn-success resolve-btn"
                                    data-id="<%= tx._id %>" data-action="delivered"
                                    data-amount="<%= tx.amount %>" data-user="<%= userName %>">
                                    Mark Delivered
                                  </button>
                                  <button class="btn btn-sm btn-secondary resolve-btn"
                                    data-id="<%= tx._id %>" data-action="refund"
                                    data-amount="<%= tx.amount %>" data-user="<%= userName %>">
                                    Refund User
                                  </button>
                                <% } %>
                                <button class="btn btn-sm btn-outline-secondary clear-btn"
                                  data-id="<%= tx._id %>"
                                  title="Dismiss / clear this entry"
                                  style="padding:4px 8px;">
                                  <i class="fas fa-trash-alt" style="font-size:12px;"></i>
                                </button>
                              </div>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- ── Tab 2: Deducted (lazy) ── -->
            <div class="tab-pane fade" id="tab-deducted" role="tabpanel">
              <div class="card" style="border-top-left-radius:0;border-top-right-radius:0;">
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                      <thead>
                        <tr>
                          <th>Deducted At</th>
                          <th>User</th>
                          <th>Phone</th>
                          <th class="text-right">Amount</th>
                          <th class="text-right">Balance Before</th>
                          <th class="text-right">Balance After</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody id="deducted-tbody">
                        <tr><td colspan="7" class="text-center py-4 text-muted">
                          <span class="spinner-border spinner-border-sm" role="status"></span> Loading…
                        </td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- ── Tab 3: Refunded (lazy) ── -->
            <div class="tab-pane fade" id="tab-refunded" role="tabpanel">
              <div class="card" style="border-top-left-radius:0;border-top-right-radius:0;">
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                      <thead>
                        <tr>
                          <th>Date</th>
                          <th>User</th>
                          <th>Phone</th>
                          <th class="text-right">Amount</th>
                          <th>Reason</th>
                          <th>Requested By</th>
                          <th>Status</th>
                          <th id="refunded-action-th" style="display:none;">Action</th>
                        </tr>
                      </thead>
                      <tbody id="refunded-tbody">
                        <tr><td colspan="8" class="text-center py-4 text-muted">
                          <span class="spinner-border spinner-border-sm" role="status"></span> Loading…
                        </td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- ── Tab 4: Cleared (lazy) ── -->
            <div class="tab-pane fade" id="tab-cleared" role="tabpanel">
              <div class="card" style="border-top-left-radius:0;border-top-right-radius:0;">
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                      <thead>
                        <tr>
                          <th>Date</th>
                          <th>User</th>
                          <th>Phone</th>
                          <th class="text-right">Amount</th>
                          <th>Original Status</th>
                          <th>Cleared By</th>
                          <th>Cleared At</th>
                        </tr>
                      </thead>
                      <tbody id="cleared-tbody">
                        <tr><td colspan="7" class="text-center py-4 text-muted">
                          <span class="spinner-border spinner-border-sm" role="status"></span> Loading…
                        </td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

          </div><!-- /tab-content -->

        </div><!-- /section-body -->
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<!-- ── Refund Reason Modal ── -->
<div class="modal fade" id="refundReasonModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Refund Deduction</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body">
        <p id="refundModalDesc" class="text-muted mb-3" style="font-size:14px;"></p>
        <div class="form-group mb-0">
          <label style="font-size:13px;">Reason for Refund <span class="text-danger">*</span></label>
          <textarea id="refundReasonInput" class="form-control" rows="3" placeholder="Enter reason for this refund…"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" id="refundContinueBtn">
          <span id="refundBtnLabel">Continue</span>
          <span id="refundBtnSpinner" style="display:none;">
            <span class="spinner-border spinner-border-sm" role="status"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Review Refund Modal (super_admin only, rendered server-side) ── -->
<div class="modal fade" id="reviewRefundModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header" style="background:#fff8e1;border-bottom:1px solid #ffe082;">
        <h5 class="modal-title">Review Refund Request</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body">
        <table class="table table-sm mb-3" style="font-size:13px;">
          <tr><td class="text-muted" style="width:40%;">User</td><td><strong id="reviewRefundUser"></strong></td></tr>
          <tr><td class="text-muted">Amount</td><td><strong>₦<span id="reviewRefundAmount"></span></strong></td></tr>
          <tr><td class="text-muted">Requested by</td><td id="reviewRefundRequestedBy"></td></tr>
        </table>
        <div class="alert alert-info mb-0" style="font-size:13px;">
          <strong>Reason:</strong><br>
          <span id="reviewRefundReason"></span>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="approveRefundBtn">
          <span id="approveBtnLabel">Approve &amp; Refund</span>
          <span id="approveBtnSpinner" style="display:none;">
            <span class="spinner-border spinner-border-sm" role="status"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
var _csrf = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

async function postAction(url, body) {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
    body: JSON.stringify(body),
  });
  return res.json();
}

function fadeRow(id, btn, label) {
  var row = document.getElementById('row-' + id);
  if (row) row.style.opacity = '0.4';
  btn.textContent = label;
  btn.disabled = true;
  btn.className = 'btn btn-sm btn-secondary';
}

// ── Deduct Wallet ────────────────────────────────────────────────────
document.querySelectorAll('.deduct-btn').forEach(function (btn) {
  btn.addEventListener('click', async function () {
    var id = this.dataset.id, amount = Number(this.dataset.amount).toLocaleString(), user = this.dataset.user;
    var ok = await Swal.fire({
      icon: 'warning', title: 'Confirm Deduction',
      html: 'Deduct <strong>₦' + amount + '</strong> from <strong>' + user + '</strong>\'s wallet?<br><small class="text-muted">Only do this after confirming data delivery in OurDataStore.</small>',
      showCancelButton: true, confirmButtonText: 'Yes, Deduct', confirmButtonColor: '#dc3545',
    });
    if (!ok.isConfirmed) return;
    btn.disabled = true; btn.textContent = 'Working…';
    try {
      var data = await postAction('/admin/flagged-transactions/deduct', { transactionId: id });
      if (data.success) {
        Swal.fire({ icon: 'success', title: 'Done', text: data.message, timer: 2500, showConfirmButton: false });
        fadeRow(id, btn, 'Deducted');
      } else {
        Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
        btn.disabled = false; btn.textContent = 'Deduct Wallet';
      }
    } catch (_) {
      Swal.fire({ icon: 'error', text: 'Something went wrong' });
      btn.disabled = false; btn.textContent = 'Deduct Wallet';
    }
  });
});

// ── Mark Delivered / Refund User ─────────────────────────────────────
document.querySelectorAll('.resolve-btn').forEach(function (btn) {
  btn.addEventListener('click', async function () {
    var id = this.dataset.id, action = this.dataset.action;
    var amount = Number(this.dataset.amount).toLocaleString(), user = this.dataset.user;
    var isDelivered = action === 'delivered';
    var ok = await Swal.fire({
      icon: isDelivered ? 'question' : 'warning',
      title: isDelivered ? 'Mark as Delivered?' : 'Refund User?',
      html: isDelivered
        ? 'Confirm that OurDataStore delivered data for <strong>' + user + '</strong> (₦' + amount + '). The wallet charge will stand.'
        : 'Refund <strong>₦' + amount + '</strong> to <strong>' + user + '</strong>? Only do this if OurDataStore did <em>not</em> deliver.',
      showCancelButton: true,
      confirmButtonText: isDelivered ? 'Yes, Delivered' : 'Yes, Refund',
      confirmButtonColor: isDelivered ? '#47c363' : '#6c757d',
    });
    if (!ok.isConfirmed) return;
    btn.disabled = true; btn.textContent = 'Working…';
    try {
      var data = await postAction('/admin/flagged-transactions/resolve', { transactionId: id, action });
      if (data.success) {
        Swal.fire({ icon: 'success', title: 'Done', text: data.message, timer: 2500, showConfirmButton: false });
        fadeRow(id, btn, isDelivered ? 'Delivered' : 'Refunded');
        var row = document.getElementById('row-' + id);
        if (row) row.querySelectorAll('.resolve-btn').forEach(function(b){ b.disabled = true; });
      } else {
        Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
        btn.disabled = false; btn.textContent = isDelivered ? 'Mark Delivered' : 'Refund User';
      }
    } catch (_) {
      Swal.fire({ icon: 'error', text: 'Something went wrong' });
      btn.disabled = false; btn.textContent = isDelivered ? 'Mark Delivered' : 'Refund User';
    }
  });
});

// ── Live search ───────────────────────────────────────────────────────
function applySearch(q) {
  var activePane = document.querySelector('#flaggedTabs + .tab-content .tab-pane.active');
  if (!activePane) return;
  activePane.querySelectorAll('tbody tr').forEach(function (row) {
    var text = row.textContent.toLowerCase();
    row.style.display = (!q || text.includes(q)) ? '' : 'none';
  });
}

document.getElementById('flaggedSearch').addEventListener('input', function () {
  applySearch(this.value.toLowerCase().trim());
});

$('#flaggedTabs a[data-toggle="tab"]').on('shown.bs.tab', function () {
  applySearch(document.getElementById('flaggedSearch').value.toLowerCase().trim());
});

// ── Clear / dismiss ───────────────────────────────────────────────────
document.querySelectorAll('.clear-btn').forEach(function (btn) {
  btn.addEventListener('click', async function () {
    var id = this.dataset.id;
    this.disabled = true;
    try {
      var data = await postAction('/admin/flagged-transactions/clear', { transactionId: id });
      if (data.success) {
        var row = document.getElementById('row-' + id);
        if (row) { row.style.opacity = '0.3'; row.style.pointerEvents = 'none'; }
      } else {
        Swal.fire({ icon: 'error', text: data.message });
        this.disabled = false;
      }
    } catch (_) {
      Swal.fire({ icon: 'error', text: 'Something went wrong' });
      this.disabled = false;
    }
  });
});

// ── Refund Deduction modal (event delegation — rows loaded lazily) ────
var _refundTxId = null;
var _refundRow  = null;

document.getElementById('tab-deducted').addEventListener('click', function (e) {
  var btn = e.target.closest('.refund-deduct-btn');
  if (!btn) return;
  _refundTxId = btn.dataset.id;
  _refundRow  = document.getElementById('deducted-row-' + btn.dataset.id);
  document.getElementById('refundModalDesc').textContent =
    'You are about to refund ₦' + Number(btn.dataset.amount).toLocaleString() + ' to ' + btn.dataset.user + '\'s wallet.';
  document.getElementById('refundReasonInput').value = '';
  $('#refundReasonModal').modal('show');
});

document.getElementById('refundContinueBtn').addEventListener('click', async function () {
  var reason = document.getElementById('refundReasonInput').value.trim();
  if (!reason) { Swal.fire({ icon: 'warning', text: 'Please enter a reason for the refund.' }); return; }
  var lbl = document.getElementById('refundBtnLabel');
  var spn = document.getElementById('refundBtnSpinner');
  this.disabled = true; lbl.style.display = 'none'; spn.style.display = 'inline';
  try {
    var data = await postAction('/admin/flagged-transactions/refund-deduction', { transactionId: _refundTxId, reason });
    $('#refundReasonModal').modal('hide');
    this.disabled = false; lbl.style.display = 'inline'; spn.style.display = 'none';
    if (data.success) {
      if (data.immediate) {
        Swal.fire({ icon: 'success', title: 'Refunded', text: data.message, timer: 2500, showConfirmButton: false });
      } else {
        Swal.fire({ icon: 'info', title: 'Request Submitted', text: 'Your refund request has been submitted for super admin approval.', confirmButtonColor: '#6777ef' });
      }
      if (_refundRow) { _refundRow.style.opacity = '0.4'; _refundRow.style.pointerEvents = 'none'; }
    } else {
      Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
    }
  } catch (_) {
    $('#refundReasonModal').modal('hide');
    this.disabled = false; lbl.style.display = 'inline'; spn.style.display = 'none';
    Swal.fire({ icon: 'error', text: 'Something went wrong.' });
  }
});

// ── Review / Approve Refund (event delegation) ────────────────────────
var _reviewTxId = null;
var _reviewRow  = null;

document.getElementById('tab-refunded').addEventListener('click', function (e) {
  var btn = e.target.closest('.review-refund-btn');
  if (!btn) return;
  _reviewTxId = btn.dataset.id;
  _reviewRow  = document.getElementById('refunded-row-' + btn.dataset.id);
  document.getElementById('reviewRefundUser').textContent        = btn.dataset.user;
  document.getElementById('reviewRefundAmount').textContent      = Number(btn.dataset.amount).toLocaleString();
  document.getElementById('reviewRefundRequestedBy').textContent = btn.dataset.requestedby;
  document.getElementById('reviewRefundReason').textContent      = btn.dataset.reason;
  $('#reviewRefundModal').modal('show');
});

document.getElementById('approveRefundBtn').addEventListener('click', async function () {
  var lbl = document.getElementById('approveBtnLabel');
  var spn = document.getElementById('approveBtnSpinner');
  this.disabled = true; lbl.style.display = 'none'; spn.style.display = 'inline';
  try {
    var data = await postAction('/admin/flagged-transactions/approve-refund', { transactionId: _reviewTxId });
    $('#reviewRefundModal').modal('hide');
    this.disabled = false; lbl.style.display = 'inline'; spn.style.display = 'none';
    if (data.success) {
      Swal.fire({ icon: 'success', title: 'Approved', text: data.message, timer: 2500, showConfirmButton: false });
      if (_reviewRow) {
        var statusCell = _reviewRow.querySelector('.refund-status-cell');
        if (statusCell) statusCell.innerHTML = '<span class="badge badge-success">Refunded</span>';
        var reviewBtnEl = _reviewRow.querySelector('.review-refund-btn');
        if (reviewBtnEl) reviewBtnEl.remove();
      }
    } else {
      Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
    }
  } catch (_) {
    $('#reviewRefundModal').modal('hide');
    this.disabled = false; lbl.style.display = 'inline'; spn.style.display = 'none';
    Swal.fire({ icon: 'error', text: 'Something went wrong.' });
  }
});

// ── Lazy tab loading ──────────────────────────────────────────────────
var _tabLoaded = { deducted: false, cleared: false, refunded: false };

function fmtDate(str) {
  if (!str) return '—';
  return new Date(str).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
}
function escHtml(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderDeductedRows(rows) {
  var tbody = document.getElementById('deducted-tbody');
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No manually deducted accounts yet.</td></tr>';
    return;
  }
  tbody.innerHTML = rows.map(function(tx) {
    var dUser   = tx.user ? tx.user.username : 'Unknown';
    var dEmail  = tx.user ? tx.user.email : '';
    var dAt     = fmtDate(tx.apiResponse && tx.apiResponse.adminDeductedAt);
    var bBefore = tx.apiResponse && tx.apiResponse.balanceBefore != null ? '₦' + Number(tx.apiResponse.balanceBefore).toLocaleString() : '—';
    var bAfter  = tx.apiResponse && tx.apiResponse.balanceAfter  != null ? '₦' + Number(tx.apiResponse.balanceAfter).toLocaleString()  : '—';
    return '<tr id="deducted-row-' + tx._id + '">' +
      '<td><small>' + dAt + '</small></td>' +
      '<td><strong>' + escHtml(dUser) + '</strong><br><small class="text-muted">' + escHtml(dEmail) + '</small></td>' +
      '<td><code>' + escHtml(tx.phone || '—') + '</code></td>' +
      '<td class="text-right"><strong>₦' + Number(tx.amount || 0).toLocaleString() + '</strong></td>' +
      '<td class="text-right">' + bBefore + '</td>' +
      '<td class="text-right">' + bAfter + '</td>' +
      '<td><button class="btn btn-sm btn-outline-warning refund-deduct-btn" data-id="' + tx._id + '" data-amount="' + (tx.amount||0) + '" data-user="' + escHtml(dUser) + '">Refund</button></td>' +
    '</tr>';
  }).join('');
}

function renderRefundedRows(rows, isSuperAdmin) {
  var tbody = document.getElementById('refunded-tbody');
  var actionTh = document.getElementById('refunded-action-th');
  if (isSuperAdmin) actionTh.style.display = '';
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No refunded entries yet.</td></tr>';
    return;
  }
  tbody.innerHTML = rows.map(function(tx) {
    var rUser         = tx.user ? tx.user.username : 'Unknown';
    var rEmail        = tx.user ? tx.user.email : '';
    var rDate         = fmtDate(tx.createdAt);
    var rReason       = (tx.apiResponse && tx.apiResponse.refundReason) || '—';
    var rRequestedBy  = (tx.apiResponse && tx.apiResponse.refundRequestedBy) || '—';
    var rApprovedBy   = (tx.apiResponse && tx.apiResponse.refundApprovedBy) || null;
    var isPending     = tx.apiResponse && tx.apiResponse.refundPending;
    var statusHtml    = isPending
      ? '<span class="badge badge-warning">Pending</span>'
      : '<span class="badge badge-success">Refunded</span>' + (rApprovedBy ? '<br><small class="text-muted">by ' + escHtml(rApprovedBy) + '</small>' : '');
    var actionHtml = '';
    if (isSuperAdmin && isPending) {
      actionHtml = '<button class="btn btn-sm btn-primary review-refund-btn"' +
        ' data-id="' + tx._id + '"' +
        ' data-user="' + escHtml(rUser) + '"' +
        ' data-amount="' + (tx.amount||0) + '"' +
        ' data-requestedby="' + escHtml(rRequestedBy) + '"' +
        ' data-reason="' + escHtml(rReason) + '">Review</button>';
    }
    return '<tr id="refunded-row-' + tx._id + '">' +
      '<td><small>' + rDate + '</small></td>' +
      '<td><strong>' + escHtml(rUser) + '</strong><br><small class="text-muted">' + escHtml(rEmail) + '</small></td>' +
      '<td><code>' + escHtml(tx.phone || '—') + '</code></td>' +
      '<td class="text-right"><strong>₦' + Number(tx.amount || 0).toLocaleString() + '</strong></td>' +
      '<td style="max-width:200px;word-break:break-word;font-size:13px;">' + escHtml(rReason) + '</td>' +
      '<td><small class="text-muted">' + escHtml(rRequestedBy) + '</small></td>' +
      '<td class="refund-status-cell">' + statusHtml + '</td>' +
      (isSuperAdmin ? '<td>' + actionHtml + '</td>' : '') +
    '</tr>';
  }).join('');
}

function renderClearedRows(rows) {
  var tbody = document.getElementById('cleared-tbody');
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No cleared transactions yet.</td></tr>';
    return;
  }
  tbody.innerHTML = rows.map(function(tx) {
    var cUser  = tx.user ? tx.user.username : 'Unknown';
    var cEmail = tx.user ? tx.user.email : '';
    var cAt    = fmtDate(tx.adminClearedAt);
    var txDate = fmtDate(tx.createdAt);
    var statusBadge = tx.status === 'pending'
      ? '<span class="badge badge-warning">Pending</span>'
      : tx.status === 'failed'
        ? '<span class="badge badge-danger">Failed</span>'
        : '<span class="badge badge-secondary">' + escHtml(tx.status) + '</span>';
    return '<tr>' +
      '<td><small>' + txDate + '</small></td>' +
      '<td><strong>' + escHtml(cUser) + '</strong><br><small class="text-muted">' + escHtml(cEmail) + '</small></td>' +
      '<td><code>' + escHtml(tx.phone || '—') + '</code></td>' +
      '<td class="text-right"><strong>₦' + Number(tx.amount || 0).toLocaleString() + '</strong></td>' +
      '<td>' + statusBadge + '</td>' +
      '<td><small class="text-muted">' + escHtml(tx.adminClearedBy || 'admin') + '</small></td>' +
      '<td><small>' + cAt + '</small></td>' +
    '</tr>';
  }).join('');
}

async function loadTab(tabName) {
  if (_tabLoaded[tabName]) return;
  _tabLoaded[tabName] = true;
  try {
    var res  = await fetch('/admin/flagged-transactions/tab-data?tab=' + tabName);
    var data = await res.json();
    if (tabName === 'deducted') {
      renderDeductedRows(data.rows || []);
      document.getElementById('deducted-badge').textContent = (data.rows || []).length;
    } else if (tabName === 'refunded') {
      renderRefundedRows(data.rows || [], data.isSuperAdmin);
      document.getElementById('refunded-badge').textContent = (data.rows || []).length;
    } else if (tabName === 'cleared') {
      renderClearedRows(data.rows || []);
      document.getElementById('cleared-badge').textContent = (data.rows || []).length;
    }
  } catch (err) {
    console.error('Failed to load tab:', tabName, err);
    var tbodyId = tabName + '-tbody';
    var el = document.getElementById(tbodyId);
    if (el) el.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Failed to load data. Please refresh.</td></tr>';
    _tabLoaded[tabName] = false; // allow retry
  }
}

$('#flaggedTabs a[data-lazy]').on('shown.bs.tab', function () {
  loadTab($(this).data('lazy'));
});
</script>
