<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1 kp-has-drawer">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <%
            var liveOf = function (list) { return list.filter(function (a) { return a.isActive; }).length; };
          %>

          <div class="kp-panel">

            <%
              var _navSections = [
                  { id: 'editor',  label: 'New / Edit', icon: 'edit-3' },
                  { id: 'banners', label: 'Banners',    icon: 'image',    badge: liveOf(banners) },
                  { id: 'strips',  label: 'Strips',     icon: 'minus',    badge: liveOf(strips) },
                  { id: 'popups',  label: 'Popups',     icon: 'square',   badge: liveOf(popups) }
                ];
            %>
            <div class="kp-panel__head">
              <h1 class="kp-panel__title">Announcements</h1>
              <p class="kp-panel__sub kp-panel__section-label"><%= _navSections[0].label %></p>
            </div>

            <div class="kp-panel__body">

              <%- include('partials/panelDrawer', {
                panelKey: 'announcements',
                drawerLabel: 'Announcements',
                sections: _navSections
              }) %>

              <div class="kp-panel__main">

                <!-- ══ Editor ════════════════════════════════════════════ -->
                <div class="kp-section" data-section="editor">
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title" id="editor-title">Add new announcement</h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill kp-pill--warn" id="editing-banner" style="display:none;"></span>
                      </div>
                    </div>

                    <div class="kp-card__body">
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Type</span>
                          <p class="kp-row__hint" id="type-help"></p>
                        </div>
                        <div class="kp-row__ctrl">
                          <select id="f-type" class="kp-select" onchange="onTypeChange()" style="min-width:150px;">
                            <option value="banner">Banner</option>
                            <option value="strip">Strip</option>
                            <option value="popup">Popup</option>
                          </select>
                        </div>
                      </div>

                      <!-- Strip: one line of text plus an optional countdown -->
                      <div id="grp-strip" hidden>
                        <div class="kp-row kp-row--stack">
                          <div class="kp-row__main"><span class="kp-row__label">Strip text</span></div>
                          <input type="text" id="f-text" class="kp-input" style="width:100%;"
                                 placeholder="This is a test strip and it will be here for {countdown}">
                          <p class="kp-row__hint" style="margin:0;">
                            Use <code>{countdown}</code> where the timer should appear.
                          </p>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Countdown ends</span>
                            <p class="kp-row__hint">Leave blank for no timer.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <input type="datetime-local" id="f-countdown" class="kp-input" style="min-width:220px;">
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Colours</span></div>
                          <div class="kp-row__ctrl">
                            <input type="color" id="f-bg" class="kp-input" value="#15a844" style="width:52px;padding:3px;">
                            <input type="color" id="f-fg" class="kp-input" value="#ffffff" style="width:52px;padding:3px;">
                          </div>
                        </div>
                      </div>

                      <!-- Banner and popup: title, text, image, call to action -->
                      <div id="grp-rich">
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Title</span></div>
                          <div class="kp-row__ctrl">
                            <input type="text" id="f-title" class="kp-input" style="min-width:260px;" placeholder="Data that goes further">
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Eyebrow</span>
                            <p class="kp-row__hint">Small label above the title.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <input type="text" id="f-eyebrow" class="kp-input" style="min-width:180px;" placeholder="New">
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Subtitle</span></div>
                          <div class="kp-row__ctrl">
                            <input type="text" id="f-subtitle" class="kp-input" style="min-width:260px;">
                          </div>
                        </div>
                        <div class="kp-row" id="grp-caption">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Caption</span>
                            <p class="kp-row__hint">Desktop only.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <input type="text" id="f-caption" class="kp-input" style="min-width:260px;">
                          </div>
                        </div>
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Button label</span>
                          <p class="kp-row__hint">Leave blank for no button.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <input type="text" id="f-ctalabel" class="kp-input" placeholder="Buy data">
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Button link</span>
                          <p class="kp-row__hint">Type a page name to search, or pick from the list.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <!-- A closed list, not free text: a public-facing button must not be
                               pointable at an admin route, an API endpoint, or a typo. The
                               server rejects anything that is not one of these paths, so the
                               datalist is the actual restriction, not just a convenience. -->
                          <input type="text" id="f-ctalink" class="kp-input" style="min-width:260px;"
                                 list="cta-link-options" placeholder="Search for a page…" autocomplete="off">
                          <datalist id="cta-link-options">
                            <% publicPages.forEach(function (pg) { %>
                            <option value="<%= pg.path %>"><%= pg.label %></option>
                            <% }) %>
                          </datalist>
                        </div>
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Image</span>
                          <p class="kp-row__hint">Upload a file, or give a path below.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <input type="file" id="f-image" accept="image/*" class="kp-input" style="padding:6px 10px;height:auto;">
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Image path</span></div>
                        <div class="kp-row__ctrl">
                          <input type="text" id="f-imageurl" class="kp-input" style="min-width:240px;" placeholder="/assets/images/new.PNG">
                        </div>
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Order</span>
                          <p class="kp-row__hint">Lower shows first.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <input type="number" id="f-order" class="kp-input kp-input--num" min="0" step="1" placeholder="0">
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Status</span></div>
                        <div class="kp-row__ctrl">
                          <select id="f-active" class="kp-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                          </select>
                        </div>
                      </div>
                    </div>

                    <div class="kp-card__foot">
                      <button class="kp-btn kp-btn--primary" id="save-btn" onclick="saveAnnouncement()">Create announcement</button>
                      <button class="kp-btn" id="preview-btn" onclick="openPreview()">Preview</button>
                      <button class="kp-btn" id="cancel-btn" onclick="resetForm()" style="display:none;">Cancel edit</button>
                    </div>
                  </div>
                </div>

                <!-- ══ Preview ═══════════════════════════════════════════
                     Shows the announcement as a user would actually see it —
                     the same three layouts main.ejs renders on the live site
                     (hero slide, header strip, sign-in popup) — built from
                     whatever is currently in the form, including an unsaved
                     image pick. -->
                <!-- A self-built overlay rather than Bootstrap's `.modal()`: that
                     plugin is not reliably available on this panel (the admin
                     bootstrap.min.js is 404ing — a pre-existing issue, unrelated
                     to this feature), so this stays correct either way. -->
                <div class="kp-preview-overlay" id="previewModal">
                  <div class="kp-preview-overlay__backdrop" onclick="closePreview()"></div>
                  <div class="kp-preview-overlay__box">
                    <div class="kp-preview-overlay__head">
                      <h5 style="font-size:15px;font-weight:700;margin:0;color:#1a1d21;">How this looks to a user</h5>
                      <button type="button" class="kp-preview-overlay__close" onclick="closePreview()" aria-label="Close">&times;</button>
                    </div>
                    <div class="kp-preview-overlay__body">
                      <div id="previewStage"></div>
                    </div>
                  </div>
                </div>

                <!-- ══ Lists ═════════════════════════════════════════════ -->
                <%
                  var lists = [
                    { key: 'banners', title: 'Hero banners', rows: banners,
                      note: 'Slides in the home page hero carousel.' },
                    { key: 'strips',  title: 'Header strips', rows: strips,
                      note: 'A thin bar under the header. Supports a countdown.' },
                    { key: 'popups',  title: 'Sign-in popups', rows: popups,
                      note: 'Shown once each time a user signs in.' }
                  ];
                %>
                <% lists.forEach(function (L) { %>
                <div class="kp-section" data-section="<%= L.key %>">
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title"><%= L.title %></h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill kp-pill--good"><%= liveOf(L.rows) %> active</span>
                        <span class="kp-pill"><%= L.rows.length %> total</span>
                      </div>
                    </div>
                    <div class="kp-card__body kp-card__body--pad" style="padding-bottom:0;">
                      <p class="kp-note"><%= L.note %></p>
                    </div>
                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table">
                          <thead>
                            <tr>
                              <% if (L.key === 'strips') { %>
                              <th>Text</th><th>Countdown</th>
                              <% } else { %>
                              <th style="width:70px;">Image</th><th>Title</th><th>Button</th>
                              <% } %>
                              <th class="kp-table__num">Order</th>
                              <th>Status</th>
                              <th class="kp-table__act">Actions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (!L.rows.length) { %>
                            <tr><td colspan="6"><div class="kp-empty">No <%= L.key %> yet.</div></td></tr>
                            <% } %>
                            <% L.rows.forEach(function (a) { %>
                            <tr data-id="<%= a._id %>">
                              <% if (L.key === 'strips') { %>
                              <td>
                                <span class="kp-strong"><%= (a.text || '').slice(0, 80) %></span>
                                <div class="kp-inline" style="margin-top:5px;">
                                  <span class="kp-pill" style="background:<%= a.background %>;color:<%= a.textColor %>;">colours</span>
                                </div>
                              </td>
                              <td>
                                <% if (a.countdownEndsAt) { %>
                                <span class="kp-mute" style="font-size:12.5px;"><%= new Date(a.countdownEndsAt).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) %></span>
                                <% } else { %><span class="kp-mute">—</span><% } %>
                              </td>
                              <% } else { %>
                              <td>
                                <img src="<%= a.image || '/assets/images/new.PNG' %>" alt=""
                                     style="width:52px;height:36px;object-fit:cover;border-radius:6px;border:1px solid #f0f1f3;">
                              </td>
                              <td>
                                <span class="kp-strong"><%= a.title %></span>
                                <% if (a.subtitle) { %><br><span class="kp-mute" style="font-size:12.5px;"><%= a.subtitle.slice(0, 70) %></span><% } %>
                              </td>
                              <td><span class="kp-mute" style="font-size:12.5px;"><%= a.ctaLabel || '—' %></span></td>
                              <% } %>
                              <td class="kp-table__num"><%= a.order %></td>
                              <td>
                                <span class="kp-pill <%= a.isActive ? 'kp-pill--good' : '' %>"><%= a.isActive ? 'Active' : 'Off' %></span>
                              </td>
                              <td class="kp-table__act">
                                <button class="kp-btn kp-btn--sm" onclick='editAnnouncement(<%- JSON.stringify(a) %>)'>Edit</button>
                                <button class="kp-btn kp-btn--sm" onclick="toggleAnnouncement('<%= a._id %>')"><%= a.isActive ? 'Disable' : 'Enable' %></button>
                                <button class="kp-btn kp-btn--sm kp-btn--danger" onclick="deleteAnnouncement('<%= a._id %>')">Delete</button>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
                <% }) %>

              </div><!-- /kp-panel__main -->
            </div><!-- /kp-panel__body -->
          </div><!-- /kp-panel -->

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/admin/assets/js/kbc-panel.js"></script>
<script>
var CSRF = '<%= csrfToken %>';
var editingId = null;

// Same list the server checks — lets a bad link be caught before the request
// even goes out, rather than only after a round trip.
var ALLOWED_LINKS = <%- JSON.stringify(publicPages.map(function (p) { return p.path; })) %>;

var TYPE_HELP = {
  banner: 'A slide in the home page hero carousel.',
  strip:  'A thin bar under the header. Supports a countdown.',
  popup:  'A card shown once each time a user signs in.',
};

// ── Show only the fields that matter for the selected type ───────────────────
function onTypeChange() {
  var type = document.getElementById('f-type').value;
  document.getElementById('type-help').textContent = TYPE_HELP[type];
  document.getElementById('grp-strip').hidden   = (type !== 'strip');
  document.getElementById('grp-rich').hidden    = (type === 'strip');
  document.getElementById('grp-caption').hidden = (type !== 'banner');
}

function val(id)      { return document.getElementById(id).value; }
function setVal(id,v) { document.getElementById(id).value = v == null ? '' : v; }

// Converts an ISO date into the value a datetime-local input expects
function toLocalInput(iso) {
  if (!iso) return '';
  var d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  var pad = function(n) { return String(n).padStart(2, '0'); };
  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
         'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
}

/* Bring the editor into view. The lists live in their own drawer sections, so
   clicking Edit has to switch section as well as fill the form — otherwise the
   form is populated somewhere the admin cannot see. */
function openEditorSection() {
  var btn = document.querySelector('.kp-drawer__item[data-target="editor"]');
  if (btn) btn.click();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function resetForm() {
  editingId = null;
  ['f-title','f-eyebrow','f-subtitle','f-caption','f-text','f-ctalabel','f-ctalink','f-imageurl','f-order','f-countdown']
    .forEach(function(id) { setVal(id, ''); });
  document.getElementById('f-image').value = '';
  setVal('f-bg', '#15a844');
  setVal('f-fg', '#ffffff');
  setVal('f-active', 'true');
  document.getElementById('f-type').disabled = false;
  document.getElementById('editor-title').textContent = 'Add new announcement';
  document.getElementById('save-btn').textContent = 'Create announcement';
  document.getElementById('cancel-btn').style.display = 'none';
  document.getElementById('editing-banner').style.display = 'none';
  onTypeChange();
}

function editAnnouncement(a) {
  editingId = a._id;
  setVal('f-type', a.type);
  // Type is fixed after creation — a strip cannot become a banner
  document.getElementById('f-type').disabled = true;
  onTypeChange();

  setVal('f-title', a.title);
  setVal('f-eyebrow', a.eyebrow);
  setVal('f-subtitle', a.subtitle);
  setVal('f-caption', a.caption);
  setVal('f-text', a.text);
  setVal('f-ctalabel', a.ctaLabel);
  setVal('f-ctalink', a.ctaLink);
  setVal('f-imageurl', a.image);
  setVal('f-order', a.order);
  setVal('f-bg', a.background || '#15a844');
  setVal('f-fg', a.textColor || '#ffffff');
  setVal('f-active', a.isActive ? 'true' : 'false');
  setVal('f-countdown', toLocalInput(a.countdownEndsAt));

  document.getElementById('editor-title').textContent = 'Edit announcement';
  document.getElementById('save-btn').textContent = 'Save changes';
  document.getElementById('cancel-btn').style.display = '';
  var banner = document.getElementById('editing-banner');
  banner.textContent = 'Editing: ' + (a.title || a.text || a.type);
  banner.style.display = '';

  openEditorSection();
}

async function saveAnnouncement() {
  var type = val('f-type');

  if (type === 'strip' && !val('f-text').trim()) {
    return Swal.fire({ icon: 'warning', text: 'Enter the strip text.', confirmButtonColor: '#15a844' });
  }
  if (type !== 'strip' && !val('f-title').trim()) {
    return Swal.fire({ icon: 'warning', text: 'Enter a title.', confirmButtonColor: '#15a844' });
  }
  var linkVal = val('f-ctalink').trim();
  if (linkVal && ALLOWED_LINKS.indexOf(linkVal) === -1) {
    return Swal.fire({
      icon: 'warning',
      text: 'That is not one of the listed pages. Pick one from the dropdown as you type.',
      confirmButtonColor: '#15a844',
    });
  }

  // FormData so the optional file upload rides along with the text fields
  var fd = new FormData();
  fd.append('type', type);
  fd.append('title', val('f-title'));
  fd.append('eyebrow', val('f-eyebrow'));
  fd.append('subtitle', val('f-subtitle'));
  fd.append('caption', val('f-caption'));
  fd.append('text', val('f-text'));
  fd.append('ctaLabel', val('f-ctalabel'));
  fd.append('ctaLink', val('f-ctalink'));
  fd.append('imageUrl', val('f-imageurl'));
  fd.append('order', val('f-order'));
  fd.append('background', val('f-bg'));
  fd.append('textColor', val('f-fg'));
  fd.append('isActive', val('f-active'));
  fd.append('countdownEndsAt', val('f-countdown'));

  var file = document.getElementById('f-image').files[0];
  if (file) fd.append('image', file);

  var url = editingId ? '/admin/announcements/' + editingId + '/update'
                      : '/admin/announcements/create';

  var btn = document.getElementById('save-btn');
  var label = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Saving…';

  try {
    var res  = await fetch(url, { method: 'POST', headers: { 'X-CSRF-Token': CSRF }, body: fd });
    var data = await res.json();

    if (data.success) {
      Swal.fire({ icon: 'success', text: data.message, toast: true, position: 'top', timer: 1600, showConfirmButton: false });
      setTimeout(function() { location.reload(); }, 900);
      return;
    }
    Swal.fire({ icon: 'error', text: data.message || 'Failed to save.', confirmButtonColor: '#15a844' });
  } catch (e) {
    Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#15a844' });
  }

  btn.disabled = false;
  btn.textContent = label;
}

async function toggleAnnouncement(id) {
  try {
    var res  = await fetch('/admin/announcements/' + id + '/toggle', {
      method: 'POST', headers: { 'X-CSRF-Token': CSRF },
    });
    var data = await res.json();
    if (data.success) location.reload();
    else Swal.fire({ icon: 'error', text: data.message, confirmButtonColor: '#15a844' });
  } catch (e) {
    Swal.fire({ icon: 'error', text: 'Server error.', confirmButtonColor: '#15a844' });
  }
}

async function deleteAnnouncement(id) {
  var confirmed = await Swal.fire({
    icon: 'warning', title: 'Delete this announcement?',
    text: 'This cannot be undone.',
    showCancelButton: true, confirmButtonText: 'Delete',
    confirmButtonColor: '#d1453b',
  });
  if (!confirmed.isConfirmed) return;

  try {
    var res  = await fetch('/admin/announcements/' + id + '/delete', {
      method: 'POST', headers: { 'X-CSRF-Token': CSRF },
    });
    var data = await res.json();
    if (data.success) location.reload();
    else Swal.fire({ icon: 'error', text: data.message, confirmButtonColor: '#15a844' });
  } catch (e) {
    Swal.fire({ icon: 'error', text: 'Server error.', confirmButtonColor: '#15a844' });
  }
}

onTypeChange();

/* ── Preview ────────────────────────────────────────────────────────────────
   Mirrors the three renderers in views/layouts/main.ejs closely enough to be
   a faithful preview, without pulling in the public stylesheet — this is an
   admin page, and importing the whole site theme here risks it bleeding into
   the rest of the panel. Rebuilt from the live form values every time it is
   shown, and again on every keystroke while it is open, so "preview" always
   means the announcement as it is configured right now. */
function escP(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// An uploaded-but-unsaved file previews from the browser's own copy of it;
// otherwise fall back to the pasted path, exactly the precedence the server
// uses once the form is actually submitted.
function previewImageSrc() {
  var file = document.getElementById('f-image').files[0];
  if (file) return URL.createObjectURL(file);
  var url = val('f-imageurl').trim();
  return url || '';
}

function previewStrip() {
  var text = val('f-text').trim() || 'Your strip text appears here';
  text = text.replace('{countdown}', '02:15:33');
  var bg = val('f-bg') || '#15a844';
  var fg = val('f-fg') || '#ffffff';
  return ''
    + '<div style="width:380px;max-width:86vw;border-radius:10px;overflow:hidden;box-shadow:0 6px 22px rgba(0,0,0,.16);">'
    +   '<div style="background:#1a1a2e;color:#fff;padding:10px 14px;font-size:12px;font-weight:800;text-align:center;letter-spacing:.02em;">Kabacu</div>'
    +   '<div style="background:' + bg + ';color:' + fg + ';padding:11px 16px;font-size:13px;font-weight:700;text-align:center;">' + escP(text) + '</div>'
    +   '<div style="background:#fff;padding:44px 16px;text-align:center;color:#9aa0a6;font-size:12px;">— page content —</div>'
    + '</div>';
}

function previewPopup() {
  var img = previewImageSrc();
  var eyebrow = val('f-eyebrow').trim();
  var title = val('f-title').trim() || 'Announcement title';
  var subtitle = val('f-subtitle').trim();
  var ctaLabel = val('f-ctalabel').trim();
  return ''
    + '<div style="width:340px;max-width:88vw;background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,.28);">'
    +   (img
          ? '<div style="background:#f0f0f0;padding:22px 20px;text-align:center;"><img src="' + img + '" style="max-width:100%;max-height:120px;" alt=""></div>'
          : '')
    +   '<div style="padding:18px 20px 22px;text-align:center;">'
    +     (eyebrow ? '<span style="display:block;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#15a844;margin-bottom:6px;">' + escP(eyebrow) + '</span>' : '')
    +     '<h3 style="font-size:17px;font-weight:800;margin:0 0 8px;color:#1a1a2e;">' + escP(title) + '</h3>'
    +     (subtitle ? '<p style="font-size:13px;color:#666;line-height:1.6;margin:0;">' + escP(subtitle) + '</p>' : '')
    +     (ctaLabel ? '<span style="display:inline-block;margin-top:16px;padding:10px 22px;border-radius:9999px;background:#15a844;color:#fff;font-size:13px;font-weight:700;">' + escP(ctaLabel) + '</span>' : '')
    +   '</div>'
    + '</div>';
}

function previewBanner() {
  var img = previewImageSrc();
  var eyebrow = val('f-eyebrow').trim();
  var title = val('f-title').trim() || 'Announcement title';
  var subtitle = val('f-subtitle').trim();
  var ctaLabel = val('f-ctalabel').trim();
  return ''
    + '<div style="width:520px;max-width:92vw;aspect-ratio:16/8;border-radius:14px;overflow:hidden;position:relative;'
    +   'background:#155e34' + (img ? ';background-image:linear-gradient(90deg,rgba(21,94,52,.88),rgba(21,94,52,.35)),url(' + img + ');background-size:cover;background-position:center' : '') + ';">'
    +   '<div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:0 28px;color:#fff;max-width:70%;">'
    +     (eyebrow ? '<span style="font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;opacity:.85;margin-bottom:6px;">' + escP(eyebrow) + '</span>' : '')
    +     '<h3 style="font-size:19px;font-weight:800;margin:0 0 6px;line-height:1.25;">' + escP(title) + '</h3>'
    +     (subtitle ? '<p style="font-size:13px;opacity:.9;margin:0 0 12px;">' + escP(subtitle) + '</p>' : '')
    +     (ctaLabel ? '<span style="align-self:flex-start;padding:8px 18px;border-radius:9999px;background:#fff;color:#155e34;font-size:12.5px;font-weight:700;">' + escP(ctaLabel) + '</span>' : '')
    +   '</div>'
    + '</div>';
}

function renderPreview() {
  var type = val('f-type');
  var stage = document.getElementById('previewStage');
  if (!stage) return;
  stage.innerHTML = type === 'strip' ? previewStrip() : (type === 'popup' ? previewPopup() : previewBanner());
}

function openPreview() {
  renderPreview();
  document.getElementById('previewModal').classList.add('is-open');
  document.body.style.overflow = 'hidden';
}

function closePreview() {
  document.getElementById('previewModal').classList.remove('is-open');
  document.body.style.overflow = '';
}

document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape' && document.getElementById('previewModal').classList.contains('is-open')) closePreview();
});

/* Keeps the preview honest while it is open — the point of a live preview is
   that it reflects the field the admin is actually typing into right now.
   Delegated on the document rather than bound to each field individually: the
   editor form is outside the modal, and listening there (rather than on the
   modal body, which holds only the rendered output) is what actually catches
   the edits. Guarded on the modal being visible so this does no work on every
   other page interaction. */
var PREVIEW_FIELD_IDS = [
  'f-type', 'f-title', 'f-eyebrow', 'f-subtitle', 'f-text',
  'f-ctalabel', 'f-imageurl', 'f-bg', 'f-fg',
];
document.addEventListener('input', function (e) {
  if (!e.target || PREVIEW_FIELD_IDS.indexOf(e.target.id) === -1) return;
  if (document.getElementById('previewModal').classList.contains('is-open')) renderPreview();
});
document.getElementById('f-image').addEventListener('change', function () {
  if (document.getElementById('previewModal').classList.contains('is-open')) renderPreview();
});
</script>
