
  <div class="loader"></div>
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../../partials/headerAdmin.ejs')%>
      <%- include('../../partials/sideMenuAdmin.ejs')%>

      <div class="main-content">
        <section class="section">
          <div class="section-body">
            <div class="row">
              <div class="col-12 col-lg-10 mx-auto">
                <div class="card">
                  <div class="card-header">
                    <h4>Add Product</h4>
                  </div>
                  <div class="card-body">

                    <% if (typeof query !== 'undefined' && query.success == '1') { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                      Product added successfully.
                      <button type="button" class="close" data-dismiss="alert">&times;</button>
                    </div>
                    <% } %>

                    <form method="post" action="/admin/product/add-product?_csrf=<%= csrfToken %>" enctype="multipart/form-data">

                      <!-- Category -->
                      <div class="form-group">
                        <label>Category</label>
                        <select class="form-control" name="category" id="categorySelect" required>
                          <option value="" disabled selected>Select Category</option>
                          <% category.forEach(function(cat){ %>
                            <option value="<%= cat.category_name %>"><%= cat.category_name %></option>
                          <% }) %>
                        </select>
                      </div>

                      <!-- Market — signed-in users only see products for their own country -->
                      <div class="form-group">
                        <label>Country</label>
                        <select class="form-control" name="country" required>
                          <% countryList.forEach(function(c){ %>
                          <option value="<%= c.code %>" <%= c.code === 'NG' ? 'selected' : '' %>><%= c.name %></option>
                          <% }) %>
                        </select>
                        <small class="text-muted">
                          Only users whose profile country matches will see this product.
                          Signed-out visitors can browse any market.
                        </small>
                      </div>

                      <!-- DATA fields -->
                      <div id="dataFields" style="display:none;">
                        <div class="form-group">
                          <label>Data Service Provider <span class="text-danger">*</span></label>
                          <select name="provider" id="dataProviderSelect" class="form-control" required>
                            <option value="ODS">OurDataStore (ODS)</option>
                            <option value="GSUBZ">GSubz</option>
                          </select>
                          <small class="text-muted">Which provider actually fulfils this bundle.</small>
                        </div>

                        <div id="odsPlanGroup">
                          <div class="form-group">
                            <label>Select Plan <span class="text-danger">*</span></label>
                            <select name="network" id="odsNetworkSelect" class="form-control" required>
                              <option value="" disabled selected>Select plan…</option>
                              <% if (typeof networks !== 'undefined') { networks.forEach(n => { %>
                              <option value="<%= n.name %>"><%= n.name %></option>
                              <% }) } %>
                            </select>
                            <small class="text-muted">
                              The plan carries its own network, so that isn't entered here.
                              Plan not listed? <a href="/admin/networks" target="_blank">Manage Data Plans</a>
                            </small>
                          </div>
                          <div class="form-group">
                            <label>Bundle ID <span class="text-danger">*</span></label>
                            <input type="number" name="plan_id" id="odsPlanIdInput" class="form-control" placeholder="e.g. 244" min="0" required>
                            <small class="text-muted">
                              The provider's id for <em>this exact size</em>. It cannot come from the
                              plan — every size under a plan has its own id (1GB, 2GB and 15GB on the
                              same plan are all different), and a wrong id delivers the wrong bundle.
                            </small>
                          </div>
                        </div>

                        <div id="gsubzPlanGroup" style="display:none;">
                          <div class="form-group">
                            <label>Select Plan <span class="text-danger">*</span></label>
                            <select name="network" id="gsubzNetworkSelect" class="form-control">
                              <option value="" disabled selected>Select plan…</option>
                              <% if (typeof gsubzPlans !== 'undefined') { gsubzPlans.forEach(function (p) { %>
                              <option value="<%= p.name %>"><%= p.name %> (<%= p.carrier %> · <%= p.category %>)</option>
                              <% }) } %>
                            </select>
                            <small class="text-muted">
                              Plan not listed? <a href="/admin/networks#gsubz" target="_blank">Manage GSubz Plans</a>
                            </small>
                          </div>
                          <div class="form-group">
                            <label>Plan Code <span class="text-danger">*</span></label>
                            <input type="text" name="gsubz_plan_code" id="gsubzPlanCodeInput" class="form-control" placeholder="GSubz's plan value for this exact size">
                            <small class="text-muted">
                              GSubz's own code for <em>this exact bundle size</em> — look it up under the
                              chosen plan's category on GSubz's own plan list.
                            </small>
                          </div>
                        </div>

                        <div class="form-group">
                          <label>Plan Type <span class="text-danger">*</span></label>
                          <input type="text" name="plan_type" class="form-control" placeholder="e.g. 2GB Data Plan">
                        </div>
                        <div class="form-group">
                          <label>Validity Period <span class="text-danger">*</span></label>
                          <input type="text" name="validate_period" class="form-control" placeholder="e.g. 1 Week Validity">
                        </div>
                        <div class="form-group">
                          <label>Price <span class="text-danger">*</span></label>
                          <input type="number" name="amount" class="form-control" placeholder="e.g. 300" min="0" step="any">
                        </div>
                        <div class="form-group">
                          <label>Old Price <small class="text-muted">(optional)</small></label>
                          <input type="number" name="oldPrice" class="form-control" placeholder="e.g. 600" min="0" step="any">
                          <small class="text-muted">
                            Shown struck through beside the price. When set, the card also shows the
                            difference as a cashback badge — that figure is displayed only, nothing
                            is credited.
                          </small>
                        </div>
                        <div class="form-group">
                          <label>Bonus <small class="text-muted">(optional)</small></label>
                          <input type="text" name="bonus" class="form-control" placeholder="e.g. 2GB YouTube">
                        </div>
                      </div>

                      <!-- AUTOMOBILE fields -->
                      <div id="automobileFields" style="display:none;">
                        <div class="form-group">
                          <label>Brand</label>
                          <input type="text" name="brand" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Model</label>
                          <input type="text" name="model" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Year</label>
                          <input type="number" name="year" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Fuel Type</label>
                          <input type="text" name="fuel_type" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Transmission</label>
                          <input type="text" name="transmission" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Condition</label>
                          <select name="condition" class="form-control">
                            <option value="new">New</option>
                            <option value="used">Used</option>
                          </select>
                        </div>
                        <div class="form-group">
                          <label>Price</label>
                          <input type="number" name="auto_price" class="form-control">
                        </div>
                      </div>

                      <!-- ELECTRONICS fields -->
                      <div id="electronicsFields" style="display:none;">
                        <div class="form-group">
                          <label>Name</label>
                          <input type="text" name="itemName" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Brand</label>
                          <input type="text" name="brandItem" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Type</label>
                          <input type="text" name="itemtype" class="form-control">
                        </div>
                        <div class="form-group">
                          <label>Price</label>
                          <input type="number" name="items_price" class="form-control">
                        </div>
                      </div>

                      <!-- Common fields -->
                      <div class="form-group">
                        <label>Cost Price (₦) <small class="text-muted">— for internal profit tracking only</small></label>
                        <input type="number" name="costPrice" class="form-control" min="0" step="0.01" placeholder="0.00">
                      </div>
                      <div class="form-group">
                        <label>RP</label>
                        <input type="number" name="reward_point" class="form-control">
                      </div>

                      <div class="form-group">
                        <label>Description</label>
                        <textarea name="description" class="form-control" placeholder="Enter product description..."></textarea>
                      </div>

                      <div class="form-group">
                        <label>Upload Images (Max 3)</label>
                        <input type="file" id="imageInput" name="images" multiple accept="image/*" class="form-control">
                      </div>

                      <div id="imagePreview" style="display:flex; gap:10px; margin-top:10px;"></div>

                      <div class="card-footer text-right">
                        <button class="btn btn-primary mr-1" type="button" id="addProductBtn">Submit</button>
                      </div>
                    </form>

                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="settingSidebar">
          <a href="javascript:void(0)" class="settingPanelToggle"><i class="fa fa-spin fa-cog"></i></a>
          <div class="settingSidebar-body ps-container ps-theme-default">
            <div class="fade show active">
              <div class="setting-panel-header">Setting Panel</div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Select Layout</h6>
                <div class="selectgroup layout-color w-50">
                  <label class="selectgroup-item">
                    <input type="radio" name="value" value="1" class="selectgroup-input-radio select-layout" checked>
                    <span class="selectgroup-button">Light</span>
                  </label>
                  <label class="selectgroup-item">
                    <input type="radio" name="value" value="2" class="selectgroup-input-radio select-layout">
                    <span class="selectgroup-button">Dark</span>
                  </label>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Sidebar Color</h6>
                <div class="selectgroup selectgroup-pills sidebar-color">
                  <label class="selectgroup-item">
                    <input type="radio" name="icon-input" value="1" class="selectgroup-input select-sidebar">
                    <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip" data-original-title="Light Sidebar"><i class="fas fa-sun"></i></span>
                  </label>
                  <label class="selectgroup-item">
                    <input type="radio" name="icon-input" value="2" class="selectgroup-input select-sidebar" checked>
                    <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip" data-original-title="Dark Sidebar"><i class="fas fa-moon"></i></span>
                  </label>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Color Theme</h6>
                <div class="theme-setting-options">
                  <ul class="choose-theme list-unstyled mb-0">
                    <li title="white" class="active"><div class="white"></div></li>
                    <li title="cyan"><div class="cyan"></div></li>
                    <li title="black"><div class="black"></div></li>
                    <li title="purple"><div class="purple"></div></li>
                    <li title="orange"><div class="orange"></div></li>
                    <li title="green"><div class="green"></div></li>
                    <li title="red"><div class="red"></div></li>
                  </ul>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <div class="theme-setting-options">
                  <label class="m-b-0">
                    <input type="checkbox" name="custom-switch-checkbox" class="custom-switch-input" id="mini_sidebar_setting">
                    <span class="custom-switch-indicator"></span>
                    <span class="control-label p-l-10">Mini Sidebar</span>
                  </label>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <div class="theme-setting-options">
                  <label class="m-b-0">
                    <input type="checkbox" name="custom-switch-checkbox" class="custom-switch-input" id="sticky_header_setting">
                    <span class="custom-switch-indicator"></span>
                    <span class="control-label p-l-10">Sticky Header</span>
                  </label>
                </div>
              </div>
              <div class="mt-4 mb-4 p-3 align-center rt-sidebar-last-ele">
                <a href="#" class="btn btn-icon icon-left btn-primary btn-restore-theme">
                  <i class="fas fa-undo"></i> Restore Default
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <footer class="main-footer">
        <div class="footer-left">&copy; <%= new Date().getFullYear() %> Kabacu. All rights reserved.</div>
        <div class="footer-right"></div>
      </footer>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
  var categorySelect = document.getElementById('categorySelect');
  var dataFields        = document.getElementById('dataFields');
  var automobileFields  = document.getElementById('automobileFields');
  var electronicsFields = document.getElementById('electronicsFields');

  function hideAllFields() {
    dataFields.style.display       = 'none';
    automobileFields.style.display = 'none';
    electronicsFields.style.display = 'none';
  }

  categorySelect.addEventListener('change', function () {
    hideAllFields();
    if (this.value === 'DATA')        dataFields.style.display        = 'block';
    else if (this.value === 'AUTOMOBILE') automobileFields.style.display  = 'block';
    else if (this.value === 'ELECTRONICS') electronicsFields.style.display = 'block';
  });

  // DATA: provider toggle — only the group matching the chosen provider is
  // enabled, so its "network" field is the only one actually submitted (a
  // disabled field is left out of form submission entirely; a merely-hidden
  // one is not).
  var providerSelect     = document.getElementById('dataProviderSelect');
  var odsPlanGroup        = document.getElementById('odsPlanGroup');
  var gsubzPlanGroup      = document.getElementById('gsubzPlanGroup');
  var odsNetworkSelect    = document.getElementById('odsNetworkSelect');
  var odsPlanIdInput      = document.getElementById('odsPlanIdInput');
  var gsubzNetworkSelect  = document.getElementById('gsubzNetworkSelect');
  var gsubzPlanCodeInput  = document.getElementById('gsubzPlanCodeInput');

  function onProviderChange() {
    var isGsubz = providerSelect.value === 'GSUBZ';
    odsPlanGroup.style.display   = isGsubz ? 'none' : 'block';
    gsubzPlanGroup.style.display = isGsubz ? 'block' : 'none';

    odsNetworkSelect.disabled = isGsubz;
    odsNetworkSelect.required = !isGsubz;
    odsPlanIdInput.disabled   = isGsubz;
    odsPlanIdInput.required   = !isGsubz;

    gsubzNetworkSelect.disabled = !isGsubz;
    gsubzNetworkSelect.required = isGsubz;
    gsubzPlanCodeInput.disabled = !isGsubz;
    gsubzPlanCodeInput.required = isGsubz;
  }
  providerSelect.addEventListener('change', onProviderChange);
  onProviderChange();

  var imageInput      = document.getElementById('imageInput');
  var previewContainer = document.getElementById('imagePreview');

  imageInput.addEventListener('change', function () {
    previewContainer.innerHTML = '';
    var files = Array.from(this.files);
    if (files.length > 3) {
      alert('You can only upload a maximum of 3 images.');
      this.value = '';
      return;
    }
    files.forEach(function (file) {
      var reader = new FileReader();
      reader.onload = function (e) {
        var img = document.createElement('img');
        img.src = e.target.result;
        img.style.cssText = 'width:100px;height:100px;object-fit:cover;border-radius:6px;';
        previewContainer.appendChild(img);
      };
      reader.readAsDataURL(file);
    });
  });

  document.getElementById('addProductBtn').addEventListener('click', function() {
    var cat = categorySelect.value;
    if (!cat) {
      Swal.fire({ icon: 'warning', title: 'Required', text: 'Please select a category.' });
      return;
    }
    Swal.fire({
      title: 'Add Product?',
      text: 'Are you sure you want to add this product?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonText: 'Yes, Add It',
      confirmButtonColor: '#47c363',
      cancelButtonText: 'Cancel',
    }).then(function(result) {
      if (result.isConfirmed) {
        document.querySelector('form').submit();
      }
    });
  });
  </script>
