
  <div class="loader"></div>
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../partials/headerAdmin.ejs') %>
      <%- include('../partials/sideMenuAdmin.ejs') %>

      <div class="main-content">
        <section class="section">
          <div class="section-header">
            <h1>My Profile</h1>
            <div class="section-header-breadcrumb">
              <div class="breadcrumb-item"><a href="/admin/main/dashboard">Dashboard</a></div>
              <div class="breadcrumb-item active">My Profile</div>
            </div>
          </div>

          <div class="section-body">

            <% if (firstLogin) { %>
            <div class="alert alert-warning mb-4" style="font-size:14px;">
              <strong><i data-feather="alert-circle" style="width:15px;height:15px;margin-right:4px;vertical-align:middle;"></i> Welcome!</strong>
              Please complete your profile before accessing the dashboard. Fill in the details below and click <strong>Save Profile</strong>.
            </div>
            <% } %>

            <% if (typeof query !== 'undefined' && query.saved == '1') { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              Profile saved successfully.
              <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
            <% } %>

            <% if (typeof query !== 'undefined' && query.error == '1') { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              Something went wrong. Please try again.
              <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
            <% } %>

            <div class="row">
              <div class="col-12 col-lg-8 mx-auto">

                <!-- Account info (read-only) -->
                <div class="card mb-4">
                  <div class="card-header">
                    <h4>Account Information</h4>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col-md-2 text-center mb-3 mb-md-0">
                        <div style="width:64px;height:64px;border-radius:50%;background:#47c363;display:flex;align-items:center;justify-content:center;color:#fff;font-size:26px;font-weight:700;margin:0 auto;">
                          <%= admin && admin.username ? admin.username.charAt(0).toUpperCase() : 'A' %>
                        </div>
                      </div>
                      <div class="col-md-10">
                        <table class="table table-sm mb-0" style="font-size:14px;">
                          <tr>
                            <td style="width:120px;color:#6b7280;font-weight:500;">Name</td>
                            <td><strong><%= admin ? admin.username : '—' %></strong></td>
                          </tr>
                          <tr>
                            <td style="color:#6b7280;font-weight:500;">Email</td>
                            <td><%= admin ? admin.email : '—' %></td>
                          </tr>
                          <tr>
                            <td style="color:#6b7280;font-weight:500;">Role</td>
                            <td>
                              <% const roleColors = { super_admin: 'badge-danger', senior_admin: 'badge-warning', junior_admin: 'badge-info' }; %>
                              <span class="badge <%= admin ? (roleColors[admin.role] || 'badge-secondary') : 'badge-secondary' %>" style="font-size:11px;padding:4px 8px;">
                                <%= admin ? admin.role.replace(/_/g, ' ') : '—' %>
                              </span>
                            </td>
                          </tr>
                          <tr>
                            <td style="color:#6b7280;font-weight:500;">Joined</td>
                            <td style="font-size:12px;color:#6b7280;">
                              <%= admin && admin.createdAt ? new Date(admin.createdAt).toLocaleDateString('en-GB', { day:'2-digit', month:'long', year:'numeric' }) : '—' %>
                            </td>
                          </tr>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Security: two-factor verification -->
                <div class="card">
                  <div class="card-header">
                    <h4>Security</h4>
                  </div>
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                      <div style="max-width:520px;">
                        <h6 class="mb-1" style="font-size:14px;font-weight:700;">Two-factor verification</h6>
                        <p class="text-muted mb-0" style="font-size:13px;line-height:1.7;">
                          When on, signing in also requires a 6-digit code emailed to
                          <strong><%= admin.email %></strong>. Turning it off means your password
                          alone will sign you in.
                        </p>
                        <% if (admin.twoFactorEnabled === false && admin.twoFactorDisabledBy) { %>
                        <p class="mb-0 mt-2" style="font-size:12px;color:#9a3412;">
                          Currently off — disabled by <strong><%= admin.twoFactorDisabledBy %></strong>
                          <% if (admin.twoFactorDisabledAt) { %>
                            on <%= new Date(admin.twoFactorDisabledAt).toLocaleString('en-GB') %>
                          <% } %>
                          <% if (admin.twoFactorDisabledReason) { %>
                            — <%= admin.twoFactorDisabledReason %>
                          <% } %>
                        </p>
                        <% } %>
                      </div>
                      <div class="mt-3 mt-md-0 text-md-right">
                        <span class="badge <%= admin.twoFactorEnabled === false ? 'badge-warning' : 'badge-success' %>"
                              id="twofa-badge" style="font-size:12px;padding:6px 12px;">
                          <%= admin.twoFactorEnabled === false ? 'Off' : 'On' %>
                        </span>
                        <br>
                        <button type="button"
                                class="btn btn-sm mt-2 <%= admin.twoFactorEnabled === false ? 'btn-primary' : 'btn-outline-danger' %>"
                                id="twofa-toggle"
                                data-enabled="<%= admin.twoFactorEnabled === false ? 'false' : 'true' %>">
                          <%= admin.twoFactorEnabled === false ? 'Turn on' : 'Turn off' %>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Editable profile -->
                <div class="card">
                  <div class="card-header">
                    <h4>Profile Details</h4>
                  </div>
                  <div class="card-body">
                    <form method="post" action="/admin/profile">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="firstLogin" value="<%= firstLogin ? '1' : '' %>">

                      <div class="form-group">
                        <label>Phone Number</label>
                        <input type="text" name="phone" class="form-control"
                          placeholder="+234 800 000 0000"
                          value="<%= admin && admin.phone ? admin.phone : '' %>">
                      </div>

                      <div class="form-group">
                        <label>Department</label>
                        <input type="text" name="department" class="form-control"
                          placeholder="e.g. Operations, Finance, Technology"
                          value="<%= admin && admin.department ? admin.department : '' %>">
                      </div>

                      <div class="form-group">
                        <label>Bio</label>
                        <textarea name="bio" class="form-control" rows="3"
                          placeholder="A brief description about yourself…"><%= admin && admin.bio ? admin.bio : '' %></textarea>
                      </div>

                      <div class="card-footer text-right px-0 pb-0 mt-2" style="border-top:none;">
                        <% if (!firstLogin) { %>
                        <a href="/admin/main/dashboard" class="btn btn-secondary mr-2">Cancel</a>
                        <% } %>
                        <button type="submit" class="btn btn-primary">Save Profile</button>
                      </div>
                    </form>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </section>
      </div>

      <footer class="main-footer">
        <div class="footer-left">
          &copy; <%= new Date().getFullYear() %> Kabacu. All rights reserved.
        </div>
        <div class="footer-right"></div>
      </footer>
    </div>
  </div>

<script>
// ── Two-factor self-toggle ────────────────────────────────────────────
(function () {
  var btn = document.getElementById('twofa-toggle');
  if (!btn) return;

  btn.addEventListener('click', async function () {
    var currentlyOn = this.dataset.enabled === 'true';
    var turningOff  = currentlyOn;

    var ask = await Swal.fire({
      icon: turningOff ? 'warning' : 'question',
      title: turningOff ? 'Turn off two-factor?' : 'Turn on two-factor?',
      text: turningOff
        ? 'Your password alone will sign you in. Only do this if you cannot receive the emailed code.'
        : 'You will be asked for a 6-digit emailed code at every login.',
      input: turningOff ? 'text' : undefined,
      inputLabel: turningOff ? 'Reason (optional, recorded for audit)' : undefined,
      showCancelButton: true,
      confirmButtonText: turningOff ? 'Turn off' : 'Turn on',
      confirmButtonColor: turningOff ? '#dc3545' : '#6777ef',
    });
    if (!ask.isConfirmed) return;

    btn.disabled = true;
    try {
      var res = await fetch('/admin/profile/two-factor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ enabled: !currentlyOn, reason: ask.value || '' }),
      });
      var data = await res.json();
      if (data.success) {
        Swal.fire({ icon: 'success', text: data.message, confirmButtonColor: '#6777ef' })
          .then(function () { location.reload(); });
        return;
      }
      Swal.fire({ icon: 'error', text: data.message, confirmButtonColor: '#6777ef' });
    } catch (e) {
      Swal.fire({ icon: 'error', text: 'Request failed. Please try again.', confirmButtonColor: '#6777ef' });
    }
    btn.disabled = false;
  });
})();
</script>
