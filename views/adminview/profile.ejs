<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1 kp-has-drawer">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <%
            var roleColors = {
              super_admin: 'kp-pill--danger',
              senior_admin: 'kp-pill--warn',
              junior_admin: 'kp-pill--info',
            };
            var twoFaOn = admin && admin.twoFactorEnabled !== false;
          %>

          <div class="kp-panel">

            <%
              var _navSections = [
                  { id: 'profile',  label: 'Profile',  icon: 'user' },
                  { id: 'security', label: 'Security', icon: 'shield', badge: twoFaOn ? 0 : 1 }
                ];
            %>
            <div class="kp-panel__head">
              <h1 class="kp-panel__title">My Profile</h1>
              <p class="kp-panel__sub kp-panel__section-label"><%= _navSections[0].label %></p>
            </div>

            <% if (firstLogin) { %>
            <p class="kp-note kp-note--warn" style="max-width:760px;">
              <strong>Welcome.</strong> Fill in your details below to finish setting up your account.
            </p>
            <% } %>
            <% if (typeof query !== 'undefined' && query && query.saved) { %>
            <p class="kp-note" style="max-width:760px;">Your profile has been saved.</p>
            <% } %>
            <% if (typeof query !== 'undefined' && query && query.error) { %>
            <p class="kp-note kp-note--danger" style="max-width:760px;">
              We could not save your profile. Please try again.
            </p>
            <% } %>

            <div class="kp-panel__body">

              <%- include('partials/panelDrawer', {
                panelKey: 'adminprofile',
                drawerLabel: 'My Profile',
                sections: _navSections
              }) %>

              <div class="kp-panel__main">

                <!-- ══ Profile ═══════════════════════════════════════════ -->
                <div class="kp-section" data-section="profile">

                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Account information</h2></div>
                    <div class="kp-card__body kp-card__body--pad">
                      <div style="display:flex;align-items:center;gap:16px;margin-bottom:6px;">
                        <div style="width:56px;height:56px;border-radius:50%;background:var(--kp-accent);display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;font-weight:700;flex-shrink:0;">
                          <%= admin && admin.username ? admin.username.charAt(0).toUpperCase() : 'A' %>
                        </div>
                        <div style="min-width:0;">
                          <div style="font-size:16px;font-weight:600;color:var(--kp-text);"><%= admin ? admin.username : '—' %></div>
                          <div class="kp-mute" style="font-size:13px;"><%= admin ? admin.email : '—' %></div>
                        </div>
                      </div>
                    </div>
                    <div class="kp-card__body">
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Role</span></div>
                        <div class="kp-row__ctrl">
                          <span class="kp-pill <%= admin ? (roleColors[admin.role] || '') : '' %>">
                            <%= admin ? admin.role.replace(/_/g, ' ') : '—' %>
                          </span>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Email</span>
                          <p class="kp-row__hint">Contact a super admin to change this.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <span class="kp-row__value"><%= admin ? admin.email : '—' %></span>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Joined</span></div>
                        <div class="kp-row__ctrl">
                          <span class="kp-row__value">
                            <%= admin && admin.createdAt ? new Date(admin.createdAt).toLocaleDateString('en-GB', { day:'2-digit', month:'long', year:'numeric' }) : '—' %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Your details</h2></div>
                    <form method="post" action="/admin/profile">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="firstLogin" value="<%= firstLogin ? '1' : '' %>">

                      <div class="kp-card__body">
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Phone number</span></div>
                          <div class="kp-row__ctrl">
                            <input type="text" name="phone" class="kp-input" style="min-width:220px;"
                                   placeholder="+234 800 000 0000"
                                   value="<%= admin && admin.phone ? admin.phone : '' %>">
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Department</span></div>
                          <div class="kp-row__ctrl">
                            <input type="text" name="department" class="kp-input" style="min-width:220px;"
                                   placeholder="Operations"
                                   value="<%= admin && admin.department ? admin.department : '' %>">
                          </div>
                        </div>
                        <div class="kp-row kp-row--stack">
                          <div class="kp-row__main"><span class="kp-row__label">Bio</span></div>
                          <textarea name="bio" class="kp-input" rows="3" style="width:100%;min-height:80px;"
                                    placeholder="A brief description about yourself…"><%= admin && admin.bio ? admin.bio : '' %></textarea>
                        </div>
                      </div>

                      <div class="kp-card__foot">
                        <button type="submit" class="kp-btn kp-btn--primary">Save profile</button>
                        <% if (!firstLogin) { %>
                        <a href="/admin/main/dashboard" class="kp-btn">Cancel</a>
                        <% } %>
                      </div>
                    </form>
                  </div>
                </div>

                <!-- ══ Security ══════════════════════════════════════════ -->
                <div class="kp-section" data-section="security">
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Two-factor verification</h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill <%= twoFaOn ? 'kp-pill--good' : 'kp-pill--warn' %>" id="twofa-badge">
                          <%= twoFaOn ? 'On' : 'Off' %>
                        </span>
                      </div>
                    </div>
                    <div class="kp-card__body">
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Require a code at every sign-in</span>
                          <p class="kp-row__hint">
                            A 6-digit code is emailed to <%= admin.email %>. Off means your password
                            alone signs you in.
                          </p>
                        </div>
                        <div class="kp-row__ctrl">
                          <button type="button"
                                  class="kp-btn <%= twoFaOn ? 'kp-btn--danger' : 'kp-btn--primary' %>"
                                  id="twofa-toggle"
                                  data-enabled="<%= twoFaOn ? 'true' : 'false' %>">
                            <%= twoFaOn ? 'Turn off' : 'Turn on' %>
                          </button>
                        </div>
                      </div>

                      <% if (!twoFaOn && admin.twoFactorDisabledBy) { %>
                      <div class="kp-row kp-row--stack">
                        <p class="kp-note kp-note--warn" style="margin:0;">
                          Disabled by <strong><%= admin.twoFactorDisabledBy %></strong><%
                          if (admin.twoFactorDisabledAt) { %> on
                          <%= new Date(admin.twoFactorDisabledAt).toLocaleString('en-GB') %><% } %><%
                          if (admin.twoFactorDisabledReason) { %> — <%= admin.twoFactorDisabledReason %><% } %>
                        </p>
                      </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Password</h2></div>
                    <div class="kp-card__body kp-card__body--pad">
                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Current password</span>
                        </div>
                        <input type="password" id="pw-current" class="kp-input" style="width:100%;max-width:320px;"
                               autocomplete="current-password" placeholder="••••••••">
                      </div>

                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main">
                          <span class="kp-row__label">New password</span>
                          <p class="kp-row__hint">At least 8 characters.</p>
                        </div>
                        <input type="password" id="pw-new" class="kp-input" style="width:100%;max-width:320px;"
                               autocomplete="new-password" placeholder="••••••••">
                      </div>

                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Confirm new password</span>
                        </div>
                        <input type="password" id="pw-confirm" class="kp-input" style="width:100%;max-width:320px;"
                               autocomplete="new-password" placeholder="••••••••">
                      </div>

                      <p id="pw-error" class="kp-note kp-note--danger" style="display:none;"></p>
                    </div>
                    <div class="kp-card__foot">
                      <button type="button" class="kp-btn kp-btn--primary" id="pw-save">Update password</button>
                      <a href="/admin/forgot-password" class="kp-mute" style="font-size:12.5px;">
                        Forgot your current password?
                      </a>
                    </div>
                  </div>
                </div>

              </div><!-- /kp-panel__main -->
            </div><!-- /kp-panel__body -->
          </div><!-- /kp-panel -->

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/admin/assets/js/kbc-panel.js"></script>
<script>
// ── Two-factor self-toggle ──────────────────────────────────────────────────
(function () {
  var btn = document.getElementById('twofa-toggle');
  if (!btn) return;

  btn.addEventListener('click', async function () {
    var isOn = btn.dataset.enabled === 'true';

    var ask = await Swal.fire({
      icon: 'warning',
      title: isOn ? 'Turn off two-factor?' : 'Turn on two-factor?',
      text: isOn
        ? 'Your password alone will sign you in. Anyone with it gets your account.'
        : 'You will be asked for an emailed code at every sign-in.',
      showCancelButton: true,
      confirmButtonText: isOn ? 'Turn it off' : 'Turn it on',
      confirmButtonColor: isOn ? '#d1453b' : '#15a844',
    });
    if (!ask.isConfirmed) return;

    btn.disabled = true;

    try {
      var res = await fetch('/admin/profile/two-factor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ enabled: !isOn }),
      });
      var data = await res.json();

      if (data.success) {
        await Swal.fire({ icon: 'success', text: data.message, confirmButtonColor: '#15a844' });
        location.reload();
        return;
      }
      Swal.fire({ icon: 'error', text: data.message, confirmButtonColor: '#15a844' });
    } catch (e) {
      Swal.fire({ icon: 'error', text: 'Request failed. Please try again.', confirmButtonColor: '#15a844' });
    }

    btn.disabled = false;
  });
})();

// ── Change password ─────────────────────────────────────────────────────────
(function () {
  var saveBtn = document.getElementById('pw-save');
  if (!saveBtn) return;

  var currentEl = document.getElementById('pw-current');
  var newEl     = document.getElementById('pw-new');
  var confirmEl = document.getElementById('pw-confirm');
  var errorEl   = document.getElementById('pw-error');

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
  }
  function clearError() {
    errorEl.style.display = 'none';
    errorEl.textContent = '';
  }

  saveBtn.addEventListener('click', async function () {
    clearError();

    var current = currentEl.value;
    var next    = newEl.value;
    var confirm = confirmEl.value;

    // Same checks the server makes, so a mistake is caught before a round trip
    // rather than after — the server call is still the authority, this just
    // saves a wasted request for the common slips.
    if (!current || !next || !confirm) {
      return showError('Fill in all three fields.');
    }
    if (next.length < 8) {
      return showError('New password must be at least 8 characters.');
    }
    if (next !== confirm) {
      return showError('New password and confirmation do not match.');
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Updating…';

    try {
      var res = await fetch('/admin/profile/password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ currentPassword: current, newPassword: next, confirmPassword: confirm }),
      });
      var data = await res.json();

      if (data.success) {
        currentEl.value = '';
        newEl.value = '';
        confirmEl.value = '';
        await Swal.fire({ icon: 'success', text: data.message, confirmButtonColor: '#15a844' });
      } else {
        showError(data.message);
      }
    } catch (e) {
      showError('Request failed. Please try again.');
    }

    saveBtn.disabled = false;
    saveBtn.textContent = 'Update password';
  });
})();
</script>
