<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1 kp-has-drawer">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <%
            var sb  = settings.signupBonus || {};
            var rc  = settings.referralCommission || {};
            var pc  = settings.paidCodes || {};
            var pcs = pc.special || {};
            var pcc = pc.custom  || {};
            var cs  = typeof codeStats    !== 'undefined' ? codeStats    : { system: 0, special: 0, custom: 0 };
            var rq  = typeof requestStats !== 'undefined' ? requestStats : { pending: 0, approved: 0, rejected: 0 };
            var reqs = (typeof codeRequests !== 'undefined' && codeRequests) || [];
            var pool = (specialCodes || []);
            var unsold = pool.filter(function (c) { return !c.permittedUser; }).length;
          %>

          <div class="kp-panel">

            <div class="kp-panel__head">
              <h1 class="kp-panel__title">Growth &amp; Rewards</h1>
              <p class="kp-panel__sub">Referrals, bonuses and the codes users can buy</p>
            </div>

            <div class="kp-panel__body">

              <%- include('partials/panelDrawer', {
                panelKey: 'referrals',
                drawerLabel: 'Referrals',
                sections: [
                  { id: 'overview',  label: 'Overview',      icon: 'bar-chart-2' },
                  { id: 'reward',    label: 'Reward',        icon: 'gift' },
                  { id: 'signup',    label: 'Signup Bonus',  icon: 'user-plus' },
                  { id: 'comm',      label: 'Commission',    icon: 'repeat' },
                  { id: 'paid',      label: 'Paid Codes',    icon: 'tag' },
                  { id: 'requests',  label: 'Requests',      icon: 'inbox', badge: rq.pending || 0 },
                  { id: 'reserved',  label: 'Reserved Pool', icon: 'bookmark' }
                ]
              }) %>

              <div class="kp-panel__main">

                <!-- ══ Overview ══════════════════════════════════════════ -->
                <div class="kp-section" data-section="overview">
                  <div class="kp-stats">
                    <div class="kp-stat">
                      <div class="kp-stat__num"><%= stats.pending %></div>
                      <div class="kp-stat__lbl">Pending</div>
                    </div>
                    <div class="kp-stat">
                      <div class="kp-stat__num"><%= stats.qualified %></div>
                      <div class="kp-stat__lbl">Qualified</div>
                    </div>
                    <div class="kp-stat">
                      <div class="kp-stat__num kp-stat__num--good"><%= stats.rewarded %></div>
                      <div class="kp-stat__lbl">Rewarded</div>
                    </div>
                    <div class="kp-stat">
                      <div class="kp-stat__num kp-stat__num--mute"><%= stats.void %></div>
                      <div class="kp-stat__lbl">Void</div>
                    </div>
                  </div>

                  <div class="kp-grid kp-grid--2">
                    <div class="kp-card">
                      <div class="kp-card__head"><h2 class="kp-card__title">Codes in issue</h2></div>
                      <div class="kp-card__body">
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Free system codes</span></div>
                          <div class="kp-row__ctrl"><span class="kp-row__value"><%= cs.system.toLocaleString() %></span></div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Reserved, sold</span></div>
                          <div class="kp-row__ctrl"><span class="kp-row__value"><%= cs.special.toLocaleString() %></span></div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Custom, sold</span></div>
                          <div class="kp-row__ctrl"><span class="kp-row__value"><%= cs.custom.toLocaleString() %></span></div>
                        </div>
                      </div>
                    </div>

                    <div class="kp-card">
                      <div class="kp-card__head"><h2 class="kp-card__title">Programme state</h2></div>
                      <div class="kp-card__body">
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Referrals</span></div>
                          <div class="kp-row__ctrl">
                            <span class="kp-pill <%= settings.isActive ? 'kp-pill--good' : '' %>"><%= settings.isActive ? 'Running' : 'Paused' %></span>
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Paid codes</span></div>
                          <div class="kp-row__ctrl">
                            <span class="kp-pill <%= pc.isActive ? 'kp-pill--good' : '' %>"><%= pc.isActive ? 'On sale' : 'Off' %></span>
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Requests waiting</span></div>
                          <div class="kp-row__ctrl">
                            <% if (rq.pending > 0) { %>
                            <a href="#requests" class="kp-pill kp-pill--warn"><%= rq.pending %> to review</a>
                            <% } else { %>
                            <span class="kp-row__value">None</span>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Recent referrals</h2></div>
                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table">
                          <thead>
                            <tr>
                              <th>Referrer</th><th>Referred</th><th>Code</th>
                              <th>Status</th><th>Reward</th><th>When</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (!referrals.length) { %>
                            <tr><td colspan="6"><div class="kp-empty">No referrals yet.</div></td></tr>
                            <% } %>
                            <% referrals.slice(0, 25).forEach(function (r) { %>
                            <tr>
                              <td><span class="kp-strong"><%= r.referrer ? r.referrer.username : '—' %></span></td>
                              <td><%= r.referred ? r.referred.username : '—' %></td>
                              <td><span class="kp-code"><%= r.codeUsed %></span></td>
                              <td>
                                <span class="kp-pill <%= r.status === 'rewarded' ? 'kp-pill--good' : (r.status === 'void' ? '' : 'kp-pill--warn') %>"><%= r.status %></span>
                              </td>
                              <td><%= r.rewardNote || '—' %></td>
                              <td><%= new Date(r.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- ══ Reward ════════════════════════════════════════════ -->
                <div class="kp-section" data-section="reward">
                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Referral reward</h2></div>
                    <div class="kp-card__body">
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Programme</span>
                          <p class="kp-row__hint">Paused stops all new rewards.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <label class="kp-toggle">
                            <input type="checkbox" id="f-active" <%= settings.isActive ? 'checked' : '' %>>
                            <span class="kp-toggle__track"></span>
                          </label>
                        </div>
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Reward type</span>
                          <p class="kp-row__hint" id="amount-help"></p>
                        </div>
                        <div class="kp-row__ctrl">
                          <select id="f-rewardtype" class="kp-select" onchange="onRewardTypeChange()">
                            <option value="rewardpoint" <%= settings.rewardType === 'rewardpoint' ? 'selected' : '' %>>Reward Points</option>
                            <option value="money"       <%= settings.rewardType === 'money'       ? 'selected' : '' %>>Money</option>
                            <option value="data"        <%= settings.rewardType === 'data'        ? 'selected' : '' %>>Data bundle</option>
                          </select>
                        </div>
                      </div>

                      <div class="kp-row" id="grp-amount">
                        <div class="kp-row__main"><span class="kp-row__label">Amount</span></div>
                        <div class="kp-row__ctrl">
                          <input type="number" id="f-amount" class="kp-input kp-input--num" min="0" step="any"
                                 value="<%= settings.amount || '' %>" placeholder="0">
                        </div>
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Minimum first purchase</span>
                          <p class="kp-row__hint">0 means any purchase qualifies.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <input type="number" id="f-minpurchase" class="kp-input kp-input--num" min="0" step="any"
                                 value="<%= settings.minPurchaseAmount || 0 %>">
                        </div>
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Cap per referrer</span>
                          <p class="kp-row__hint">0 means unlimited.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <input type="number" id="f-maxrewards" class="kp-input kp-input--num" min="0" step="1"
                                 value="<%= settings.maxRewardsPerReferrer || 0 %>">
                        </div>
                      </div>
                    </div>
                    <div class="kp-card__foot">
                      <button class="kp-btn kp-btn--primary js-save-settings" onclick="saveSettings()">Save</button>
                      <span class="kp-mute" style="font-size:12.5px;">Saves every section in this panel.</span>
                    </div>
                  </div>

                  <!-- Data reward needs a real package, so it gets its own card -->
                  <div class="kp-card" id="grp-data" hidden>
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Package to award</h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill" id="chosen-wrap" style="display:none;">
                          <strong id="chosen-label">—</strong>
                        </span>
                      </div>
                    </div>
                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table">
                          <thead>
                            <tr><th style="width:44px;"></th><th>Plan</th><th>Network</th><th>Validity</th><th class="kp-table__num">Price</th></tr>
                          </thead>
                          <tbody>
                            <% if (!dataProducts.length) { %>
                            <tr><td colspan="5"><div class="kp-empty">No data packages exist yet.</div></td></tr>
                            <% } %>
                            <% dataProducts.forEach(function (p) {
                                 var d = p.dataDetails || {};
                                 var label = (d.plan_type || 'Plan') + ' · ' + (d.network || '');
                                 var isSel = settings.dataProduct && String(settings.dataProduct) === String(p._id);
                            %>
                            <tr class="rf-pkg-row <%= isSel ? 'selected' : '' %>"
                                data-id="<%= p._id %>" data-label="<%= label %>"
                                onclick="selectPackage(this)" style="cursor:pointer;">
                              <td><input type="radio" name="rf-pkg" value="<%= p._id %>" <%= isSel ? 'checked' : '' %>></td>
                              <td><span class="kp-strong"><%= d.plan_type || '—' %></span></td>
                              <td><%= d.network || '—' %></td>
                              <td><%= d.validate_period || '—' %></td>
                              <td class="kp-table__num">&#8358;<%= d.amount != null ? d.amount : '—' %></td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- ══ Signup bonus ══════════════════════════════════════ -->
                <div class="kp-section" data-section="signup">
                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Signup bonus</h2></div>
                    <div class="kp-card__body">
                      <p class="kp-note" style="margin-top:14px;">
                        Paid at email verification, not at signup, and to <strong>every</strong> new
                        user — not only those who arrived on a code.
                      </p>
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Promotion</span></div>
                        <div class="kp-row__ctrl">
                          <label class="kp-toggle">
                            <input type="checkbox" id="sb-active" <%= sb.isActive ? 'checked' : '' %>>
                            <span class="kp-toggle__track"></span>
                          </label>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Bonus type</span>
                          <p class="kp-row__hint" id="sb-amount-help"></p>
                        </div>
                        <div class="kp-row__ctrl">
                          <select id="sb-type" class="kp-select" onchange="onSignupBonusTypeChange()">
                            <option value="rewardpoint" <%= sb.rewardType === 'rewardpoint' ? 'selected' : '' %>>Reward Points</option>
                            <option value="money"       <%= sb.rewardType === 'money'       ? 'selected' : '' %>>Money</option>
                          </select>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Amount</span></div>
                        <div class="kp-row__ctrl">
                          <input type="number" id="sb-amount" class="kp-input kp-input--num" min="0" step="any"
                                 value="<%= sb.amount || '' %>" placeholder="0">
                        </div>
                      </div>
                    </div>
                    <div class="kp-card__foot">
                      <button class="kp-btn kp-btn--primary js-save-settings" onclick="saveSettings()">Save</button>
                      <span class="kp-mute" style="font-size:12.5px;">Saves every section in this panel.</span>
                    </div>
                  </div>
                </div>

                <!-- ══ Commission ════════════════════════════════════════ -->
                <div class="kp-section" data-section="comm">
                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Ongoing commission</h2></div>
                    <div class="kp-card__body">
                      <p class="kp-note" style="margin-top:14px;">
                        Once a referred user has qualified, every later purchase earns their referrer
                        a percentage. <strong>Always a gift on top</strong> — the buyer is charged in
                        full and keeps their own reward points.
                      </p>
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Commission</span></div>
                        <div class="kp-row__ctrl">
                          <label class="kp-toggle">
                            <input type="checkbox" id="rc-active" <%= rc.isActive ? 'checked' : '' %>>
                            <span class="kp-toggle__track"></span>
                          </label>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Type</span>
                          <p class="kp-row__hint" id="rc-type-help"></p>
                        </div>
                        <div class="kp-row__ctrl">
                          <select id="rc-type" class="kp-select" onchange="onCommissionTypeChange()">
                            <option value="cashback"    <%= rc.type === 'cashback'    ? 'selected' : '' %>>Cash back</option>
                            <option value="rewardpoint" <%= rc.type === 'rewardpoint' ? 'selected' : '' %>>Reward Points</option>
                          </select>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Percentage</span></div>
                        <div class="kp-row__ctrl">
                          <span class="kp-affix">
                            <input type="number" id="rc-percent" class="kp-input kp-input--num" min="0" max="100" step="any"
                                   value="<%= rc.percent || '' %>" placeholder="0">
                            <span class="kp-affix__unit">%</span>
                          </span>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Lifetime cap per referred user</span>
                          <p class="kp-row__hint">0 means unlimited.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <input type="number" id="rc-cap" class="kp-input kp-input--num" min="0" step="any"
                                 value="<%= rc.maxPerReferredUser || 0 %>">
                        </div>
                      </div>
                    </div>
                    <div class="kp-card__foot">
                      <button class="kp-btn kp-btn--primary js-save-settings" onclick="saveSettings()">Save</button>
                      <span class="kp-mute" style="font-size:12.5px;">Saves every section in this panel.</span>
                    </div>
                  </div>
                </div>

                <!-- ══ Paid codes ════════════════════════════════════════ -->
                <div class="kp-section" data-section="paid">
                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Selling codes</h2></div>
                    <div class="kp-card__body">
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">On sale</span>
                          <p class="kp-row__hint">Off hides the option from users entirely.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <label class="kp-toggle">
                            <input type="checkbox" id="pc-active" <%= pc.isActive ? 'checked' : '' %>>
                            <span class="kp-toggle__track"></span>
                          </label>
                        </div>
                      </div>
                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Approve automatically</span>
                          <p class="kp-row__hint">Skips review. Custom codes are text other users see.</p>
                        </div>
                        <div class="kp-row__ctrl">
                          <label class="kp-toggle">
                            <input type="checkbox" id="pc-auto" <%= pc.autoApprove ? 'checked' : '' %>>
                            <span class="kp-toggle__track"></span>
                          </label>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="kp-grid kp-grid--2">
                    <div class="kp-card">
                      <div class="kp-card__head">
                        <h2 class="kp-card__title">Reserved</h2>
                        <div class="kp-card__aside"><span class="kp-pill"><%= unsold %> unsold</span></div>
                      </div>
                      <div class="kp-card__body">
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Default price</span>
                            <p class="kp-row__hint">A code with its own price keeps it.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <input type="number" id="pc-sp-price" class="kp-input kp-input--num" min="0" step="any"
                                   value="<%= pcs.price || 0 %>">
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Reward bonus</span>
                            <p class="kp-row__hint">On the one-off reward.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <span class="kp-affix">
                              <input type="number" id="pc-sp-reward" class="kp-input kp-input--num" min="0" max="500" step="any"
                                     value="<%= pcs.rewardBonusPercent || 0 %>">
                              <span class="kp-affix__unit">%</span>
                            </span>
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Commission bonus</span>
                            <p class="kp-row__hint">On every later purchase. 0 = none.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <span class="kp-affix">
                              <input type="number" id="pc-sp-comm" class="kp-input kp-input--num" min="0" max="500" step="any"
                                     value="<%= pcs.commissionBonusPercent || 0 %>">
                              <span class="kp-affix__unit">%</span>
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="kp-card">
                      <div class="kp-card__head">
                        <h2 class="kp-card__title">Custom</h2>
                        <div class="kp-card__aside"><span class="kp-pill"><%= cs.custom %> sold</span></div>
                      </div>
                      <div class="kp-card__body">
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Price</span>
                            <p class="kp-row__hint">What a user pays to choose their own.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <input type="number" id="pc-cu-price" class="kp-input kp-input--num" min="0" step="any"
                                   value="<%= pcc.price || 0 %>">
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Reward bonus</span>
                            <p class="kp-row__hint">On the one-off reward.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <span class="kp-affix">
                              <input type="number" id="pc-cu-reward" class="kp-input kp-input--num" min="0" max="500" step="any"
                                     value="<%= pcc.rewardBonusPercent || 0 %>">
                              <span class="kp-affix__unit">%</span>
                            </span>
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Commission bonus</span>
                            <p class="kp-row__hint">On every later purchase. 0 = none.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <span class="kp-affix">
                              <input type="number" id="pc-cu-comm" class="kp-input kp-input--num" min="0" max="500" step="any"
                                     value="<%= pcc.commissionBonusPercent || 0 %>">
                              <span class="kp-affix__unit">%</span>
                            </span>
                          </div>
                        </div>
                        <div class="kp-row">
                          <div class="kp-row__main"><span class="kp-row__label">Length</span></div>
                          <div class="kp-row__ctrl">
                            <input type="number" id="pc-cu-min" class="kp-input kp-input--num" min="3" max="32"
                                   value="<%= pcc.minLength || 4 %>" style="width:74px;">
                            <span class="kp-mute">to</span>
                            <input type="number" id="pc-cu-max" class="kp-input kp-input--num" min="4" max="64"
                                   value="<%= pcc.maxLength || 16 %>" style="width:74px;">
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="kp-card">
                    <div class="kp-card__foot">
                      <button class="kp-btn kp-btn--primary js-save-settings" onclick="saveSettings()">Save</button>
                      <span class="kp-mute" style="font-size:12.5px;">
                        Bonuses are frozen onto a code when it is bought — changes affect future purchases only.
                      </span>
                    </div>
                  </div>
                </div>

                <!-- ══ Requests ══════════════════════════════════════════ -->
                <div class="kp-section" data-section="requests">
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Code requests</h2>
                      <div class="kp-card__aside">
                        <select id="cr-filter" class="kp-select kp-select--sm" onchange="loadCodeRequests(this.value)" style="height:32px;font-size:12.5px;">
                          <option value="pending">Waiting (<%= rq.pending %>)</option>
                          <option value="approved">Approved (<%= rq.approved %>)</option>
                          <option value="rejected">Rejected (<%= rq.rejected %>)</option>
                        </select>
                      </div>
                    </div>
                    <div class="kp-card__body kp-card__body--pad" style="padding-bottom:0;">
                      <p class="kp-note">
                        <strong>Approving charges the user.</strong> Nothing is taken while a request
                        waits here, so rejecting costs them nothing. If their balance is short at
                        approval the request stays waiting.
                      </p>
                    </div>
                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table" id="cr-table">
                          <thead>
                            <tr>
                              <th>When</th><th>User</th><th>Code</th><th>Kind</th>
                              <th class="kp-table__num">Price</th>
                              <th class="kp-table__num">Reward</th>
                              <th class="kp-table__num">Comm.</th>
                              <th class="kp-table__act">Action</th>
                            </tr>
                          </thead>
                          <tbody id="cr-body">
                            <% if (!reqs.length) { %>
                            <tr><td colspan="8"><div class="kp-empty">Nothing waiting.</div></td></tr>
                            <% } %>
                            <% reqs.forEach(function (r) { %>
                            <tr id="cr-row-<%= r._id %>">
                              <td><%= new Date(r.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) %></td>
                              <td>
                                <% if (r.user) { %>
                                <a href="/admin/product/user-details/<%= r.user._id %>" class="kp-strong"><%= r.user.username %></a><br>
                                <span class="kp-mute" style="font-size:12px;"><%= r.user.email %></span>
                                <% } else { %><span class="kp-mute">Deleted user</span><% } %>
                              </td>
                              <td><span class="kp-code"><%= r.code %></span></td>
                              <td><span class="kp-pill <%= r.type === 'custom' ? 'kp-pill--warn' : 'kp-pill--info' %>"><%= r.type === 'custom' ? 'custom' : 'reserved' %></span></td>
                              <td class="kp-table__num"><%= (r.price || 0).toLocaleString() %></td>
                              <td class="kp-table__num"><%= r.rewardBonusPercent || 0 %>%</td>
                              <td class="kp-table__num"><%= r.commissionBonusPercent || 0 %>%</td>
                              <td class="kp-table__act">
                                <button class="kp-btn kp-btn--sm kp-btn--primary"
                                        onclick="approveCodeRequest('<%= r._id %>', '<%= r.code %>', '<%= (r.price || 0) %>')">Approve</button>
                                <button class="kp-btn kp-btn--sm kp-btn--danger"
                                        onclick="rejectCodeRequest('<%= r._id %>', '<%= r.code %>')">Reject</button>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- ══ Reserved pool ═════════════════════════════════════ -->
                <div class="kp-section" data-section="reserved">
                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Add reserved codes</h2></div>
                    <div class="kp-card__body kp-card__body--pad">
                      <p class="kp-note">
                        Letters and numbers only. A code is <strong>blocked from the system</strong>
                        the moment you add it, and becomes usable only when a user buys it and you
                        approve.
                      </p>

                      <div class="kp-stack">
                        <div class="kp-field">
                          <label class="kp-field__label" for="sc-codes">Codes, separated by commas</label>
                          <textarea id="sc-codes" class="kp-input kp-input--code" rows="4"
                                    style="text-transform:uppercase;"
                                    placeholder="VICTOR1, KABACU01, LAGOS2026"></textarea>
                        </div>

                        <div class="kp-grid kp-grid--2">
                          <div class="kp-field">
                            <label class="kp-field__label" for="sc-price">Price for this batch</label>
                            <input type="number" id="sc-price" class="kp-input" min="0" step="any" placeholder="0">
                          </div>
                          <div class="kp-field">
                            <label class="kp-field__label" for="sc-note">Note</label>
                            <input type="text" id="sc-note" class="kp-input" placeholder="e.g. Lagos launch batch">
                          </div>
                        </div>
                      </div>

                      <div id="sc-bulk-report" style="display:none;margin-top:14px;"></div>
                    </div>
                    <div class="kp-card__foot">
                      <button class="kp-btn kp-btn--primary" id="sc-create-btn" onclick="bulkCreateSpecialCodes()">Reserve codes</button>
                      <span class="kp-mute" style="font-size:12.5px;">Newlines and semicolons work too.</span>
                    </div>
                  </div>

                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">The pool</h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill"><%= unsold %> unsold</span>
                        <span class="kp-pill"><%= pool.length %> total</span>
                      </div>
                    </div>
                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table">
                          <thead>
                            <tr>
                              <th>Code</th><th class="kp-table__num">Price</th><th>Status</th>
                              <th>Held by</th><th>Note</th><th class="kp-table__act">Actions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (!pool.length) { %>
                            <tr><td colspan="6"><div class="kp-empty">No reserved codes yet.</div></td></tr>
                            <% } %>
                            <% pool.forEach(function (sc) { %>
                            <tr>
                              <td><span class="kp-code"><%= sc.code %></span></td>
                              <td class="kp-table__num"><%= (sc.price || 0).toLocaleString() %></td>
                              <td>
                                <% if (!sc.isActive) { %>
                                <span class="kp-pill">Disabled</span>
                                <% } else if (sc.permittedUser) { %>
                                <span class="kp-pill kp-pill--good">Sold</span>
                                <% } else { %>
                                <span class="kp-pill kp-pill--info">For sale</span>
                                <% } %>
                              </td>
                              <td>
                                <% if (sc.permittedUser) { %>
                                <span class="kp-strong"><%= sc.permittedUser.username %></span>
                                <% } else { %><span class="kp-mute">—</span><% } %>
                              </td>
                              <td><span class="kp-mute" style="font-size:12.5px;"><%= sc.note || '—' %></span></td>
                              <td class="kp-table__act">
                                <% if (sc.permittedUser) { %>
                                <button class="kp-btn kp-btn--sm" onclick="unassignSpecialCode('<%= sc._id %>')">Take back</button>
                                <% } else { %>
                                <button class="kp-btn kp-btn--sm" onclick="assignSpecialCode('<%= sc._id %>', '<%= sc.code %>')">Assign</button>
                                <% } %>
                                <button class="kp-btn kp-btn--sm" onclick="toggleSpecialCode('<%= sc._id %>')"><%= sc.isActive ? 'Disable' : 'Enable' %></button>
                                <button class="kp-btn kp-btn--sm kp-btn--danger" onclick="deleteSpecialCode('<%= sc._id %>')">Delete</button>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

              </div><!-- /kp-panel__main -->
            </div><!-- /kp-panel__body -->
          </div><!-- /kp-panel -->

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="/admin/assets/js/kbc-panel.js"></script>

<%- include('partials/referralsScripts.ejs') %>
