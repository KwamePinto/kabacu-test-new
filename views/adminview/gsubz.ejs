<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-header">
          <h1>GSubz</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/admin/main">Dashboard</a></div>
            <div class="breadcrumb-item">Service Providers</div>
            <div class="breadcrumb-item">GSubz</div>
          </div>
        </div>

        <div class="section-body">

          <div id="gzErrorAlert" style="display:none;" class="alert alert-danger">
            <strong>Error loading data:</strong> <span id="gzErrorMsg"></span>
          </div>

          <!-- Raised only when GSubz's own answer contradicts our records in a
               way that means money or data went astray. -->
          <div id="gzMismatchAlert" style="display:none;" class="alert alert-warning">
            <strong><span id="gzMismatchCount">0</span> transaction(s) need review.</strong>
            GSubz's records disagree with ours on these — a purchase may have been
            delivered without being recorded, or charged without being delivered.
            <a href="/admin/gsubz?status=mismatch" class="btn btn-sm btn-warning ml-2">Show them</a>
          </div>

          <!-- ── Account overview ── -->
          <div class="row mb-4" id="gzStatRow">
            <div class="col-12 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-primary"><i class="fas fa-wallet"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Wallet Balance</h4></div>
                  <div class="card-body gz-skel" id="gzBalance">&nbsp;</div>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-list-alt"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Total Transactions</h4></div>
                  <div class="card-body gz-skel" id="gzTotal">&nbsp;</div>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-check-circle"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Delivered</h4></div>
                  <div class="card-body gz-skel" id="gzSuccess">&nbsp;</div>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-danger"><i class="fas fa-triangle-exclamation"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Needs Review</h4></div>
                  <div class="card-body gz-skel" id="gzMismatches">&nbsp;</div>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Transactions ── -->
          <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap" style="gap:10px;">
              <h4 class="mb-0">API Transactions</h4>
              <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                <button type="button" id="gzReconcileBtn" class="btn btn-sm btn-info">
                  <i class="fas fa-rotate"></i> Check against GSubz
                </button>
                <form method="GET" action="/admin/gsubz" class="d-flex" style="gap:8px;flex-wrap:wrap;">
                  <input type="hidden" name="status" value="<%= filters.status %>">
                  <input type="text" name="search" value="<%= filters.search %>"
                    class="form-control form-control-sm" style="width:220px;"
                    placeholder="Search phone, ref or trans ID…">
                  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i></button>
                  <% if (filters.search) { %>
                    <a href="/admin/gsubz?status=<%= filters.status %>" class="btn btn-sm btn-secondary">Clear</a>
                  <% } %>
                </form>
              </div>
            </div>

            <div class="card-header" style="padding-top:0;border-top:none;">
              <ul class="nav nav-pills">
                <% statusOptions.forEach(function (opt) { %>
                  <li class="nav-item">
                    <a class="nav-link <%= filters.status === opt.value ? 'active' : '' %>"
                      href="/admin/gsubz?status=<%= opt.value %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>">
                      <%= opt.label %>
                    </a>
                  </li>
                <% }) %>
              </ul>
            </div>

            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                  <thead>
                    <tr>
                      <th style="width:44px;">#</th>
                      <th>Date</th>
                      <th>Trans ID</th>
                      <th>Service</th>
                      <th>Phone</th>
                      <th class="text-right">Amount</th>
                      <th>Status</th>
                      <th>GSubz says</th>
                      <th>Response</th>
                    </tr>
                  </thead>
                  <tbody id="gzTableBody">
                    <tr>
                      <td colspan="9" class="text-center py-4 text-muted">
                        <i class="fas fa-spinner fa-spin mr-1"></i> Loading transactions…
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div id="gzPaginationWrap"></div>
          </div>

          <p class="text-muted" style="font-size:12px;">
            Transactions are Kabacu's own records of every GSubz purchase. <strong>Check against GSubz</strong>
            asks GSubz to confirm each one by its request id, so a purchase that failed here but was
            delivered anyway cannot pass unnoticed. Checking never changes a transaction or moves money —
            it only records what GSubz reported.
          </p>

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
  .gz-skel {
    display: inline-block; min-width: 60px; height: 1em; border-radius: 4px;
    background: linear-gradient(90deg, rgba(0,0,0,.06) 25%, rgba(0,0,0,.12) 37%, rgba(0,0,0,.06) 63%);
    background-size: 400% 100%; animation: gz-skel-shimmer 1.4s ease infinite;
  }
  @keyframes gz-skel-shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
  .gz-check { font-size: 11px; }
  .gz-critical td { background: #fff5f5 !important; }
</style>
<script>
(function () {
  var CSRF = '<%= csrfToken %>';
  var filters = {
    page:   '<%= filters.page %>',
    status: '<%= filters.status %>',
    search: '<%= filters.search %>',
  };
  var currentIds = [];

  function esc(v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function money(n) {
    return n == null ? '—' : '₦' + Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function fmtDate(raw) {
    if (!raw) return '—';
    var d = new Date(raw);
    return isNaN(d.getTime()) ? '—' : d.toLocaleString('en-GB',
      { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function renderStats(d) {
    document.getElementById('gzBalance').innerHTML = d.balance != null ? money(d.balance)
      : '<span class="text-danger" style="font-size:13px;" title="' + esc(d.balanceError || '') + '">unavailable</span>';
    document.getElementById('gzTotal').textContent      = Number(d.stats.total).toLocaleString();
    document.getElementById('gzSuccess').textContent    = Number(d.stats.success).toLocaleString();
    document.getElementById('gzMismatches').innerHTML   = d.stats.mismatches
      ? '<span class="text-danger">' + d.stats.mismatches + '</span>' : '0';
    document.querySelectorAll('#gzStatRow .gz-skel').forEach(function (el) { el.classList.remove('gz-skel'); });

    if (d.stats.mismatches > 0 && filters.status !== 'mismatch') {
      document.getElementById('gzMismatchCount').textContent = d.stats.mismatches;
      document.getElementById('gzMismatchAlert').style.display = '';
    }
  }

  var LEVEL_CLS = { ok: 'badge-success', warn: 'badge-warning', critical: 'badge-danger', inconclusive: 'badge-secondary' };

  function checkCell(c) {
    if (!c) return '<small class="text-muted">not checked</small>';
    return '<span class="badge ' + (LEVEL_CLS[c.level] || 'badge-secondary') + ' gz-check" ' +
           'style="cursor:help;white-space:normal;text-align:left;" title="' + esc(c.note) + '">' +
           esc(c.label) + '</span>';
  }

  function renderRow(t, i, from) {
    var critical = t.check && t.check.level === 'critical';
    var costLine = t.cost != null && t.cost !== t.amount
      ? '<br><small class="text-muted" style="font-size:10.5px;">cost ' + money(t.cost) + '</small>' : '';
    var resp = t.response
      ? '<small title="' + esc(t.response) + '">' + esc(t.response.length > 70 ? t.response.slice(0, 70) + '…' : t.response) + '</small>'
      : '<small class="text-muted">—</small>';

    return '<tr' + (critical ? ' class="gz-critical"' : '') + '>' +
      '<td>' + (from + i) + '</td>' +
      '<td><small>' + fmtDate(t.date) + '</small></td>' +
      '<td><code style="font-size:11px;">' + esc(t.transactionId || t.reference || '—') + '</code></td>' +
      '<td><small>' + esc(t.service) + '</small></td>' +
      '<td><code style="font-size:11.5px;">' + esc(t.phone || '—') + '</code></td>' +
      '<td class="text-right"><strong>' + money(t.amount) + '</strong>' + costLine + '</td>' +
      '<td><span class="badge ' + t.status.cls + '">' + esc(t.status.label) + '</span></td>' +
      '<td style="max-width:190px;">' + checkCell(t.check) + '</td>' +
      '<td style="max-width:220px;">' + resp + '</td>' +
      '</tr>';
  }

  function renderTable(d) {
    var tbody = document.getElementById('gzTableBody');
    currentIds = d.transactions.map(function (t) { return t.id; });
    if (!d.transactions.length) {
      tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">No GSubz transactions found.</td></tr>';
      return;
    }
    tbody.innerHTML = d.transactions.map(function (t, i) { return renderRow(t, i, d.pagination.from); }).join('');
  }

  function pageLink(p) {
    return '/admin/gsubz?page=' + p + '&status=' + encodeURIComponent(filters.status) +
           '&search=' + encodeURIComponent(filters.search);
  }

  function renderPagination(pg) {
    var wrap = document.getElementById('gzPaginationWrap');
    if (!pg || pg.lastPage <= 1) { wrap.innerHTML = ''; return; }
    var cur = pg.currentPage, last = pg.lastPage, pages = [];
    if (last <= 7) { for (var p = 1; p <= last; p++) pages.push(p); }
    else {
      pages = [1];
      if (cur > 3) pages.push('…');
      for (var q = Math.max(2, cur - 1); q <= Math.min(last - 1, cur + 1); q++) pages.push(q);
      if (cur < last - 2) pages.push('…');
      pages.push(last);
    }
    wrap.innerHTML = '<div class="card-footer d-flex align-items-center justify-content-between flex-wrap" style="gap:8px;">' +
      '<small class="text-muted">Showing ' + pg.from + '–' + pg.to + ' of ' + Number(pg.total).toLocaleString() + '</small>' +
      '<ul class="pagination pagination-sm mb-0">' +
      '<li class="page-item ' + (cur <= 1 ? 'disabled' : '') + '"><a class="page-link" href="' + pageLink(cur - 1) + '">«</a></li>' +
      pages.map(function (p) {
        if (p === '…') return '<li class="page-item disabled"><span class="page-link">…</span></li>';
        return '<li class="page-item ' + (p === cur ? 'active' : '') + '"><a class="page-link" href="' + pageLink(p) + '">' + p + '</a></li>';
      }).join('') +
      '<li class="page-item ' + (cur >= last ? 'disabled' : '') + '"><a class="page-link" href="' + pageLink(cur + 1) + '">»</a></li>' +
      '</ul></div>';
  }

  function showError(msg) {
    document.getElementById('gzErrorAlert').style.display = '';
    document.getElementById('gzErrorMsg').textContent = msg;
    document.getElementById('gzTableBody').innerHTML =
      '<tr><td colspan="9" class="text-center py-4 text-muted">Could not load transactions.</td></tr>';
    document.querySelectorAll('#gzStatRow .gz-skel').forEach(function (el) {
      el.classList.remove('gz-skel'); el.innerHTML = '—';
    });
  }

  function load() {
    return fetch('/admin/gsubz/data?page=' + encodeURIComponent(filters.page) +
                 '&status=' + encodeURIComponent(filters.status) +
                 '&search=' + encodeURIComponent(filters.search))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.success) { showError(d.error || 'Something went wrong.'); return; }
        renderStats(d);
        renderTable(d);
        renderPagination(d.pagination);
      })
      .catch(function () { showError('Network error. Please try again.'); });
  }

  document.getElementById('gzReconcileBtn').addEventListener('click', function () {
    var btn = this;
    if (!currentIds.length) return;
    btn.disabled = true;
    var original = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Checking…';

    fetch('/admin/gsubz/reconcile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ ids: currentIds }),
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.success) { Swal.fire({ icon: 'error', title: 'Check failed', text: d.error }); return; }
        return load().then(function () {
          Swal.fire({
            icon: d.criticals ? 'warning' : 'success',
            title: d.criticals ? d.criticals + ' need review' : 'All agree',
            text: d.criticals
              ? 'Checked ' + d.checked + ' transaction(s). ' + d.criticals + ' disagree with GSubz in a way that needs a human decision — nothing was changed automatically.'
              : 'Checked ' + d.checked + ' transaction(s); GSubz agrees with all of them.',
          });
        });
      })
      .catch(function () { Swal.fire({ icon: 'error', text: 'Network error.' }); })
      .finally(function () { btn.disabled = false; btn.innerHTML = original; });
  });

  load();
})();
</script>
