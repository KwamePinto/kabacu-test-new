<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-header">
          <h1>Notifications</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/admin/main">Dashboard</a></div>
            <div class="breadcrumb-item">Notifications</div>
          </div>
        </div>

        <div class="section-body">

          <% if (locals.success_msg && success_msg.length) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= success_msg[0] %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
          <% } %>
          <% if (locals.error_msg && error_msg.length) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error_msg[0] %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><strong>Error:</strong> <%= error %></div>
          <% } %>

          <!-- Tab nav -->
          <ul class="nav nav-tabs mb-3" id="notifTabs">
            <li class="nav-item">
              <a class="nav-link <%= tab === 'messages' ? 'active' : '' %>" href="/admin/push-notifications?tab=messages">Messages</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= tab === 'send' ? 'active' : '' %>" href="/admin/push-notifications?tab=send">Send</a>
            </li>
          </ul>

          <!-- ══════════════ MESSAGES TAB ══════════════ -->
          <% if (tab === 'messages') { %>

          <!-- Add message card -->
          <div class="card">
            <div class="card-header">
              <h4>Add Message</h4>
            </div>
            <div class="card-body">
              <form method="POST" action="/admin/push-notifications/messages">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                  <label>Title</label>
                  <input type="text" name="title" class="form-control" required placeholder="Notification title">
                </div>
                <div class="form-group">
                  <label>Body</label>
                  <textarea name="body" class="form-control" rows="3" required placeholder="Notification body"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Save Message</button>
              </form>
            </div>
          </div>

          <!-- Saved messages list -->
          <div class="card">
            <div class="card-header">
              <h4>Saved Messages</h4>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                  <thead>
                    <tr>
                      <th style="width:200px;">Title</th>
                      <th>Body</th>
                      <th style="width:160px;">Created</th>
                      <th style="width:80px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (messages && messages.length) { %>
                    <% messages.forEach(m => { %>
                    <tr>
                      <td><strong><%= m.title %></strong></td>
                      <td><%= m.body %></td>
                      <td>
                        <small><%= new Date(m.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></small>
                      </td>
                      <td>
                        <form method="POST" action="/admin/push-notifications/messages/<%= m._id %>?_method=DELETE" onsubmit="return confirm('Delete this message?')">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                    <% }) %>
                    <% } else { %>
                    <tr>
                      <td colspan="4" class="text-center py-4 text-muted">No messages saved yet.</td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <% } %>

          <!-- ══════════════ SEND TAB ══════════════ -->
          <% if (tab === 'send') { %>

          <div class="row">

            <!-- Per-user send -->
            <div class="col-12 col-lg-6">
              <div class="card">
                <div class="card-header">
                  <h4>Send to User</h4>
                </div>
                <div class="card-body">

                  <!-- Sub-tabs: Registered Devices / All Users -->
                  <ul class="nav nav-tabs nav-tabs-sm mb-3" id="sendUserTabs">
                    <li class="nav-item">
                      <a class="nav-link active" id="tabDevicesLink" href="#" onclick="switchSendTab('devices'); return false;">Registered Devices</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="tabAllUsersLink" href="#" onclick="switchSendTab('allUsers'); return false;">All Users</a>
                    </li>
                  </ul>

                  <!-- Registered Devices section -->
                  <div id="sendDevicesSection">
                    <% if (!registeredUsers || !registeredUsers.length) { %>
                    <p class="text-muted">No registered devices yet.</p>
                    <% } else { %>
                    <form id="sendUserForm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="form-group">
                        <label>User</label>
                        <input type="text" id="devicesFilterInput" class="form-control mb-2" placeholder="Filter by name or email…" autocomplete="off">
                        <select name="userId" id="devicesSelect" class="form-control" required>
                          <option value="">— Select user —</option>
                        </select>
                      </div>
                      <%- include('../partials/notificationMessageSelect.ejs') %>
                      <button type="submit" class="btn btn-primary btn-block" id="sendUserBtn">Send</button>
                    </form>
                    <% } %>
                  </div>

                  <!-- All Users section -->
                  <div id="sendAllUsersSection" style="display:none;">
                    <% if (!allUsers || !allUsers.length) { %>
                    <p class="text-muted">No users found.</p>
                    <% } else { %>
                    <form id="sendAllUsersForm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="form-group">
                        <label>User</label>
                        <input type="text" id="allUsersFilterInput" class="form-control mb-2" placeholder="Filter by name or email…" autocomplete="off">
                        <select name="userId" id="allUsersSelect" class="form-control" required>
                          <option value="">— Select user —</option>
                        </select>
                      </div>
                      <%- include('../partials/notificationMessageSelect.ejs') %>
                      <button type="submit" class="btn btn-primary btn-block" id="sendAllUsersBtn">Send</button>
                    </form>
                    <% } %>
                  </div>

                </div>
              </div>
            </div>

            <!-- Broadcast -->
            <div class="col-12 col-lg-6">
              <div class="card">
                <div class="card-header">
                  <h4>Broadcast</h4>
                  <small class="text-muted ml-2">Check users below for selective broadcast, or leave unchecked to send to all.</small>
                </div>
                <div class="card-body">
                  <form id="broadcastForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <%- include('../partials/notificationMessageSelect.ejs') %>

                    <% if (registeredUsers && registeredUsers.length) { %>
                    <div class="form-group">
                      <label>Select users (optional — leave blank for all)</label>
                      <div style="max-height:200px;overflow-y:auto;border:1px solid #e4e6fc;border-radius:4px;padding:8px;">
                        <% registeredUsers.forEach(ru => { %>
                        <div class="custom-control custom-checkbox mb-1">
                          <input type="checkbox" class="custom-control-input" name="userIds" value="<%= ru.user._id %>" id="user_<%= ru.user._id %>">
                          <label class="custom-control-label" for="user_<%= ru.user._id %>">
                            <%= ru.user.firstname %> <%= ru.user.lastname %> (<%= ru.user.email %>)
                          </label>
                        </div>
                        <% }) %>
                      </div>
                    </div>
                    <% } else { %>
                    <p class="text-muted">No registered devices yet. Broadcast will still reach all users via in-app notifications.</p>
                    <% } %>

                    <button type="submit" class="btn btn-warning btn-block" id="broadcastBtn">Broadcast</button>
                  </form>
                </div>
              </div>
            </div>

          </div>

          <% } %>

        </div><!-- /section-body -->
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>
<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // ── User list filter ──────────────────────────────────────────
  function escH(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function initUserFilter(filterInputId, selectId, users) {
    var filterInput = document.getElementById(filterInputId);
    var selectEl = document.getElementById(selectId);
    if (!filterInput || !selectEl) return;

    function populate(query) {
      var q = query.trim().toLowerCase();
      var filtered = q ?
        users.filter(function(u) {
          return u.label.toLowerCase().indexOf(q) !== -1;
        }) :
        users;
      selectEl.innerHTML = '<option value="">— Select user —</option>' +
        filtered.map(function(u) {
          return '<option value="' + escH(u.id) + '">' + escH(u.label) + '</option>';
        }).join('');
    }

    filterInput.addEventListener('input', function() {
      populate(filterInput.value);
    });
    populate('');
  }

  // Embed user data
  var registeredUsersData = <%- JSON.stringify((registeredUsers || []).map(function(ru) {
    return { id: String(ru.user._id), label: ru.user.firstname + ' ' + ru.user.lastname + ' — ' + ru.user.email };
  })) %>;
  var allUsersData = <%- JSON.stringify((allUsers || []).map(function(u) {
    return { id: String(u._id), label: u.firstname + ' ' + u.lastname + ' — ' + u.email };
  })) %>;

  // Initialise filters
  initUserFilter('devicesFilterInput', 'devicesSelect', registeredUsersData);
  initUserFilter('allUsersFilterInput', 'allUsersSelect', allUsersData);

  // ── Toggle custom message fields ──────────────────────────────
  document.querySelectorAll('.msg-select').forEach(function(sel) {
    var wrap = sel.closest('form').querySelector('.custom-msg-wrap');

    function toggle() {
      if (sel.value === 'custom') {
        wrap.style.display = '';
        wrap.querySelectorAll('input,textarea').forEach(function(el) {
          el.required = true;
        });
      } else {
        wrap.style.display = 'none';
        wrap.querySelectorAll('input,textarea').forEach(function(el) {
          el.required = false;
        });
      }
    }
    sel.addEventListener('change', toggle);
    toggle();
  });

  // ── Sub-tab switcher ──────────────────────────────────────────
  function switchSendTab(tab) {
    var devicesSection = document.getElementById('sendDevicesSection');
    var allUsersSection = document.getElementById('sendAllUsersSection');
    var devicesLink = document.getElementById('tabDevicesLink');
    var allUsersLink = document.getElementById('tabAllUsersLink');
    if (tab === 'devices') {
      if (devicesSection) devicesSection.style.display = '';
      if (allUsersSection) allUsersSection.style.display = 'none';
      if (devicesLink) devicesLink.classList.add('active');
      if (allUsersLink) allUsersLink.classList.remove('active');
    } else {
      if (devicesSection) devicesSection.style.display = 'none';
      if (allUsersSection) allUsersSection.style.display = '';
      if (devicesLink) devicesLink.classList.remove('active');
      if (allUsersLink) allUsersLink.classList.add('active');
    }
  }

  // ── Alert helper ─────────────────────────────────────────────
  function notifToast(data) {
    var delivered = data && data.success && ((data.inApp && data.inApp.success) || (data.push && data.push.success));
    if (delivered) {
      Swal.fire({
        icon: 'success',
        title: 'Message sent',
        text: 'The notification was delivered successfully.',
        timer: 2500,
        showConfirmButton: false
      });
    } else {
      var msg = (data && data.message) || 'Could not deliver the notification. Please try again.';
      Swal.fire({
        icon: 'error',
        title: 'Delivery failed',
        text: msg,
        confirmButtonColor: '#6777ef'
      });
    }
  }

  // ── Send form submit helper ───────────────────────────────────
  async function submitSendForm(form, btnId) {
    var btn = document.getElementById(btnId);
    if (!btn) return;

    var userSelect = form.querySelector('select[name="userId"]');
    if (!userSelect || !userSelect.value) {
      if (userSelect) {
        userSelect.style.borderColor = '#dc3545';
        userSelect.focus();
      }
      return;
    }
    if (userSelect) userSelect.style.borderColor = '';

    btn.disabled = true;
    var orig = btn.textContent;
    btn.textContent = 'Sending…';
    try {
      var formData = new FormData(form);
      var params = new URLSearchParams(formData).toString();
      var csrf = formData.get('_csrf') || '';
      var res = await fetch('/admin/push-notifications/send', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-CSRF-Token': csrf
        },
        body: params,
      });
      var data = await res.json();
      notifToast(data);
    } catch (err) {
      notifToast(null);
    }
    btn.disabled = false;
    btn.textContent = orig;
  }

  // ── Send to User (Registered Devices) ────────────────────────
  var sendUserForm = document.getElementById('sendUserForm');
  if (sendUserForm) {
    sendUserForm.addEventListener('submit', function(e) {
      e.preventDefault();
      submitSendForm(sendUserForm, 'sendUserBtn');
    });
  }

  // ── Send to User (All Users) ──────────────────────────────────
  var sendAllUsersForm = document.getElementById('sendAllUsersForm');
  if (sendAllUsersForm) {
    sendAllUsersForm.addEventListener('submit', function(e) {
      e.preventDefault();
      submitSendForm(sendAllUsersForm, 'sendAllUsersBtn');
    });
  }

  // ── Broadcast ────────────────────────────────────────────────
  var broadcastForm = document.getElementById('broadcastForm');
  if (broadcastForm) {
    broadcastForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      var btn = document.getElementById('broadcastBtn');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        var formData = new FormData(broadcastForm);
        var params = new URLSearchParams(formData).toString();
        var csrf = formData.get('_csrf') || '';
        var res = await fetch('/admin/push-notifications/broadcast', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-Token': csrf
          },
          body: params,
        });
        var data = await res.json();
        notifToast(data);
      } catch (err) {
        notifToast(null);
      }
      btn.disabled = false;
      btn.textContent = 'Broadcast';
    });
  }
</script>