<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-header">
          <h1>Notifications</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/admin/main">Dashboard</a></div>
            <div class="breadcrumb-item">Notifications</div>
          </div>
        </div>

        <div class="section-body">

          <% if (locals.success_msg && success_msg.length) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= success_msg[0] %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
          <% } %>
          <% if (locals.error_msg && error_msg.length) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error_msg[0] %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><strong>Error:</strong> <%= error %></div>
          <% } %>

          <!-- Tab nav -->
          <ul class="nav nav-tabs mb-3" id="notifTabs">
            <li class="nav-item">
              <a class="nav-link <%= tab === 'messages' ? 'active' : '' %>" href="/admin/push-notifications?tab=messages">Messages</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= tab === 'send' ? 'active' : '' %>" href="/admin/push-notifications?tab=send">Send</a>
            </li>
          </ul>

          <!-- ══════════════ MESSAGES TAB ══════════════ -->
          <% if (tab === 'messages') { %>

          <!-- Add message card -->
          <div class="card">
            <div class="card-header">
              <h4>Add Message</h4>
            </div>
            <div class="card-body">
              <form method="POST" action="/admin/push-notifications/messages">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                  <label>Title</label>
                  <input type="text" name="title" class="form-control" required placeholder="Notification title">
                </div>
                <div class="form-group">
                  <label>Body</label>
                  <textarea name="body" class="form-control" rows="3" required placeholder="Notification body"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Save Message</button>
              </form>
            </div>
          </div>

          <!-- Saved messages list -->
          <div class="card">
            <div class="card-header">
              <h4>Saved Messages</h4>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                  <thead>
                    <tr>
                      <th style="width:200px;">Title</th>
                      <th>Body</th>
                      <th style="width:160px;">Created</th>
                      <th style="width:80px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (messages && messages.length) { %>
                    <% messages.forEach(m => { %>
                    <tr>
                      <td><strong><%= m.title %></strong></td>
                      <td><%= m.body %></td>
                      <td>
                        <small><%= new Date(m.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></small>
                      </td>
                      <td>
                        <form method="POST" action="/admin/push-notifications/messages/<%= m._id %>?_method=DELETE" onsubmit="return confirm('Delete this message?')">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                    <% }) %>
                    <% } else { %>
                    <tr>
                      <td colspan="4" class="text-center py-4 text-muted">No messages saved yet.</td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <% } %>

          <!-- ══════════════ SEND TAB ══════════════ -->
          <% if (tab === 'send') { %>

          <div class="row">

            <!-- Per-user send -->
            <div class="col-12 col-lg-6">
              <div class="card">
                <div class="card-header">
                  <h4>Send to User</h4>
                </div>
                <div class="card-body">

                  <!-- Sub-tabs: Registered Devices / All Users -->
                  <ul class="nav nav-tabs nav-tabs-sm mb-3" id="sendUserTabs">
                    <li class="nav-item">
                      <a class="nav-link active" id="tabDevicesLink" href="#" onclick="switchSendTab('devices'); return false;">Registered Devices</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="tabAllUsersLink" href="#" onclick="switchSendTab('allUsers'); return false;">All Users</a>
                    </li>
                  </ul>

                  <!-- Registered Devices section -->
                  <div id="sendDevicesSection">
                    <% if (!registeredUsers || !registeredUsers.length) { %>
                    <p class="text-muted">No registered devices yet.</p>
                    <% } else { %>
                    <form id="sendUserForm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="form-group">
                        <label>Users</label>
                        <div class="user-picker" id="devicesPicker" data-name="userIds">
                          <div class="user-picker__field">
                            <input type="text" class="form-control user-picker__input"
                                   placeholder="Start typing a name or email…" autocomplete="off"
                                   role="combobox" aria-expanded="false" aria-autocomplete="list">
                            <div class="user-picker__menu" role="listbox"></div>
                          </div>
                          <div class="user-picker__chips"></div>
                          <div class="user-picker__hidden"></div>
                        </div>
                        <small class="text-muted">Tick as many as you like — the message goes only to the people listed below.</small>
                      </div>
                      <%- include('../partials/notificationMessageSelect.ejs') %>
                      <button type="submit" class="btn btn-primary btn-block" id="sendUserBtn">Send</button>
                    </form>
                    <% } %>
                  </div>

                  <!-- All Users section -->
                  <div id="sendAllUsersSection" style="display:none;">
                    <% if (!allUsers || !allUsers.length) { %>
                    <p class="text-muted">No users found.</p>
                    <% } else { %>
                    <form id="sendAllUsersForm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="form-group">
                        <label>Users</label>
                        <div class="user-picker" id="allUsersPicker" data-name="userIds">
                          <div class="user-picker__field">
                            <input type="text" class="form-control user-picker__input"
                                   placeholder="Start typing a name or email…" autocomplete="off"
                                   role="combobox" aria-expanded="false" aria-autocomplete="list">
                            <div class="user-picker__menu" role="listbox"></div>
                          </div>
                          <div class="user-picker__chips"></div>
                          <div class="user-picker__hidden"></div>
                        </div>
                        <small class="text-muted">Tick as many as you like — the message goes only to the people listed below.</small>
                      </div>
                      <%- include('../partials/notificationMessageSelect.ejs') %>
                      <button type="submit" class="btn btn-primary btn-block" id="sendAllUsersBtn">Send</button>
                    </form>
                    <% } %>
                  </div>

                </div>
              </div>
            </div>

            <!-- Broadcast -->
            <div class="col-12 col-lg-6">
              <div class="card">
                <div class="card-header">
                  <h4>Broadcast</h4>
                  <small class="text-muted ml-2">Check users below for selective broadcast, or leave unchecked to send to all.</small>
                </div>
                <div class="card-body">
                  <form id="broadcastForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <%- include('../partials/notificationMessageSelect.ejs') %>

                    <% if (registeredUsers && registeredUsers.length) { %>
                    <div class="form-group">
                      <label>Select users</label>
                      <div class="user-picker" id="broadcastPicker" data-name="userIds">
                        <div class="user-picker__field">
                          <input type="text" class="form-control user-picker__input"
                                 placeholder="Start typing a name or email…" autocomplete="off"
                                 role="combobox" aria-expanded="false" aria-autocomplete="list">
                          <div class="user-picker__menu" role="listbox"></div>
                        </div>
                        <div class="user-picker__chips"></div>
                        <div class="user-picker__hidden"></div>
                      </div>
                      <small class="text-muted">Leave empty to broadcast to <strong>everyone</strong> — you will be asked to confirm first.</small>
                    </div>
                    <% } else { %>
                    <p class="text-muted">No registered devices yet. Broadcast will still reach all users via in-app notifications.</p>
                    <% } %>

                    <button type="submit" class="btn btn-warning btn-block" id="broadcastBtn">Broadcast</button>
                  </form>
                </div>
              </div>
            </div>

          </div>

          <% } %>

        </div><!-- /section-body -->
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>
<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<style>
  /* Multi-select user picker (Send panel). Scoped to .user-picker so it cannot
     reach the Stisla form styles used everywhere else in the admin. */
  .user-picker__field { position: relative; }

  .user-picker__menu {
    display: none;
    position: absolute;
    top: 100%; left: 0; right: 0;
    z-index: 30;
    max-height: 260px;
    overflow-y: auto;
    margin-top: 2px;
    background: #fff;
    border: 1px solid #e4e6fc;
    border-radius: 4px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, .12);
  }

  .user-picker__row {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    padding: 8px 11px;
    font-weight: 400;
    font-size: 13px;
    cursor: pointer;
  }
  .user-picker__row:hover { background: #f6f7ff; }
  .user-picker__row input { margin: 0; flex-shrink: 0; }
  .user-picker__row span { overflow-wrap: anywhere; }

  .user-picker__empty {
    padding: 11px;
    font-size: 12.5px;
    color: #98a6ad;
  }

  .user-picker__chips { margin-top: 9px; }

  .user-picker__count {
    font-size: 12px;
    font-weight: 600;
    color: #6777ef;
    margin-bottom: 5px;
  }

  .user-picker__chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: 100%;
    margin: 0 4px 4px 0;
    padding: 3px 5px 3px 10px;
    border-radius: 14px;
    background: #eef0ff;
    color: #3b4ba8;
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .user-picker__remove {
    flex-shrink: 0;
    border: 0;
    background: transparent;
    color: #3b4ba8;
    font-size: 16px;
    line-height: 1;
    padding: 0 3px;
    cursor: pointer;
  }
  .user-picker__remove:hover { color: #dc3545; }

  .user-picker__none { font-size: 12px; color: #98a6ad; }
</style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // ── User list filter ──────────────────────────────────────────
  function escH(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  /**
   * Multi-select user picker.
   *
   * Replaces a filter box wired to a <select>, which needed the admin to type,
   * then open the dropdown, then pick — and could only ever hold one name. The
   * list opens on the first keystroke, each row is a checkbox so several
   * people can be ticked in one pass, and everything ticked is listed
   * underneath. Only the users in that list are sent to.
   *
   * Selections are posted as repeated hidden `userIds` inputs, which is the
   * shape the broadcast endpoint already accepted.
   */
  function initUserPicker(rootId, users) {
    var root = document.getElementById(rootId);
    if (!root) return null;

    var input  = root.querySelector('.user-picker__input');
    var menu   = root.querySelector('.user-picker__menu');
    var chips  = root.querySelector('.user-picker__chips');
    var hidden = root.querySelector('.user-picker__hidden');
    var fieldName = root.getAttribute('data-name') || 'userIds';

    var byId = {};
    users.forEach(function(u) { byId[u.id] = u; });

    // Kept in the order the admin picked them, so the list below reads as a
    // record of what they did rather than re-sorting under them.
    var selected = [];
    function isSelected(id) { return selected.indexOf(id) !== -1; }

    function renderMenu() {
      var q = input.value.trim().toLowerCase();
      var matches = q
        ? users.filter(function(u) { return u.label.toLowerCase().indexOf(q) !== -1; })
        : users;

      if (!matches.length) {
        menu.innerHTML = '<div class="user-picker__empty">No users match \u201c' + escH(input.value) + '\u201d</div>';
        return;
      }

      // Capped so a few thousand accounts cannot lock the browser up building
      // DOM nodes on every keystroke. Typing narrows it well below the cap.
      var shown = matches.slice(0, 200);
      menu.innerHTML = shown.map(function(u) {
        return '<label class="user-picker__row">' +
          '<input type="checkbox" value="' + escH(u.id) + '"' + (isSelected(u.id) ? ' checked' : '') + '>' +
          '<span>' + escH(u.label) + '</span>' +
        '</label>';
      }).join('') + (matches.length > shown.length
        ? '<div class="user-picker__empty">' + (matches.length - shown.length) +
          ' more\u2026 keep typing to narrow the list.</div>'
        : '');
    }

    function renderSelected() {
      hidden.innerHTML = selected.map(function(id) {
        return '<input type="hidden" name="' + escH(fieldName) + '" value="' + escH(id) + '">';
      }).join('');

      if (!selected.length) {
        chips.innerHTML = '<span class="user-picker__none">No one selected yet.</span>';
        return;
      }
      chips.innerHTML =
        '<div class="user-picker__count">Sending to ' + selected.length +
          ' user' + (selected.length === 1 ? '' : 's') + '</div>' +
        selected.map(function(id) {
          var u = byId[id];
          return '<span class="user-picker__chip">' + escH(u ? u.label : id) +
            '<button type="button" class="user-picker__remove" data-id="' + escH(id) +
            '" aria-label="Remove">\u00d7</button></span>';
        }).join('');
    }

    function open()  { menu.style.display = 'block'; input.setAttribute('aria-expanded', 'true'); }
    function close() { menu.style.display = 'none';  input.setAttribute('aria-expanded', 'false'); }

    input.addEventListener('input', function() { renderMenu(); open(); });
    input.addEventListener('focus', function() { renderMenu(); open(); });

    menu.addEventListener('change', function(e) {
      var cb = e.target;
      if (!cb || cb.type !== 'checkbox') return;
      if (cb.checked) {
        if (!isSelected(cb.value)) selected.push(cb.value);
      } else {
        selected = selected.filter(function(s) { return s !== cb.value; });
      }
      // The menu is deliberately left open and the query untouched, so a run
      // of people can be ticked without retyping the search each time.
      renderSelected();
    });

    chips.addEventListener('click', function(e) {
      var btn = e.target.closest ? e.target.closest('.user-picker__remove') : null;
      if (!btn) return;
      var id = btn.getAttribute('data-id');
      selected = selected.filter(function(s) { return s !== id; });
      renderSelected();
      renderMenu();
    });

    document.addEventListener('click', function(e) {
      if (!root.contains(e.target)) close();
    });
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { close(); input.blur(); }
    });

    renderSelected();
    return {
      count:  function() { return selected.length; },
      focus:  function() { input.focus(); },
      labels: function() { return selected.map(function(id) { return byId[id] ? byId[id].label : id; }); }
    };
  }

  // Embed user data
  /* Labels are built from `username` — the only name field on the user model.
     They used to read firstname + lastname, neither of which exists, so every
     row in this panel showed "undefined undefined" beside the email. */
  var registeredUsersData = <%- JSON.stringify((registeredUsers || []).map(function(ru) {
    return { id: String(ru.user._id), label: (ru.user.username || 'Unnamed') + ' — ' + ru.user.email };
  })).replace(/</g, '\\u003c') %>;
  var allUsersData = <%- JSON.stringify((allUsers || []).map(function(u) {
    return { id: String(u._id), label: (u.username || 'Unnamed') + ' — ' + u.email };
  })).replace(/</g, '\\u003c') %>;

  var devicesPicker   = initUserPicker('devicesPicker', registeredUsersData);
  var allUsersPicker  = initUserPicker('allUsersPicker', allUsersData);
  var broadcastPicker = initUserPicker('broadcastPicker', registeredUsersData);

  // ── Toggle custom message fields ──────────────────────────────
  document.querySelectorAll('.msg-select').forEach(function(sel) {
    var wrap = sel.closest('form').querySelector('.custom-msg-wrap');

    function toggle() {
      if (sel.value === 'custom') {
        wrap.style.display = '';
        wrap.querySelectorAll('input,textarea').forEach(function(el) {
          el.required = true;
        });
      } else {
        wrap.style.display = 'none';
        wrap.querySelectorAll('input,textarea').forEach(function(el) {
          el.required = false;
        });
      }
    }
    sel.addEventListener('change', toggle);
    toggle();
  });

  // ── Sub-tab switcher ──────────────────────────────────────────
  function switchSendTab(tab) {
    var devicesSection = document.getElementById('sendDevicesSection');
    var allUsersSection = document.getElementById('sendAllUsersSection');
    var devicesLink = document.getElementById('tabDevicesLink');
    var allUsersLink = document.getElementById('tabAllUsersLink');
    if (tab === 'devices') {
      if (devicesSection) devicesSection.style.display = '';
      if (allUsersSection) allUsersSection.style.display = 'none';
      if (devicesLink) devicesLink.classList.add('active');
      if (allUsersLink) allUsersLink.classList.remove('active');
    } else {
      if (devicesSection) devicesSection.style.display = 'none';
      if (allUsersSection) allUsersSection.style.display = '';
      if (devicesLink) devicesLink.classList.remove('active');
      if (allUsersLink) allUsersLink.classList.add('active');
    }
  }

  // ── Alert helper ─────────────────────────────────────────────
  function notifToast(data) {
    var delivered = data && data.success && ((data.inApp && data.inApp.success) || (data.push && data.push.success));
    if (delivered) {
      Swal.fire({
        icon: 'success',
        title: 'Message sent',
        text: 'The notification was delivered successfully.',
        timer: 2500,
        showConfirmButton: false
      });
    } else {
      var msg = (data && data.message) || 'Could not deliver the notification. Please try again.';
      Swal.fire({
        icon: 'error',
        title: 'Delivery failed',
        text: msg,
        confirmButtonColor: '#6777ef'
      });
    }
  }

  // ── Send form submit helper ───────────────────────────────────
  async function submitSendForm(form, btnId, picker) {
    var btn = document.getElementById(btnId);
    if (!btn) return;

    // This form has no all-users fallback: an empty selection means the admin
    // has not finished choosing, so it is refused rather than sent anywhere.
    if (!picker || picker.count() === 0) {
      Swal.fire({
        icon: 'warning',
        title: 'No users selected',
        text: 'Search for a user and tick at least one name before sending.',
        confirmButtonColor: '#6777ef'
      });
      if (picker) picker.focus();
      return;
    }

    btn.disabled = true;
    var orig = btn.textContent;
    btn.textContent = 'Sending…';
    try {
      var formData = new FormData(form);
      var params = new URLSearchParams(formData).toString();
      var csrf = formData.get('_csrf') || '';
      var res = await fetch('/admin/push-notifications/send', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-CSRF-Token': csrf
        },
        body: params,
      });
      var data = await res.json();
      notifToast(data);
    } catch (err) {
      notifToast(null);
    }
    btn.disabled = false;
    btn.textContent = orig;
  }

  // ── Send to User (Registered Devices) ────────────────────────
  var sendUserForm = document.getElementById('sendUserForm');
  if (sendUserForm) {
    sendUserForm.addEventListener('submit', function(e) {
      e.preventDefault();
      submitSendForm(sendUserForm, 'sendUserBtn', devicesPicker);
    });
  }

  // ── Send to User (All Users) ──────────────────────────────────
  var sendAllUsersForm = document.getElementById('sendAllUsersForm');
  if (sendAllUsersForm) {
    sendAllUsersForm.addEventListener('submit', function(e) {
      e.preventDefault();
      submitSendForm(sendAllUsersForm, 'sendAllUsersBtn', allUsersPicker);
    });
  }

  // ── Broadcast ────────────────────────────────────────────────
  var broadcastForm = document.getElementById('broadcastForm');
  if (broadcastForm) {
    broadcastForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      /* An empty picker still means "everyone" here — that is what Broadcast
         is for — but it is now a deliberate confirmation rather than the
         silent consequence of forgetting to tick anyone. */
      if (!broadcastPicker || broadcastPicker.count() === 0) {
        var ok = await Swal.fire({
          icon: 'warning',
          title: 'Send to every user?',
          text: 'No users are selected, so this will go to your entire user base.',
          showCancelButton: true,
          confirmButtonText: 'Yes, send to everyone',
          cancelButtonText: 'Cancel',
          confirmButtonColor: '#fd7e14'
        });
        if (!ok.isConfirmed) return;
      }

      var btn = document.getElementById('broadcastBtn');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        var formData = new FormData(broadcastForm);
        var params = new URLSearchParams(formData).toString();
        var csrf = formData.get('_csrf') || '';
        var res = await fetch('/admin/push-notifications/broadcast', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-Token': csrf
          },
          body: params,
        });
        var data = await res.json();
        notifToast(data);
      } catch (err) {
        notifToast(null);
      }
      btn.disabled = false;
      btn.textContent = 'Broadcast';
    });
  }
</script>