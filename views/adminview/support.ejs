<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1 kp-has-drawer">
    <div class="navbar-bg"></div>
    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <%
            var _openCount = (reports || []).filter(function (r) { return !r.fixed; }).length;

            var _navSections = [
              { id: 'developers', label: 'Developers',      icon: 'users' },
              { id: 'create',     label: 'Create a Report', icon: 'plus-circle' },
              { id: 'reports',    label: 'Reports',         icon: 'inbox', badge: (reports || []).length }
            ];

            var SIDE_LABEL = { client: 'Client site', admin: 'Admin dashboard' };
            var ROLE_LABEL = { super_admin: 'Super admin', senior_admin: 'Senior admin', junior_admin: 'Junior admin' };

            function fmtWhen(d) {
              if (!d) return '—';
              var dt = new Date(d);
              return dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                   + ' · ' + dt.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            }
          %>

          <div class="kp-panel">

            <div class="kp-panel__head">
              <h1 class="kp-panel__title">Support &amp; Reports</h1>
              <p class="kp-panel__sub kp-panel__section-label"><%= _navSections[0].label %></p>
            </div>

            <div class="kp-panel__body">

              <%- include('partials/panelDrawer', {
                panelKey: 'support',
                drawerLabel: 'Support & Reports',
                sections: _navSections
              }) %>

              <div class="kp-panel__main">

                <!-- ══ Developers ════════════════════════════════════════ -->
                <div class="kp-section" data-section="developers">

                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Developers</h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill"><%= developers.length %></span>
                      </div>
                    </div>
                    <div class="kp-card__body kp-card__body--pad">
                      <div class="kp-note">
                        Whoever is active here shows up in the "Assign to" list when a report is
                        filed, and is who a Remind resends the notification to.
                      </div>
                    </div>
                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table">
                          <thead>
                            <tr>
                              <th>Name</th>
                              <th>Email</th>
                              <th>Role</th>
                              <th style="width:90px;">Status</th>
                              <% if (isSuperAdmin) { %><th style="width:80px;">Actions</th><% } %>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (developers.length) { %>
                            <% developers.forEach(function (d) { %>
                            <tr data-id="<%= d._id %>">
                              <td style="font-weight:600;font-size:13px;"><%= d.name %></td>
                              <td style="font-size:12.5px;"><%= d.email %></td>
                              <td style="font-size:12.5px;"><%= d.role || '—' %></td>
                              <td>
                                <% if (d.isActive) { %>
                                  <span class="kp-pill kp-pill--good">Active</span>
                                <% } else { %>
                                  <span class="kp-pill">Removed</span>
                                <% } %>
                              </td>
                              <% if (isSuperAdmin) { %>
                              <td>
                                <% if (d.isActive) { %>
                                <button class="kp-btn kp-btn--sm kp-btn--danger"
                                        onclick="removeDeveloper('<%= d._id %>', '<%= d.name.replace(/'/g, "&#39;") %>', this)">Remove</button>
                                <% } %>
                              </td>
                              <% } %>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="<%= isSuperAdmin ? 5 : 4 %>"><div class="kp-empty">No developers yet.</div></td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>

                  <% if (isSuperAdmin) { %>
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Add a developer</h2>
                      <div class="kp-card__aside"><span class="kp-pill kp-pill--warn">Super admin only</span></div>
                    </div>
                    <div class="kp-card__body kp-card__body--pad">
                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main"><span class="kp-row__label">Name</span></div>
                        <input type="text" id="dev-name" class="kp-input" style="width:100%;" placeholder="Full name">
                      </div>
                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main"><span class="kp-row__label">Email</span></div>
                        <input type="email" id="dev-email" class="kp-input" style="width:100%;" placeholder="name@example.com">
                      </div>
                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main"><span class="kp-row__label">Role <span class="kp-muted">(optional)</span></span></div>
                        <input type="text" id="dev-role" class="kp-input" style="width:100%;" placeholder="e.g. Backend">
                      </div>
                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main"><span class="kp-row__label">Phone <span class="kp-muted">(optional)</span></span></div>
                        <input type="text" id="dev-phone" class="kp-input" style="width:100%;">
                      </div>
                    </div>
                    <div class="kp-card__foot">
                      <button type="button" class="kp-btn kp-btn--primary" id="add-dev-btn" onclick="addDeveloper()">Add developer</button>
                    </div>
                  </div>
                  <% } else { %>
                  <div class="kp-card">
                    <div class="kp-card__body kp-card__body--pad">
                      <div class="kp-note kp-note--warn">
                        Only a super admin can add or remove developers. You can still assign a
                        report to any of the active ones above from Create a Report.
                      </div>
                    </div>
                  </div>
                  <% } %>

                </div>

                <!-- ══ Create a Report ═══════════════════════════════════ -->
                <div class="kp-section" data-section="create">
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Report a bug</h2>
                    </div>
                    <div class="kp-card__body kp-card__body--pad">

                      <div class="kp-note">
                        Say what you did, what you expected, and what actually happened.
                        A report that says only &ldquo;it is broken&rdquo; usually needs a second
                        conversation before anyone can act on it.
                      </div>

                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main"><span class="kp-row__label">Title</span></div>
                        <input type="text" id="rep-title" class="kp-input" style="width:100%;"
                               placeholder="A one-line summary of the problem">
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Where is it?</span>
                          <span class="kp-row__hint">Which side of the product the bug is on</span>
                        </div>
                        <div class="kp-row__ctrl" style="width:220px;">
                          <select id="rep-side" class="kp-select" style="width:100%;">
                            <option value="">— Select —</option>
                            <option value="client">Client site</option>
                            <option value="admin">Admin dashboard</option>
                          </select>
                        </div>
                      </div>

                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Page</span>
                          <span class="kp-row__hint">The page or screen it happens on</span>
                        </div>
                        <input type="text" id="rep-page" class="kp-input" style="width:100%;"
                               placeholder="e.g. Flagged Transactions, or /my-wallet">
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Assign to</span>
                          <span class="kp-row__hint">Who this report is emailed to</span>
                        </div>
                        <div class="kp-row__ctrl" style="width:220px;">
                          <select id="rep-developer" class="kp-select" style="width:100%;">
                            <option value="">— Select —</option>
                            <% activeDevelopers.forEach(function (d) { %>
                            <option value="<%= d._id %>"><%= d.name %></option>
                            <% }) %>
                          </select>
                        </div>
                      </div>

                      <div class="kp-row">
                        <div class="kp-row__main"><span class="kp-row__label">Severity</span></div>
                        <div class="kp-row__ctrl" style="width:220px;">
                          <select id="rep-severity" class="kp-select" style="width:100%;">
                            <option value="low">Low — cosmetic or minor</option>
                            <option value="medium" selected>Medium — awkward but usable</option>
                            <option value="high">High — blocking work</option>
                          </select>
                        </div>
                      </div>

                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Description</span>
                          <span class="kp-row__hint">What you did, what you expected, what happened</span>
                        </div>
                        <textarea id="rep-description" class="kp-input" rows="6" style="width:100%;"
                                  placeholder="1. Opened …&#10;2. Clicked …&#10;Expected: …&#10;Instead: …"></textarea>
                      </div>

                      <div class="kp-row kp-row--stack">
                        <div class="kp-row__main">
                          <span class="kp-row__label">Screenshots <span class="kp-muted">(optional, up to 3)</span></span>
                          <span class="kp-row__hint">Attached to the email the developer receives</span>
                        </div>
                        <input type="file" id="rep-screenshots" class="kp-input" style="padding:6px 10px;height:auto;"
                               accept="image/*" multiple>
                      </div>

                    </div>
                    <div class="kp-card__foot">
                      <button type="button" class="kp-btn kp-btn--primary" id="submit-report-btn" onclick="submitReport()">Submit report</button>
                    </div>
                  </div>
                </div>

                <!-- ══ Reports ═══════════════════════════════════════════ -->
                <div class="kp-section" data-section="reports">
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title"><%= isSuperAdmin ? 'All reports' : 'My reports' %></h2>
                      <div class="kp-card__aside">
                        <% if (_openCount) { %>
                        <span class="kp-pill kp-pill--warn"><%= _openCount %> unfixed</span>
                        <% } %>
                        <span class="kp-pill"><%= (reports || []).length %></span>
                      </div>
                    </div>

                    <% if (!isSuperAdmin) { %>
                    <div class="kp-card__body kp-card__body--pad">
                      <div class="kp-note">
                        These are the reports you have filed. A super admin sees every report
                        and marks them fixed once they are resolved.
                      </div>
                    </div>
                    <% } %>

                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table">
                          <thead>
                            <tr>
                              <th>Report</th>
                              <th style="width:130px;">Side</th>
                              <th style="width:140px;">Assigned to</th>
                              <% if (isSuperAdmin) { %>
                              <th style="width:150px;">Reported by</th>
                              <% } %>
                              <th style="width:170px;">Submitted</th>
                              <th style="width:100px;">Status</th>
                              <th style="width:170px;">Actions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if ((reports || []).length) { %>
                            <% reports.forEach(function (r) { %>
                            <tr data-id="<%= r._id %>">
                              <td>
                                <div style="font-size:13px;font-weight:600;"><%= r.title %></div>
                                <div class="kp-muted" style="font-size:12px;margin-top:2px;">
                                  <%= r.page %>
                                  <% if (r.severity && r.severity !== 'medium') { %>
                                    &middot; <%= r.severity %> severity
                                  <% } %>
                                  <% if (r.screenshots && r.screenshots.length) { %>
                                    &middot; <%= r.screenshots.length %> screenshot<%= r.screenshots.length === 1 ? '' : 's' %>
                                  <% } %>
                                </div>
                              </td>
                              <td><span class="kp-pill"><%= SIDE_LABEL[r.side] || r.side %></span></td>
                              <td style="font-size:12.5px;"><%= r.assignedDeveloperName || '—' %></td>
                              <% if (isSuperAdmin) { %>
                              <td style="font-size:12.5px;">
                                <%= r.reporterName || 'Unknown' %>
                                <div class="kp-muted" style="font-size:11.5px;">
                                  <%= ROLE_LABEL[r.reporterRole] || r.reporterRole || '' %>
                                </div>
                              </td>
                              <% } %>
                              <td style="font-size:12.5px;"><%= fmtWhen(r.createdAt) %></td>
                              <td>
                                <% if (r.fixed) { %>
                                <span class="kp-pill kp-pill--good">Fixed</span>
                                <% } else { %>
                                <span class="kp-pill kp-pill--warn">Unfixed</span>
                                <% } %>
                              </td>
                              <td>
                                <button class="kp-btn kp-btn--sm" onclick="viewReport('<%= r._id %>')">View</button>
                                <button class="kp-btn kp-btn--sm" onclick="remindReport('<%= r._id %>', this)">Remind</button>
                                <% if (isSuperAdmin) { %>
                                <button class="kp-btn kp-btn--sm kp-btn--danger" onclick="deleteReport('<%= r._id %>', this)">Delete</button>
                                <% } %>
                              </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="<%= isSuperAdmin ? 7 : 6 %>">
                                <div class="kp-empty">
                                  <%= isSuperAdmin ? 'No reports have been filed yet.' : 'You have not filed any reports yet.' %>
                                </div>
                              </td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

              </div><!-- /kp-panel__main -->
            </div><!-- /kp-panel__body -->
          </div><!-- /kp-panel -->

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/admin/assets/js/kbc-panel.js"></script>
<script>
  var CSRF = '<%= csrfToken %>';
  var IS_SUPER = <%= isSuperAdmin ? 'true' : 'false' %>;

  /* Rendered as JSON so the detail dialog can show the full description
     without a second request — the list is already capped at 200 rows
     server-side. */
  var ALL_REPORTS = <%- JSON.stringify(reports || []) %>;
  var ACTIVE_DEVELOPERS = <%- JSON.stringify(activeDevelopers || []) %>;

  var SIDE_LABEL_JS = { client: 'Client site', admin: 'Admin dashboard' };

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ── Developers ─────────────────────────────────────────────────────────────
  async function addDeveloper() {
    var name = document.getElementById('dev-name').value.trim();
    var email = document.getElementById('dev-email').value.trim();
    if (!name)  { Swal.fire({ icon: 'warning', text: 'Enter a name.', confirmButtonColor: '#6777ef' }); return; }
    if (!email) { Swal.fire({ icon: 'warning', text: 'Enter an email address.', confirmButtonColor: '#6777ef' }); return; }

    var btn = document.getElementById('add-dev-btn');
    var orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Adding…';

    try {
      var res = await fetch('/admin/support/developers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({
          name: name, email: email,
          role: document.getElementById('dev-role').value.trim(),
          phone: document.getElementById('dev-phone').value.trim(),
        }),
      });
      var data = await res.json();
      if (data.success) {
        Swal.fire({ icon: 'success', text: data.message, toast: true, position: 'top', timer: 1800, showConfirmButton: false });
        setTimeout(function () { location.reload(); }, 1300);
      } else {
        Swal.fire({ icon: 'error', text: data.message || 'Could not add.', confirmButtonColor: '#6777ef' });
        btn.disabled = false;
        btn.innerHTML = orig;
      }
    } catch (e) {
      Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#6777ef' });
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  }

  async function removeDeveloper(id, name, btn) {
    var confirmed = await Swal.fire({
      icon: 'warning',
      title: 'Remove ' + name + '?',
      text: 'Reports already assigned to them keep their name — this only takes them off future assignments.',
      showCancelButton: true,
      confirmButtonText: 'Remove',
      confirmButtonColor: '#dc3545',
    });
    if (!confirmed.isConfirmed) return;

    btn.disabled = true;
    try {
      var res = await fetch('/admin/support/developers/' + id + '/remove', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      });
      var data = await res.json();
      if (data.success) {
        Swal.fire({ icon: 'success', text: data.message, toast: true, position: 'top', timer: 1600, showConfirmButton: false });
        setTimeout(function () { location.reload(); }, 1200);
      } else {
        Swal.fire({ icon: 'error', text: data.message || 'Could not remove.', confirmButtonColor: '#6777ef' });
        btn.disabled = false;
      }
    } catch (e) {
      Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#6777ef' });
      btn.disabled = false;
    }
  }

  // ── Submit a report ────────────────────────────────────────────────────────
  async function submitReport() {
    var title       = document.getElementById('rep-title').value.trim();
    var side        = document.getElementById('rep-side').value;
    var page        = document.getElementById('rep-page').value.trim();
    var developer   = document.getElementById('rep-developer').value;
    var severity    = document.getElementById('rep-severity').value;
    var description = document.getElementById('rep-description').value.trim();
    var files       = document.getElementById('rep-screenshots').files;

    if (!title)       { Swal.fire({ icon: 'warning', text: 'Give the report a title.',   confirmButtonColor: '#6777ef' }); return; }
    if (!side)        { Swal.fire({ icon: 'warning', text: 'Choose where the bug is.',   confirmButtonColor: '#6777ef' }); return; }
    if (!page)        { Swal.fire({ icon: 'warning', text: 'Name the page it is on.',    confirmButtonColor: '#6777ef' }); return; }
    if (!developer)   { Swal.fire({ icon: 'warning', text: 'Choose who this is for.',    confirmButtonColor: '#6777ef' }); return; }
    if (!description) { Swal.fire({ icon: 'warning', text: 'Describe the problem.',      confirmButtonColor: '#6777ef' }); return; }

    var btn = document.getElementById('submit-report-btn');
    var orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Sending…';

    // FormData, not JSON, so the screenshots ride along with the text fields —
    // matching how announcements' image upload already does it on this panel.
    var fd = new FormData();
    fd.append('title', title);
    fd.append('side', side);
    fd.append('page', page);
    fd.append('assignedDeveloper', developer);
    fd.append('severity', severity);
    fd.append('description', description);
    for (var i = 0; i < files.length && i < 3; i++) fd.append('screenshots', files[i]);

    try {
      var res = await fetch('/admin/support/report', {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF },
        body: fd,
      });
      var data = await res.json();

      if (data.success) {
        Swal.fire({
          icon: data.emailed ? 'success' : 'warning',
          title: data.emailed ? 'Report sent' : 'Report saved',
          text: data.message,
          confirmButtonColor: '#6777ef',
        }).then(function () { location.reload(); });
      } else {
        Swal.fire({ icon: 'error', text: data.message || 'Could not submit.', confirmButtonColor: '#6777ef' });
        btn.disabled = false;
        btn.innerHTML = orig;
      }
    } catch (e) {
      Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#6777ef' });
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  }

  // ── Remind ─────────────────────────────────────────────────────────────────
  async function remindReport(id, btn) {
    var orig = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.innerHTML = 'Sending…'; }
    try {
      var res = await fetch('/admin/support/report/' + id + '/remind', {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF },
      });
      var data = await res.json();
      Swal.fire({
        icon: data.success ? 'success' : 'error',
        text: data.message,
        toast: data.success, position: 'top', timer: data.success ? 1800 : undefined,
        showConfirmButton: !data.success,
        confirmButtonColor: '#6777ef',
      });
    } catch (e) {
      Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#6777ef' });
    }
    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
  }

  // ── View one report ────────────────────────────────────────────────────────
  function viewReport(id) {
    var r = ALL_REPORTS.find(function (x) { return String(x._id) === String(id); });
    if (!r) return;

    var when = new Date(r.createdAt).toLocaleString('en-GB');
    var shots = (r.screenshots || []).map(function (s) {
      return '<a href="/uploads/' + encodeURIComponent(s.filename) + '" target="_blank" rel="noopener" '
        + 'style="display:inline-block;margin:4px 6px 0 0;">'
        + '<img src="/uploads/' + encodeURIComponent(s.filename) + '" alt="" '
        + 'style="width:64px;height:64px;object-fit:cover;border-radius:6px;border:1px solid #e6e8eb;"></a>';
    }).join('');

    var meta = ''
      + '<div style="text-align:left;font-size:13px;line-height:1.7;">'
      +   '<div><strong>Side:</strong> ' + escapeHtml(SIDE_LABEL_JS[r.side] || r.side) + '</div>'
      +   '<div><strong>Page:</strong> ' + escapeHtml(r.page) + '</div>'
      +   '<div><strong>Severity:</strong> ' + escapeHtml(r.severity) + '</div>'
      +   '<div><strong>Assigned to:</strong> ' + escapeHtml(r.assignedDeveloperName || 'Unassigned') + '</div>'
      +   '<div><strong>Status:</strong> ' + (r.fixed ? 'Fixed' : 'Unfixed') + '</div>'
      +   (IS_SUPER ? '<div><strong>Reported by:</strong> ' + escapeHtml(r.reporterName || 'Unknown') + '</div>' : '')
      +   '<div><strong>Submitted:</strong> ' + escapeHtml(when) + '</div>'
      +   (r.lastRemindedAt ? '<div><strong>Last reminded:</strong> ' + escapeHtml(new Date(r.lastRemindedAt).toLocaleString('en-GB')) + '</div>' : '')
      +   '<div style="margin-top:10px;padding:10px 12px;background:#f9fafb;border-left:3px solid #15a844;border-radius:6px;white-space:pre-wrap;">'
      +     escapeHtml(r.description)
      +   '</div>'
      +   (shots ? '<div style="margin-top:10px;">' + shots + '</div>' : '')
      +   (r.fixNote
            ? '<div style="margin-top:10px;"><strong>Fix note:</strong> ' + escapeHtml(r.fixNote) + '</div>'
            : '')
      + '</div>';

    if (!IS_SUPER) {
      Swal.fire({
        title: r.title, html: meta, width: 620,
        showCancelButton: true,
        confirmButtonText: 'Close', cancelButtonText: 'Remind',
        confirmButtonColor: '#6777ef', cancelButtonColor: '#28a745',
        reverseButtons: true,
      }).then(function (result) {
        if (result.dismiss === Swal.DismissReason.cancel) remindReport(id);
      });
      return;
    }

    // A super admin triages from the same dialog they read it in.
    Swal.fire({
      title: r.title,
      html: meta
        + '<div style="text-align:left;margin-top:14px;">'
        +   '<label style="font-size:12.5px;font-weight:600;display:block;margin-bottom:4px;">Status</label>'
        +   '<select id="swal-fixed" class="swal2-select" style="width:100%;margin:0;">'
        +     '<option value="false"' + (!r.fixed ? ' selected' : '') + '>Unfixed</option>'
        +     '<option value="true"' + (r.fixed ? ' selected' : '') + '>Fixed</option>'
        +   '</select>'
        +   '<label style="font-size:12.5px;font-weight:600;display:block;margin:10px 0 4px;">Reassign to <span style="font-weight:400;color:#8b919c;">(optional)</span></label>'
        +   '<select id="swal-developer" class="swal2-select" style="width:100%;margin:0;">'
        +     '<option value="">— keep ' + escapeHtml(r.assignedDeveloperName || 'unassigned') + ' —</option>'
        +     ACTIVE_DEVELOPERS.map(function (d) {
                return '<option value="' + d._id + '">' + escapeHtml(d.name) + '</option>';
              }).join('')
        +   '</select>'
        +   '<label style="font-size:12.5px;font-weight:600;display:block;margin:10px 0 4px;">Fix note</label>'
        +   '<textarea id="swal-note" class="swal2-textarea" style="width:100%;margin:0;" rows="2"'
        +     ' placeholder="What was done about it">' + escapeHtml(r.fixNote || '') + '</textarea>'
        + '</div>',
      width: 620,
      showCancelButton: true,
      showDenyButton: true,
      confirmButtonText: 'Save',
      denyButtonText: 'Remind',
      denyButtonColor: '#28a745',
      confirmButtonColor: '#6777ef',
      preConfirm: function () {
        return {
          fixed: document.getElementById('swal-fixed').value,
          fixNote: document.getElementById('swal-note').value.trim(),
          assignedDeveloper: document.getElementById('swal-developer').value,
        };
      },
    }).then(async function (result) {
      if (result.isDenied) { remindReport(id); return; }
      if (!result.isConfirmed) return;
      try {
        var res = await fetch('/admin/support/report/' + id + '/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body: JSON.stringify(result.value),
        });
        var data = await res.json();
        if (data.success) {
          Swal.fire({ icon: 'success', text: data.message, toast: true, position: 'top', timer: 1600, showConfirmButton: false });
          setTimeout(function () { location.reload(); }, 1200);
        } else {
          Swal.fire({ icon: 'error', text: data.message || 'Could not update.', confirmButtonColor: '#6777ef' });
        }
      } catch (e) {
        Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#6777ef' });
      }
    });
  }

  // ── Delete ─────────────────────────────────────────────────────────────────
  async function deleteReport(id, btn) {
    var confirmed = await Swal.fire({
      icon: 'warning',
      title: 'Delete this report?',
      text: 'This cannot be undone.',
      showCancelButton: true,
      confirmButtonText: 'Delete',
      confirmButtonColor: '#dc3545',
    });
    if (!confirmed.isConfirmed) return;

    btn.disabled = true;
    try {
      var res = await fetch('/admin/support/report/' + id + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      });
      var data = await res.json();
      if (data.success) {
        var row = btn.closest('tr');
        if (row) row.remove();
        Swal.fire({ icon: 'success', text: data.message, toast: true, position: 'top', timer: 1600, showConfirmButton: false });
      } else {
        Swal.fire({ icon: 'error', text: data.message || 'Could not delete.', confirmButtonColor: '#6777ef' });
        btn.disabled = false;
      }
    } catch (e) {
      Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#6777ef' });
      btn.disabled = false;
    }
  }
</script>
