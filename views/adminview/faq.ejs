<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
<style>
  #editor { min-height: 200px; font-size: 14px; }
  .ql-container { border-radius: 0 0 4px 4px; }
  .ql-toolbar { border-radius: 4px 4px 0 0; }
  #link-popover { background: #f8f9ff; border: 1px solid #e4e6fc; border-radius: 6px; padding: 16px; margin-top: 8px; }
  .editing-banner { background: #fff3cd; border: 1px solid #ffc107; border-radius: 6px; padding: 10px 16px; margin-bottom: 12px; font-size: 13px; font-weight: 600; color: #856404; }
</style>

<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1 kp-has-drawer">
    <div class="navbar-bg"></div>
    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <%
            var _navSections = [
              { id: 'editor', label: 'New / Edit', icon: 'edit-3' },
              { id: 'list',   label: 'All FAQs',   icon: 'list', badge: faqs.length }
            ];
          %>

          <div class="kp-panel">

            <div class="kp-panel__head">
              <h1 class="kp-panel__title">FAQ Manager</h1>
              <p class="kp-panel__sub kp-panel__section-label"><%= _navSections[0].label %></p>
            </div>

            <div class="kp-panel__body">

              <%- include('partials/panelDrawer', {
                panelKey: 'faq',
                drawerLabel: 'FAQ Manager',
                sections: _navSections
              }) %>

              <div class="kp-panel__main">

                <!-- ══ Editor ════════════════════════════════════════════ -->
                <div class="kp-section" data-section="editor">
                  <div class="kp-card" id="faq-editor-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title" id="editor-card-title">Add new FAQ</h2>
                    </div>
                    <div class="kp-card__body kp-card__body--pad">
                      <%
                        var FAQ_CATEGORIES = [
                          { id: 'getting-started', label: 'Getting Started' },
                          { id: 'wallet',          label: 'Wallet & Payments' },
                          { id: 'data',            label: 'Data Bundles' },
                          { id: 'courses',         label: 'Courses' },
                          { id: 'account',         label: 'Account & Profile' },
                          { id: 'rewards',         label: 'Reward Points' },
                        ];
                      %>

              <div id="editing-banner" class="kp-note kp-note--warn" style="display:none;"></div>

              <div class="kp-row kp-row--stack">
                <div class="kp-row__main"><span class="kp-row__label">Question</span></div>
                <input type="text" id="faq-question" class="kp-input" style="width:100%;" placeholder="Enter the FAQ question…">
              </div>

              <div class="kp-row">
                <div class="kp-row__main"><span class="kp-row__label">Category</span></div>
                <div class="kp-row__ctrl" style="width:220px;">
                    <select id="faq-category" class="kp-select" style="width:100%;">
                      <option value="">— Select category —</option>
                      <% FAQ_CATEGORIES.forEach(function (c) { %>
                      <option value="<%= c.id %>"><%= c.label %></option>
                      <% }) %>
                    </select>
                </div>
              </div>

              <div class="kp-row kp-row--stack">
                <div class="kp-row__main"><span class="kp-row__label">Answer</span></div>

                <div id="quill-toolbar">
                  <span class="ql-formats">
                    <button class="ql-bold"></button>
                    <button class="ql-italic"></button>
                    <button class="ql-underline"></button>
                  </span>
                  <span class="ql-formats">
                    <button class="ql-list" value="ordered"></button>
                    <button class="ql-list" value="bullet"></button>
                  </span>
                  <span class="ql-formats">
                    <button class="ql-blockquote"></button>
                    <button class="ql-clean"></button>
                  </span>
                  <span class="ql-formats">
                    <button class="ql-link" title="Insert Link"></button>
                  </span>
                </div>
                <div id="editor"></div>

                <!-- Link popover -->
                <div id="link-popover" style="display:none;">
                  <p class="mb-2" style="font-size:13px;font-weight:700;color:#495057;">Insert Link</p>
                  <div class="row">
                    <div class="col-12 col-md-5">
                      <div class="form-group mb-2">
                        <label style="font-size:12px;font-weight:600;">Link Text (display text)</label>
                        <input type="text" id="link-text" class="form-control form-control-sm" placeholder="e.g. Click here">
                      </div>
                    </div>
                    <div class="col-12 col-md-7">
                      <div class="form-group mb-2">
                        <label style="font-size:12px;font-weight:600;">URL</label>
                        <input type="text" id="link-url" class="form-control form-control-sm" placeholder="https://...">
                      </div>
                    </div>
                  </div>
                  <div style="display:flex;gap:8px;">
                    <button type="button" class="btn btn-sm btn-primary" onclick="insertLink()">Insert Link</button>
                    <button type="button" class="btn btn-sm btn-light" onclick="closeLinkPopover()">Cancel</button>
                  </div>
                </div>
              </div>

              <div class="kp-row">
                <div class="kp-row__main"><span class="kp-row__label">Visible to users</span></div>
                <div class="kp-row__ctrl">
                  <label class="kp-toggle">
                    <input type="checkbox" id="faq-active" checked>
                    <span class="kp-toggle__track"></span>
                  </label>
                </div>
              </div>
                    </div>
                    <div class="kp-card__foot">
                      <button type="button" class="kp-btn kp-btn--primary" id="save-btn" onclick="saveFaq()">Save FAQ</button>
                      <button type="button" class="kp-btn" id="cancel-edit-btn" style="display:none;" onclick="resetForm()">Cancel</button>
                    </div>
                  </div>
                </div>

                <!-- ══ List ══════════════════════════════════════════════ -->
                <div class="kp-section" data-section="list">
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">All FAQs</h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill" id="faq-count"><%= faqs.length %></span>
                <select class="kp-select" id="category-filter" onchange="filterTable(this.value)" style="width:190px;height:32px;font-size:12.5px;">
                  <option value="">All categories</option>
                  <% FAQ_CATEGORIES.forEach(function (c) { %>
                  <option value="<%= c.id %>"><%= c.label %></option>
                  <% }) %>
                </select>
                            </div>
            </div>
                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                <table class="kp-table" id="faq-table">
                  <thead>
                    <tr>
                      <th style="width:160px;">Category</th>
                      <th>Question</th>
                      <th style="width:90px;">Status</th>
                      <th style="width:100px;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (faqs && faqs.length) { %>
                    <%
                      function catLabel(c) {
                        return { 'getting-started': 'Getting Started', 'wallet': 'Wallet & Payments',
                                 'data': 'Data Bundles', 'courses': 'Courses',
                                 'account': 'Account & Profile', 'rewards': 'Reward Points' }[c] || c;
                      }
                    %>
                    <% faqs.forEach(function(faq) { %>
                    <tr data-id="<%= faq._id %>" data-category="<%= faq.category %>">
                      <td><span class="kp-pill"><%= catLabel(faq.category) %></span></td>
                      <td style="font-size:13px;"><%= faq.question %></td>
                      <td>
                        <% if (faq.isActive) { %>
                          <span class="kp-pill kp-pill--good">Active</span>
                        <% } else { %>
                          <span class="kp-pill">Hidden</span>
                        <% } %>
                      </td>
                      <td>
                        <button class="kp-btn kp-btn--sm" onclick="editFaq('<%= faq._id %>')" title="Edit">Edit</button>
                        <button class="kp-btn kp-btn--sm kp-btn--danger" onclick="deleteFaq('<%= faq._id %>', this)" title="Delete">Delete</button>
                      </td>
                    </tr>
                    <% }) %>
                    <% } else { %>
                    <tr id="empty-row">
                      <td colspan="4"><div class="kp-empty">No FAQs yet. Create one on the left.</div></td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
                      </div>
                    </div>
                  </div>
                </div>

              </div><!-- /kp-panel__main -->
            </div><!-- /kp-panel__body -->
          </div><!-- /kp-panel -->

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script src="/admin/assets/js/kbc-panel.js"></script>
<script>
var ALL_FAQS = <%- JSON.stringify(faqs.map(function(f) {
  return { _id: String(f._id), question: f.question, answer: f.answer, category: f.category, isActive: f.isActive };
})) %>;

var CSRF = '<%= csrfToken %>';
var currentEditId = null;

// ── Quill init ────────────────────────────────────────────────────────────────
var quill = new Quill('#editor', {
  theme: 'snow',
  modules: {
    toolbar: {
      container: '#quill-toolbar',
      handlers: { 'link': showLinkPopover }
    }
  },
  placeholder: 'Write the FAQ answer here…',
});

// ── Link popover ──────────────────────────────────────────────────────────────
var _savedRange = null;

function showLinkPopover() {
  _savedRange = quill.getSelection(true);
  var existingText = '';
  var existingUrl  = '';
  if (_savedRange && _savedRange.length > 0) {
    existingText = quill.getText(_savedRange.index, _savedRange.length).trim();
    var fmt = quill.getFormat(_savedRange);
    if (fmt.link) existingUrl = fmt.link;
  }
  document.getElementById('link-text').value = existingText;
  document.getElementById('link-url').value  = existingUrl;
  document.getElementById('link-popover').style.display = 'block';
  document.getElementById(existingText ? 'link-url' : 'link-text').focus();
}

function insertLink() {
  var text = document.getElementById('link-text').value.trim();
  var url  = document.getElementById('link-url').value.trim();
  if (!text || !url) {
    Swal.fire({ icon: 'warning', text: 'Both Link Text and URL are required.', toast: true, position: 'top', timer: 2500, showConfirmButton: false });
    return;
  }
  if (!url.match(/^https?:\/\//)) url = 'https://' + url;
  quill.focus();
  var range = _savedRange;
  if (range && range.length > 0) {
    quill.deleteText(range.index, range.length);
    quill.insertText(range.index, text, 'link', url);
    quill.setSelection(range.index + text.length);
  } else {
    var idx = range ? range.index : Math.max(0, quill.getLength() - 1);
    quill.insertText(idx, text, 'link', url);
    quill.setSelection(idx + text.length);
  }
  closeLinkPopover();
}

function closeLinkPopover() {
  document.getElementById('link-popover').style.display = 'none';
  document.getElementById('link-text').value = '';
  document.getElementById('link-url').value  = '';
}

document.getElementById('link-url').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') { e.preventDefault(); insertLink(); }
});

// ── Reset form ────────────────────────────────────────────────────────────────
function resetForm() {
  currentEditId = null;
  document.getElementById('faq-question').value = '';
  document.getElementById('faq-category').value = '';
  document.getElementById('faq-active').checked = true;
  quill.setContents([]);
  document.getElementById('editor-card-title').textContent = 'Add New FAQ';
  document.getElementById('save-btn').innerHTML = '<i class="fas fa-save mr-1"></i> Save FAQ';
  document.getElementById('cancel-edit-btn').style.display = 'none';
  document.getElementById('editing-banner').style.display = 'none';
  closeLinkPopover();
}

// ── Edit FAQ ──────────────────────────────────────────────────────────────────
function editFaq(id) {
  var faq = ALL_FAQS.find(function(f) { return f._id === id; });
  if (!faq) return;

  currentEditId = faq._id;
  document.getElementById('faq-question').value = faq.question;
  document.getElementById('faq-category').value = faq.category;
  document.getElementById('faq-active').checked = faq.isActive;
  quill.root.innerHTML = faq.answer;

  document.getElementById('editor-card-title').textContent = 'Edit FAQ';
  document.getElementById('save-btn').innerHTML = '<i class="fas fa-save mr-1"></i> Update FAQ';
  document.getElementById('cancel-edit-btn').style.display = '';

  var banner = document.getElementById('editing-banner');
  banner.textContent = 'Editing: ' + faq.question;
  banner.style.display = 'block';

  var editorTab = document.querySelector('.kp-drawer__item[data-target="editor"]');
  if (editorTab) editorTab.click();
  document.getElementById('faq-editor-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── Save (create or update) ───────────────────────────────────────────────────
async function saveFaq() {
  var question = document.getElementById('faq-question').value.trim();
  var category = document.getElementById('faq-category').value;
  var answer   = quill.root.innerHTML.trim();
  var isActive = document.getElementById('faq-active').checked;

  if (!question) {
    Swal.fire({ icon: 'warning', text: 'Please enter a question.', confirmButtonColor: '#6777ef' });
    return;
  }
  if (!category) {
    Swal.fire({ icon: 'warning', text: 'Please select a category.', confirmButtonColor: '#6777ef' });
    return;
  }
  if (answer === '<p><br></p>' || !answer) {
    Swal.fire({ icon: 'warning', text: 'Please enter an answer.', confirmButtonColor: '#6777ef' });
    return;
  }

  var btn  = document.getElementById('save-btn');
  var orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Saving…';

  try {
    var url = currentEditId
      ? '/admin/faq/' + currentEditId + '/update'
      : '/admin/faq/create';

    var res  = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ question, category, answer, isActive }),
    });
    var data = await res.json();

    if (data.success) {
      Swal.fire({ icon: 'success', text: data.message, toast: true, position: 'top', timer: 2000, showConfirmButton: false });
      setTimeout(function() { location.reload(); }, 1400);
    } else {
      Swal.fire({ icon: 'error', text: data.message || 'Failed to save.', confirmButtonColor: '#6777ef' });
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  } catch (e) {
    Swal.fire({ icon: 'error', text: 'Server error. Please try again.', confirmButtonColor: '#6777ef' });
    btn.disabled = false;
    btn.innerHTML = orig;
  }
}

// ── Delete FAQ ────────────────────────────────────────────────────────────────
async function deleteFaq(id, btn) {
  var result = await Swal.fire({
    icon: 'warning',
    title: 'Delete this FAQ?',
    text: 'This action cannot be undone.',
    showCancelButton: true,
    confirmButtonColor: '#e55353',
    confirmButtonText: 'Delete',
    cancelButtonText: 'Cancel',
  });
  if (!result.isConfirmed) return;

  try {
    var res  = await fetch('/admin/faq/' + id + '/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
    });
    var data = await res.json();
    if (data.success) {
      var row = btn.closest('tr');
      row.remove();
      ALL_FAQS = ALL_FAQS.filter(function(f) { return f._id !== id; });
      var countEl = document.getElementById('faq-count');
      if (countEl) countEl.textContent = parseInt(countEl.textContent || '0') - 1;
      if (currentEditId === id) resetForm();
      Swal.fire({ icon: 'success', text: 'FAQ deleted.', toast: true, position: 'top', timer: 1800, showConfirmButton: false });
    } else {
      Swal.fire({ icon: 'error', text: data.message || 'Delete failed.', confirmButtonColor: '#6777ef' });
    }
  } catch (e) {
    Swal.fire({ icon: 'error', text: 'Server error.', confirmButtonColor: '#6777ef' });
  }
}

// ── Category filter ───────────────────────────────────────────────────────────
function filterTable(category) {
  var rows = document.querySelectorAll('#faq-table tbody tr[data-id]');
  rows.forEach(function(row) {
    row.style.display = (!category || row.dataset.category === category) ? '' : 'none';
  });
}
</script>
