<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../../partials/headerAdmin.ejs') %>
    <%- include('../../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <!-- Summary cards -->
          <div class="row mb-3">
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-primary"><i class="fas fa-users"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Total Users</h4></div>
                  <div class="card-body"><%= stats.total %></div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-user-check"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Verified</h4></div>
                  <div class="card-body"><%= stats.verified %></div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-user-clock"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Unverified</h4></div>
                  <div class="card-body"><%= stats.unverified %></div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-info"><i class="fas fa-id-card"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>With Miner ID</h4></div>
                  <div class="card-body"><%= stats.withMinerId %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap" style="gap:8px;">
                  <h4 class="mb-0">All Users</h4>
                  <input type="text" id="users-search-input" class="form-control"
                         placeholder="Search name, email, phone…" style="max-width:300px;">
                </div>
                <div class="card-body">
                  <div class="table-responsive">
                    <table class="table table-striped" id="admin-users-server" style="width:100%">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>User</th>
                          <th>Phone</th>
                          <th>Country</th>
                          <th>Miner ID</th>
                          <th>RP Balance</th>
                          <th>Verified</th>
                          <th>Registered</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody></tbody>
                    </table>
                  </div>
                </div>

                <script>
                window.addEventListener('load', function () {
                  var dt = $('#admin-users-server').DataTable({
                    serverSide: true,
                    processing: true,
                    destroy:    true,
                    ajax: { url: '/admin/product/view-users/data', type: 'GET' },
                    dom: 'lrtip',
                    columns: [
                      { data: 'rowNum', orderable: false },
                      { data: 'username', render: function(d, t, row) {
                          return '<b>' + d + '</b><br><small class="text-muted">' + row.email + '</small>';
                        }
                      },
                      { data: 'phone' },
                      { data: 'country' },
                      { data: 'minerId', orderable: false, render: function(d) {
                          return d ? '<span class="badge badge-info">' + d + '</span>' : '<span class="text-muted">—</span>';
                        }
                      },
                      { data: null, orderable: false, render: function() { return '<span class="text-muted">—</span>'; } },
                      { data: 'isVerified', orderable: false, render: function(d) {
                          return d
                            ? '<span class="badge badge-success">Verified</span>'
                            : '<span class="badge badge-danger">Unverified</span>';
                        }
                      },
                      { data: 'createdAt' },
                      { data: 'id', orderable: false, render: function(d) {
                          return '<a href="/admin/product/user-details/' + d + '" class="btn btn-sm btn-primary" style="border-radius:20px;">View Details</a>';
                        }
                      },
                    ],
                    order:      [[7, 'desc']],
                    pageLength: 25,
                    lengthMenu: [[25, 50, 100, 250], [25, 50, 100, 250]],
                    language: {
                      processing: 'Loading users…',
                      emptyTable:  'No users found',
                    },
                  });

                  var searchTimer;
                  document.getElementById('users-search-input').addEventListener('input', function () {
                    var q = this.value;
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () { dt.search(q).draw(); }, 400);
                  });
                });
                </script>
              </div>
            </div>
          </div>

        </div>
      </section>
    </div>

    <footer class="main-footer">
      <div class="footer-left">Kabacu Admin</div>
    </footer>
  </div>
</div>
