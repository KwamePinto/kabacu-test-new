<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../../partials/headerAdmin.ejs') %>
    <%- include('../../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <div class="row align-items-center mb-3">
            <div class="col">
              <a href="/admin/product/view-users" class="btn btn-light">
                <i class="fas fa-arrow-left"></i> Back to Users
              </a>
            </div>
          </div>

          <!-- User identity card -->
          <div class="row mb-3">
            <div class="col-12">
              <div class="card">
                <div class="card-body d-flex align-items-center flex-wrap" style="gap: 16px;">
                  <div class="d-flex align-items-center justify-content-center" style="width:64px;height:64px;border-radius:50%;background:#e9ecef;font-size:24px;font-weight:700;color:#495057;flex-shrink:0;">
                    <%= (user.username || '?').charAt(0).toUpperCase() %>
                  </div>
                  <div style="flex:1;min-width:200px;">
                    <h4 class="mb-1"><%= user.username %></h4>
                    <div class="text-muted"><%= user.email %></div>
                  </div>
                  <div>
                    <% if (user.isVerified) { %>
                    <span class="badge badge-success">Verified</span>
                    <% } else { %>
                    <span class="badge badge-danger">Unverified</span>
                    <% } %>
                    <span class="badge badge-secondary text-uppercase"><%= user.role === 'users' ? 'User' : (user.role || 'user') %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Summary cards -->
          <div class="row mb-3">
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-wallet"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>Wallet Balance</h4>
                  </div>
                  <div class="card-body">₦<%= Number(walletBalances.NAIRA || user.walletBalance || 0).toLocaleString() %></div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-coins"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>RP Balance</h4>
                  </div>
                  <div class="card-body"><%= user.rpBalance || 0 %> RP</div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-primary"><i class="fas fa-coins"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>BTT Balance</h4>
                  </div>
                  <div class="card-body"><%= Number(walletBalances.BTT || 0).toLocaleString() %> BTT</div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-info"><i class="fas fa-dollar-sign"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>USDT Balance</h4>
                  </div>
                  <div class="card-body"><%= Number(walletBalances.USDT || 0).toLocaleString() %> USDT</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Admin actions -->
          <div class="row mb-3">
            <div class="col-12">
              <button id="deduct-wallet-btn" class="btn btn-danger btn-sm">
                <i class="fas fa-minus-circle"></i> Deduct Wallet
              </button>
              <button id="refund-deduction-btn" class="btn btn-success btn-sm ml-2">
                <i class="fas fa-undo-alt"></i> Refund Deduction
              </button>
            </div>
          </div>

          <!-- Tabs -->
          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                      <a class="nav-link active" data-toggle="tab" href="#tab-profile" role="tab">Profile</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-topups" role="tab">Top-ups</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-transactions" role="tab">Transactions</a>
                    </li>
                  </ul>
                </div>
                <div class="card-body">
                  <div class="tab-content">

                    <!-- Profile tab -->
                    <div class="tab-pane fade show active" id="tab-profile" role="tabpanel">
                      <div class="row">
                        <div class="col-md-6">
                          <table class="table table-striped">
                            <tbody>
                              <tr>
                                <th style="width:40%;">User ID</th>
                                <td><small><%= user._id %></small></td>
                              </tr>
                              <tr>
                                <th>Username</th>
                                <td><%= user.username %></td>
                              </tr>
                              <tr>
                                <th>Email</th>
                                <td><%= user.email %></td>
                              </tr>
                              <tr>
                                <th>Phone Number</th>
                                <td><%= user.phone_number || '—' %></td>
                              </tr>
                              <tr>
                                <th>Country</th>
                                <td><%= user.country || '—' %></td>
                              </tr>
                              <tr>
                                <th>Miner ID</th>
                                <td><%= user.minerId || '—' %></td>
                              </tr>
                              <tr>
                                <th>Role</th>
                                <td class="text-capitalize"><%= user.role === 'users' ? 'User' : (user.role || '—') %></td>
                              </tr>
                              <tr>
                                <th>Verification Status</th>
                                <td>
                                  <% if (user.isVerified) { %>
                                  <span class="badge badge-success">Verified</span>
                                  <% } else { %>
                                  <span class="badge badge-danger">Unverified</span>
                                  <% } %>
                                </td>
                              </tr>
                              <tr>
                                <th>Account Created</th>
                                <td><%= user._id.getTimestamp().toLocaleString() %></td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                        <div class="col-md-6">
                          <table class="table table-striped">
                            <tbody>
                              <tr>
                                <th style="width:40%;">Wallet — NAIRA</th>
                                <td>₦<%= Number(walletBalances.NAIRA || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Wallet — RP</th>
                                <td><%= Number(walletBalances.RP || 0).toLocaleString() %> RP</td>
                              </tr>
                              <tr>
                                <th>Wallet — BTT</th>
                                <td><%= Number(walletBalances.BTT || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Wallet — USDT</th>
                                <td><%= Number(walletBalances.USDT || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Spent (successful)</th>
                                <td>₦<%= Number(totalSpent).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Topped Up (completed)</th>
                                <td>₦<%= Number(totalToppedUp).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Transactions</th>
                                <td><%= transactions.length %></td>
                              </tr>
                              <tr>
                                <th>Total Top-ups</th>
                                <td><%= topups.length %></td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>

                    <!-- Top-ups tab -->
                    <div class="tab-pane fade" id="tab-topups" role="tabpanel">
                      <div class="table-responsive">
                        <table class="table table-striped" id="table-topups">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Reference</th>
                              <th>Amount</th>
                              <th>Naira Amount</th>
                              <th>Balance Type</th>
                              <th>Payment Method</th>
                              <th>Status</th>
                              <th>Wallet Credited</th>
                              <th>Date</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (topups && topups.length > 0) { %>
                            <% topups.forEach((topup, index) => { %>
                            <tr>
                              <td><%= index + 1 %></td>
                              <td><small><%= topup.reference || 'N/A' %></small></td>
                              <td><%= Number(topup.amount).toLocaleString() %></td>
                              <td>
                                <% if (topup.nairaAmount) { %>
                                ₦<%= Number(topup.nairaAmount).toLocaleString() %>
                                <% } else { %>
                                —
                                <% } %>
                              </td>
                              <td><span class="badge badge-info"><%= topup.balanceType %></span></td>
                              <td>
                                <span class="badge badge-primary">
                                  <% if (['RP', 'BTT', 'USDT'].includes(topup.balanceType)) { %>
                                  Bittoken
                                  <% } else { %>
                                  <%= topup.paymentMethod || 'N/A' %>
                                  <% } %>
                                </span>
                              </td>
                              <td>
                                <% if (topup.status === 'COMPLETED') { %>
                                <span class="badge badge-success">Completed</span>
                                <% } else if (topup.status === 'FAILED') { %>
                                <span class="badge badge-danger">Failed</span>
                                <% } else { %>
                                <span class="badge badge-warning">Pending</span>
                                <% } %>
                              </td>
                              <td>
                                <% if (topup.walletCredited) { %>
                                <span class="badge badge-success">Yes</span>
                                <% } else { %>
                                <span class="badge badge-danger">No</span>
                                <% } %>
                              </td>
                              <td><%= new Date(topup.createdAt).toLocaleString() %></td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="9" class="text-center">No top-up records found</td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                    <!-- Transactions tab -->
                    <div class="tab-pane fade" id="tab-transactions" role="tabpanel">
                      <div class="table-responsive">
                        <table class="table table-striped" id="table-transactions">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Type</th>
                              <th>Reference</th>
                              <th>Product</th>
                              <th>Qty</th>
                              <th>Amount</th>
                              <th>Wallet</th>
                              <th>RP Earned</th>
                              <th>Prev Bal</th>
                              <th>New Bal</th>
                              <th>Status</th>
                              <th>Date</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (transactions && transactions.length > 0) { %>
                            <% transactions.forEach((tx, index) => {
                                 var productName = 'N/A';
                                 if (tx.product && tx.product.item_name) {
                                   productName = tx.product.item_name;
                                 } else if (tx.product && tx.product.dataDetails && tx.product.dataDetails.plan_name) {
                                   productName = tx.product.dataDetails.plan_name;
                                 } else if (tx.products && tx.products.length > 0) {
                                   var names = tx.products
                                     .filter(function(p){ return p.product; })
                                     .map(function(p){ return p.product.item_name || (p.product.dataDetails && p.product.dataDetails.plan_name) || '?'; });
                                   if (names.length > 0) productName = names.join(', ');
                                 }

                                 var qty = 1;
                                 if (tx.products && tx.products.length > 0) {
                                   qty = tx.products.reduce(function(s, p){ return s + (p.quantity || 1); }, 0);
                                 }

                                 var apiBefore = tx.apiResponse && tx.apiResponse.balanceBefore != null ? tx.apiResponse.balanceBefore
                                                 : (tx.apiResponse && tx.apiResponse.refundBalBefore != null ? tx.apiResponse.refundBalBefore : null);
                                 var apiAfter  = tx.apiResponse && tx.apiResponse.balanceAfter  != null ? tx.apiResponse.balanceAfter
                                                 : (tx.apiResponse && tx.apiResponse.refundBalAfter  != null ? tx.apiResponse.refundBalAfter  : null);
                                 var prevBalNum = tx.balanceBefore != null ? tx.balanceBefore : apiBefore;
                                 var newBalNum  = tx.balanceAfter  != null ? tx.balanceAfter  : apiAfter;
                                 var prevBal = prevBalNum != null ? '₦' + Number(prevBalNum).toLocaleString() : '—';
                                 var newBal  = newBalNum  != null ? '₦' + Number(newBalNum).toLocaleString()  : '—';

                                 var isRefund    = tx.status === 'refunded' || !!(tx.apiResponse && tx.apiResponse.adminRefunded);
                                 var isDeduction = !isRefund && !!(tx.apiResponse && tx.apiResponse.adminDeducted);
                            %>
                            <tr>
                              <td><%= index + 1 %></td>
                              <td>
                                <% if (isRefund) { %>
                                  <span class="badge" style="background:#17a2b8;color:#fff;">Refund</span>
                                <% } else if (isDeduction) { %>
                                  <span class="badge badge-warning" style="color:#fff;">Deduction</span>
                                <% } else { %>
                                  <span class="badge badge-primary">Payment</span>
                                <% } %>
                              </td>
                              <td><small><%= tx.reference %></small></td>
                              <td><%= productName %></td>
                              <td><%= qty %></td>
                              <td>₦<%= tx.amount.toLocaleString() %></td>
                              <td><span class="badge badge-info"><%= tx.walletType %></span></td>
                              <td><span class="badge badge-success"><%= tx.rpEarned || 0 %></span></td>
                              <td><small><%= prevBal %></small></td>
                              <td><small><%= newBal %></small></td>
                              <td>
                                <% if (tx.status === 'success') { %>
                                <span class="badge badge-success">Success</span>
                                <% } else if (tx.status === 'failed') { %>
                                <span class="badge badge-danger">Failed</span>
                                <% } else { %>
                                <span class="badge badge-warning"><%= tx.status %></span>
                                <% } %>
                              </td>
                              <td><small><%= new Date(tx.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small></td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="12" class="text-center">No transactions found</td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                      <div class="mt-2">
                        <small class="text-muted">
                          Total Transactions = <%= transactions.length %>
                          &nbsp;&nbsp;
                          <span style="color: #28a745;">Successful = <%= successfulTransactions %></span>
                          &nbsp;&nbsp;
                          <span style="color: #dc3545;">Failed = <%= failedTransactions %></span>
                        </small>
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>
    </div>

    <footer class="main-footer">
      <div class="footer-left">Kabacu Admin</div>
    </footer>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
(function () {
  var csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
  var userId    = '<%= user._id %>';
  var username  = '<%= user.username || user.email %>';

  document.getElementById('deduct-wallet-btn').addEventListener('click', function () {
    Swal.fire({
      title: 'Deduct Wallet',
      html:
        '<p class="text-muted mb-3">Deducting from <strong>' + username + '</strong>\'s NAIRA wallet.<br>The balance may go negative.</p>' +
        '<div class="form-group text-left mb-2">' +
          '<label>Amount (₦)</label>' +
          '<input id="swal-amount" type="number" min="1" class="form-control" placeholder="e.g. 500">' +
        '</div>' +
        '<div class="form-group text-left">' +
          '<label>Reason <small class="text-muted">(optional)</small></label>' +
          '<input id="swal-reason" type="text" class="form-control" placeholder="e.g. Chargeback adjustment">' +
        '</div>',
      showCancelButton: true,
      confirmButtonText: 'Deduct',
      confirmButtonColor: '#dc3545',
      preConfirm: function () {
        var amount = document.getElementById('swal-amount').value;
        if (!amount || parseFloat(amount) <= 0) {
          Swal.showValidationMessage('Enter a valid amount greater than 0.');
          return false;
        }
        return {
          amount: amount,
          reason: document.getElementById('swal-reason').value,
        };
      },
    }).then(function (result) {
      if (!result.isConfirmed) return;

      fetch('/admin/product/user-details/' + userId + '/deduct-wallet', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
        body: JSON.stringify(result.value),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Deducted',
              html: data.message + '<br><small class="text-muted">New balance: ₦' + Number(data.balanceAfter).toLocaleString() + '</small>',
            }).then(function () { location.reload(); });
          } else {
            Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
          }
        })
        .catch(function () {
          Swal.fire({ icon: 'error', title: 'Error', text: 'Request failed. Please try again.' });
        });
    });
  });

  // ── Refund Deduction ──────────────────────────────────────────────────────────
  document.getElementById('refund-deduction-btn').addEventListener('click', async function () {
    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading…';

    try {
      var res  = await fetch('/admin/product/user-details/' + userId + '/available-refunds', {
        headers: { 'X-CSRF-Token': csrfToken },
      });
      var data = await res.json();

      if (!data.success) {
        Swal.fire({ icon: 'error', title: 'Error', text: data.message });
        return;
      }

      if (!data.deductions || data.deductions.length === 0) {
        Swal.fire({
          icon: 'info',
          title: 'No deductions available',
          text: 'There are no unrefunded deductions recorded for this user.',
        });
        return;
      }

      var rows = data.deductions.map(function (d, i) {
        var date    = new Date(d.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        var reason  = (d.apiResponse && d.apiResponse.adminDeductReason) ? d.apiResponse.adminDeductReason : '—';
        var by      = (d.apiResponse && d.apiResponse.adminDeductedBy)   ? d.apiResponse.adminDeductedBy   : 'admin';
        return '<tr class="deduct-row" style="cursor:pointer;" data-id="' + d._id + '">' +
          '<td style="padding:8px 10px;width:36px;"><input type="radio" name="txSelect" value="' + d._id + '" id="swal-tx-' + i + '"></td>' +
          '<td style="padding:8px 10px;white-space:nowrap;font-size:13px;">' + date + '</td>' +
          '<td style="padding:8px 10px;font-weight:700;font-size:13px;">₦' + Number(d.amount).toLocaleString() + '</td>' +
          '<td style="padding:8px 10px;font-size:12px;max-width:180px;word-break:break-word;">' + reason + '</td>' +
          '<td style="padding:8px 10px;font-size:11px;color:#888;">' + by + '</td>' +
        '</tr>';
      }).join('');

      var tableHtml =
        '<p class="text-muted mb-3" style="font-size:13px;">Select a deduction to refund for <strong>' + username + '</strong>:</p>' +
        '<div style="overflow-x:auto;max-height:260px;overflow-y:auto;border:1px solid #dee2e6;border-radius:4px;margin-bottom:16px;">' +
          '<table style="width:100%;border-collapse:collapse;">' +
            '<thead style="background:#f8f9fc;position:sticky;top:0;">' +
              '<tr>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;"></th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Date</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Amount</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Deduction Reason</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">By</th>' +
              '</tr>' +
            '</thead>' +
            '<tbody id="deductions-tbody">' + rows + '</tbody>' +
          '</table>' +
        '</div>' +
        '<div class="form-group text-left mb-0">' +
          '<label style="font-weight:600;font-size:13px;">Refund Reason <span style="color:#dc3545;">*</span></label>' +
          '<input id="swal-refund-reason" type="text" class="form-control" placeholder="e.g. Accidental deduction">' +
        '</div>';

      Swal.fire({
        title: 'Refund a Deduction',
        width: 680,
        html: tableHtml,
        showCancelButton: true,
        confirmButtonText: 'Proceed with Refund',
        confirmButtonColor: '#28a745',
        didOpen: function () {
          document.querySelectorAll('.deduct-row').forEach(function (row) {
            row.addEventListener('click', function () {
              document.querySelectorAll('.deduct-row').forEach(function (r) { r.style.background = ''; });
              this.style.background = '#e8f5e9';
              var radio = this.querySelector('input[type="radio"]');
              if (radio) radio.checked = true;
            });
          });
        },
        preConfirm: function () {
          var selected = document.querySelector('input[name="txSelect"]:checked');
          if (!selected) {
            Swal.showValidationMessage('Please select a deduction to refund.');
            return false;
          }
          var reason = document.getElementById('swal-refund-reason').value.trim();
          if (!reason) {
            Swal.showValidationMessage('A refund reason is required.');
            return false;
          }
          return { transactionId: selected.value, reason: reason };
        },
      }).then(function (result) {
        if (!result.isConfirmed) return;

        fetch('/admin/product/user-details/' + userId + '/refund-deduction', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify(result.value),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.success) {
              Swal.fire({ icon: 'success', title: 'Refunded', text: d.message })
                .then(function () { location.reload(); });
            } else {
              Swal.fire({ icon: 'error', title: 'Failed', text: d.message });
            }
          })
          .catch(function () {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Request failed. Please try again.' });
          });
      });

    } catch (e) {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Could not load deductions. Please try again.' });
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-undo-alt"></i> Refund Deduction';
    }
  });
})();
</script>