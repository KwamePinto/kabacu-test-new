<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../../partials/headerAdmin.ejs') %>
    <%- include('../../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <div class="row align-items-center mb-3">
            <div class="col">
              <a href="/admin/product/view-users" class="btn btn-light">
                <i class="fas fa-arrow-left"></i> Back to Users
              </a>
            </div>
          </div>

          <!-- User identity card -->
          <div class="row mb-3">
            <div class="col-12">
              <div class="card">
                <div class="card-body d-flex align-items-center flex-wrap" style="gap: 16px;">
                  <div class="d-flex align-items-center justify-content-center" style="width:64px;height:64px;border-radius:50%;background:#e9ecef;font-size:24px;font-weight:700;color:#495057;flex-shrink:0;">
                    <%= (user.username || '?').charAt(0).toUpperCase() %>
                  </div>
                  <div style="flex:1;min-width:200px;">
                    <h4 class="mb-1"><%= user.username %></h4>
                    <div class="text-muted"><%= user.email %></div>
                  </div>
                  <div>
                    <% if (user.isVerified) { %>
                    <span class="badge badge-success">Verified</span>
                    <% } else { %>
                    <span class="badge badge-danger">Unverified</span>
                    <% } %>
                    <span class="badge badge-secondary text-uppercase"><%= user.role === 'users' ? 'User' : (user.role || 'user') %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Summary cards -->
          <div class="row mb-3">
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-wallet"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>Wallet Balance</h4>
                  </div>
                  <div class="card-body">₦<%= Number(walletBalances.NAIRA || user.walletBalance || 0).toLocaleString() %></div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-coins"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>RP Balance</h4>
                  </div>
                  <div class="card-body"><%= user.rpBalance || 0 %> RP</div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-primary"><i class="fas fa-coins"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>BTT Balance</h4>
                  </div>
                  <div class="card-body"><%= Number(walletBalances.BTT || 0).toLocaleString() %> BTT</div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-info"><i class="fas fa-dollar-sign"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>USDT Balance</h4>
                  </div>
                  <div class="card-body"><%= Number(walletBalances.USDT || 0).toLocaleString() %> USDT</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Admin actions -->
          <div class="row mb-3">
            <div class="col-12">
              <button id="deduct-wallet-btn" class="btn btn-danger btn-sm">
                <i class="fas fa-minus-circle"></i> Deduct Wallet
              </button>
              <button id="refund-deduction-btn" class="btn btn-success btn-sm ml-2">
                <i class="fas fa-undo-alt"></i> Refund Deduction
              </button>
            </div>
          </div>

          <!-- Tabs -->
          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                      <a class="nav-link active" data-toggle="tab" href="#tab-profile" role="tab">Profile</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-topups" role="tab">Top-ups</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-transactions" role="tab">Account Statements</a>
                    </li>
                  </ul>
                </div>
                <div class="card-body">
                  <div class="tab-content">

                    <!-- Profile tab -->
                    <div class="tab-pane fade show active" id="tab-profile" role="tabpanel">
                      <div class="row">
                        <div class="col-md-6">
                          <table class="table table-striped">
                            <tbody>
                              <tr>
                                <th style="width:40%;">User ID</th>
                                <td><small><%= user._id %></small></td>
                              </tr>
                              <tr>
                                <th>Username</th>
                                <td><%= user.username %></td>
                              </tr>
                              <tr>
                                <th>Email</th>
                                <td><%= user.email %></td>
                              </tr>
                              <tr>
                                <th>Phone Number</th>
                                <td><%= user.phone_number || '—' %></td>
                              </tr>
                              <tr>
                                <th>Country</th>
                                <td><%= user.country || '—' %></td>
                              </tr>
                              <tr>
                                <th>Miner ID</th>
                                <td><%= user.minerId || '—' %></td>
                              </tr>
                              <tr>
                                <th>Role</th>
                                <td class="text-capitalize"><%= user.role === 'users' ? 'User' : (user.role || '—') %></td>
                              </tr>
                              <tr>
                                <th>Verification Status</th>
                                <td>
                                  <% if (user.isVerified) { %>
                                  <span class="badge badge-success">Verified</span>
                                  <% } else { %>
                                  <span class="badge badge-danger">Unverified</span>
                                  <% } %>
                                </td>
                              </tr>
                              <tr>
                                <th>Account Created</th>
                                <td><%= user._id.getTimestamp().toLocaleString() %></td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                        <div class="col-md-6">
                          <table class="table table-striped">
                            <tbody>
                              <tr>
                                <th style="width:40%;">Wallet — NAIRA</th>
                                <td>₦<%= Number(walletBalances.NAIRA || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Wallet — RP</th>
                                <td><%= Number(walletBalances.RP || 0).toLocaleString() %> RP</td>
                              </tr>
                              <tr>
                                <th>Wallet — BTT</th>
                                <td><%= Number(walletBalances.BTT || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Wallet — USDT</th>
                                <td><%= Number(walletBalances.USDT || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Spent (successful)</th>
                                <td>₦<%= Number(totalSpent).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Topped Up (completed)</th>
                                <td>₦<%= Number(totalToppedUp).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Transactions</th>
                                <td><%= transactions.length %></td>
                              </tr>
                              <tr>
                                <th>Total Top-ups</th>
                                <td><%= topups.length %></td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>

                    <!-- Top-ups tab -->
                    <div class="tab-pane fade" id="tab-topups" role="tabpanel">
                      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap:8px;">
                        <small class="text-muted"><%= topups.length %> records</small>
                        <input type="text" id="topup-search" class="form-control" placeholder="Search top-ups…" style="max-width:320px;">
                      </div>
                      <div class="table-responsive">
                        <table class="table table-striped" id="table-topups">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Reference</th>
                              <th>Amount</th>
                              <th>Naira Amount</th>
                              <th>Balance Type</th>
                              <th>Payment Method</th>
                              <th>Status</th>
                              <th>Wallet Credited</th>
                              <th>Date</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (topups && topups.length > 0) { %>
                            <% topups.forEach((topup, index) => { %>
                            <tr>
                              <td><%= index + 1 %></td>
                              <td><small><%= topup.reference || 'N/A' %></small></td>
                              <td><%= Number(topup.amount).toLocaleString() %></td>
                              <td>
                                <% if (topup.nairaAmount) { %>
                                ₦<%= Number(topup.nairaAmount).toLocaleString() %>
                                <% } else { %>
                                —
                                <% } %>
                              </td>
                              <td><span class="badge badge-info"><%= topup.balanceType %></span></td>
                              <td>
                                <span class="badge badge-primary">
                                  <% if (['RP', 'BTT', 'USDT'].includes(topup.balanceType)) { %>
                                  Bittoken
                                  <% } else { %>
                                  <%= topup.paymentMethod || 'N/A' %>
                                  <% } %>
                                </span>
                              </td>
                              <td>
                                <% if (topup.status === 'COMPLETED') { %>
                                <span class="badge badge-success">Completed</span>
                                <% } else if (topup.status === 'FAILED') { %>
                                <span class="badge badge-danger">Failed</span>
                                <% } else { %>
                                <span class="badge badge-warning">Pending</span>
                                <% } %>
                              </td>
                              <td>
                                <% if (topup.walletCredited) { %>
                                <span class="badge badge-success">Yes</span>
                                <% } else { %>
                                <span class="badge badge-danger">No</span>
                                <% } %>
                              </td>
                              <td><%= new Date(topup.createdAt).toLocaleString() %></td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="9" class="text-center">No top-up records found</td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                    <!-- Account Statements tab -->
                    <div class="tab-pane fade" id="tab-transactions" role="tabpanel">
                      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap:8px;">
                        <small class="text-muted">
                          <%= accountStatements.length %> entries &mdash;
                          <span style="color:#28a745;"><%= successfulTransactions %> successful payments</span>,
                          <span style="color:#dc3545;"><%= failedTransactions %> failed</span>
                        </small>
                        <input type="text" id="stmt-search" class="form-control" placeholder="Search reference, description, amount…" style="max-width:320px;">
                      </div>
                      <div class="table-responsive">
                        <table class="table table-hover table-sm" id="table-statements">
                          <thead class="thead-light">
                            <tr>
                              <th style="width:36px;">#</th>
                              <th>Type</th>
                              <th>Reference</th>
                              <th>Description</th>
                              <th>Amount</th>
                              <th>Bal. Before</th>
                              <th>Bal. After</th>
                              <th>Status</th>
                              <th>Date</th>
                              <th></th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (accountStatements && accountStatements.length > 0) { %>
                            <% accountStatements.forEach(function(stmt, idx) {
                                 var typeLabel = 'Payment';
                                 var typeBadge = 'badge-primary';
                                 var typeTeal  = false;
                                 if (stmt._entryType === 'deduction')                                { typeLabel = 'Deduction'; typeBadge = 'badge-danger'; }
                                 else if (stmt._entryType === 'refund' || stmt._entryType === 'system-refund') { typeLabel = 'Refund';    typeTeal  = true; }
                                 else if (stmt._entryType === 'credit')                              { typeLabel = 'Credit';    typeBadge = 'badge-success'; }
                                 else if (stmt._entryType === 'topup')                               { typeLabel = 'Top-up';    typeBadge = 'badge-success'; }

                                 var isCredit = (stmt._entryType === 'topup' || stmt._entryType === 'refund' || stmt._entryType === 'credit' || stmt._entryType === 'system-refund');
                                 var isDebit  = (stmt._entryType === 'deduction' || (stmt._entryType === 'payment' && stmt.status === 'success'));

                                 var descPreview = stmt.description && stmt.description.length > 45
                                   ? stmt.description.substring(0, 45) + '…'
                                   : (stmt.description || '—');
                                 var refPreview = stmt.reference && stmt.reference.length > 22
                                   ? stmt.reference.substring(0, 22) + '…'
                                   : (stmt.reference || '—');
                            %>
                            <tr data-idx="<%= idx %>">
                              <td class="text-muted" style="font-size:12px;"><%= idx + 1 %></td>
                              <td>
                                <% if (typeTeal) { %>
                                  <span class="badge" style="background:#17a2b8;color:#fff;font-size:10px;"><%= typeLabel %></span>
                                <% } else { %>
                                  <span class="badge <%= typeBadge %>" style="font-size:10px;"><%= typeLabel %></span>
                                <% } %>
                              </td>
                              <td><small style="font-family:monospace;font-size:11px;" title="<%= stmt.reference %>"><%= refPreview %></small></td>
                              <td style="max-width:200px;" title="<%= stmt.description %>"><small><%= descPreview %></small></td>
                              <td style="white-space:nowrap;">
                                <% if (isCredit) { %>
                                  <strong style="color:#28a745;">+₦<%= Number(stmt.amount).toLocaleString() %></strong>
                                <% } else if (isDebit) { %>
                                  <strong style="color:#dc3545;">&minus;₦<%= Number(stmt.amount).toLocaleString() %></strong>
                                <% } else { %>
                                  <span class="text-muted">₦<%= Number(stmt.amount).toLocaleString() %></span>
                                <% } %>
                              </td>
                              <td><small class="text-muted" style="white-space:nowrap;"><%= stmt.balanceBefore != null ? '₦' + Number(stmt.balanceBefore).toLocaleString() : '—' %></small></td>
                              <td><small class="text-muted" style="white-space:nowrap;"><%= stmt.balanceAfter  != null ? '₦' + Number(stmt.balanceAfter).toLocaleString()  : '—' %></small></td>
                              <td>
                                <% if (stmt.status === 'success') { %>
                                  <span class="badge badge-success" style="font-size:10px;">Success</span>
                                <% } else if (stmt.status === 'failed') { %>
                                  <span class="badge badge-danger" style="font-size:10px;">Failed</span>
                                <% } else if (stmt.status === 'refunded') { %>
                                  <span class="badge" style="background:#17a2b8;color:#fff;font-size:10px;">Refunded</span>
                                <% } else if (stmt.status === 'pending') { %>
                                  <span class="badge badge-warning" style="font-size:10px;">Pending</span>
                                <% } else { %>
                                  <span class="badge badge-secondary" style="font-size:10px;"><%= stmt.status %></span>
                                <% } %>
                              </td>
                              <td><small style="white-space:nowrap;"><%= new Date(stmt.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small></td>
                              <td>
                                <button class="btn btn-outline-secondary btn-sm stmt-details-btn" data-idx="<%= idx %>" style="font-size:11px;padding:2px 8px;white-space:nowrap;">Details</button>
                              </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="10" class="text-center text-muted py-3">No account records found</td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>
    </div>

    <footer class="main-footer">
      <div class="footer-left">Kabacu Admin</div>
    </footer>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
(function () {
  var csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
  var userId    = '<%= user._id %>';
  var username  = '<%= user.username || user.email %>';

  // ── Account Statement Details ─────────────────────────────────────────────────
  var stmtData = <%- JSON.stringify(accountStatements.map(function(s) {
    return {
      type:          s._entryType,
      source:        s._source,
      reference:     s.reference,
      description:   s.description,
      amount:        s.amount,
      walletType:    s.walletType,
      balanceBefore: s.balanceBefore,
      balanceAfter:  s.balanceAfter,
      status:        s.status,
      createdAt:     s.createdAt,
      rpEarned:      s.rpEarned,
      paymentMethod: s.paymentMethod,
      phone:         s.phone,
      performedBy:   s.performedBy,
      refundOf:      s._refundOf,
      originalRef:   s._originalRef,
    };
  })) %>;

  function escHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  var TYPE_LABELS = { 'payment':'Payment', 'topup':'Top-up', 'deduction':'Admin Deduction', 'refund':'Admin Refund', 'credit':'Admin Credit', 'system-refund':'System Refund' };
  var TYPE_COLORS = { 'payment':'#3d72bd', 'topup':'#28a745', 'deduction':'#dc3545', 'refund':'#17a2b8', 'credit':'#28a745', 'system-refund':'#17a2b8' };

  document.getElementById('table-statements').addEventListener('click', function(e) {
    var btn = e.target.closest('.stmt-details-btn');
    if (!btn) return;
    var idx = parseInt(btn.getAttribute('data-idx'), 10);
    var d = stmtData[idx];
    if (!d) return;

    var isCredit = ['topup','refund','credit','system-refund'].includes(d.type);
    var isDebit  = d.type === 'deduction' || (d.type === 'payment' && d.status === 'success');
    var dir      = isCredit ? '+' : (isDebit ? '−' : '');
    var amtColor = isCredit ? '#28a745' : (isDebit ? '#dc3545' : '#555');

    var rows = [
      ['Type',           '<span style="background:' + (TYPE_COLORS[d.type]||'#666') + ';color:#fff;padding:2px 10px;border-radius:4px;font-size:12px;">' + escHtml(TYPE_LABELS[d.type]||d.type) + '</span>'],
      ['Reference',      '<code style="font-size:12px;word-break:break-all;">' + escHtml(d.reference||'—') + '</code>'],
      ['Description',    escHtml(d.description||'—')],
      ['Amount',         '<strong style="color:' + amtColor + ';font-size:15px;">' + dir + '₦' + Number(d.amount).toLocaleString() + '</strong>'],
      ['Wallet',         escHtml(d.walletType||'NAIRA')],
      ['Balance Before', d.balanceBefore != null ? '₦' + Number(d.balanceBefore).toLocaleString() : '—'],
      ['Balance After',  d.balanceAfter  != null ? '₦' + Number(d.balanceAfter).toLocaleString()  : '—'],
      ['Status',         escHtml(d.status)],
      ['Payment Method', escHtml(d.paymentMethod||'—')],
      ['Phone',          escHtml(d.phone||'—')],
      ['RP Earned',      String(Number(d.rpEarned||0))],
      ['Date / Time',    new Date(d.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' })],
    ];
    if (d.performedBy) rows.push(['Performed By',   escHtml(d.performedBy)]);
    if (d.refundOf)    rows.push(['Refund of Tx ID','<code style="font-size:11px;word-break:break-all;">' + escHtml(d.refundOf) + '</code>']);
    if (d.originalRef) rows.push(['Original Ref',   '<code style="font-size:12px;">' + escHtml(d.originalRef) + '</code>']);

    var html = '<table style="width:100%;border-collapse:collapse;">';
    rows.forEach(function(r) {
      html += '<tr style="border-bottom:1px solid #f3f3f3;">'
        + '<td style="padding:7px 10px;font-weight:600;font-size:11px;color:#999;white-space:nowrap;width:38%;">' + r[0] + '</td>'
        + '<td style="padding:7px 10px;font-size:13px;word-break:break-word;">' + r[1] + '</td>'
        + '</tr>';
    });
    html += '</table>';

    Swal.fire({ title: 'Statement Details', html: html, width: 540, showCloseButton: true, showConfirmButton: false });
  });

  // ── Live search — Account Statements ─────────────────────────────────────────
  var stmtSearch = document.getElementById('stmt-search');
  if (stmtSearch) {
    stmtSearch.addEventListener('input', function() {
      var q = this.value.toLowerCase().trim();
      document.querySelectorAll('#table-statements tbody tr[data-idx]').forEach(function(row) {
        row.style.display = (!q || row.textContent.toLowerCase().includes(q)) ? '' : 'none';
      });
    });
  }

  // ── Live search — Top-ups ─────────────────────────────────────────────────────
  // datatables.js initializes #table-topups with DataTables pagination,
  // so we must use the DataTables API to search all rows (not just the current page).
  var topupSearch = document.getElementById('topup-search');
  if (topupSearch) {
    topupSearch.addEventListener('input', function() {
      var q = this.value.trim();
      if (window.topupsTable && typeof window.topupsTable.search === 'function') {
        window.topupsTable.search(q).draw();
      } else {
        // Fallback: plain DOM filter (works when DataTables is not active)
        document.querySelectorAll('#table-topups tbody tr').forEach(function(row) {
          row.style.display = (!q || row.textContent.toLowerCase().includes(q.toLowerCase())) ? '' : 'none';
        });
      }
    });
  }

  document.getElementById('deduct-wallet-btn').addEventListener('click', function () {
    Swal.fire({
      title: 'Deduct Wallet',
      html:
        '<p class="text-muted mb-3">Deducting from <strong>' + username + '</strong>\'s NAIRA wallet.<br>The balance may go negative.</p>' +
        '<div class="form-group text-left mb-2">' +
          '<label>Amount (₦)</label>' +
          '<input id="swal-amount" type="number" min="1" class="form-control" placeholder="e.g. 500">' +
        '</div>' +
        '<div class="form-group text-left">' +
          '<label>Reason <small class="text-muted">(optional)</small></label>' +
          '<input id="swal-reason" type="text" class="form-control" placeholder="e.g. Chargeback adjustment">' +
        '</div>',
      showCancelButton: true,
      confirmButtonText: 'Deduct',
      confirmButtonColor: '#dc3545',
      preConfirm: function () {
        var amount = document.getElementById('swal-amount').value;
        if (!amount || parseFloat(amount) <= 0) {
          Swal.showValidationMessage('Enter a valid amount greater than 0.');
          return false;
        }
        return {
          amount: amount,
          reason: document.getElementById('swal-reason').value,
        };
      },
    }).then(function (result) {
      if (!result.isConfirmed) return;

      fetch('/admin/product/user-details/' + userId + '/deduct-wallet', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
        body: JSON.stringify(result.value),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Deducted',
              html: data.message + '<br><small class="text-muted">New balance: ₦' + Number(data.balanceAfter).toLocaleString() + '</small>',
            }).then(function () { location.reload(); });
          } else {
            Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
          }
        })
        .catch(function () {
          Swal.fire({ icon: 'error', title: 'Error', text: 'Request failed. Please try again.' });
        });
    });
  });

  // ── Refund Deduction ──────────────────────────────────────────────────────────
  document.getElementById('refund-deduction-btn').addEventListener('click', async function () {
    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading…';

    try {
      var res  = await fetch('/admin/product/user-details/' + userId + '/available-refunds', {
        headers: { 'X-CSRF-Token': csrfToken },
      });
      var data = await res.json();

      if (!data.success) {
        Swal.fire({ icon: 'error', title: 'Error', text: data.message });
        return;
      }

      if (!data.deductions || data.deductions.length === 0) {
        Swal.fire({
          icon: 'info',
          title: 'No deductions available',
          text: 'There are no unrefunded deductions recorded for this user.',
        });
        return;
      }

      var rows = data.deductions.map(function (d, i) {
        var date    = new Date(d.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        var reason  = (d.apiResponse && d.apiResponse.adminDeductReason) ? d.apiResponse.adminDeductReason : '—';
        var by      = (d.apiResponse && d.apiResponse.adminDeductedBy)   ? d.apiResponse.adminDeductedBy   : 'admin';
        return '<tr class="deduct-row" style="cursor:pointer;" data-id="' + d._id + '">' +
          '<td style="padding:8px 10px;width:36px;"><input type="radio" name="txSelect" value="' + d._id + '" id="swal-tx-' + i + '"></td>' +
          '<td style="padding:8px 10px;white-space:nowrap;font-size:13px;">' + date + '</td>' +
          '<td style="padding:8px 10px;font-weight:700;font-size:13px;">₦' + Number(d.amount).toLocaleString() + '</td>' +
          '<td style="padding:8px 10px;font-size:12px;max-width:180px;word-break:break-word;">' + reason + '</td>' +
          '<td style="padding:8px 10px;font-size:11px;color:#888;">' + by + '</td>' +
        '</tr>';
      }).join('');

      var tableHtml =
        '<p class="text-muted mb-3" style="font-size:13px;">Select a deduction to refund for <strong>' + username + '</strong>:</p>' +
        '<div style="overflow-x:auto;max-height:260px;overflow-y:auto;border:1px solid #dee2e6;border-radius:4px;margin-bottom:16px;">' +
          '<table style="width:100%;border-collapse:collapse;">' +
            '<thead style="background:#f8f9fc;position:sticky;top:0;">' +
              '<tr>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;"></th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Date</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Amount</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Deduction Reason</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">By</th>' +
              '</tr>' +
            '</thead>' +
            '<tbody id="deductions-tbody">' + rows + '</tbody>' +
          '</table>' +
        '</div>' +
        '<div class="form-group text-left mb-0">' +
          '<label style="font-weight:600;font-size:13px;">Refund Reason <span style="color:#dc3545;">*</span></label>' +
          '<input id="swal-refund-reason" type="text" class="form-control" placeholder="e.g. Accidental deduction">' +
        '</div>';

      Swal.fire({
        title: 'Refund a Deduction',
        width: 680,
        html: tableHtml,
        showCancelButton: true,
        confirmButtonText: 'Proceed with Refund',
        confirmButtonColor: '#28a745',
        didOpen: function () {
          document.querySelectorAll('.deduct-row').forEach(function (row) {
            row.addEventListener('click', function () {
              document.querySelectorAll('.deduct-row').forEach(function (r) { r.style.background = ''; });
              this.style.background = '#e8f5e9';
              var radio = this.querySelector('input[type="radio"]');
              if (radio) radio.checked = true;
            });
          });
        },
        preConfirm: function () {
          var selected = document.querySelector('input[name="txSelect"]:checked');
          if (!selected) {
            Swal.showValidationMessage('Please select a deduction to refund.');
            return false;
          }
          var reason = document.getElementById('swal-refund-reason').value.trim();
          if (!reason) {
            Swal.showValidationMessage('A refund reason is required.');
            return false;
          }
          return { transactionId: selected.value, reason: reason };
        },
      }).then(function (result) {
        if (!result.isConfirmed) return;

        fetch('/admin/product/user-details/' + userId + '/refund-deduction', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify(result.value),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.success) {
              Swal.fire({ icon: 'success', title: 'Refunded', text: d.message })
                .then(function () { location.reload(); });
            } else {
              Swal.fire({ icon: 'error', title: 'Failed', text: d.message });
            }
          })
          .catch(function () {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Request failed. Please try again.' });
          });
      });

    } catch (e) {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Could not load deductions. Please try again.' });
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-undo-alt"></i> Refund Deduction';
    }
  });
})();
</script>