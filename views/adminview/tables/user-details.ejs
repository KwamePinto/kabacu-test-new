<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../../partials/headerAdmin.ejs') %>
    <%- include('../../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <div class="row align-items-center mb-3">
            <div class="col">
              <a href="/admin/product/view-users" class="btn btn-light">
                <i class="fas fa-arrow-left"></i> Back to Users
              </a>
            </div>
          </div>

          <!-- User identity card -->
          <div class="row mb-3">
            <div class="col-12">
              <div class="card">
                <div class="card-body d-flex align-items-center flex-wrap" style="gap: 16px;">
                  <div class="d-flex align-items-center justify-content-center" style="width:64px;height:64px;border-radius:50%;background:#e9ecef;font-size:24px;font-weight:700;color:#495057;flex-shrink:0;">
                    <%= (user.username || '?').charAt(0).toUpperCase() %>
                  </div>
                  <div style="flex:1;min-width:200px;">
                    <h4 class="mb-1"><%= user.username %></h4>
                    <div class="text-muted"><%= user.email %></div>
                  </div>
                  <div>
                    <% if (user.isVerified) { %>
                    <span class="badge badge-success">Verified</span>
                    <% } else { %>
                    <span class="badge badge-danger">Unverified</span>
                    <% } %>
                    <span class="badge badge-secondary text-uppercase"><%= user.role === 'users' ? 'User' : (user.role || 'user') %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Summary cards -->
          <div class="row mb-3">
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-wallet"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>Wallet Balance</h4>
                  </div>
                  <div class="card-body">₦<%= Number(walletBalances.NAIRA || user.walletBalance || 0).toLocaleString() %></div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-coins"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>RP Balance</h4>
                  </div>
                  <!-- Reads walletBalances.RP, matching the Wallet/BTT/USDT cards
                       beside it and the "Wallet — RP" row in the table below.
                       It previously read user.rpBalance — reward points earned
                       but not yet claimed into the wallet — which is a different,
                       unrelated number that only coincidentally shares the "RP"
                       label. That made this one card disagree with everything
                       else on the page showing the same user at the same
                       moment. -->
                  <div class="card-body"><%= Number(walletBalances.RP || 0).toLocaleString() %> RP</div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-primary"><i class="fas fa-coins"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>BTT Balance</h4>
                  </div>
                  <div class="card-body"><%= Number(walletBalances.BTT || 0).toLocaleString() %> BTT</div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-info"><i class="fas fa-dollar-sign"></i></div>
                <div class="card-wrap">
                  <div class="card-header">
                    <h4>USDT Balance</h4>
                  </div>
                  <div class="card-body"><%= Number(walletBalances.USDT || 0).toLocaleString() %> USDT</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Admin actions -->
          <div class="row mb-3">
            <div class="col-12">
              <!-- .col-12 is forced into flex-direction:column by the panel's
                   compatibility layer (kbc-panel.css), which stretches direct
                   children to full width. Wrapping the buttons in their own
                   flex-row container keeps them at their natural size. -->
              <div class="d-flex flex-wrap" style="gap: 10px;">
                <button id="deduct-wallet-btn" class="btn btn-danger btn-sm">
                  <i class="fas fa-minus-circle"></i> Deduct Wallet
                </button>
                <button id="refund-deduction-btn" class="btn btn-success btn-sm">
                  <i class="fas fa-undo-alt"></i> Refund Deduction
                </button>
              </div>
            </div>
          </div>

          <!-- Tabs -->
          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                      <a class="nav-link active" data-toggle="tab" href="#tab-profile" role="tab">Profile</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-topups" role="tab">Top-ups</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-transactions" role="tab">Account Statements</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-referrals" role="tab">Referrals</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#tab-commissions" role="tab">Commissions</a>
                    </li>
                  </ul>
                </div>
                <div class="card-body">
                  <div class="tab-content">

                    <!-- Profile tab -->
                    <div class="tab-pane fade show active" id="tab-profile" role="tabpanel">
                      <div class="row">
                        <div class="col-md-6">
                          <table class="table table-striped">
                            <tbody>
                              <tr>
                                <th style="width:40%;">User ID</th>
                                <td><small><%= user._id %></small></td>
                              </tr>
                              <tr>
                                <th>Username</th>
                                <td><%= user.username %></td>
                              </tr>
                              <tr>
                                <th>Email</th>
                                <td><%= user.email %></td>
                              </tr>
                              <tr>
                                <th>Phone Number</th>
                                <td><%= user.phone_number || '—' %></td>
                              </tr>
                              <tr>
                                <th>Country</th>
                                <td><%= user.country || '—' %></td>
                              </tr>
                              <tr>
                                <th>Miner ID</th>
                                <td><%= user.minerId || '—' %></td>
                              </tr>
                              <tr>
                                <th>Role</th>
                                <td class="text-capitalize"><%= user.role === 'users' ? 'User' : (user.role || '—') %></td>
                              </tr>
                              <tr>
                                <th>Verification Status</th>
                                <td>
                                  <% if (user.isVerified) { %>
                                  <span class="badge badge-success">Verified</span>
                                  <% } else { %>
                                  <span class="badge badge-danger">Unverified</span>
                                  <% } %>
                                </td>
                              </tr>
                              <tr>
                                <th>Account Created</th>
                                <td><%= user._id.getTimestamp().toLocaleString() %></td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                        <div class="col-md-6">
                          <table class="table table-striped">
                            <tbody>
                              <tr>
                                <th style="width:40%;">Wallet — NAIRA</th>
                                <td>₦<%= Number(walletBalances.NAIRA || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Wallet — RP</th>
                                <td><%= Number(walletBalances.RP || 0).toLocaleString() %> RP</td>
                              </tr>
                              <tr>
                                <th>Wallet — BTT</th>
                                <td><%= Number(walletBalances.BTT || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Wallet — USDT</th>
                                <td><%= Number(walletBalances.USDT || 0).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Spent (successful)</th>
                                <td>₦<%= Number(totalSpent).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Topped Up (completed)</th>
                                <td>₦<%= Number(totalToppedUp).toLocaleString() %></td>
                              </tr>
                              <tr>
                                <th>Total Transactions</th>
                                <td><%= transactions.length %></td>
                              </tr>
                              <tr>
                                <th>Total Top-ups</th>
                                <td><%= topups.length %></td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>

                    <!-- Top-ups tab -->
                    <div class="tab-pane fade" id="tab-topups" role="tabpanel">
                      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap:8px;">
                        <small class="text-muted"><%= topups.length %> records</small>
                        <input type="text" id="topup-search" class="form-control" placeholder="Search top-ups…" style="max-width:320px;">
                      </div>
                      <div class="table-responsive">
                        <table class="table table-striped" id="table-topups">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Reference</th>
                              <th>Amount</th>
                              <th>Naira Amount</th>
                              <th>Balance Type</th>
                              <th>Payment Method</th>
                              <th>Status</th>
                              <th>Wallet Credited</th>
                              <th>Date</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (topups && topups.length > 0) { %>
                            <% topups.forEach((topup, index) => { %>
                            <tr>
                              <td><%= index + 1 %></td>
                              <td><small><%= topup.reference || 'N/A' %></small></td>
                              <td><%= Number(topup.amount).toLocaleString() %></td>
                              <td>
                                <% if (topup.nairaAmount) { %>
                                ₦<%= Number(topup.nairaAmount).toLocaleString() %>
                                <% } else { %>
                                —
                                <% } %>
                              </td>
                              <td><span class="badge badge-info"><%= topup.balanceType %></span></td>
                              <td>
                                <span class="badge badge-primary">
                                  <% if (['RP', 'BTT', 'USDT'].includes(topup.balanceType)) { %>
                                  Bittoken
                                  <% } else { %>
                                  <%= topup.paymentMethod || 'N/A' %>
                                  <% } %>
                                </span>
                              </td>
                              <td>
                                <% if (topup.status === 'COMPLETED') { %>
                                <span class="badge badge-success">Completed</span>
                                <% } else if (topup.status === 'FAILED') { %>
                                <span class="badge badge-danger">Failed</span>
                                <% } else { %>
                                <span class="badge badge-warning">Pending</span>
                                <% } %>
                              </td>
                              <td>
                                <% if (topup.walletCredited) { %>
                                <span class="badge badge-success">Yes</span>
                                <% } else { %>
                                <span class="badge badge-danger">No</span>
                                <% } %>
                              </td>
                              <td><%= new Date(topup.createdAt).toLocaleString() %></td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="9" class="text-center">No top-up records found</td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                    <!-- Account Statements tab -->

                    <!-- Referrals tab -->
                    <div class="tab-pane fade" id="tab-referrals" role="tabpanel">
                      <%
                        var rStats = typeof referralStats !== 'undefined' ? referralStats : null;
                        var rMade  = typeof referralsMade !== 'undefined' ? (referralsMade || []) : [];
                        var rBy    = typeof referredBy    !== 'undefined' ? referredBy : null;
                        var rSet   = typeof referralSettings !== 'undefined' ? referralSettings : null;
                        var naira  = function (n) { return '₦' + Number(n || 0).toLocaleString(); };

                        /* What one referral actually paid out. Reads the snapshot frozen on
                           the referral at payout time, so later settings changes never
                           rewrite history. Unpaid rows show what they would be worth. */
                        function rewardLabel(r) {
                          if (r.status === 'rewarded') {
                            if (r.rewardType === 'rewardpoint')                    return (r.rewardAmount || 0) + ' RP';
                            if (r.rewardType === 'BTT' || r.rewardType === 'USDT') return (r.rewardAmount || 0).toLocaleString() + ' ' + r.rewardType;
                            // Historic rows only — these two are no longer awarded.
                            if (r.rewardType === 'money')                          return naira(r.rewardAmount);
                            if (r.rewardType === 'data') {
                              var d = r.rewardProduct && r.rewardProduct.dataDetails;
                              return d ? (d.plan_type || 'Data bundle') : 'Data bundle';
                            }
                            return 'Rewarded';
                          }
                          if (r.status === 'void') return 'Not eligible';
                          if (!rSet || !rSet.isActive) return 'Programme paused';
                          if (rSet.rewardType === 'rewardpoint')                     return 'Would pay ' + (rSet.amount || 0) + ' RP';
                          if (rSet.rewardType === 'BTT' || rSet.rewardType === 'USDT') return 'Would pay ' + (rSet.amount || 0).toLocaleString() + ' ' + rSet.rewardType;
                          return 'Programme paused';
                        }

                        // Commission no longer has a reward-type choice — this now holds
                        // a currency code (e.g. 'NGN') from the payout's market, set from
                        // the most recent one. Historic rows written before that change
                        // still say 'rewardpoint'/'cashback'/'BTT'/'USDT'; shown as-is
                        // rather than guessed at, since there's no way to know what
                        // currency those old payouts actually landed in from the code alone.
                        function commissionTypeLabel(t) {
                          return t || '';
                        }

                        var statusBadge = {
                          rewarded:  'badge-success',
                          qualified: 'badge-info',
                          pending:   'badge-warning',
                          void:      'badge-secondary',
                        };
                      %>

                      <!-- This user's own code -->
                      <div class="row mb-4">
                        <div class="col-md-6">
                          <div class="card mb-0" style="border:1px solid #e4e6fc;">
                            <div class="card-body">
                              <h6 style="font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#6c757d;">Their referral code</h6>
                              <div class="d-flex align-items-center" style="gap:10px;">
                                <code id="ud-ref-code" style="font-size:20px;font-weight:700;letter-spacing:.14em;background:#f8f9fa;border:1px dashed #c9d0ff;border-radius:6px;padding:8px 14px;">
                                  <%= typeof referralCode !== 'undefined' && referralCode ? referralCode : '—' %>
                                </code>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="ud-copy-code"
                                        data-code="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>">Copy</button>
                              </div>

                              <%
                                var _hist = (typeof codeHistory !== 'undefined' && codeHistory) || [];
                                var _cur  = _hist.filter(function (h) { return h.isPrimary; })[0] || null;
                                var _past = _hist.filter(function (h) { return !h.isPrimary; });
                                var _pReq = typeof pendingCodeRequest !== 'undefined' ? pendingCodeRequest : null;
                              %>

                              <% if (_cur) { %>
                              <div class="mt-2">
                                <span class="badge <%= _cur.kind === 'system' ? 'badge-light' : 'badge-info' %>"
                                      style="font-size:11px;<%= _cur.kind === 'system' ? 'border:1px solid #e4e6fc;' : '' %>">
                                  <%= _cur.kind %>
                                </span>
                                <% if (_cur.rewardBonusPercent > 0) { %>
                                <span class="badge badge-success" style="font-size:11px;">+<%= _cur.rewardBonusPercent %>% reward</span>
                                <% } %>
                                <% if (_cur.commissionBonusPercent > 0) { %>
                                <span class="badge badge-success" style="font-size:11px;">+<%= _cur.commissionBonusPercent %>% commission</span>
                                <% } %>
                                <% if (_cur.pricePaid > 0) { %>
                                <small class="text-muted">paid <%= _cur.pricePaid.toLocaleString() %></small>
                                <% } %>
                              </div>
                              <% } %>

                              <% if (_pReq) { %>
                              <div class="alert alert-warning mt-2 mb-0" style="font-size:12px;padding:8px 10px;">
                                Awaiting review: <code><%= _pReq.code %></code>
                                (<%= _pReq.type %><% if (_pReq.price > 0) { %>, <%= _pReq.price.toLocaleString() %><% } %>)
                                — <a href="/admin/referrals">go to the queue</a>
                              </div>
                              <% } %>

                              <!-- Retired codes. They still resolve to this user, which is
                                   what an admin needs to know when someone reports an old
                                   link "not working" — it does work. -->
                              <% if (_past.length) { %>
                              <div class="mt-3">
                                <h6 style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#6c757d;">
                                  Earlier codes — still valid
                                </h6>
                                <table class="table table-sm mb-0" style="font-size:12px;">
                                  <tbody>
                                    <% _past.forEach(function (h) { %>
                                    <tr>
                                      <td style="padding:4px 6px;">
                                        <code style="text-decoration:line-through;opacity:.8;"><%= h.code %></code>
                                      </td>
                                      <td style="padding:4px 6px;"><span class="text-muted"><%= h.kind %></span></td>
                                      <td style="padding:4px 6px;">
                                        <%
                                          var _b = [];
                                          if (h.rewardBonusPercent > 0) _b.push('+' + h.rewardBonusPercent + '% rwd');
                                          if (h.commissionBonusPercent > 0) _b.push('+' + h.commissionBonusPercent + '% comm');
                                        %>
                                        <%= _b.length ? _b.join(' · ') : '—' %>
                                      </td>
                                      <td style="padding:4px 6px;" class="text-right">
                                        <small class="text-muted">
                                          <% if (h.retiredAt) { %>
                                          replaced <%= new Date(h.retiredAt).toLocaleDateString('en-GB') %>
                                          <% } %>
                                        </small>
                                      </td>
                                    </tr>
                                    <% }) %>
                                  </tbody>
                                </table>
                              </div>
                              <% } %>
                            </div>
                          </div>
                        </div>

                        <!-- Who brought them in -->
                        <div class="col-md-6 mt-3 mt-md-0">
                          <div class="card mb-0" style="border:1px solid #e4e6fc;">
                            <div class="card-body">
                              <h6 style="font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#6c757d;">Referred by</h6>
                              <% if (rBy && rBy.referrer) { %>
                                <div style="font-size:15px;font-weight:700;">
                                  <a href="/admin/product/user-details/<%= rBy.referrer._id %>"><%= rBy.referrer.username %></a>
                                </div>
                                <small class="text-muted d-block"><%= rBy.referrer.email %></small>
                                <small class="text-muted d-block">
                                  Used code <code><%= rBy.codeUsed %></code>
                                  on <%= new Date(rBy.createdAt).toLocaleDateString('en-GB') %>
                                </small>
                                <span class="badge <%= statusBadge[rBy.status] || 'badge-secondary' %> mt-2" style="font-size:11px;padding:4px 9px;">
                                  <%= rBy.status %>
                                </span>
                                <% if (rBy.status === 'rewarded') { %>
                                  <small class="d-block mt-1 text-success">
                                    Paid their referrer <%= rewardLabel(rBy) %>
                                  </small>
                                <% } %>
                              <% } else { %>
                                <p class="text-muted mb-0" style="font-size:13px;">Signed up without a referral code.</p>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Totals -->
                      <% if (rStats) { %>
                      <div class="row mb-3">
                        <div class="col-4 col-md-2"><div class="card mb-2"><div class="card-body text-center py-3">
                          <div style="font-size:22px;font-weight:700;"><%= rStats.total %></div>
                          <div style="font-size:11px;color:#6c757d;text-transform:uppercase;">Referred</div>
                        </div></div></div>
                        <div class="col-4 col-md-2"><div class="card mb-2"><div class="card-body text-center py-3">
                          <div style="font-size:22px;font-weight:700;" class="text-success"><%= rStats.rewarded %></div>
                          <div style="font-size:11px;color:#6c757d;text-transform:uppercase;">Rewarded</div>
                        </div></div></div>
                        <div class="col-4 col-md-2"><div class="card mb-2"><div class="card-body text-center py-3">
                          <div style="font-size:22px;font-weight:700;" class="text-warning"><%= rStats.pending %></div>
                          <div style="font-size:11px;color:#6c757d;text-transform:uppercase;">Awaiting</div>
                        </div></div></div>
                        <div class="col-4 col-md-2"><div class="card mb-2"><div class="card-body text-center py-3">
                          <div style="font-size:22px;font-weight:700;"><%= rStats.earnedRp %></div>
                          <div style="font-size:11px;color:#6c757d;text-transform:uppercase;">RP earned</div>
                        </div></div></div>
                        <div class="col-4 col-md-2"><div class="card mb-2"><div class="card-body text-center py-3">
                          <div style="font-size:22px;font-weight:700;"><%= naira(rStats.earnedMoney) %></div>
                          <div style="font-size:11px;color:#6c757d;text-transform:uppercase;">Cash earned</div>
                        </div></div></div>
                        <div class="col-4 col-md-2"><div class="card mb-2"><div class="card-body text-center py-3">
                          <div style="font-size:22px;font-weight:700;"><%= rStats.earnedData %></div>
                          <div style="font-size:11px;color:#6c757d;text-transform:uppercase;">Data rewards</div>
                        </div></div></div>
                      </div>

                      <% if (rStats.commissionCount > 0) { %>
                      <div class="alert alert-light" style="border:1px solid #e4e6fc;font-size:13px;">
                        Ongoing commission: <strong><%= rStats.commissionCount %></strong> payout(s) from
                        purchases made by people they referred, after those referrals qualified — paid in
                        each purchase's own currency, so see the <strong>Commissions</strong> tab for the
                        breakdown and full history.
                      </div>
                      <% } %>
                      <% } %>

                      <!-- Everyone they brought in -->
                      <h6 class="mt-4 mb-2" style="font-size:13px;font-weight:700;">People they referred</h6>
                      <div class="table-responsive">
                        <table class="table table-striped mb-0">
                          <thead>
                            <tr>
                              <th>User</th>
                              <th>Their code</th>
                              <th>Joined</th>
                              <th>Status</th>
                              <th>Reward</th>
                              <th>Qualified / Paid</th>
                              <th class="text-right">Commission</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (!rMade.length) { %>
                            <tr><td colspan="7" class="text-center text-muted py-4">This user has not referred anyone.</td></tr>
                            <% } %>
                            <% rMade.forEach(function (r) { %>
                            <tr>
                              <td>
                                <% if (r.referred) { %>
                                  <a href="/admin/product/user-details/<%= r.referred._id %>"><strong><%= r.referred.username %></strong></a><br>
                                  <small class="text-muted"><%= r.referred.email %></small>
                                <% } else { %>
                                  <span class="text-muted">Deleted user</span>
                                <% } %>
                              </td>
                              <td><small><code><%= (r.referred && r.referred.referralCode) || '—' %></code></small></td>
                              <td><small><%= new Date(r.createdAt).toLocaleDateString('en-GB') %></small></td>
                              <td>
                                <span class="badge <%= statusBadge[r.status] || 'badge-secondary' %>" style="font-size:11px;padding:4px 9px;">
                                  <%= r.status %>
                                </span>
                              </td>
                              <td>
                                <span class="<%= r.status === 'rewarded' ? 'text-success font-weight-bold' : 'text-muted' %>">
                                  <%= rewardLabel(r) %>
                                </span>
                                <% if (r.rewardNote) { %><br><small class="text-muted"><%= r.rewardNote %></small><% } %>
                              </td>
                              <td>
                                <small>
                                  <% if (r.qualifiedAt) { %>Q: <%= new Date(r.qualifiedAt).toLocaleDateString('en-GB') %><br><% } %>
                                  <% if (r.rewardedAt) { %>P: <%= new Date(r.rewardedAt).toLocaleDateString('en-GB') %><% } %>
                                  <% if (!r.qualifiedAt && !r.rewardedAt) { %><span class="text-muted">—</span><% } %>
                                </small>
                              </td>
                              <td class="text-right">
                                <% if (r.commissionEarned) { %>
                                  <strong><%= r.commissionEarned %></strong><br>
                                  <small class="text-muted"><%= r.commissionCount %>x <%= commissionTypeLabel(r.commissionType) %></small>
                                <% } else { %>
                                  <span class="text-muted">—</span>
                                <% } %>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                    <!-- Commissions tab — every individual commission payout this
                         user has earned as a referrer. Kept separate from the
                         Referrals tab above (which stays about who they referred,
                         not every payout) so an active referrer's long payout
                         history doesn't clutter it. -->
                    <div class="tab-pane fade" id="tab-commissions" role="tabpanel">
                      <%
                        var cEvents = typeof commissionEvents !== 'undefined' ? (commissionEvents || []) : [];
                        var cTotals = typeof commissionTotals !== 'undefined' ? (commissionTotals || []) : [];
                        var cCap    = typeof commissionListCap !== 'undefined' ? commissionListCap : 200;
                      %>

                      <% if (cTotals.length) { %>
                      <div class="row mb-3">
                        <% cTotals.forEach(function (t) { %>
                        <div class="col-6 col-md-3">
                          <div class="card mb-2"><div class="card-body text-center py-3">
                            <div style="font-size:20px;font-weight:700;"><%= t.symbol %><%= Number(t.total).toLocaleString() %></div>
                            <div style="font-size:11px;color:#6c757d;text-transform:uppercase;"><%= t.count %> payout<%= t.count === 1 ? '' : 's' %></div>
                          </div></div>
                        </div>
                        <% }) %>
                      </div>
                      <% } %>

                      <div class="table-responsive">
                        <table class="table table-striped mb-0">
                          <thead>
                            <tr>
                              <th>Date</th>
                              <th>Referred user</th>
                              <th class="text-right">Purchase</th>
                              <th class="text-right">Commission</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (!cEvents.length) { %>
                            <tr><td colspan="4" class="text-center text-muted py-4">No commission payouts yet.</td></tr>
                            <% } %>
                            <% cEvents.forEach(function (c) { %>
                            <tr>
                              <td><small><%= new Date(c.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small></td>
                              <td>
                                <% if (c.referred) { %>
                                  <a href="/admin/product/user-details/<%= c.referred._id %>"><strong><%= c.referred.username %></strong></a><br>
                                  <small class="text-muted"><%= c.referred.email %></small>
                                <% } else { %>
                                  <span class="text-muted">Deleted user</span>
                                <% } %>
                              </td>
                              <td class="text-right"><%= c.currencySymbol %><%= Number(c.purchaseAmount || 0).toLocaleString() %></td>
                              <td class="text-right"><strong><%= c.currencySymbol %><%= Number(c.amount).toLocaleString() %></strong></td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                      <% if (cEvents.length >= cCap) { %>
                      <p class="text-muted mt-2" style="font-size:12.5px;">Showing the <%= cCap %> most recent payouts.</p>
                      <% } %>
                    </div>

                    <div class="tab-pane fade" id="tab-transactions" role="tabpanel">
                      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap:8px;">
                        <small class="text-muted">
                          <%= accountStatements.length %> entries &mdash;
                          <span style="color:#28a745;"><%= successfulTransactions %> successful payments</span>,
                          <span style="color:#dc3545;"><%= failedTransactions %> failed</span>
                        </small>
                        <input type="text" id="stmt-search" class="form-control" placeholder="Search reference, description, amount…" style="max-width:320px;">
                      </div>
                      <div class="table-responsive">
                        <table class="table table-hover table-sm" id="table-statements">
                          <thead class="thead-light">
                            <tr>
                              <th style="width:36px;">#</th>
                              <th>Type</th>
                              <th>Reference</th>
                              <th>Description</th>
                              <th>Amount</th>
                              <th>Bal. Before</th>
                              <th>Bal. After</th>
                              <th>Status</th>
                              <th>Date</th>
                              <th></th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (accountStatements && accountStatements.length > 0) { %>
                            <% accountStatements.forEach(function(stmt, idx) {
                                 var typeLabel = 'Payment';
                                 var typeBadge = 'badge-primary';
                                 var typeTeal  = false;
                                 if (stmt._entryType === 'deduction')                                { typeLabel = 'Deduction';  typeBadge = 'badge-danger'; }
                                 else if (stmt._entryType === 'refund' || stmt._entryType === 'system-refund') { typeLabel = 'Refund';    typeTeal  = true; }
                                 else if (stmt._entryType === 'credit')                              { typeLabel = 'Credit';     typeBadge = 'badge-success'; }
                                 else if (stmt._entryType === 'topup')                               { typeLabel = 'Top-up';     typeBadge = 'badge-success'; }
                                 else if (stmt._entryType === 'conversion')                           { typeLabel = 'Conversion'; typeBadge = 'badge-info'; }

                                 var isCredit = (stmt._entryType === 'topup' || stmt._entryType === 'refund' || stmt._entryType === 'credit' || stmt._entryType === 'system-refund');
                                 var isDebit  = (stmt._entryType === 'deduction' || (stmt._entryType === 'payment' && stmt.status === 'success'));

                                 var descPreview = stmt.description && stmt.description.length > 45
                                   ? stmt.description.substring(0, 45) + '…'
                                   : (stmt.description || '—');
                                 var refPreview = stmt.reference && stmt.reference.length > 22
                                   ? stmt.reference.substring(0, 22) + '…'
                                   : (stmt.reference || '—');
                            %>
                            <tr data-idx="<%= idx %>">
                              <td class="text-muted" style="font-size:12px;"><%= idx + 1 %></td>
                              <td>
                                <% if (typeTeal) { %>
                                  <span class="badge" style="background:#17a2b8;color:#fff;font-size:10px;"><%= typeLabel %></span>
                                <% } else { %>
                                  <span class="badge <%= typeBadge %>" style="font-size:10px;"><%= typeLabel %></span>
                                <% } %>
                              </td>
                              <td><small style="font-family:monospace;font-size:11px;" title="<%= stmt.reference %>"><%= refPreview %></small></td>
                              <td style="max-width:200px;" title="<%= stmt.description %>"><small><%= descPreview %></small></td>
                              <td style="white-space:nowrap;">
                                <% if (isCredit) { %>
                                  <strong style="color:#28a745;">+₦<%= Number(stmt.amount).toLocaleString() %></strong>
                                <% } else if (isDebit) { %>
                                  <strong style="color:#dc3545;">&minus;₦<%= Number(stmt.amount).toLocaleString() %></strong>
                                <% } else { %>
                                  <span class="text-muted">₦<%= Number(stmt.amount).toLocaleString() %></span>
                                <% } %>
                              </td>
                              <td><small class="text-muted" style="white-space:nowrap;"><%= stmt.balanceBefore != null ? '₦' + Number(stmt.balanceBefore).toLocaleString() : '—' %></small></td>
                              <td><small class="text-muted" style="white-space:nowrap;"><%= stmt.balanceAfter  != null ? '₦' + Number(stmt.balanceAfter).toLocaleString()  : '—' %></small></td>
                              <td>
                                <% if (stmt.status === 'success') { %>
                                  <span class="badge badge-success" style="font-size:10px;">Success</span>
                                <% } else if (stmt.status === 'failed') { %>
                                  <span class="badge badge-danger" style="font-size:10px;">Failed</span>
                                <% } else if (stmt.status === 'refunded') { %>
                                  <span class="badge" style="background:#17a2b8;color:#fff;font-size:10px;">Refunded</span>
                                <% } else if (stmt.status === 'pending') { %>
                                  <span class="badge badge-warning" style="font-size:10px;">Pending</span>
                                <% } else { %>
                                  <span class="badge badge-secondary" style="font-size:10px;"><%= stmt.status %></span>
                                <% } %>
                              </td>
                              <td><small style="white-space:nowrap;"><%= new Date(stmt.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small></td>
                              <td>
                                <button class="btn btn-outline-secondary btn-sm stmt-details-btn" data-idx="<%= idx %>" style="font-size:11px;padding:2px 8px;white-space:nowrap;">Details</button>
                              </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr>
                              <td colspan="10" class="text-center text-muted py-3">No account records found</td>
                            </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>
    </div>

    <footer class="main-footer">
      <div class="footer-left">Kabacu Admin</div>
    </footer>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
(function () {
  var csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
  var userId    = '<%= user._id %>';
  var username  = '<%= user.username || user.email %>';

  // ── Account Statement Details ─────────────────────────────────────────────────
  var stmtData = <%- JSON.stringify(accountStatements.map(function(s) {
    return {
      type:          s._entryType,
      source:        s._source,
      reference:     s.reference,
      description:   s.description,
      amount:        s.amount,
      walletType:    s.walletType,
      balanceBefore: s.balanceBefore,
      balanceAfter:  s.balanceAfter,
      status:        s.status,
      createdAt:     s.createdAt,
      rpEarned:      s.rpEarned,
      paymentMethod: s.paymentMethod,
      phone:         s.phone,
      performedBy:   s.performedBy,
      refundOf:      s._refundOf,
      originalRef:   s._originalRef,
    };
  })) %>;

  function escHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  var TYPE_LABELS = { 'payment':'Payment', 'topup':'Top-up', 'deduction':'Admin Deduction', 'refund':'Admin Refund', 'credit':'Admin Credit', 'system-refund':'System Refund', 'conversion':'Conversion' };
  var TYPE_COLORS = { 'payment':'#3d72bd', 'topup':'#28a745', 'deduction':'#dc3545', 'refund':'#17a2b8', 'credit':'#28a745', 'system-refund':'#17a2b8', 'conversion':'#6f42c1' };

  document.getElementById('table-statements').addEventListener('click', function(e) {
    var btn = e.target.closest('.stmt-details-btn');
    if (!btn) return;
    var idx = parseInt(btn.getAttribute('data-idx'), 10);
    var d = stmtData[idx];
    if (!d) return;

    var isCredit = ['topup','refund','credit','system-refund'].includes(d.type);
    var isDebit  = d.type === 'deduction' || (d.type === 'payment' && d.status === 'success');
    var dir      = isCredit ? '+' : (isDebit ? '−' : '');
    var amtColor = isCredit ? '#28a745' : (isDebit ? '#dc3545' : '#555');

    var rows = [
      ['Type',           '<span style="background:' + (TYPE_COLORS[d.type]||'#666') + ';color:#fff;padding:2px 10px;border-radius:4px;font-size:12px;">' + escHtml(TYPE_LABELS[d.type]||d.type) + '</span>'],
      ['Reference',      '<code style="font-size:12px;word-break:break-all;">' + escHtml(d.reference||'—') + '</code>'],
      ['Description',    escHtml(d.description||'—')],
      ['Amount',         '<strong style="color:' + amtColor + ';font-size:15px;">' + dir + '₦' + Number(d.amount).toLocaleString() + '</strong>'],
      ['Wallet',         escHtml(d.walletType||'NAIRA')],
      ['Balance Before', d.balanceBefore != null ? '₦' + Number(d.balanceBefore).toLocaleString() : '—'],
      ['Balance After',  d.balanceAfter  != null ? '₦' + Number(d.balanceAfter).toLocaleString()  : '—'],
      ['Status',         escHtml(d.status)],
      ['Payment Method', escHtml(d.paymentMethod||'—')],
      ['Phone',          escHtml(d.phone||'—')],
      ['RP Earned',      String(Number(d.rpEarned||0))],
      ['Date / Time',    new Date(d.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' })],
    ];
    if (d.performedBy) rows.push(['Performed By',   escHtml(d.performedBy)]);
    if (d.refundOf)    rows.push(['Refund of Tx ID','<code style="font-size:11px;word-break:break-all;">' + escHtml(d.refundOf) + '</code>']);
    if (d.originalRef) rows.push(['Original Ref',   '<code style="font-size:12px;">' + escHtml(d.originalRef) + '</code>']);

    var html = '<table style="width:100%;border-collapse:collapse;">';
    rows.forEach(function(r) {
      html += '<tr style="border-bottom:1px solid #f3f3f3;">'
        + '<td style="padding:7px 10px;font-weight:600;font-size:11px;color:#999;white-space:nowrap;width:38%;">' + r[0] + '</td>'
        + '<td style="padding:7px 10px;font-size:13px;word-break:break-word;">' + r[1] + '</td>'
        + '</tr>';
    });
    html += '</table>';

    Swal.fire({ title: 'Statement Details', html: html, width: 540, showCloseButton: true, showConfirmButton: false });
  });

  // ── Live search — Account Statements ─────────────────────────────────────────
  var stmtSearch = document.getElementById('stmt-search');
  if (stmtSearch) {
    stmtSearch.addEventListener('input', function() {
      var q = this.value.toLowerCase().trim();
      document.querySelectorAll('#table-statements tbody tr[data-idx]').forEach(function(row) {
        row.style.display = (!q || row.textContent.toLowerCase().includes(q)) ? '' : 'none';
      });
    });
  }

  // ── Live search — Top-ups ─────────────────────────────────────────────────────
  // datatables.js initializes #table-topups with DataTables pagination,
  // so we must use the DataTables API to search all rows (not just the current page).
  var topupSearch = document.getElementById('topup-search');
  if (topupSearch) {
    topupSearch.addEventListener('input', function() {
      var q = this.value.trim();
      if (window.topupsTable && typeof window.topupsTable.search === 'function') {
        window.topupsTable.search(q).draw();
      } else {
        // Fallback: plain DOM filter (works when DataTables is not active)
        document.querySelectorAll('#table-topups tbody tr').forEach(function(row) {
          row.style.display = (!q || row.textContent.toLowerCase().includes(q.toLowerCase())) ? '' : 'none';
        });
      }
    });
  }

  document.getElementById('deduct-wallet-btn').addEventListener('click', function () {
    Swal.fire({
      title: 'Deduct Wallet',
      html:
        '<p class="text-muted mb-3">Deducting from <strong>' + username + '</strong>\'s NAIRA wallet.<br>The balance may go negative.</p>' +
        '<div class="form-group text-left mb-2">' +
          '<label>Amount (₦)</label>' +
          '<input id="swal-amount" type="number" min="1" class="form-control" placeholder="e.g. 500">' +
        '</div>' +
        '<div class="form-group text-left">' +
          '<label>Reason <small class="text-muted">(optional)</small></label>' +
          '<input id="swal-reason" type="text" class="form-control" placeholder="e.g. Chargeback adjustment">' +
        '</div>',
      showCancelButton: true,
      confirmButtonText: 'Deduct',
      confirmButtonColor: '#dc3545',
      preConfirm: function () {
        var amount = document.getElementById('swal-amount').value;
        if (!amount || parseFloat(amount) <= 0) {
          Swal.showValidationMessage('Enter a valid amount greater than 0.');
          return false;
        }
        return {
          amount: amount,
          reason: document.getElementById('swal-reason').value,
        };
      },
    }).then(function (result) {
      if (!result.isConfirmed) return;

      fetch('/admin/product/user-details/' + userId + '/deduct-wallet', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
        body: JSON.stringify(result.value),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Deducted',
              html: data.message + '<br><small class="text-muted">New balance: ₦' + Number(data.balanceAfter).toLocaleString() + '</small>',
            }).then(function () { location.reload(); });
          } else {
            Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
          }
        })
        .catch(function () {
          Swal.fire({ icon: 'error', title: 'Error', text: 'Request failed. Please try again.' });
        });
    });
  });

  // ── Refund Deduction ──────────────────────────────────────────────────────────
  document.getElementById('refund-deduction-btn').addEventListener('click', async function () {
    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading…';

    try {
      var res  = await fetch('/admin/product/user-details/' + userId + '/available-refunds', {
        headers: { 'X-CSRF-Token': csrfToken },
      });
      var data = await res.json();

      if (!data.success) {
        Swal.fire({ icon: 'error', title: 'Error', text: data.message });
        return;
      }

      if (!data.deductions || data.deductions.length === 0) {
        Swal.fire({
          icon: 'info',
          title: 'No deductions available',
          text: 'There are no unrefunded deductions recorded for this user.',
        });
        return;
      }

      var rows = data.deductions.map(function (d, i) {
        var date    = new Date(d.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        var reason  = (d.apiResponse && d.apiResponse.adminDeductReason) ? d.apiResponse.adminDeductReason : '—';
        var by      = (d.apiResponse && d.apiResponse.adminDeductedBy)   ? d.apiResponse.adminDeductedBy   : 'admin';
        return '<tr class="deduct-row" style="cursor:pointer;" data-id="' + d._id + '">' +
          '<td style="padding:8px 10px;width:36px;"><input type="radio" name="txSelect" value="' + d._id + '" id="swal-tx-' + i + '"></td>' +
          '<td style="padding:8px 10px;white-space:nowrap;font-size:13px;">' + date + '</td>' +
          '<td style="padding:8px 10px;font-weight:700;font-size:13px;">₦' + Number(d.amount).toLocaleString() + '</td>' +
          '<td style="padding:8px 10px;font-size:12px;max-width:180px;word-break:break-word;">' + reason + '</td>' +
          '<td style="padding:8px 10px;font-size:11px;color:#888;">' + by + '</td>' +
        '</tr>';
      }).join('');

      var tableHtml =
        '<p class="text-muted mb-3" style="font-size:13px;">Select a deduction to refund for <strong>' + username + '</strong>:</p>' +
        '<div style="overflow-x:auto;max-height:260px;overflow-y:auto;border:1px solid #dee2e6;border-radius:4px;margin-bottom:16px;">' +
          '<table style="width:100%;border-collapse:collapse;">' +
            '<thead style="background:#f8f9fc;position:sticky;top:0;">' +
              '<tr>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;"></th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Date</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Amount</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">Deduction Reason</th>' +
                '<th style="padding:8px 10px;text-align:left;font-size:12px;">By</th>' +
              '</tr>' +
            '</thead>' +
            '<tbody id="deductions-tbody">' + rows + '</tbody>' +
          '</table>' +
        '</div>' +
        '<div class="form-group text-left mb-0">' +
          '<label style="font-weight:600;font-size:13px;">Refund Reason <span style="color:#dc3545;">*</span></label>' +
          '<input id="swal-refund-reason" type="text" class="form-control" placeholder="e.g. Accidental deduction">' +
        '</div>';

      Swal.fire({
        title: 'Refund a Deduction',
        width: 680,
        html: tableHtml,
        showCancelButton: true,
        confirmButtonText: 'Proceed with Refund',
        confirmButtonColor: '#28a745',
        didOpen: function () {
          document.querySelectorAll('.deduct-row').forEach(function (row) {
            row.addEventListener('click', function () {
              document.querySelectorAll('.deduct-row').forEach(function (r) { r.style.background = ''; });
              this.style.background = '#e8f5e9';
              var radio = this.querySelector('input[type="radio"]');
              if (radio) radio.checked = true;
            });
          });
        },
        preConfirm: function () {
          var selected = document.querySelector('input[name="txSelect"]:checked');
          if (!selected) {
            Swal.showValidationMessage('Please select a deduction to refund.');
            return false;
          }
          var reason = document.getElementById('swal-refund-reason').value.trim();
          if (!reason) {
            Swal.showValidationMessage('A refund reason is required.');
            return false;
          }
          return { transactionId: selected.value, reason: reason };
        },
      }).then(function (result) {
        if (!result.isConfirmed) return;

        fetch('/admin/product/user-details/' + userId + '/refund-deduction', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify(result.value),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.success) {
              Swal.fire({ icon: 'success', title: 'Refunded', text: d.message })
                .then(function () { location.reload(); });
            } else {
              Swal.fire({ icon: 'error', title: 'Failed', text: d.message });
            }
          })
          .catch(function () {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Request failed. Please try again.' });
          });
      });

    } catch (e) {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Could not load deductions. Please try again.' });
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-undo-alt"></i> Refund Deduction';
    }
  });
})();
</script>
<script>
// Copy the user's referral code — with a fallback for non-HTTPS admin sessions,
// where navigator.clipboard is unavailable.
(function () {
  var btn = document.getElementById('ud-copy-code');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var code = this.dataset.code;
    if (!code) return;
    var done = function () {
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(code).then(done).catch(fallback);
    } else { fallback(); }
    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = code; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); done(); } catch (e) {}
      document.body.removeChild(ta);
    }
  });
})();
</script>
