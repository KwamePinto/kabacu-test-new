
  <div class="loader"></div>
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../../partials/headerAdmin.ejs')%>
      <%- include('../../partials/sideMenuAdmin.ejs')%>

      <div class="main-content">
        <section class="section">
          <div class="section-body">
            <div class="row">
              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <h4>All Products</h4>
                  </div>
                  <div class="card-body">
                    <div class="table-responsive">
                      <table class="table table-striped" id="table-1">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Image</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Details</th>
                            <th>Price</th>
                            <th>RP</th>
                            <th>Listed</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (products.length > 0) { %>
                          <% products.forEach(function(product, index) {
                               var active = product.isActive !== false;
                          %>
                          <tr id="prod-row-<%= product._id %>" style="<%= active ? '' : 'opacity:0.6;' %>">
                            <td><%= index + 1 %></td>
                            <td>
                              <% if (product.images && product.images.length > 0) { %>
                              <img src="<%= product.images[0] %>" width="50" style="border-radius:5px;"
                   onerror="this.style.opacity='0.3'; this.title='Image not found'; this.onerror=null;">
                              <% } %>
                            </td>
                            <td>
                              <b><%= product.productName %></b>
                              <% if (!active) { %>
                                <span class="badge badge-secondary ml-1" style="font-size:10px;">Unlisted</span>
                              <% } %>
                            </td>
                            <td>
                              <span class="badge badge-info"><%= product.category %></span>
                            </td>
                            <td><%= product.productExtra %></td>
                            <td>₦<%= product.productPrice.toLocaleString() %></td>
                            <td>
                              <span class="badge badge-success"><%= product.reward_point || 0 %></span>
                            </td>
                            <td>
                              <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input prod-toggle"
                                  id="toggle-<%= product._id %>"
                                  data-id="<%= product._id %>"
                                  data-name="<%= product.productName %>"
                                  <%= active ? 'checked' : '' %>>
                                <label class="custom-control-label" for="toggle-<%= product._id %>"></label>
                              </div>
                            </td>
                            <td>
                              <div class="dropdown dropdown-action">
                                <a href="#" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                  Actions
                                </a>
                                <div class="dropdown-menu dropdown-menu-right">
                                  <a class="dropdown-item" href="/admin/product/edit-product/<%= product._id %>">
                                    <i class="fa fa-pencil m-r-5"></i> Edit
                                  </a>
                                  <a class="dropdown-item text-danger prod-delete-btn" href="#"
                                     data-id="<%= product._id %>"
                                     data-name="<%= product.productName %>">
                                    <i class="fa fa-trash-o m-r-5"></i> Delete
                                  </a>
                                </div>
                              </div>
                            </td>
                          </tr>
                          <% }) %>
                          <% } else { %>
                          <tr>
                            <td colspan="9" class="text-center">No products found</td>
                          </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="settingSidebar">
          <a href="javascript:void(0)" class="settingPanelToggle"><i class="fa fa-spin fa-cog"></i></a>
          <div class="settingSidebar-body ps-container ps-theme-default">
            <div class="fade show active">
              <div class="setting-panel-header">Setting Panel</div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Select Layout</h6>
                <div class="selectgroup layout-color w-50">
                  <label class="selectgroup-item">
                    <input type="radio" name="value" value="1" class="selectgroup-input-radio select-layout" checked>
                    <span class="selectgroup-button">Light</span>
                  </label>
                  <label class="selectgroup-item">
                    <input type="radio" name="value" value="2" class="selectgroup-input-radio select-layout">
                    <span class="selectgroup-button">Dark</span>
                  </label>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Sidebar Color</h6>
                <div class="selectgroup selectgroup-pills sidebar-color">
                  <label class="selectgroup-item">
                    <input type="radio" name="icon-input" value="1" class="selectgroup-input select-sidebar">
                    <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip" data-original-title="Light Sidebar"><i class="fas fa-sun"></i></span>
                  </label>
                  <label class="selectgroup-item">
                    <input type="radio" name="icon-input" value="2" class="selectgroup-input select-sidebar" checked>
                    <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip" data-original-title="Dark Sidebar"><i class="fas fa-moon"></i></span>
                  </label>
                </div>
              </div>
              <div class="mt-4 mb-4 p-3 align-center rt-sidebar-last-ele">
                <a href="#" class="btn btn-icon icon-left btn-primary btn-restore-theme">
                  <i class="fas fa-undo"></i> Restore Default
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <footer class="main-footer">
        <div class="footer-left">&copy; <%= new Date().getFullYear() %> Kabacu. All rights reserved.</div>
        <div class="footer-right"></div>
      </footer>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
var CSRF_TOKEN = '<%= csrfToken %>';

<% if (typeof query !== 'undefined' && query.added == '1') { %>
Swal.fire({ icon: 'success', title: 'Product Added!', text: 'New product has been added successfully.', timer: 2500, showConfirmButton: false });
<% } %>
<% if (typeof query !== 'undefined' && query.updated == '1') { %>
Swal.fire({ icon: 'success', title: 'Updated!', text: 'Product updated successfully.', timer: 2000, showConfirmButton: false });
<% } %>
<% if (typeof query !== 'undefined' && query.deleted == '1') { %>
Swal.fire({ icon: 'success', title: 'Deleted!', text: 'Product removed successfully.', timer: 2000, showConfirmButton: false });
<% } %>

document.querySelectorAll('.prod-toggle').forEach(function(checkbox) {
  checkbox.addEventListener('change', function() {
    var id      = this.dataset.id;
    var name    = this.dataset.name;
    var checked = this.checked;
    var row     = document.getElementById('prod-row-' + id);
    var badge   = row ? row.querySelector('.badge.badge-secondary') : null;
    var self    = this;

    fetch('/admin/product/toggle-product/' + id, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
    })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          var nowActive = data.isActive;
          if (row) row.style.opacity = nowActive ? '' : '0.6';
          var nameCell = row ? row.querySelector('td:nth-child(3)') : null;
          if (nameCell) {
            var existing = nameCell.querySelector('.badge.badge-secondary');
            if (!nowActive && !existing) {
              var b = document.createElement('span');
              b.className = 'badge badge-secondary ml-1';
              b.style.fontSize = '10px';
              b.textContent = 'Unlisted';
              nameCell.appendChild(b);
            } else if (nowActive && existing) {
              existing.remove();
            }
          }
          Swal.fire({
            icon: 'success',
            title: nowActive ? 'Product Listed' : 'Product Unlisted',
            text: '"' + name + '" is now ' + (nowActive ? 'visible to users.' : 'hidden from users.'),
            timer: 2000,
            showConfirmButton: false,
          });
        } else {
          self.checked = !checked;
          Swal.fire({ icon: 'error', title: 'Error', text: data.error || 'Could not update product.' });
        }
      })
      .catch(function() {
        self.checked = !checked;
        Swal.fire({ icon: 'error', title: 'Error', text: 'Network error. Please try again.' });
      });
  });
});

document.querySelectorAll('.prod-delete-btn').forEach(function(btn) {
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    var id   = this.dataset.id;
    var name = this.dataset.name;

    Swal.fire({
      title: 'Delete Product?',
      text: 'Are you sure you want to delete "' + name + '"? This cannot be undone.',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Yes, Delete',
      confirmButtonColor: '#e74c3c',
      cancelButtonText: 'Cancel',
    }).then(function(result) {
      if (!result.isConfirmed) return;

      fetch('/admin/product/delete-product/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            var row = document.getElementById('prod-row-' + id);
            if (row) row.remove();
            Swal.fire({ icon: 'success', title: 'Deleted!', text: '"' + name + '" has been removed.', timer: 2000, showConfirmButton: false });
          } else {
            Swal.fire({ icon: 'error', title: 'Error', text: data.error || 'Could not delete product.' });
          }
        })
        .catch(function() {
          Swal.fire({ icon: 'error', title: 'Error', text: 'Network error. Please try again.' });
        });
    });
  });
});
</script>
