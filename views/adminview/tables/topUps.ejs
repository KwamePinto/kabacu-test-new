<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../../partials/headerAdmin.ejs')%>

    <%- include('../../partials/sideMenuAdmin.ejs')%>

    <!-- Main Content -->
    <div class="main-content">
      <section class="section">
        <div class="section-body">
          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap" style="gap:8px;">
                  <h4 class="mb-0">All Top-ups</h4>
                  <input type="text" id="topups-admin-search" class="form-control"
                         placeholder="Search reference, user, status…" style="max-width:300px;">
                </div>
                <div class="card-body">
                  <div class="table-responsive">
                    <table class="table table-striped" id="table-1">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Reference</th>
                          <th>User</th>
                          <th>Amount</th>
                          <th>Naira Amount</th>
                          <th>Balance Type</th>
                          <th>Payment Method</th>
                          <th>Status</th>
                          <th>Wallet Credited</th>
                          <th>Market</th>
                          <th>Date</th>
                          <th>Action</th>
                        </tr>
                      </thead>

                      <tbody>
                        <% if(topups && topups.length > 0){ %>

                        <% topups.forEach((topup, index) => { %>

                        <tr>
                          <td><%= index + 1 %></td>

                          <td>
                            <small>
                              <%= topup.reference || 'N/A' %>
                            </small>
                          </td>

                          <td>
                            <% if(topup.user?.firstname || topup.user?.name || topup.user?.email){ %>
                            <a href="/admin/product/user-details/<%= topup.user._id %>"><%= topup.user?.firstname || topup.user?.username || topup.user?.email %></a>
                            <% } else { %>
                            N/A
                            <% } %>
                          </td>

                          <td>
                            <%= Number(topup.amount).toLocaleString() %>
                          </td>

                          <td>
                            <% if(topup.nairaAmount){ %>
                            ₦<%= Number(topup.nairaAmount).toLocaleString() %>
                            <% } else { %>
                            —
                            <% } %>
                          </td>

                          <td>
                            <span class="badge badge-info">
                              <%= topup.balanceType %>
                            </span>
                          </td>

                          <td>
                            <span class="badge badge-primary">
                              <% if(['RP', 'BTT', 'USDT'].includes(topup.balanceType)){ %>
                              Bittoken
                              <% } else { %>
                              <%= topup.paymentMethod || 'N/A' %>
                              <% } %>
                            </span>
                          </td>

                          <td>
                            <% if(topup.status === 'COMPLETED'){ %>
                            <span class="badge badge-success">
                              Completed
                            </span>

                            <% } else if(topup.status === 'FAILED'){ %>
                            <span class="badge badge-danger">
                              Failed
                            </span>

                            <% } else { %>
                            <span class="badge badge-warning">
                              Pending
                            </span>
                            <% } %>
                          </td>

                          <td>
                            <% if(topup.walletCredited){ %>
                            <span class="badge badge-success">
                              Yes
                            </span>
                            <% } else { %>
                            <span class="badge badge-danger">
                              No
                            </span>
                            <% } %>
                          </td>

                          <td>
                            <small>
                              <%= topup.walletCountry || 'NG' %>
                              <% if (topup.isManual) { %>
                              <br><span class="badge badge-light" style="border:1px solid #e4e6fc;font-size:10px;">manual</span>
                              <% } %>
                            </small>
                          </td>

                          <td>
                            <%= new Date(topup.createdAt).toLocaleString() %>
                          </td>

                          <td style="white-space:nowrap;">
                            <%
                              /* Only a pending, uncredited manual top-up can be
                                 acted on. Gateway top-ups are confirmed by the
                                 provider's webhook, so offering a button here
                                 would let an admin credit a payment that never
                                 landed. */
                              var _actionable = topup.isManual
                                             && topup.status === 'PENDING'
                                             && !topup.walletCredited;
                            %>
                            <% if (_actionable) { %>
                            <button type="button" class="btn btn-sm btn-success topup-confirm"
                                    style="border-radius:45px;"
                                    data-id="<%= topup._id %>"
                                    data-amount="<%= topup.amount %>"
                                    data-market="<%= topup.walletCountry || 'NG' %>"
                                    data-user="<%= topup.user ? topup.user.username : 'user' %>"
                                    data-method="<%= topup.paymentMethod || '' %>"
                                    data-ref="<%= topup.userReference || '' %>">Confirm</button>
                            <button type="button" class="btn btn-sm btn-outline-danger topup-reject"
                                    style="border-radius:45px;"
                                    data-id="<%= topup._id %>">Reject</button>
                            <% } else if (topup.isManual && topup.confirmedBy) { %>
                            <small class="text-muted">
                              <%= topup.status === 'COMPLETED' ? 'Confirmed' : 'Rejected' %>
                              by <%= topup.confirmedBy %>
                            </small>
                            <% } else { %>
                            <small class="text-muted">&mdash;</small>
                            <% } %>
                          </td>
                        </tr>

                        <% }) %>

                        <% } else { %>

                        <tr>
                          <td colspan="12" class="text-center">
                            No top-up records found
                          </td>
                        </tr>

                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </section>
      <div class="settingSidebar">
        <a href="javascript:void(0)" class="settingPanelToggle"> <i class="fa fa-spin fa-cog"></i>
        </a>
        <div class="settingSidebar-body ps-container ps-theme-default">
          <div class=" fade show active">
            <div class="setting-panel-header">Setting Panel
            </div>
            <div class="p-15 border-bottom">
              <h6 class="font-medium m-b-10">Select Layout</h6>
              <div class="selectgroup layout-color w-50">
                <label class="selectgroup-item">
                  <input type="radio" name="value" value="1" class="selectgroup-input-radio select-layout" checked>
                  <span class="selectgroup-button">Light</span>
                </label>
                <label class="selectgroup-item">
                  <input type="radio" name="value" value="2" class="selectgroup-input-radio select-layout">
                  <span class="selectgroup-button">Dark</span>
                </label>
              </div>
            </div>
            <div class="p-15 border-bottom">
              <h6 class="font-medium m-b-10">Sidebar Color</h6>
              <div class="selectgroup selectgroup-pills sidebar-color">
                <label class="selectgroup-item">
                  <input type="radio" name="icon-input" value="1" class="selectgroup-input select-sidebar">
                  <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip" data-original-title="Light Sidebar"><i class="fas fa-sun"></i></span>
                </label>
                <label class="selectgroup-item">
                  <input type="radio" name="icon-input" value="2" class="selectgroup-input select-sidebar" checked>
                  <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip" data-original-title="Dark Sidebar"><i class="fas fa-moon"></i></span>
                </label>
              </div>
            </div>
            <div class="p-15 border-bottom">
              <h6 class="font-medium m-b-10">Color Theme</h6>
              <div class="theme-setting-options">
                <ul class="choose-theme list-unstyled mb-0">
                  <li title="white" class="active">
                    <div class="white"></div>
                  </li>
                  <li title="cyan">
                    <div class="cyan"></div>
                  </li>
                  <li title="black">
                    <div class="black"></div>
                  </li>
                  <li title="purple">
                    <div class="purple"></div>
                  </li>
                  <li title="orange">
                    <div class="orange"></div>
                  </li>
                  <li title="green">
                    <div class="green"></div>
                  </li>
                  <li title="red">
                    <div class="red"></div>
                  </li>
                </ul>
              </div>
            </div>
            <div class="p-15 border-bottom">
              <div class="theme-setting-options">
                <label class="m-b-0">
                  <input type="checkbox" name="custom-switch-checkbox" class="custom-switch-input" id="mini_sidebar_setting">
                  <span class="custom-switch-indicator"></span>
                  <span class="control-label p-l-10">Mini Sidebar</span>
                </label>
              </div>
            </div>
            <div class="p-15 border-bottom">
              <div class="theme-setting-options">
                <label class="m-b-0">
                  <input type="checkbox" name="custom-switch-checkbox" class="custom-switch-input" id="sticky_header_setting">
                  <span class="custom-switch-indicator"></span>
                  <span class="control-label p-l-10">Sticky Header</span>
                </label>
              </div>
            </div>
            <div class="mt-4 mb-4 p-3 align-center rt-sidebar-last-ele">
              <a href="#" class="btn btn-icon icon-left btn-primary btn-restore-theme">
                <i class="fas fa-undo"></i> Restore Default
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <footer class="main-footer">
      <div class="footer-left">
        <a href="templateshub.net">Templateshub</a></a>
      </div>
      <div class="footer-right">
      </div>
    </footer>
  </div>
</div>

<script>
window.addEventListener('load', function () {
  var dt = $('#table-1').DataTable();
  var timer;
  document.getElementById('topups-admin-search').addEventListener('input', function () {
    var q = this.value;
    clearTimeout(timer);
    timer = setTimeout(function () { dt.search(q).draw(); }, 300);
  });
});
</script>
<script>
/* Manual top-up confirmation.
   These are markets with no payment gateway: the user says they have paid and
   nothing has moved yet. Confirming is what credits the wallet, so the dialog
   shows what the admin should be checking against before they commit. */
(function () {
  var CSRF = '<%= csrfToken %>';

  async function post(url, body) {
    var res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify(body || {}),
    });
    return res.json();
  }

  $(document).on('click', '.topup-confirm', async function () {
    var b = $(this);
    var d = this.dataset;

    var ask = await Swal.fire({
      icon: 'question',
      title: 'Confirm this payment?',
      html:
        '<div style="text-align:left;font-size:14px;line-height:1.7;">' +
          '<b>User:</b> ' + d.user + '<br>' +
          '<b>Amount:</b> ' + Number(d.amount).toLocaleString() + ' (' + d.market + ')<br>' +
          '<b>Method:</b> ' + (d.method || '—') + '<br>' +
          '<b>Their reference:</b> ' + (d.ref || 'none given') +
        '</div>' +
        '<p style="margin-top:14px;font-size:13px;color:#6c757d;">' +
          'Check the payment actually landed before confirming. This credits their wallet.' +
        '</p>',
      showCancelButton: true,
      confirmButtonText: 'Payment received — credit it',
      confirmButtonColor: '#47c363',
    });
    if (!ask.isConfirmed) return;

    b.prop('disabled', true).text('Crediting…');
    try {
      var data = await post('/admin/product/top-ups/' + d.id + '/confirm');
      if (data.success) {
        await Swal.fire({ icon: 'success', text: data.message, confirmButtonColor: '#6777ef' });
        window.location.reload();
        return;
      }
      Swal.fire({ icon: 'error', text: data.message, confirmButtonColor: '#6777ef' });
    } catch (_) {
      Swal.fire({ icon: 'error', text: 'Request failed. Reload before retrying so you do not credit twice.', confirmButtonColor: '#6777ef' });
    }
    b.prop('disabled', false).text('Confirm');
  });

  $(document).on('click', '.topup-reject', async function () {
    var b = $(this);
    var id = this.dataset.id;

    var ask = await Swal.fire({
      icon: 'warning',
      title: 'Not confirmed?',
      input: 'text',
      inputLabel: 'Why — the user is told this',
      inputPlaceholder: 'e.g. No payment found with that reference',
      showCancelButton: true,
      confirmButtonText: 'Reject',
      confirmButtonColor: '#fc544b',
      inputValidator: function (v) {
        if (!v || !v.trim()) return 'Give a reason so the user knows what to do next.';
      },
    });
    if (!ask.isConfirmed) return;

    b.prop('disabled', true).text('…');
    try {
      var data = await post('/admin/product/top-ups/' + id + '/reject', { reason: ask.value });
      if (data.success) {
        window.location.reload();
        return;
      }
      Swal.fire({ icon: 'error', text: data.message, confirmButtonColor: '#6777ef' });
    } catch (_) {
      Swal.fire({ icon: 'error', text: 'Request failed. Please try again.', confirmButtonColor: '#6777ef' });
    }
    b.prop('disabled', false).text('Reject');
  });
})();
</script>
