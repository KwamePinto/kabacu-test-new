<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-body">

          <%
            var issues = (unwalleted ? unwalleted.length : 0) + (orphanMethods ? orphanMethods.length : 0);
            var liveCount = wallets.filter(function (w) { return w.isActive; }).length;
            var methodCount = wallets.reduce(function (n, w) {
              return n + w.methods.filter(function (m) { return m.isActive; }).length;
            }, 0);
          %>

          <div class="kp-panel">

            <div class="kp-panel__head">
              <h1 class="kp-panel__title">Payments &amp; Wallets</h1>
              <p class="kp-panel__sub">Which countries are live, and how users fund them</p>
            </div>

            <div class="kp-panel__body">

              <%- include('partials/panelDrawer', {
                panelKey: 'payments',
                drawerLabel: 'Markets',
                sections: [
                  { id: 'markets', label: 'Live Markets', icon: 'globe' },
                  { id: 'add',     label: 'Add a Market', icon: 'plus-circle' },
                  { id: 'issues',  label: 'Issues',       icon: 'alert-triangle', badge: issues }
                ]
              }) %>

              <div class="kp-panel__main">

                <!-- ══ Live markets ══════════════════════════════════════ -->
                <div class="kp-section" data-section="markets">

                  <div class="kp-stats">
                    <div class="kp-stat">
                      <div class="kp-stat__num"><%= wallets.length %></div>
                      <div class="kp-stat__lbl">Markets</div>
                    </div>
                    <div class="kp-stat">
                      <div class="kp-stat__num kp-stat__num--good"><%= liveCount %></div>
                      <div class="kp-stat__lbl">Live</div>
                    </div>
                    <div class="kp-stat">
                      <div class="kp-stat__num"><%= methodCount %></div>
                      <div class="kp-stat__lbl">Active methods</div>
                    </div>
                    <div class="kp-stat">
                      <div class="kp-stat__num <%= issues ? 'kp-stat__num--warn' : 'kp-stat__num--mute' %>"><%= issues %></div>
                      <div class="kp-stat__lbl">Issues</div>
                    </div>
                  </div>

                  <% if (!wallets.length) { %>
                  <div class="kp-card">
                    <div class="kp-empty">
                      No markets yet. Nigeria should be seeded first —
                      run <code>node scripts/seed-country-wallets.js</code>.
                    </div>
                  </div>
                  <% } %>

                  <% wallets.forEach(function (w) {
                       var activeMethods = w.methods.filter(function (m) { return m.isActive; });
                  %>
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">
                        <span style="font-size:19px;vertical-align:-2px;"><%= w.flag %></span>
                        <%= w.name %>
                      </h2>
                      <div class="kp-card__aside">
                        <span class="kp-pill"><%= w.currencySymbol %> <%= w.currencyCode %></span>
                        <span class="kp-pill"><%= w.productCount %> product<%= w.productCount === 1 ? '' : 's' %></span>
                        <span class="kp-pill <%= w.isActive ? 'kp-pill--good' : '' %>"><%= w.isActive ? 'Live' : 'Hidden' %></span>
                      </div>
                    </div>

                    <% if (!w.productCount || !activeMethods.length) { %>
                    <div class="kp-card__body kp-card__body--pad" style="padding-bottom:0;">
                      <% if (!activeMethods.length) { %>
                      <p class="kp-note kp-note--warn">
                        No active payment method — users cannot fund this wallet.
                      </p>
                      <% } %>
                      <% if (!w.productCount) { %>
                      <p class="kp-note">
                        No products, so users switching here see &ldquo;coming soon&rdquo;.
                        <a href="/admin/product/add-products">Add products</a>.
                      </p>
                      <% } %>
                    </div>
                    <% } %>

                    <div class="kp-card__body kp-card__body--flush">
                      <div class="kp-tablewrap">
                        <table class="kp-table">
                          <thead>
                            <tr>
                              <th>Method</th><th>How it works</th><th>Status</th>
                              <th class="kp-table__act">Actions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (!w.methods.length) { %>
                            <tr><td colspan="4"><div class="kp-empty">No methods yet.</div></td></tr>
                            <% } %>
                            <% w.methods.forEach(function (m) { %>
                            <tr>
                              <td>
                                <span class="kp-strong"><%= m.name %></span>
                                <% if (m.description) { %><br><span class="kp-mute" style="font-size:12.5px;"><%= m.description %></span><% } %>
                              </td>
                              <td>
                                <% if (m.kind === 'gateway') { %>
                                <span class="kp-pill kp-pill--info">Hosted checkout</span>
                                <% if (m.provider) { %><br><span class="kp-mute" style="font-size:12px;"><%= m.provider %></span><% } %>
                                <% } else { %>
                                <span class="kp-pill">Manual</span>
                                <% if (m.instructions) { %><br><span class="kp-mute" style="font-size:12px;"><%= m.instructions %></span><% } %>
                                <% } %>
                              </td>
                              <td>
                                <span class="kp-pill <%= m.isActive ? 'kp-pill--good' : '' %>"><%= m.isActive ? 'Active' : 'Off' %></span>
                              </td>
                              <td class="kp-table__act">
                                <button type="button" class="kp-btn kp-btn--sm edit-method-btn"
                                        data-id="<%= m._id %>"
                                        data-name="<%= m.name %>"
                                        data-description="<%= m.description || '' %>"
                                        data-instructions="<%= m.instructions || '' %>">Edit</button>
                                <a href="/admin/payments-wallets/methods/toggle/<%= m._id %>" class="kp-btn kp-btn--sm">
                                  <%= m.isActive ? 'Disable' : 'Enable' %>
                                </a>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>

                    <!-- Add a method to this market -->
                    <div class="kp-card__body kp-card__body--pad" style="border-top:1px solid #f0f1f3;">
                      <form method="POST" action="/admin/payments-wallets/methods/add">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="country" value="<%= w.country %>">
                        <div class="kp-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;align-items:end;">
                          <div class="kp-field">
                            <label class="kp-field__label">Method name</label>
                            <input type="text" name="name" class="kp-input" placeholder="MTN Mobile Money" required>
                          </div>
                          <div class="kp-field">
                            <label class="kp-field__label">Shown to the user</label>
                            <input type="text" name="description" class="kp-input" maxlength="100" placeholder="Mobile money">
                          </div>
                          <div class="kp-field">
                            <label class="kp-field__label">Pay-to details</label>
                            <input type="text" name="instructions" class="kp-input" placeholder="024 555 0000">
                          </div>
                          <button type="submit" class="kp-btn kp-btn--primary">Add method</button>
                        </div>
                      </form>
                    </div>

                    <div class="kp-card__foot">
                      <button type="button" class="kp-btn kp-btn--sm edit-currency-btn"
                              data-id="<%= w._id %>"
                              data-name="<%= w.name %>"
                              data-symbol="<%= w.currencySymbol %>"
                              data-code="<%= w.currencyCode %>"
                              data-currencyname="<%= w.currencyName %>">Edit currency</button>

                      <% if (w.country !== 'NG') { %>
                      <a href="/admin/payments-wallets/countries/toggle/<%= w._id %>" class="kp-btn kp-btn--sm">
                        <%= w.isActive ? 'Hide from users' : 'Make live' %>
                      </a>
                      <a href="/admin/payments-wallets/countries/delete/<%= w._id %>"
                         class="kp-btn kp-btn--sm kp-btn--danger"
                         onclick="return confirm('Remove the <%= w.name %> wallet and its payment methods? Refused if any user still holds funds.')">Remove</a>
                      <% } else { %>
                      <span class="kp-mute" style="font-size:12.5px;">
                        Nigeria is the fallback market — it cannot be hidden or removed.
                      </span>
                      <% } %>
                    </div>
                  </div>
                  <% }) %>
                </div>

                <!-- ══ Add a market ══════════════════════════════════════ -->
                <div class="kp-section" data-section="add">
                  <div class="kp-card">
                    <div class="kp-card__head"><h2 class="kp-card__title">Add a country wallet</h2></div>
                    <form method="POST" action="/admin/payments-wallets/countries/add" id="addWalletForm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                      <div class="kp-card__body kp-card__body--pad">
                        <p class="kp-note">
                          Creating a wallet makes the market live: users get a balance in its
                          currency and it appears in their wallet switcher.
                        </p>

                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Country</span>
                            <p class="kp-row__hint">Countries that already have a wallet are not listed.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <select name="country" id="walletCountry" class="kp-select" required style="min-width:200px;">
                              <option value="">Select a country…</option>
                              <% addableCountries.forEach(function (c) { %>
                              <option value="<%= c.code %>"><%= c.name %></option>
                              <% }) %>
                            </select>
                          </div>
                        </div>

                        <div class="kp-row">
                          <div class="kp-row__main">
                            <span class="kp-row__label">Currency</span>
                            <p class="kp-row__hint">Filled in for markets we know. The wallet keeps this for good.</p>
                          </div>
                          <div class="kp-row__ctrl">
                            <input type="text" name="currencySymbol" id="curSymbol" class="kp-input" placeholder="₵" required style="width:70px;">
                            <input type="text" name="currencyCode" id="curCode" class="kp-input" placeholder="GHS" maxlength="3" style="width:84px;">
                            <input type="text" name="currencyName" id="curName" class="kp-input" placeholder="Cedi" style="width:110px;">
                          </div>
                        </div>
                      </div>

                      <div class="kp-card__body kp-card__body--pad" style="border-top:1px solid #f0f1f3;">
                        <div class="kp-field__label" style="margin-bottom:4px;">Payment methods</div>
                        <p class="kp-row__hint" style="margin:0 0 12px;">
                          How users fund this wallet. A new market starts manual — the user pays out
                          of band and you confirm the top-up.
                        </p>

                        <div id="methodRows"></div>
                        <button type="button" class="kp-btn kp-btn--sm" id="addMethodRow">+ Add another method</button>
                      </div>

                      <div class="kp-card__foot">
                        <button type="submit" class="kp-btn kp-btn--primary">Create wallet</button>
                      </div>
                    </form>
                  </div>
                </div>

                <!-- ══ Issues ════════════════════════════════════════════ -->
                <div class="kp-section" data-section="issues">
                  <% if (!issues) { %>
                  <div class="kp-card">
                    <div class="kp-empty">Nothing to fix. Every market has a wallet and a way to pay.</div>
                  </div>
                  <% } %>

                  <% if (unwalleted && unwalleted.length) { %>
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Products with no wallet</h2>
                      <div class="kp-card__aside"><span class="kp-pill kp-pill--warn"><%= unwalleted.length %></span></div>
                    </div>
                    <div class="kp-card__body kp-card__body--pad">
                      <p class="kp-note kp-note--warn">
                        Users can browse these markets and cannot pay. Add a wallet, or move the
                        products to a market that has one.
                      </p>
                      <div class="kp-inline">
                        <% unwalleted.forEach(function (u) { %>
                        <span class="kp-pill kp-pill--warn">
                          <%= u.flag %> <%= u.name %> · <%= u.productCount %> product<%= u.productCount === 1 ? '' : 's' %>
                        </span>
                        <% }) %>
                      </div>
                    </div>
                  </div>
                  <% } %>

                  <% if (orphanMethods && orphanMethods.length) { %>
                  <div class="kp-card">
                    <div class="kp-card__head">
                      <h2 class="kp-card__title">Unused payment methods</h2>
                      <div class="kp-card__aside"><span class="kp-pill"><%= orphanMethods.length %></span></div>
                    </div>
                    <div class="kp-card__body kp-card__body--pad">
                      <p class="kp-note">
                        These belong to a country with no wallet, so no user can see them.
                      </p>
                      <div class="kp-inline">
                        <% orphanMethods.forEach(function (m) { %>
                        <span class="kp-pill"><%= m.name %> · <%= m.country %></span>
                        <% }) %>
                      </div>
                    </div>
                  </div>
                  <% } %>
                </div>

              </div><!-- /kp-panel__main -->
            </div><!-- /kp-panel__body -->
          </div><!-- /kp-panel -->

        </div>
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>

<!-- ── Edit payment method ── -->
<div class="modal fade" id="editMethodModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content" style="border-radius:12px;">
      <form method="POST" id="editMethodForm" action="">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header" style="border-bottom:1px solid #f0f1f3;">
          <h5 class="modal-title" style="font-size:15px;font-weight:600;">Edit payment method</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">
          <div class="kp-panel">
            <div class="kp-stack">
              <div class="kp-field">
                <label class="kp-field__label">Method name</label>
                <input type="text" name="name" id="editMethodName" class="kp-input" required>
              </div>
              <div class="kp-field">
                <label class="kp-field__label">Shown to the user</label>
                <input type="text" name="description" id="editMethodDescription" class="kp-input" maxlength="100">
              </div>
              <div class="kp-field">
                <label class="kp-field__label">Pay-to details</label>
                <input type="text" name="instructions" id="editMethodInstructions" class="kp-input">
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="border-top:1px solid #f0f1f3;">
          <div class="kp-panel kp-inline">
            <button type="button" class="kp-btn" data-dismiss="modal">Cancel</button>
            <button type="submit" class="kp-btn kp-btn--primary">Save changes</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ── Edit currency ── -->
<div class="modal fade" id="editCurrencyModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content" style="border-radius:12px;">
      <form method="POST" id="editCurrencyForm" action="">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header" style="border-bottom:1px solid #f0f1f3;">
          <h5 class="modal-title" style="font-size:15px;font-weight:600;">
            Currency — <span id="editCurrencyCountry"></span>
          </h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">
          <div class="kp-panel">
            <p class="kp-note">
              The country cannot be changed — balances are keyed by it, so repointing a wallet
              would reassign every user's money.
            </p>
            <div class="kp-stack">
              <div class="kp-field">
                <label class="kp-field__label">Symbol</label>
                <input type="text" name="currencySymbol" id="editCurSymbol" class="kp-input" required>
              </div>
              <div class="kp-field">
                <label class="kp-field__label">Code</label>
                <input type="text" name="currencyCode" id="editCurCode" class="kp-input" maxlength="3">
              </div>
              <div class="kp-field">
                <label class="kp-field__label">Name</label>
                <input type="text" name="currencyName" id="editCurName" class="kp-input">
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="border-top:1px solid #f0f1f3;">
          <div class="kp-panel kp-inline">
            <button type="button" class="kp-btn" data-dismiss="modal">Cancel</button>
            <button type="submit" class="kp-btn kp-btn--primary">Save changes</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="/admin/assets/js/kbc-panel.js"></script>
<script>
(function () {
  /* Currency lookup, served from the same table the server uses, so the
     prefill and what gets saved cannot disagree. */
  var CURRENCIES = <%- JSON.stringify(currencies) %>;

  $('#walletCountry').on('change', function () {
    var c = CURRENCIES[this.value];
    // Unknown market: leave the fields blank for the admin to fill rather than
    // guessing a symbol. The form requires a symbol, so nothing saves half-set.
    $('#curSymbol').val(c ? c.symbol : '');
    $('#curCode').val(c ? c.code : '');
    $('#curName').val(c ? c.name : '');
  });

  // Repeatable payment-method rows on the create form.
  var rowIdx = 0;
  function addRow(first) {
    rowIdx++;
    $('#methodRows').append(
      '<div class="method-row" style="border:1px solid #f0f1f3;border-radius:8px;padding:12px;margin-bottom:10px;">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">' +
          '<span class="kp-field__label">Method ' + rowIdx + '</span>' +
          (first ? '' : '<button type="button" class="kp-btn kp-btn--sm kp-btn--danger remove-row">Remove</button>') +
        '</div>' +
        '<input type="text" name="methodName" class="kp-input" style="width:100%;margin-bottom:8px;" placeholder="e.g. MTN Mobile Money">' +
        '<input type="text" name="methodDescription" class="kp-input" style="width:100%;margin-bottom:8px;" placeholder="Shown to the user" maxlength="100">' +
        '<input type="text" name="methodInstructions" class="kp-input" style="width:100%;" placeholder="Pay-to details">' +
      '</div>'
    );
  }
  addRow(true);
  $('#addMethodRow').on('click', function () { addRow(false); });
  $(document).on('click', '.remove-row', function () { $(this).closest('.method-row').remove(); });

  $(document).on('click', '.edit-method-btn', function () {
    var b = $(this);
    $('#editMethodName').val(b.data('name'));
    $('#editMethodDescription').val(b.data('description'));
    $('#editMethodInstructions').val(b.data('instructions'));
    $('#editMethodForm').attr('action', '/admin/payments-wallets/methods/edit/' + b.data('id'));
    $('#editMethodModal').modal('show');
  });

  $(document).on('click', '.edit-currency-btn', function () {
    var b = $(this);
    $('#editCurrencyCountry').text(b.data('name'));
    $('#editCurSymbol').val(b.data('symbol'));
    $('#editCurCode').val(b.data('code'));
    $('#editCurName').val(b.data('currencyname'));
    $('#editCurrencyForm').attr('action', '/admin/payments-wallets/countries/edit/' + b.data('id'));
    $('#editCurrencyModal').modal('show');
  });
})();
</script>
